<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- The complete package budget. Adding anything here requires a recorded decision in AGENTS.md. -->

  <!--
    The Marten version, defined once and tested at both ends.

    MartenStudioMartenFloor is the version the shipped package depends on (`Marten >= floor` in its
    nuspec) and the one every build, test and pack uses unless told otherwise. 9.39.0 is a SECURITY
    floor, not an API one: it fixes GHSA-q4xm-rhx9-xjm4 (GroupBy HAVING operand, critical, affects
    9.13.0 - 9.38.0) and GHSA-frqq-p5g3-8jq5 (full-text regConfig on the ranking path, critical,
    affects 9.31.0 - 9.38.0). Neither was in the GitHub advisory database on 2026-10-15, and the day
    one is, restore at any lower floor fails with NU1904 under TreatWarningsAsErrors - the same wall
    as GHSA-rfx3-98h7-v3xp at <= 9.12.0. Nothing the studio calls is missing at 9.31.0; the floor
    moved so that it cannot break CI from outside, and so that the package never asks a host to stay
    on an injectable Marten. Full record in AGENTS.md, *Package budget changes*, 2026-10-15.

    MartenStudioMartenLatest is the newest 9.x CI tests: the marten-latest workflow runs
    `dotnet fallout Test` with MARTEN_VERSION=latest, the Fallout parameter `marten-version`. It is an
    exact version, never a floating `9.*`: a red main caused by an upstream release would be nobody's
    pull request's fault. To bump it, change the value here, run both suites at it (the Fallout
    parameter set to `latest`, or `dotnet test` with -p:MartenStudioMartenVersion=<new>), and fix or
    record every difference in the same pull request.

    MartenStudioMartenVersion is what is actually restored. Leave it empty and it is the floor; set it
    with -p:MartenStudioMartenVersion=9.51.0, or through the Fallout parameter, which resolves `floor`
    and `latest` from the two properties above. Pack always packs at the floor and refuses anything
    else - the build's Pack target and a guard in src/MartenStudio/MartenStudio.csproj both say so -
    because a package packed at a newer Marten would silently raise every host's floor.

    (No double hyphen anywhere in an XML comment: it is not well-formed XML, and MSBuild answers a
    malformed Directory.Packages.props with NU1015 on every project rather than with a parse error.)
  -->
  <PropertyGroup Label="Marten version">
    <MartenStudioMartenFloor>9.39.0</MartenStudioMartenFloor>
    <MartenStudioMartenLatest>9.54.1</MartenStudioMartenLatest>
    <MartenStudioMartenVersion Condition="'$(MartenStudioMartenVersion)' == ''">$(MartenStudioMartenFloor)</MartenStudioMartenVersion>
  </PropertyGroup>

  <ItemGroup Label="Library (src/MartenStudio)">
    <!-- The only PackageReference the shipped RCL makes. Everything else it needs is in the
         Microsoft.AspNetCore.App shared framework (FrameworkReference), which is what keeps the
         package from pinning an ASP.NET Core patch on its host. Floor, not exact pin: a consumer
         on a newer Marten 9.x must not be forced down. Npgsql arrives transitively via Weasel.Postgresql.

         The floor is 9.39.0 for the two advisories above. Below it, the 2026-09-19 bisection still
         holds as the record of what the code itself needs: 9.31.0 is the lowest stable 9.x this
         repository restores, compiles and passes both suites on. 9.30.0 fails: Marten gated
         EventProgressionTable's extended columns on Events.EnableExtendedProgressionTracking until
         9.31.0 (#5309), so ExtendedProgressionLiveTests cannot even write its row
         ("42703: column heartbeat of relation mt_event_progression does not exist"). Below that,
         9.22.4 is the first with ShardName.HighWaterMarkFor, 9.20.0 the first with
         JasperFx.Events.Daemon.ShardFailure, and everything <= 9.12.0 fails restore outright with
         NU1904 for GHSA-rfx3-98h7-v3xp. Full record in AGENTS.md, *Package budget changes*. -->
    <PackageVersion Include="Marten" Version="$(MartenStudioMartenVersion)" />
    <!--
      blazor.web.js. As of .NET 10 it is not in the shared framework and not embedded in any ASP.NET
      Core assembly: it lives in this pack, which the SDK resolves only for a project whose
      `RequiresAspNetWebAssets` is true - and the Web SDK defaults that to true only for a project with
      `.razor` Content items of its own. A host that adds Marten Studio and writes no Blazor components
      has none, so GET /_framework/blazor.web.js answered 404 and the studio prerendered and never became
      interactive. The package cannot set the property on the consumer's behalf (NuGet excludes
      package-provided .props from restore evaluation), so the reference is how the script reaches the
      host: its buildTransitive targets define the asset IN THE CONSUMER, at the consumer's own resolved
      version, which is also what keeps the studio from shipping a frozen copy of a Microsoft script.
      No lib/, no ref/, no runtime assembly - three .js files and an MSBuild target - so it pins no
      ASP.NET Core patch on the host. Floor, not exact pin, like Marten. Recorded in AGENTS.md,
      *Package budget changes*, 2026-09-14.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Sample and integration tests">
    <!-- Zero-config `dotnet run`: with no connection string configured the sample starts its own
         throwaway Postgres. Also the container the integration tests use. Recorded in AGENTS.md;
         the sample is never packed. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup Label="Test - both projects">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <!--
      Held at 3.x deliberately: xunit.v3 4.0.0 drops VSTest-mode support, which Fallout 10.4.0's
      ITest depends on (it passes `logger trx;LogFileName=` and parses the TeamTest/2010 TRX).
      See AGENTS.md, *Package budget changes*, for the revisit trigger.
    -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!--
      Fallout's ITest probes each test project for this reference and only then passes
      `logger GitHubActions`. Without it a red CI run is a TRX file and nothing else.

      HELD AT 2.4.1, the last VSTest-only release. 3.x is a Microsoft.Testing.Platform logger: it is
      compiled against `Microsoft.Testing.Platform` 2.0.0, while `xunit.v3` 3.2.2 resolves 1.9.1, and
      the two are not assembly-version compatible - both test projects failed to compile with
      CS1705 ("Microsoft.Testing.Platform ... uses ... which has a higher version than referenced
      assembly"). 2.4.1 depends only on `Microsoft.TestPlatform.ObjectModel`, which is exactly the
      VSTest bridge Fallout 10.4.0's ITest drives (`logger trx` + `logger GitHubActions`), so it
      is the release that matches the rest of the budget rather than the newest one. Pinning
      `Microsoft.Testing.Platform` forward instead would fight xunit.v3's own resolution and is not
      done. Revisit when xunit.v3 and Fallout's ITest both speak Microsoft.Testing.Platform v2.
    -->
    <PackageVersion Include="GitHubActionsTestLogger" Version="2.4.1" />
    <!-- MIT fork of FluentAssertions. One assertion library, no mocking library: the data seam is
         our own set of interfaces and hand-written fakes are smaller and more auditable than a
         mocking framework's call-matching DSL. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>

  <ItemGroup Label="Test - MartenStudio.Tests (no Docker)">
    <PackageVersion Include="bunit" Version="2.11.3" />
    <!--
      PINNED AT 32.0.0 ON PURPOSE. Verify.XunitV3 33.x depends on xunit.v3.extensibility.core
      4.0.1; 32.0.0 is the last release that depends on 3.2.2, which is where xunit.v3 is held.
      Moving this forward silently forces xunit.v3 4.x and breaks Fallout's TRX reporting.
    -->
    <PackageVersion Include="Verify.XunitV3" Version="32.0.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <!-- `builder.WebHost.UseTestServer()` for the endpoint-metadata and startup-guard tests.
         TestHost rather than Mvc.Testing: these tests never need WebApplicationFactory. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Test - MartenStudio.Integration.Tests (needs Docker)">
    <!-- WebApplicationFactory over the real sample host. 11.0.0 is rc; do not take it. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

  <ItemGroup Label="PostgresStudio-only projects (they set PostgresStudioPinsNpgsql)">
    <PackageVersion Include="Npgsql" Version="9.0.4" Condition="'$(PostgresStudioPinsNpgsql)' == 'true'" />
  </ItemGroup>

</Project>
