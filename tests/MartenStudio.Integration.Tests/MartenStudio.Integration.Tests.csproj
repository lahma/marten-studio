<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Global usings, so no test file repeats them and IDE0005 (a warning, and warnings are errors)
       stays meaningful. `Xunit` is declared here and NOT in tests/MartenStudio.Tests: over there
       Verify.XunitV3's own build props already contribute `global using Xunit;`, and a second copy
       from the csproj would be the redundant using IDE0005 exists to catch. AwesomeAssertions is the
       MIT fork of FluentAssertions and still ships its `Should()` extensions in the
       `AwesomeAssertions` namespace, not `FluentAssertions` - verified against the package's XML
       docs, 2026-09-14. -->
  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MartenStudio/MartenStudio.csproj" />
    <ProjectReference Include="../../samples/MartenStudio.SampleDomain/MartenStudio.SampleDomain.csproj" />
    <ProjectReference Include="../../samples/MartenStudio.Sample/MartenStudio.Sample.csproj" />
  </ItemGroup>

</Project>
