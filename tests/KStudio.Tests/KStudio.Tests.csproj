<Project Sdk="Microsoft.NET.Sdk">

  <!-- KStudio's fast suite (AGENTS.md D36): no Docker. The engine against the hand-written fake broker, the conventions
       and the public API baseline. M2 adds bUnit and the KStudio project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- The linked SourceScanner.cs documents itself with crefs to the other suite's tests (CS1574), which this project does not compile. -->
    <NoWarn>$(NoWarn);CS1574</NoWarn>
  </PropertyGroup>

  <!-- Global usings: `Xunit` comes from Verify.XunitV3's build props. -->
  <ItemGroup>
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <!-- Not a package: the shared framework brings the container and logging implementations the engine's real registration is tested
       with (KStudio.Core itself has no framework reference, which KStudioCoreFenceTests holds). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/KStudio.Core/KStudio.Core.csproj" />
    <ProjectReference Include="../../src/KStudio/KStudio.csproj" />
    <ProjectReference Include="../../src/PostgresStudio/PostgresStudio.csproj" />
    <!-- Only for KafkaLogValueParityTests: StudioLogValue is internal there, and this suite is granted InternalsVisibleTo. -->
    <ProjectReference Include="../../src/PostgresStudio.Diagnostics/PostgresStudio.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../MartenStudio.Tests/Conventions/RepositoryRoot.cs" Link="Support/Linked/RepositoryRoot.cs" />
    <Compile Include="../MartenStudio.Tests/Conventions/SourceScanner.cs" Link="Support/Linked/SourceScanner.cs" />
    <Compile Include="../PostgresStudio.Tests/Support/ManualTimeProvider.cs" Link="Support/Linked/ManualTimeProvider.cs" />
    <Compile Include="../MartenStudio.Tests/Support/CapturingLoggerProvider.cs" Link="Support/Linked/CapturingLoggerProvider.cs" />
  </ItemGroup>

  <!-- M2: the shell's component context. Postgres Studio's bUnit context and the doubles it is built from are compiled in from the other
       suites rather than copied (as PostgresStudio.Tests links MartenStudio.Tests'): each names only PostgresStudio's types, so a Kafka page is
       rendered in a real Postgres Studio shell with KStudio's own services added beside it. -->
  <ItemGroup>
    <Compile Include="../PostgresStudio.Tests/Components/PostgresStudioComponentContext.cs" Link="Support/Linked/PostgresStudioComponentContext.cs" />
    <Compile Include="../PostgresStudio.Tests/Support/PostgresFakes.cs" Link="Support/Linked/PostgresFakes.cs" />
    <Compile Include="../PostgresStudio.Tests/Support/NoHealthActionService.cs" Link="Support/Linked/NoHealthActionService.cs" />
    <Compile Include="../MartenStudio.Tests/Support/FakeDatabaseObjectService.cs" Link="Support/Linked/FakeDatabaseObjectService.cs" />
    <Compile Include="../MartenStudio.Tests/Support/FakeDatabaseObjects.cs" Link="Support/Linked/FakeDatabaseObjects.cs" />
    <Compile Include="../MartenStudio.Tests/Support/FakeTableRowService.cs" Link="Support/Linked/FakeTableRowService.cs" />
    <Compile Include="../MartenStudio.Tests/Support/FakeTableRows.cs" Link="Support/Linked/FakeTableRows.cs" />
    <Compile Include="../MartenStudio.Tests/Support/FakeRelationshipDataService.cs" Link="Support/Linked/FakeRelationshipDataService.cs" />
    <Compile Include="../MartenStudio.Tests/Support/TestAuthenticationHandler.cs" Link="Support/Linked/TestAuthenticationHandler.cs" />
    <Compile Include="../MartenStudio.Tests/Support/TestAuthenticationStateProvider.cs" Link="Support/Linked/TestAuthenticationStateProvider.cs" />
    <Compile Include="../MartenStudio.Tests/Support/TestFileProvider.cs" Link="Support/Linked/TestFileProvider.cs" />
    <Compile Include="../MartenStudio.Tests/Support/TestPersistentComponentStateStore.cs" Link="Support/Linked/TestPersistentComponentStateStore.cs" />
    <Compile Include="../MartenStudio.Tests/Health/FakeHealthService.cs" Link="Support/Linked/FakeHealthService.cs" />
  </ItemGroup>

</Project>
