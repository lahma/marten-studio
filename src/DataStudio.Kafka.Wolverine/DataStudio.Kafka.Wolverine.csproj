<Project Sdk="Microsoft.NET.Sdk">

  <!-- DataStudio.Kafka.Wolverine (AGENTS.md D43): lists the Kafka clusters and topics of a Wolverine application's configuration in the Kafka module. It reads
       the built WolverineOptions once and starts, connects and writes nothing. It references DataStudio.Kafka.Core and WolverineFx.Kafka only: no
       studio, no DataStudio.Kafka, no Marten, Weasel or Npgsql (KafkaWolverineFenceTests). -->
  <PropertyGroup>
    <AssemblyName>DataStudio.Kafka.Wolverine</AssemblyName>
    <RootNamespace>DataStudio.Kafka</RootNamespace>
    <PackageId>DataStudio.Kafka.Wolverine</PackageId>
    <Title>Data Studio Kafka discovery for Wolverine</Title>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageTags>kafka;blazor;studio;admin;wolverine</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Product>Data Studio</Product>
    <Description>DataStudio.Kafka.Wolverine lists the Kafka clusters and topics of a Wolverine application in the Kafka pages of Data Studio, by reading its configuration and nothing else. Apache Kafka is a trademark of the Apache Software Foundation. Data Studio is not affiliated with or endorsed by the Apache Software Foundation.</Description>
    <!-- Selects the conditional Microsoft.Extensions.* rows in Directory.Packages.props, as DataStudio.Kafka.Core does. -->
    <DataStudioKafkaCorePinsExtensions>true</DataStudioKafkaCorePinsExtensions>
  </PropertyGroup>

  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../DataStudio.Kafka/README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DataStudio.Kafka.Core/DataStudio.Kafka.Core.csproj" />
    <PackageReference Include="WolverineFx.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataStudio.Kafka.Wolverine.Tests" />
    <InternalsVisibleTo Include="DataStudio.Kafka.Integration.Tests" />
  </ItemGroup>

  <!--
    WolverineFx references the JasperFx source generator with PrivateAssets="none", so it would run over this compilation. It has nothing to
    generate here (this assembly has no handler and no aggregate), and its marker attribute would put a JasperFx type on a shipped assembly,
    which is the reason src/DataStudio.Marten/DataStudio.Marten.csproj drops Marten's. Dropped by file name at CoreCompile, the same way.
  -->
  <Target Name="KafkaWolverineWithoutTheJasperFxSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_KafkaWolverineJasperFxGenerator Include="@(Analyzer)"
                                          Condition="$([System.String]::Copy('%(Filename)').StartsWith('JasperFx')) and $([System.String]::Copy('%(Filename)').EndsWith('SourceGenerator'))" />
      <Analyzer Remove="@(_KafkaWolverineJasperFxGenerator)" />
    </ItemGroup>
  </Target>

  <!-- Exactly its own build of what sits below it, as the Marten module's DataStudioMartenPinsPostgresExactly does: `DataStudio.Kafka.Core [x.y.z]`
       in the nuspec, not NuGet's default `>=`: the version NuGet reads is DataStudio.Kafka.Core's PackageVersion, the CHANGELOG's. -->
  <Target Name="DataStudioKafkaWolverinePinsCoreExactly" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'DataStudio.Kafka.Core'">
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
    <Error Condition="'@(_ProjectReferencesWithVersions->WithMetadataValue('Filename', 'DataStudio.Kafka.Core'))' == ''"
           Text="DataStudio.Kafka.Wolverine must depend on exactly its own DataStudio.Kafka.Core build, and pack found no DataStudio.Kafka.Core project reference to pin." />
  </Target>

</Project>
