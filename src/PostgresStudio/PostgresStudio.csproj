<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AssemblyName>PostgresStudio</AssemblyName>
    <RootNamespace>PostgresStudio</RootNamespace>
    <PackageId>PostgresStudio</PackageId>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>postgresql;npgsql;database;admin;dashboard;ui;blazor;aspnetcore</PackageTags>
    <Description>An embeddable Blazor Server admin UI for the PostgreSQL databases an ASP.NET Core application already registers as NpgsqlDataSource.</Description>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Selects the conditional Npgsql PackageVersion row in Directory.Packages.props (AGENTS.md D30). -->
    <PostgresStudioPinsNpgsql>true</PostgresStudioPinsNpgsql>
  </PropertyGroup>

  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" />
  </ItemGroup>

  <!-- The diagnostics engine, with Npgsql and the Microsoft.Extensions.* abstractions it needs: Npgsql reaches this
       project through it (0.11-C), and PostgresStudio is packed with an exact dependency on its own build of it. -->
  <ItemGroup>
    <ProjectReference Include="..\PostgresStudio.Diagnostics\PostgresStudio.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MartenStudio" />
    <InternalsVisibleTo Include="MartenStudio.Tests" />
    <InternalsVisibleTo Include="MartenStudio.Integration.Tests" />
    <InternalsVisibleTo Include="PostgresStudio.Tests" />
    <InternalsVisibleTo Include="PostgresStudio.Integration.Tests" />
  </ItemGroup>

  <!--
    PostgresStudio depends on exactly its own PostgresStudio.Diagnostics: `PostgresStudio.Diagnostics [0.11.0]` in the
    nuspec, not NuGet's default `>= 0.11.0`. The two assemblies are one program split in two files - the engine grants
    PostgresStudio its internals - so PostgresStudio 0.11.0 beside PostgresStudio.Diagnostics 0.11.1 is a
    MissingMethodException on the first internal signature that moved. The same mechanism, for the same reason, as
    MartenStudioPinsPostgresStudioExactly in src/MartenStudio/MartenStudio.csproj (measured by PS-0, 2026-10-20, SDK
    10.0.402).

    How: GenerateNuspec hands PackTask @(_ProjectReferencesWithVersions), which _GetProjectReferenceVersions fills
    with each referenced project's $(PackageVersion) as ProjectVersion metadata, and PackTask reads that metadata as a
    version RANGE. Bracketing it after that target is the whole change. Both names are NuGet-private, so the build's
    Pack target also asserts the nuspec text: a NuGet that renames them fails the build instead of shipping `>=`. The
    Error is the second half of the same defence: a pack that finds no PostgresStudio.Diagnostics project reference to
    pin refuses rather than shipping a package with no pin at all.

    A host that ends up with another PostgresStudio.Diagnostics anyway - a central PackageVersion under transitive
    pinning drops it from the graph with no NuGet diagnostic at all - is stopped at startup by
    Internal/PostgresStudioDiagnosticsVersionGuard.cs.
  -->
  <Target Name="PostgresStudioPinsDiagnosticsExactly" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'PostgresStudio.Diagnostics'">
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
    <Error Condition="'@(_ProjectReferencesWithVersions->WithMetadataValue('Filename', 'PostgresStudio.Diagnostics'))' == ''"
           Text="PostgresStudio must depend on exactly its own PostgresStudio.Diagnostics build, and pack found no PostgresStudio.Diagnostics project reference to pin." />
  </Target>

  <!--
    The package is packed at the Npgsql floor and nowhere else - the same refusal, for the same reason, as
    MartenStudioPackOnlyAtTheMartenFloor in src/MartenStudio/MartenStudio.csproj. A nupkg packed after a
    restore at Npgsql 10.0.3 would say `Npgsql >= 10.0.3` and raise every host's Npgsql, every MartenStudio
    host's included, since MartenStudio depends on exactly this package. The build's Pack target refuses
    first and names the Fallout parameter; this is the refusal for a bare `dotnet pack`.

    Two checks, because the property is not what NuGet packs from: the dependency range comes from
    project.assets.json, so a restore at the latest Npgsql (the second pass over postgres-studio.slnf)
    followed by a pack with no-restore would pass a property-only check. The library key "Npgsql/<floor>",
    quotes included (\x22 in the pattern), must be in that file. No assets file is a refusal, not a pass.
  -->
  <Target Name="PostgresStudioPackOnlyAtTheNpgsqlFloor" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_PostgresStudioAssetsFileExists>false</_PostgresStudioAssetsFileExists>
      <_PostgresStudioAssetsFileExists Condition="'$(ProjectAssetsFile)' != '' and Exists('$(ProjectAssetsFile)')">true</_PostgresStudioAssetsFileExists>
      <_PostgresStudioFloorLibraryKey>"Npgsql/$(PostgresStudioNpgsqlFloor)"</_PostgresStudioFloorLibraryKey>
      <_PostgresStudioFloorLibraryPattern>\x22Npgsql/$(PostgresStudioNpgsqlFloor.Replace('.', '\.'))\x22</_PostgresStudioFloorLibraryPattern>
      <_PostgresStudioAssets Condition="'$(_PostgresStudioAssetsFileExists)' == 'true'">$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)'))</_PostgresStudioAssets>
      <_PostgresStudioAssetsAtFloor>false</_PostgresStudioAssetsAtFloor>
      <_PostgresStudioAssetsAtFloor Condition="'$(_PostgresStudioAssetsFileExists)' == 'true' and $([System.Text.RegularExpressions.Regex]::IsMatch($(_PostgresStudioAssets), $(_PostgresStudioFloorLibraryPattern)))">true</_PostgresStudioAssetsAtFloor>
    </PropertyGroup>

    <Error Condition="'$(PostgresStudioNpgsqlVersion)' != '$(PostgresStudioNpgsqlFloor)'"
           Text="PostgresStudio is packed only at the Npgsql floor ($(PostgresStudioNpgsqlFloor), Directory.Packages.props), and this pack asks for Npgsql $(PostgresStudioNpgsqlVersion). A package packed here would depend on Npgsql &gt;= $(PostgresStudioNpgsqlVersion) and raise every host's Npgsql. Pack without PostgresStudioNpgsqlVersion, or raise PostgresStudioNpgsqlFloor deliberately and record why in AGENTS.md, Package budget changes." />
    <Error Condition="'$(_PostgresStudioAssetsFileExists)' != 'true'"
           Text="PostgresStudio is packed only at the Npgsql floor ($(PostgresStudioNpgsqlFloor)), and there is no restore output to prove it ('$(ProjectAssetsFile)' does not exist). NuGet writes the package's dependency range from that file, so the guard refuses rather than guess. Pack with a restore (without --no-restore) at the floor." />
    <Error Condition="'$(_PostgresStudioAssetsFileExists)' == 'true' and '$(_PostgresStudioAssetsAtFloor)' != 'true'"
           Text="PostgresStudio is packed only at the Npgsql floor ($(PostgresStudioNpgsqlFloor)), but the last restore ('$(ProjectAssetsFile)') resolved another Npgsql - it has no $(_PostgresStudioFloorLibraryKey) library. NuGet writes the package's dependency range from that file, so this pack would raise every host's Npgsql. Restore at the floor first: pack without --no-restore and without PostgresStudioNpgsqlVersion." />
  </Target>

</Project>
