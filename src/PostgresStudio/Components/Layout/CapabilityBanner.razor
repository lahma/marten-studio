@using PostgresStudio.Services
@using PostgresStudio.Services.Settings
@inject StudioCapabilityGuard Capabilities
@inject IStudioSettings Settings

@if (Capabilities.ReadOnly)
{
    <span class="ms-chip ms-chip-warning" title="@($"{Settings.ReadOnlyOption()} is true, so every capability is off")">
        Read-only
    </span>
}
else
{
    <button type="button"
            class="ms-chip ms-chip-button"
            popovertarget="ms-capability-popover"
            aria-label="@($"{Capabilities.EnabledCount} of {Capabilities.Offered.Count} capabilities enabled")">
        @Capabilities.EnabledCount / @Capabilities.Offered.Count capabilities
    </button>

    @* Native popover: no positioning library, no third-party menu component (AGENTS.md hard rule 3).
       Two groups, because two kinds of switch: the reads (the SQL console, the database browser, other
       sessions' activity, LINQ queries) change nothing, and are still authorized as writes. Each group lists
       only what this studio offers. *@
    <div id="ms-capability-popover" popover="auto" class="ms-popover ms-capability-popover">
        @* The chip counts the studio's switches, not the visitor's rights: a viewer the write policy refuses
           everything still sees "14 / 14". Said once, here, rather than computed per visitor - the policies
           answer per call and per scope, and a number that tried to sum them would be a guess. *@
        <p class="ms-popover-lead">What this studio allows. Your account's policies decide what you may do.</p>
        <p class="ms-popover-title">Reads authorized like writes</p>
        <ul class="ms-capability-list" aria-label="Reads authorized like writes">
            @foreach (StudioCapability capability in Capabilities.OfferedReads)
            {
                @Row(capability)
            }
        </ul>
        @if (Capabilities.OfferedMutating.Count > 0)
        {
            <p class="ms-popover-title">Mutating operations</p>
            <ul class="ms-capability-list" aria-label="Mutating operations">
                @foreach (StudioCapability capability in Capabilities.OfferedMutating)
                {
                    @Row(capability)
                }
            </ul>
        }
        <p class="ms-popover-footnote">
            Every one of these is off until the host sets it. <code>@Settings.AllCapabilities()</code>
            turns them all on; <code>@Settings.ReadOnlyOption()</code> turns them all off again.
        </p>
    </div>
}

@code {
    private RenderFragment Row(StudioCapability capability) => __builder =>
    {
        bool enabled = Capabilities.IsEnabled(capability);
        <li class="ms-capability @(enabled ? "ms-capability-on" : "ms-capability-off")" @key="capability">
            <span class="ms-capability-state" aria-hidden="true">@(enabled ? "on" : "off")</span>
            <span class="ms-capability-name">@capability</span>
            <code class="ms-capability-option">@OptionName(capability)</code>
        </li>
    };

    /// <summary>
    /// The option's name with a line-break opportunity after each dot, so a popover narrower than the name - a
    /// phone - wraps it between its parts rather than cutting it off or splitting a word. <c>&lt;wbr&gt;</c>
    /// adds no character: the name reads, and copies, exactly as it is written.
    /// </summary>
    private RenderFragment OptionName(StudioCapability capability) => __builder =>
    {
        string[] parts = Capabilities.OptionFor(capability).Split('.');

        for (int i = 0; i < parts.Length; i++)
        {
            if (i > 0)
            {
                <text>.</text><wbr />
            }

            <text>@parts[i]</text>
        }
    };
}
