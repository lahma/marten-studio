@using PostgresStudio.Services.Settings
@inject IStudioSettings Settings

@* The way out of the studio to the host's own application, when the host named one (ApplicationPath; Hangfire's AppPath is the
   prior art). Absent unless set.

   The href is the option exactly as the host wrote it. It is validated at startup to be a path that starts with a single "/" or an
   absolute http(s) URL, and it is never re-rooted: the document's <base href> is the studio's mount path, and a leading slash
   resolves against the host's root, not against it.

   Interception (1.2): the studio's circuit renders a click on a link inside the mount; a link outside it is not the circuit's to
   render and the browser loads it, and so is a link that no studio page matches. data-enhance-nav="false" says the same to the
   enhanced navigation of a page that is still static markup. *@

@if (Settings.ApplicationPath is { Length: > 0 } applicationPath)
{
    <a class="ms-btn ms-btn-sm ms-back-link"
       href="@applicationPath"
       data-enhance-nav="false"
       title="Back to application: leave the studio for the application it is part of">
        <svg class="ms-back-link-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.5 3.5 5 8l4.5 4.5" />
            <path d="M5 8h8" />
        </svg>
        <span class="ms-back-link-text">Back to application</span>
    </a>
}
