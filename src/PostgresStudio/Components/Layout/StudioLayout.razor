@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.Extensions.Logging
@using PostgresStudio.Internal
@using PostgresStudio.Services
@using PostgresStudio.Services.Live
@using PostgresStudio.Services.Settings
@using PostgresStudio.Components.Shared
@inject StudioState State
@inject StudioAuthorization Authorization
@inject StudioDescriptor Descriptor
@inject IStudioSettings Settings
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject PersistentComponentState PersistentState
@inject StudioMappedEndpoints MappedEndpoints
@inject ILogger<StudioLayout> Logger

@* The stylesheet is not linked from here. It is static markup in StudioDocument's own <head>: a
   <HeadContent> put it inside the <HeadOutlet> marker, and the interactive outlet's first render - which
   happens before this layout has registered any section content - removed it from the live DOM. *@

@* data-ms-interactive (1.2): present once the circuit has rendered this shell and read the browser's preferences. StudioRoutes asked for
   navigation interception before that render batch was sent, so the attribute in the DOM means a link, Back or NavigateTo is
   handled by the circuit. It is the browser suites' readiness signal; nothing else reads it. *@
<div class="ms-studio" data-theme="@State.SelectedTheme" data-ms-interactive="@(preferencesLoaded ? "true" : null)">
    @* 1.1: the first focusable element of every page, hidden until it has focus. Its fragment is handled in studio.js, not by the
       browser: the document's <base href> would send a bare #fragment to the studio's front page. *@
    <a class="ms-skip-link" href="#ms-main-content">Skip to content</a>
    @if (MappedEndpoints.ServedAnonymously)
    {
        @* Not a toast and not dismissible. A studio that anyone can open looks exactly like one behind a
           policy, so the only honest place for this is the top of every page, always. *@
        <div class="ms-anonymous-banner" role="alert">
            <strong>This studio is served to anyone (AllowAnonymous)</strong>
            <span>
                Its pages carry no authorization, so @Descriptor.ExposedContent is readable by anyone who can
                reach this URL.
            </span>
            @* A module's own sentence follows the host's, never spliced into it (D34): the host's words do not move. *@
            @foreach (IStudioModule registered in Descriptor.Modules)
            {
                <span @key="registered.Key">@registered.ExposedSentence</span>
            }
        </div>
    }
    <div class="ms-layout">
        <aside class="ms-sidebar" role="navigation" aria-label="@($"{Descriptor.ProductName} navigation")">
            <NavMenu />
        </aside>

        <div class="ms-main">
            <header class="ms-header">
                <div class="ms-header-left">
                    @* The environment first: it is context like the scope, and the first thing to check before doing anything to a
                       database (1.2). *@
                    <EnvironmentBadge />
                    @* On a module's page (D34) the module's own scope selector stands in the host's: such a page is about the module's own scope. *@
                    @if (currentModule is { } module)
                    {
                        <DynamicComponent Type="module.ScopeSelector" />
                    }
                    else
                    {
                        <ScopeSelector />
                    }
                </div>
                @* Find by id (1.2): between the context on the left and the actions on the right. Drawn only with a scope to search in and a
                   kind to search for; a magnifier below 1024 px (see FindBox). Not on a module's page: its contributors search the host's
                   scope, which such a page is not about (D34). *@
                @if (currentModule is null)
                {
                    <FindBox />
                }
                <div class="ms-header-right">
                    <CapabilityBanner />
                    @* The way out (ApplicationPath, absent unless the host set it) and the address of this page with its scope in it. *@
                    <BackToApplication />
                    <CopyLinkButton />
                    @* The scope selector on the left is the context of every screen in the studio, so it
                       keeps the header row at every width. Theme and time zone are set once and then left
                       alone, so they are behind the gear - which is what turns a four-row header on a
                       390 px phone into one row of 56 px. The two pickers keep their ids, their labels
                       and their `aria-label`s inside it; see PreferencesMenu. *@
                    <PreferencesMenu SelectedTheme="@State.SelectedTheme"
                                     SelectedTimeZoneId="@State.SelectedTimeZoneId"
                                     ThemeChanged="OnThemeChangedAsync"
                                     TimeZoneChanged="OnTimeZoneChangedAsync" />
                </div>
            </header>

            <main class="ms-content" role="main" id="ms-main-content" tabindex="-1">
                @* The page frame is where a per-store refusal belongs: a page that is never rendered never
                   runs its OnInitializedAsync, so nothing about a store the visitor may not see is read on
                   their behalf. The header above stays, so they can pick one they may. *@
                @* A module's page (D34) is gated by the module's own frame, never by the host's scope: a visitor the host's store policy
                   refuses still reaches a module whose own policies admit them. Keyed on the matched page's assembly (CurrentModule). *@
                @if (currentModule is not null || access is ScopeAccess.Granted)
                {
                    @Body
                }
                else if (access is ScopeAccess.Denied)
                {
                    <ScopeNotAuthorized StoreName="@State.ActiveScope?.StoreKey" />
                }
                else
                {
                    <LoadingSpinner />
                }
            </main>
        </div>
    </div>
    <ToastHost />
    <ShortcutSheet />
</div>

@code {
    /// <summary>What the frame knows about the visitor's right to the scope the studio is about.</summary>
    private enum ScopeAccess
    {
        /// <summary>The policy has not answered yet, and until it does the page is not rendered.</summary>
        Unknown,
        Granted,
        Denied
    }

    /// <summary>
    /// What the prerendered scope hands to the circuit's own scope.
    /// </summary>
    /// <remarks>
    /// <see cref="StudioState" /> is scoped, and the circuit's scope is not the request's: it has no
    /// <c>HttpContext</c>, so the cookie that seeded the prerendered theme is invisible to it and the
    /// studio flashed from dark to light the moment the circuit attached. Carried across as persisted
    /// component state rather than re-fetched over JS interop, because a round trip is a flash by another
    /// name.
    /// </remarks>
    private sealed record PersistedPreferences(string Theme, string TimeZoneId);

    private const string PreferencesStateKey = "MartenStudio.Preferences";

    private ScopeAccess access = ScopeAccess.Unknown;
    private bool preferencesLoaded;
    private bool interactive;
    private bool addressScopeApplied;
    private bool locationSubscribed;

    /// <summary>
    /// The module whose page the address names (D34), or <see langword="null" /> for a page of the host studio. Found from the matched
    /// page's assembly (<see cref="StudioDescriptor.ModuleOf" />) and never from the address's text, so that no address can name a page
    /// that is not a module's and be treated as one - the host's scope gate is skipped only for a module's own pages.
    /// </summary>
    private IStudioModule? currentModule;
    private PersistingComponentStateSubscription persistingSubscription;

    /// <summary>
    /// Whether the first-render read of the browser's stored preferences has finished, however it went.
    /// </summary>
    /// <remarks>
    /// <c>internal</c> rather than a <c>[Parameter]</c> or a rendered attribute: it is not a fact any
    /// page needs, and the shipped public surface is two static classes, two classes and one record
    /// (AGENTS.md hard rule 7). What it is for is the tests - a bUnit test that acts on the theme picker
    /// before this is true is racing <see cref="LoadPreferencesAsync" /> rather than testing anything,
    /// which is what <c>StudioLayoutTests</c> was doing about one full-suite run in four.
    /// </remarks>
    internal bool PreferencesLoaded => preferencesLoaded;

    protected override async Task OnInitializedAsync()
    {
        State.ScopeChanged += OnScopeChanged;

        // Before the first render, so the circuit's first paint already carries the prerendered theme.
        if (PersistentState.TryTakeFromJson(PreferencesStateKey, out PersistedPreferences? persisted) && persisted is not null)
        {
            State.SelectedTheme = persisted.Theme;
            State.SelectedTimeZoneId = persisted.TimeZoneId;
        }

        persistingSubscription = PersistentState.RegisterOnPersisting(PersistPreferences);

        // The scope travels in the query string so a pasted link reopens the same thing (plan D9).
        // Anything the listings do not carry is ignored by StudioState rather than reported.
        currentModule = ModuleOfAddress(Navigation.Uri);

        // A module's address names no host scope (D34): its pages are about their own, and the host's scope waits in memory, untouched.
        (string? storeKey, string? databaseId, string? tenantId) = currentModule is null
            ? StudioScopeQuery.Read(Navigation.Uri, Descriptor.SourceQueryParameter)
            : (null, null, null);

        // The rail is drawn while the listings load and the scope is applied below, and a link a visitor clicks in that time must
        // carry the scope the address names, not the one the studio is still on (1.2). Ended whatever happens next.
        long applying = State.BeginApplying(storeKey, databaseId, tenantId);
        try
        {
            await State.EnsureInitializedAsync();

            if (storeKey is not null || databaseId is not null || tenantId is not null)
            {
                await State.SetScopeAsync(storeKey, databaseId, tenantId);
            }
        }
        finally
        {
            State.EndApplying(applying);
        }

        // From here on the address's own scope has been read, so the shell may write its scope into it (1.2, N5a). A no-op until the
        // circuit is interactive; OnAfterRenderAsync can run while this method is still awaiting the catalog.
        addressScopeApplied = true;
        SyncScopeToUrl();

        // From here on a link the visitor clicks may name another scope (1.2, SCOPE-1-FIX).
        Navigation.LocationChanged += OnLocationChanged;
        locationSubscribed = true;

        await UpdateAccessAsync();
    }

    /// <summary>
    /// Follows a link the visitor clicked, and nothing else: when the location changed because a link was intercepted
    /// (<see cref="LocationChangedEventArgs.IsNavigationIntercepted" />) and its address names a store, database or tenant other than
    /// the active scope's, the shell moves to it - a link to another store (the Overview's strip, a row of the Stores page) would
    /// otherwise change the address and leave the scope, and with it every page that reads the scope, on the old store (D9).
    /// </summary>
    /// <remarks>
    /// <para>
    /// <b>A programmatic navigation never changes the scope.</b> A page's own push, <see cref="SyncScopeToUrl" />'s replace and any
    /// other <c>NavigateTo</c> report <c>IsNavigationIntercepted == false</c>, so none of them is read here. That is what keeps the
    /// window in which a page's push, built from the address before a picker change, lands after the change (N5b) from turning into a
    /// scope flip: the address follows the scope, except for a click.
    /// </para>
    /// <para>
    /// An address that names no other scope - nothing, only part of the scope on screen (Back to the entry from before a link to a
    /// tenant was followed names no tenant), or the scope the shell is already on - makes no <see cref="StudioState.SetScopeAsync" />
    /// call, and the address follows the scope instead (<see cref="SyncScopeToUrl" />), so the bar names the scope on screen again
    /// (1.2-UX-FIX; it used to be left as it was). Note that the browser reports Back and Forward as intercepted too (blazor.web.js
    /// <c>onBrowserInitiatedPopState</c> notifies with <c>interceptedLink: true</c>), so a Back to an address that names <em>another</em>
    /// store, database or tenant moves the scope to it, as a click would; the window tests that report it as not intercepted prove the
    /// rewrite for a programmatic push. The handler is synchronous, an
    /// <see cref="EventHandler{TEventArgs}" /> that starts the async work and does not wait for it, never an <c>async</c> lambda
    /// (hard rule 6).
    /// </para>
    /// </remarks>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // A module's page (D34) is rendered and nothing else: no host scope is read from its address, none is applied, and the address is
        // not rewritten. The host's scope stays in StudioState for the way back, and the rail's host links carry it.
        IStudioModule? previous = currentModule;
        currentModule = ModuleOfAddress(e.Location);

        if (currentModule is not null)
        {
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        if (previous is not null)
        {
            // Back on a page of the host studio: the host's scope gate, which was not asked while a module's page was on screen.
            _ = InvokeAsync(UpdateAccessAfterLeavingModuleAsync);
        }

        (string? storeKey, string? databaseId, string? tenantId) = StudioScopeQuery.Read(e.Location, Descriptor.SourceQueryParameter);

        if (e.IsNavigationIntercepted && NamesAnotherScope(State.ActiveScope, storeKey, databaseId, tenantId))
        {
            _ = InvokeAsync(() => ApplyAddressScopeAsync(storeKey, databaseId, tenantId));
            return;
        }

        // With navigation interception switched off (1.1's navigation) the shell writes nothing here (1.2-FINAL-FIX): Back and Forward are
        // reported as not intercepted, the pages that follow their own address (Documents, Document, Database objects and rows) apply the
        // scope it names as they did in 1.1, and a rewrite from here, racing a page's own scope change under a policy that yields, bounced
        // the address between two databases with a page fetch on each turn. The switch exists to restore 1.1's navigation, so the address
        // is the pages' to follow; a scope change (OnScopeChanged) still writes the scope on screen into it.
        if (!StudioNavigationSwitch.InterceptionEnabled)
        {
            return;
        }

        // Anything else - a push built from an address before a picker change, an address that names no scope or only part of the scope
        // on screen (Back to the entry from before a link to a tenant was followed names no tenant, 1.2-UX-FIX), the same scope - leaves
        // the scope where it is, and the address follows it: the bar names what is on screen. Nothing is written when it already does.
        SyncScopeToUrl();
    }

    /// <summary>
    /// Whether an address names a store, database or tenant that is not the active scope's: each part it names is compared, and a part
    /// it leaves out says nothing. An address naming no scope, or the scope the shell is on, is not another scope.
    /// </summary>
    internal static bool NamesAnotherScope(StudioScope? active, string? storeKey, string? databaseId, string? tenantId)
    {
        return (storeKey is not null && !string.Equals(storeKey, active?.StoreKey, StringComparison.OrdinalIgnoreCase))
            || (databaseId is not null && !string.Equals(databaseId, active?.DatabaseId, StringComparison.OrdinalIgnoreCase))
            || (tenantId is not null && !string.Equals(tenantId, active?.TenantId, StringComparison.Ordinal));
    }

    /// <summary>
    /// The call the first load makes, for a clicked link: a value the listings do not carry, or the policy refuses, is ignored by
    /// <see cref="StudioState" /> exactly as it is at first load. A failure leaves the scope as it was.
    /// </summary>
    private async Task ApplyAddressScopeAsync(string? storeKey, string? databaseId, string? tenantId)
    {
        try
        {
            await State.SetScopeAsync(storeKey, databaseId, tenantId);

            // A scope the listings do not carry, or the policy refuses, was ignored and the scope did not move: the address stops naming
            // the refused value and names the scope on screen (1.2-UX-FIX-FU). A no-op when the scope moved, which has already been written.
            SyncScopeToUrl();
        }
        catch (Exception e) when (StudioLiveUpdates.IsInteropUnavailable(e))
        {
            // The circuit went away while the scope was being read: nothing to apply it to.
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            Logger.LogDebug(e, "The studio could not apply the scope a clicked link names; the scope stays as it was");
        }
    }

    /// <summary>
    /// The host's scope gate, asked now that a page of the host studio is on screen again. A failure fails closed: the page says the
    /// scope is not authorized rather than rendering without the gate's answer.
    /// </summary>
    private async Task UpdateAccessAfterLeavingModuleAsync()
    {
        try
        {
            await UpdateAccessAsync();
        }
        catch (Exception e) when (StudioLiveUpdates.IsInteropUnavailable(e))
        {
            // The circuit went away while the gate was being asked.
            return;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            Logger.LogDebug(e, "The studio could not ask the scope policy after a module's page; the page stays closed");
            access = ScopeAccess.Denied;
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The module whose page <paramref name="uri" /> names, or <see langword="null" />: the route table matches the address, and the matched
    /// page's assembly decides (D34). An address no page matches is not a module's.
    /// </summary>
    private IStudioModule? ModuleOfAddress(string uri)
    {
        if (Descriptor.Modules.Count == 0
            || StudioLink.ToDashboardRelativePath(uri, Navigation.BaseUri, Settings) is not { } relative
            || Descriptor.Routes.Match(relative, Settings) is not { } match)
        {
            return null;
        }

        return Descriptor.ModuleOf(match.PageType);
    }

    private Task PersistPreferences()
    {
        PersistentState.PersistAsJson(
            PreferencesStateKey,
            new PersistedPreferences(State.SelectedTheme, State.SelectedTimeZoneId));
        return Task.CompletedTask;
    }

    /// <summary>
    /// Re-asks the policy about whatever the studio is now about. The previous answer stands while the
    /// new one is being fetched: dropping back to <see cref="ScopeAccess.Unknown" /> would tear the page
    /// down and build it again on every switch between two stores the visitor may see.
    /// </summary>
    private async Task UpdateAccessAsync()
    {
        // The host's gate is not asked on a module's page (D34); it is asked again, below, when the visitor is back on the host's.
        if (currentModule is not null)
        {
            return;
        }

        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            // Nothing to be about. The page renders and says so for itself, which is the honest answer
            // both when no Marten store is registered and when the visitor may see none of them.
            access = ScopeAccess.Granted;
            return;
        }

        access = await Authorization.IsAuthorizedAsync(scope)
            ? ScopeAccess.Granted
            : ScopeAccess.Denied;
    }

    private async Task OnScopeChanged()
    {
        ScopeAccess previous = access;

        // The address names the selected scope whatever the policy says, so it is written first (1.2, N5b): the window in which a page's
        // push and this rewrite, each built from an address the other has not reported yet, can overwrite each other shrinks from the
        // policy's time plus a round trip to a round trip.
        SyncScopeToUrl();
        await UpdateAccessAsync();
        if (previous != access)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Writes the active scope into the query string, so the address bar names what is on screen and a
    /// link someone pastes into a chat reopens the same store, database and tenant (plan D9).
    /// </summary>
    /// <remarks>
    /// Only once the circuit exists. During static server-side rendering a <c>NavigateTo</c> is a
    /// redirect, which would turn the first page load into a round trip; <see cref="OnAfterRenderAsync" />
    /// is the one signal that says "this render is interactive" without needing renderer information a
    /// test host may not supply.
    /// </remarks>
    private void SyncScopeToUrl()
    {
        // Not before the address's own scope was read (addressScopeApplied): the catalog may still be loading, ActiveScope is null until
        // it has, and a rewrite then would strip a pasted ?store=&db= or write the default database over it (D9).
        if (!interactive || !addressScopeApplied)
        {
            return;
        }

        // Only a studio page is ever rewritten (1.2-UX-FIX-FU4), by every writer - first load, a render, a scope change, a location change:
        // an address no page matches (a file, an endpoint) is the browser's to load, as it was named (StudioRoutes), and a scope appended
        // to it would change what is loaded - while a force-load of it is in flight, say.
        if (StudioLink.ToDashboardRelativePath(Navigation.Uri, Navigation.BaseUri, Settings) is not { } relative
            || Descriptor.Routes.Match(relative, Settings) is not { } match
            || Descriptor.ModuleOf(match.PageType) is not null)
        {
            return;
        }

        string target = StudioScopeQuery.WithScope(Navigation, State.ActiveScope, Descriptor.SourceQueryParameter);
        if (!string.Equals(target, Navigation.Uri, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(target, forceLoad: false, replace: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        interactive = true;
        SyncScopeToUrl();

        await LoadPreferencesAsync();
        preferencesLoaded = true;

        // Unconditionally, and after the flag: the stored preferences may have moved the theme or the
        // time zone, and this is the render that puts the answer - whichever way it went - on screen.
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Reads the browser's own remembered preferences once the circuit exists.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The cookie has already seeded <see cref="StudioState" /> in the prerender scope and persisted
    /// component state carried that across to the circuit, which is what keeps a dark studio from
    /// flashing light. This covers the case neither can: a preference stored only in
    /// <c>localStorage</c>, and a browser whose cookie was cleared.
    /// </para>
    /// <para>
    /// <em>A stored preference never overwrites one the visitor expressed while it was being read.</em>
    /// These are two awaited round trips to the browser, and on a slow one the visitor can use the theme
    /// picker before they finish. What comes back was read before that click, so applying it would put
    /// the theme they have just moved away from back on the screen - the picker snapping back on its own
    /// a moment after it was used. <see cref="StudioState.PreferenceVersion" /> is stamped before the
    /// awaits and checked after them, and the visitor wins: whatever they chose is both newer and
    /// already written to the same storage this was reading.
    /// </para>
    /// </remarks>
    private async Task LoadPreferencesAsync()
    {
        try
        {
            long version = State.PreferenceVersion;

            string? storedTheme = await JsRuntime.InvokeAsync<string?>("martenStudio.prefs.get", new object?[] { StudioState.ThemePreferenceKey });
            string? storedTimeZoneId = await JsRuntime.InvokeAsync<string?>("martenStudio.prefs.get", new object?[] { StudioState.TimeZonePreferenceKey });

            if (State.PreferenceVersion != version)
            {
                // The visitor picked something while the browser was being asked. Theirs is the newer
                // answer and it has already been persisted, so there is nothing here to apply.
                return;
            }

            string previousTimeZoneId = State.SelectedTimeZoneId;

            if (!string.IsNullOrWhiteSpace(storedTheme))
            {
                State.SelectedTheme = storedTheme;
            }

            if (!string.IsNullOrWhiteSpace(storedTimeZoneId))
            {
                State.SelectedTimeZoneId = storedTimeZoneId;
            }

            if (!string.Equals(previousTimeZoneId, State.SelectedTimeZoneId, StringComparison.Ordinal))
            {
                // Every page re-renders its timestamps in the new zone. The theme needs no such notice:
                // it is one attribute on this component's own root.
                await State.NotifyAsync();
            }
        }
        catch (Exception e) when (StudioLiveUpdates.IsInteropUnavailable(e))
        {
            // JS interop is unavailable during prerendering, and a browser can refuse storage outright.
        }
    }

    private async Task OnTimeZoneChangedAsync(ChangeEventArgs args)
    {
        string? selected = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(selected))
        {
            return;
        }

        string previous = State.SelectedTimeZoneId;
        State.SelectedTimeZoneId = selected;
        if (!string.Equals(previous, State.SelectedTimeZoneId, StringComparison.Ordinal))
        {
            await State.NotifyAsync();
            await PersistPreferenceAsync(StudioState.TimeZonePreferenceKey);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnThemeChangedAsync(ChangeEventArgs args)
    {
        string previous = State.SelectedTheme;
        State.SelectedTheme = args.Value?.ToString() ?? "system";
        if (!string.Equals(previous, State.SelectedTheme, StringComparison.Ordinal))
        {
            await PersistPreferenceAsync(StudioState.ThemePreferenceKey);
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Writes one preference to the browser's own storage.
    /// </summary>
    /// <remarks>
    /// The value is read from <see cref="StudioState" /> here rather than passed in, so what is written
    /// is what the studio currently shows. Two clicks in quick succession are two handlers whose interop
    /// calls can finish in either order; a value captured by the first and written after the second's had
    /// landed would leave <c>localStorage</c> remembering the theme the visitor moved away from, and the
    /// next visit would open on it.
    /// </remarks>
    private async Task PersistPreferenceAsync(string key)
    {
        string value = string.Equals(key, StudioState.ThemePreferenceKey, StringComparison.Ordinal)
            ? State.SelectedTheme
            : State.SelectedTimeZoneId;

        try
        {
            await JsRuntime.InvokeVoidAsync("martenStudio.prefs.set", new object?[] { key, value });
        }
        catch (Exception e) when (StudioLiveUpdates.IsInteropUnavailable(e))
        {
        }
    }

    public void Dispose()
    {
        State.ScopeChanged -= OnScopeChanged;

        if (locationSubscribed)
        {
            Navigation.LocationChanged -= OnLocationChanged;
        }

        persistingSubscription.Dispose();
    }
}
