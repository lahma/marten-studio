@using PostgresStudio.Components.Layout
@using PostgresStudio.Services.Settings
@implements IDisposable
@inject NavigationManager Navigation
@inject IStudioSettings Settings
@inject StudioDescriptor Descriptor

@* The built-in Blazor Router can only match the compile-time page templates, so the studio matches routes
   itself - against its descriptor's route table - to honour a custom mount path. *@
@if (routeData is not null)
{
    <RouteView RouteData="routeData" DefaultLayout="typeof(StudioLayout)" />
    <FocusOnNavigate RouteData="routeData" Selector="h1" />
}
else
{
    <LayoutView Layout="typeof(StudioLayout)">
        <div class="ms-page">
            <h1>Not found</h1>
            <p class="ms-muted">The requested page was not found.</p>
            <a href="@StudioLink.To(Settings, "")" class="ms-button">Back to the overview</a>
        </div>
    </LayoutView>
}

@code
{
    private RouteData? routeData;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdateRouteData(Navigation.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateRouteData(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateRouteData(string uri)
    {
        string? relative = StudioLink.ToDashboardRelativePath(uri, Navigation.BaseUri, Settings);
        routeData = relative is null ? null : Descriptor.Routes.Match(relative, Settings);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
