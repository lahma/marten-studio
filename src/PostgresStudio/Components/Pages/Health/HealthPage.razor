@page "/postgres/health"
@using PostgresStudio.Services.Health
@using PostgresStudio.Services.Live
@using PostgresStudio.Services.Settings
@using PostgresStudio.Components.Shared
@using PostgresStudio.Services
@implements IAsyncDisposable
@inject IHealthService HealthData
@inject HealthMutes Mutes
@inject StudioState State
@inject StudioLiveUpdatesFactory LiveFactory
@inject IStudioSettings Settings
@inject StudioDescriptor Descriptor
@inject IJSRuntime JsRuntime

<PageTitle>Health</PageTitle>

<div class="ms-page ms-health">
    <div class="ms-page-header">
        <h1 class="ms-page-title">Health</h1>
        <div class="ms-health-actions">
            <button type="button" class="ms-button" @onclick="RefreshAsync" disabled="@(!interactive || busy)">Refresh</button>
            <button type="button"
                    class="ms-button ms-health-deeper"
                    @onclick="RunDeeperAsync"
                    disabled="@(!interactive || busy || report?.DeeperChecksAllowed != true)"
                    title="@DeeperTitle">
                Run deeper checks
            </button>
            @if (report?.StatementChecksExist == true)
            {
                @* The service runs the statement checks only for a visitor through the activity gate, whatever this
                   button says; the disabled state is so the refusal is not a surprise. *@
                <button type="button"
                        class="ms-button ms-health-statements"
                        @onclick="RunStatementsAsync"
                        disabled="@(!interactive || busy || report?.StatementChecksAllowed != true)"
                        title="@StatementsTitle">
                    Run statement checks
                </button>
            }
        </div>
    </div>

    @if (Settings.Text.Product == StudioProduct.MartenStudio)
    {
    <p class="ms-health-lead">
        What the advisor sees in this database: the store's configuration and the database's own statistics, read
        only while this page or the Overview is open, once per <code>HealthInterval</code> for everybody watching.
        It changes nothing, and every remedy is a line for the host's own <code>StoreOptions</code> - never DDL.
    </p>
    }
    else
    {
        <p class="ms-health-lead">
            What the advisor sees in this database: the database's own statistics, read only while this page or the
            Overview is open, once per <code>HealthInterval</code> for everybody watching. It changes nothing. A remedy is
            a server setting, or SQL for whoever owns the schema to put in a migration - the studio never runs it.
        </p>
    }

    @if (!interactive || (loading && report is null))
    {
        @* A static render reads nothing: the sweep starts once the page is interactive, so a prerender and the
           circuit after it never check the same database twice. *@
        <LoadingSpinner />
    }
    else if (error is { Length: > 0 })
    {
        <ErrorAlert Message="@error" OnRetry="RefreshAsync" />
    }
    else if (report is null)
    {
        <div class="ms-empty">
            <p class="ms-empty-title">No database selected</p>
            <p class="ms-empty-description">Pick a store and database in the header to see its health.</p>
        </div>
    }
    else if (report.Refusal != HealthRefusal.None)
    {
        <div class="ms-alert ms-alert-warning ms-health-refusal" role="status">
            <div class="ms-alert-content">
                <p>@report.Reason</p>
            </div>
        </div>
    }
    else
    {
        <div class="ms-health-summary">
            @if (report.MeasuredAt is { } measured)
            {
                <p class="ms-health-summary-line">
                    Checked @State.FormatInSelectedTimeZone(measured) (<TimeAgo Timestamp="measured" />)@SweepDuration(report).
                    @report.History
                </p>
            }

            <ServerAnswer Model="report.Server" />

            <p class="ms-health-summary-line ms-health-cost">
                @(report.Cost is { } cost ? HealthPresentation.Cost(cost, Settings.Text) : "Studio cost: withheld - " + report.CostWithheld + ".")
            </p>

            @if (!report.DeeperChecksExist)
            {
                <p class="ms-health-summary-line ms-health-deeper-note">
                    "Run deeper checks" reads a bounded slice of the data itself, behind its button and cached for five
                    minutes. This version of the studio has no such check yet, so the button is off.
                </p>
            }
            else if (!report.DeeperChecksAllowed)
            {
                @* The service refuses the run whatever this says (it reads Run as IfCached for this visitor); the note
                   is so the disabled button is not a mystery. *@
                <p class="ms-health-summary-line ms-health-deeper-note">
                    "Run deeper checks" is off for you: it reads a bounded slice of the data in every table it checks, a
                    database-wide read, so it @report.DeeperChecksRefused.
                    @if (report.DeeperMeasuredAt is { } shared)
                    {
                        <text>Results of the last run, @State.FormatInSelectedTimeZone(shared), are shown below where you may see them.</text>
                    }
                </p>
            }
            else if (report.DeeperMeasuredAt is { } deeper)
            {
                <p class="ms-health-summary-line">Deeper checks last ran @State.FormatInSelectedTimeZone(deeper).</p>
            }

            @if (report.StatementChecksExist && !report.StatementChecksAllowed)
            {
                <p class="ms-health-summary-line ms-health-statements-note">
                    "Run statement checks" is off for you: it reads pg_stat_statements - statements' text, and the plans of
                    @Settings.Text.SourcePossessive own - so it @report.StatementChecksRefused. Its findings are not shown to you either.
                </p>
            }
            else if (report.StatementsMeasuredAt is { } statementsAt)
            {
                <p class="ms-health-summary-line ms-health-statements-note">Statement checks last ran @State.FormatInSelectedTimeZone(statementsAt).</p>
            }
            else if (report.StatementChecksExist)
            {
                <p class="ms-health-summary-line ms-health-statements-note">
                    "Run statement checks" reads pg_stat_statements as @Settings.Text.SourcePossessive own role and plans @Settings.Text.SourcePossessive most
                    expensive statements, on demand and cached for five minutes. It has not run here recently.
                </p>
            }
        </div>

        @if (actionError is { Length: > 0 })
        {
            <ErrorAlert Message="@actionError" OnRetry="RefreshAsync" />
        }

        @if (report.StatisticsReset is { Length: > 0 } reset)
        {
            @* Said once, in the sweep that first sees it: a failover, a crash or a reset reads as such, never as a quiet database. *@
            <div class="ms-alert ms-alert-info ms-aur-reset" role="status">
                <div class="ms-alert-content">
                    <p>@reset</p>
                </div>
            </div>
        }

        @if (report.WithheldCount > 0)
        {
            <div class="ms-alert ms-alert-info ms-health-withheld" role="status">
                <div class="ms-alert-content">
                    <p>@HealthPresentation.Withheld(report.WithheldCount, report.WithheldReason)</p>
                </div>
            </div>
        }

        @if (VisibleFindings.Count == 0)
        {
            @* Never an all-clear while findings are withheld: the notice above counts them, and this must not then say
               that no check found anything. *@
            <div class="ms-empty ms-health-empty">
                <p class="ms-empty-title">@(report.WithheldCount > 0 ? "Nothing to show you" : "Nothing to report")</p>
                <p class="ms-empty-description">@EmptyDescription(report)</p>
            </div>
        }
        else
        {
            @foreach (IGrouping<HealthArea, HealthReportFinding> group in VisibleFindings.GroupBy(static x => x.Finding.Area).OrderBy(static x => x.Key))
            {
                <section class="ms-section ms-health-area" @key="group.Key" aria-label="@HealthPresentation.AreaTitle(group.Key)">
                    <h2 class="ms-section-title">@HealthPresentation.AreaTitle(group.Key)</h2>

                    @foreach (HealthReportFinding finding in group)
                    {
                        @FindingCard(finding, muted: false)
                    }
                </section>
            }
        }

        @if (MutedFindings.Count > 0)
        {
            <details class="ms-health-muted">
                <summary>@HealthPresentation.Count(MutedFindings.Count, "finding") muted in this browser</summary>
                @foreach (HealthReportFinding finding in MutedFindings)
                {
                    @FindingCard(finding, muted: true)
                }
            </details>
        }

        <section class="ms-section ms-health-checks">
            <h2 class="ms-section-title">What was checked</h2>
            <TableScroll Label="Health checks table">
                <table class="ms-table ms-health-check-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Check</th>
                            <th>Reads</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (HealthCheckStatus check in report.Checks)
                        {
                            <tr class="ms-table-row ms-health-check-@check.Outcome.ToString().ToLowerInvariant()" @key="check.Code">
                                <td class="ms-table-cell ms-table-cell-mono"><a href="@check.DocsUrl" target="_blank" rel="noopener noreferrer">@check.Code</a></td>
                                <td class="ms-table-cell">@check.Title</td>
                                <td class="ms-table-cell">@HealthPresentation.TierLabel(check.Tier)</td>
                                <td class="ms-table-cell">
                                    <span class="ms-health-outcome">@HealthPresentation.OutcomeLabel(check.Outcome, check.FindingCount, check.FindingsWithheld)</span>
                                    @if (check.Problem is { Length: > 0 } problem)
                                    {
                                        <span class="ms-health-outcome-detail">@problem</span>
                                    }
                                    else if (check.Note is { Length: > 0 } note)
                                    {
                                        <span class="ms-health-outcome-detail">@note</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </TableScroll>
        </section>
    }
</div>

@code {
    private readonly CancellationTokenSource lifetime = new();

    /// <summary>The page's own polling loop, at <c>HealthInterval</c>; built rather than injected.</summary>
    private StudioLiveUpdates? live;

    private HealthReport? report;
    private string? error;
    private string? actionError;
    private bool loading = true;
    private bool busy;
    private bool interactive;
    private bool disposed;

    private List<HealthReportFinding> VisibleFindings =>
        report is null ? [] : [.. report.Findings.Where(x => !Mutes.IsMuted(x.MuteKey))];

    private List<HealthReportFinding> MutedFindings =>
        report is null ? [] : [.. report.Findings.Where(x => Mutes.IsMuted(x.MuteKey))];

    private string DeeperTitle => report switch
    {
        { DeeperChecksExist: false } or null => "This version of the studio has no deeper check yet",
        { DeeperChecksAllowed: false } => "A database-wide read: it " + report.DeeperChecksRefused,
        _ => "Reads a bounded slice of the data; cached for five minutes",
    };

    private string StatementsTitle => report switch
    {
        { StatementChecksAllowed: false } => "Reads pg_stat_statements: it " + report.StatementChecksRefused,
        _ => "Reads pg_stat_statements and plans " + Settings.Text.SourcePossessive + " most expensive statements; cached for five minutes",
    };

    protected override void OnInitialized()
    {
        // Nothing is read here: this runs during prerendering too, and the sweep waits for the circuit.
        State.ScopeChanged += OnScopeChangedAsync;
        Mutes.Changed += OnMutesChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed)
        {
            return;
        }

        interactive = true;

        // Idempotent, and normally already done by the layout. Awaited here so the first read is never made
        // before the circuit's scope is settled - a scope change that arrived before this render is in it.
        // Leaving the page under any of these awaits disposes it: the lifetime's source is gone, and reading its token
        // would throw out of OnAfterRenderAsync and end the circuit. So each step asks first.
        CancellationToken token = lifetime.Token;

        await State.EnsureInitializedAsync(token);

        if (disposed)
        {
            return;
        }

        await Mutes.LoadAsync(JsRuntime, token);

        if (disposed)
        {
            return;
        }

        await LoadAsync(HealthReportRequest.Regular);

        if (disposed)
        {
            return;
        }

        live = LiveFactory.Create();
        await live.StartAsync(Settings.EffectiveHealthInterval, TickAsync, token);
    }

    private async Task TickAsync(CancellationToken _)
    {
        await LoadAsync(HealthReportRequest.Regular);
    }

    private async Task RefreshAsync() => await LoadAsync(HealthReportRequest.Regular);

    private async Task RunDeeperAsync() => await LoadAsync(new HealthReportRequest(Deeper: HealthDeeperChecks.Run));

    private async Task RunStatementsAsync() => await LoadAsync(new HealthReportRequest(Statements: HealthDeeperChecks.Run));

    private async Task OnScopeChangedAsync()
    {
        if (!interactive)
        {
            return;
        }

        report = null;
        await LoadAsync(HealthReportRequest.Regular);
    }

    private async Task OnMutesChangedAsync() => await InvokeAsync(StateHasChanged);

    private async Task LoadAsync(HealthReportRequest request)
    {
        if (disposed)
        {
            return;
        }

        StudioScope? scope = State.ActiveScope;

        // Taken while the page is alive: a disposal under the awaits below cancels it rather than leaving a disposed
        // source to be read.
        CancellationToken token = lifetime.Token;
        busy = true;
        loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            HealthReport? read = scope is null ? null : await HealthData.GetReportAsync(scope, request, token);

            // A scope change while the sweep was running: the answer is about a database nobody is looking at.
            if (State.ActiveScope == scope)
            {
                report = read;
                error = null;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            // On the page, not only in the log: a failure the visitor cannot see is a page that silently shows nothing.
            error = exception.Message;
        }
        finally
        {
            busy = false;
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleMuteAsync(HealthReportFinding finding)
    {
        actionError = null;

        try
        {
            await Mutes.SetAsync(JsRuntime, finding.MuteKey, !Mutes.IsMuted(finding.MuteKey), lifetime.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            actionError = "The mute could not be saved: " + exception.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// One finding: what is wrong, the facts behind it and when they were read, how sure the advisor is, what
    /// to change, the statements behind it, the docs, and "mute in this browser".
    /// </summary>
    /// <remarks>
    /// A render fragment rather than a component of its own: a component is a public class and a public
    /// <c>[Parameter]</c> cannot carry the internal finding type (D12). Evidence is a definition list rather
    /// than a table - label and value - so it needs no scroll region of its own (D25).
    /// </remarks>
    private RenderFragment FindingCard(HealthReportFinding finding, bool muted) => __builder =>
    {
        string severity = finding.Severity.ToString().ToLowerInvariant();

        <article class="@("ms-health-finding ms-health-finding-" + severity)" id="@finding.Anchor" @key="finding.MuteKey" aria-labelledby="@(finding.Anchor + "-title")">
            <header class="ms-health-finding-header">
                <span class="@HealthPresentation.ChipClass(finding.Severity)">@HealthPresentation.Label(finding.Severity)</span>
                <code class="ms-health-code">@finding.Code</code>
                <h3 class="ms-health-finding-title" id="@(finding.Anchor + "-title")">@finding.Finding.Title</h3>
            </header>

            <p class="ms-health-why">@finding.Finding.WhyItMatters</p>

            @if (finding.Evidence.Count > 0)
            {
                <dl class="ms-health-evidence">
                    @foreach (HealthEvidence item in finding.Evidence)
                    {
                        @* No @key: these rows are drawn once per render and never move, and a key a check did
                           not make unique would end the circuit (the sweep refuses duplicate labels as well). *@
                        <div class="ms-health-evidence-row">
                            <dt>@item.Label</dt>
                            <dd class="ms-mono">@item.Value</dd>
                        </div>
                    }
                </dl>
            }

            <p class="ms-health-measured">
                Measured @State.FormatInSelectedTimeZone(finding.Finding.MeasuredAt) (<TimeAgo Timestamp="finding.Finding.MeasuredAt" />).
            </p>

            @if (finding.Finding.Caveat is { Length: > 0 } caveat)
            {
                <p class="ms-health-caveat"><strong>How sure:</strong> @caveat</p>
            }

            @if (finding.Finding.Remedy is { } remedy)
            {
                <div class="ms-health-remedy">
                    <div class="ms-health-remedy-header">
                        <span class="ms-health-remedy-title">@remedy.Heading</span>
                        @if (remedy.Requires is { } feature)
                        {
                            <span class="@(finding.RemedyAvailable ? "ms-health-requirement" : "ms-health-requirement ms-health-requirement-missing")">
                                @RequirementText(finding, feature.Needs)
                            </span>
                        }
                        <CopyButton Value="@remedy.Code" Label="@("Copy the remedy for " + finding.Code)" />
                    </div>
                    <pre class="ms-code ms-health-remedy-code"><code>@remedy.Code</code></pre>
                    @if (remedy.Explanation is { Length: > 0 } explanation)
                    {
                        <p class="ms-health-remedy-explanation">@explanation</p>
                    }
                </div>
            }

            @if (finding.Finding.Link is { } link)
            {
                <p class="ms-health-link">
                    <a href="@HealthLinks.To(Settings, Descriptor.SourceQueryParameter, link.Route, State.ActiveScope, link.Query)">@link.Label</a>
                </p>
            }

            @foreach (HealthStatement statement in finding.Finding.Statements)
            {
                <SqlDisclosure Sql="@statement.Sql" ParameterNames="statement.ParameterNames" />
            }

            <footer class="ms-health-finding-footer">
                <a class="ms-health-docs" href="@finding.DocsUrl" target="_blank" rel="noopener noreferrer">About @finding.Code</a>
                <button type="button" class="ms-button ms-btn-sm ms-health-mute" @onclick="() => ToggleMuteAsync(finding)">
                    @(muted ? "Unmute" : "Mute in this browser")
                </button>
            </footer>
        </article>
    };

    /// <summary>What the empty state says: muted, withheld, both, or genuinely nothing.</summary>
    private string EmptyDescription(HealthReport shown) => (shown.WithheldCount > 0, MutedFindings.Count > 0) switch
    {
        (true, true) => "Every finding you may see is muted in this browser, and the findings counted above are not shown to you.",
        (true, false) => "No finding you may see needs your attention here, and the findings counted above are not shown to you. "
            + "The list below says what was checked.",
        (false, true) => "Every finding the advisor has is muted in this browser.",
        _ => "No check found anything worth your attention in this database. The list below says what was checked.",
    };

    /// <summary>"Marten 9.47+", and on a host without it, what this one runs.</summary>
    private static string RequirementText(HealthReportFinding finding, string requirement) =>
        finding.HostRuns is { } runs ? requirement + "; this host runs " + runs : requirement;

    private static string SweepDuration(HealthReport report) =>
        report.SweepDuration is { } duration
            ? ", in " + duration.TotalMilliseconds.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) + " ms"
            : string.Empty;

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;

        State.ScopeChanged -= OnScopeChangedAsync;
        Mutes.Changed -= OnMutesChangedAsync;

        try
        {
            if (live is not null)
            {
                await live.DisposeAsync();
                live = null;
            }
        }
        finally
        {
            try
            {
                await lifetime.CancelAsync();
            }
            finally
            {
                lifetime.Dispose();
            }
        }

        GC.SuppressFinalize(this);
    }
}
