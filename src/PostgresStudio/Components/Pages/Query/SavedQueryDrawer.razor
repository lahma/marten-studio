@using PostgresStudio.Services.Live
@using PostgresStudio.Services.Query
@inject IJSRuntime JsRuntime

@*
    Recent and saved queries, kept in the browser rather than on the server.

    A query somebody is in the middle of writing is theirs: it is not worth a database table, and a
    server-side list would be one more thing a shared studio leaks between colleagues. So both lists live
    in martenStudio.prefs (localStorage, cookie fallback), keyed by store and mode, and the export button
    is how they move between machines.

    Every JS call is guarded: during prerendering there is no browser, and a browser can refuse storage
    outright. Both cases mean "no lists", never an exception on a circuit.
*@

<div class="ms-query-drawer">
    <div class="ms-query-drawer-header">
        <h2 class="ms-query-drawer-title">@Title</h2>
        <div class="ms-query-drawer-actions">
            <button type="button" class="ms-btn ms-btn-sm" @onclick="ExportAsync">Export</button>
            <button type="button" class="ms-btn ms-btn-sm" @onclick="ToggleImport">Import</button>
        </div>
    </div>

    @if (naming)
    {
        <div class="ms-query-drawer-save">
            <label class="ms-form-label" for="ms-query-save-name">Name this query</label>
            <input id="ms-query-save-name"
                   class="ms-input ms-query-save-name"
                   value="@pendingName"
                   @onchange="OnNameChanged" />
            <button type="button" class="ms-btn ms-btn-sm ms-btn-primary" @onclick="ConfirmSaveAsync">Save</button>
            <button type="button" class="ms-btn ms-btn-sm" @onclick="CancelSave">Cancel</button>
        </div>
    }

    @if (importing)
    {
        <div class="ms-query-drawer-import">
            <label class="ms-form-label" for="ms-query-import">Paste an exported list</label>
            <textarea id="ms-query-import"
                      class="ms-input ms-input-mono ms-query-import-input"
                      rows="4"
                      spellcheck="false"
                      value="@importText"
                      @onchange="OnImportTextChanged"></textarea>
            <button type="button" class="ms-btn ms-btn-sm ms-btn-primary" @onclick="ImportAsync">Import</button>
            @if (!string.IsNullOrWhiteSpace(importMessage))
            {
                <span class="ms-query-drawer-message">@importMessage</span>
            }
        </div>
    }

    <h3 class="ms-query-drawer-section">Saved</h3>
    @if (saved.Count == 0)
    {
        <p class="ms-muted ms-query-drawer-empty">Nothing saved yet. Ctrl+S in the editor names and keeps one.</p>
    }
    else
    {
        <ul class="ms-query-drawer-list ms-query-drawer-saved">
            @foreach (SavedQuery query in saved)
            {
                SavedQuery current = query;
                <li class="ms-query-drawer-item" @key="current.Name">
                    <button type="button" class="ms-query-drawer-pick" title="@current.Text" @onclick="() => PickAsync(current)">
                        @current.Name
                    </button>
                    <button type="button"
                            class="ms-btn ms-btn-sm ms-btn-ghost ms-query-drawer-remove"
                            aria-label="@("Forget " + current.Name)"
                            @onclick="() => RemoveAsync(current)">
                        ×
                    </button>
                </li>
            }
        </ul>
    }

    <h3 class="ms-query-drawer-section">Recent</h3>
    @if (recent.Count == 0)
    {
        <p class="ms-muted ms-query-drawer-empty">Nothing run yet in this mode.</p>
    }
    else
    {
        @* Keyed on the ordinal: the text is not a key. AddRecent dedupes on text + mode + alias, and the
           list is rendered without filtering by alias, so running the same where clause against two
           collections puts two siblings here under one key - and a duplicate @key throws inside Blazor's
           diff builder, which ends the circuit rather than the render. Reachable by a visitor with no
           capability at all. The list is rebuilt whole, so position is stable. *@
        <ul class="ms-query-drawer-list ms-query-drawer-recent">
            @for (int ordinal = 0; ordinal < recent.Count; ordinal++)
            {
                SavedQuery current = recent[ordinal];
                <li class="ms-query-drawer-item" @key="ordinal">
                    <button type="button" class="ms-query-drawer-pick" title="@current.Text" @onclick="() => PickAsync(current)">
                        @current.Name
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    private List<SavedQuery> recent = [];
    private List<SavedQuery> saved = [];
    private string? loadedKey;
    private bool parametersSeen;
    private QueryMode seenMode;
    private string? seenStore;
    private bool naming;
    private bool importing;
    private string pendingName = string.Empty;
    private string pendingText = string.Empty;
    private string? pendingAlias;
    private string? pendingOrderBy;
    private string? pendingArchived;
    private string importText = string.Empty;
    private string? importMessage;

    /// <summary>The heading over the two lists.</summary>
    [Parameter]
    public string Title { get; set; } = "Queries";

    /// <summary>The store the lists are keyed by, so two stores never share a history.</summary>
    [Parameter]
    public string? StoreKey { get; set; }

    /// <summary>
    /// The mode the lists are keyed by: <c>marten</c>, <c>sql</c> or (1.2) <c>linq</c>. Each has its own two lists, so a LINQ
    /// entry never reaches the SQL console's editor, nor a SQL statement the LINQ predicate box.
    /// </summary>
    [Parameter]
    public string Mode { get; set; } = "marten";

    /// <summary>Raised with the text and alias of the query that was picked.</summary>
    [Parameter]
    public EventCallback<(string Text, string? Alias)> OnPick { get; set; }

    /// <summary>
    /// Raised instead of <see cref="OnPick" /> when it is set, with a LINQ entry's ordering and archived selector as well (1.2):
    /// LINQ mode is two texts, the predicate and the ordering.
    /// </summary>
    [Parameter]
    public EventCallback<(string Text, string? Alias, string? OrderBy, string? Archived)> OnPickDetailed { get; set; }

    /// <summary>How many recent and saved queries are being shown, for a test and for the page.</summary>
    internal int Count => recent.Count + saved.Count;

    /// <summary>Opens the name prompt for the text in the editor.</summary>
    /// <param name="text">The clause, predicate or statement.</param>
    /// <param name="alias">The document alias, or a LINQ entry's target token.</param>
    public Task BeginSaveAsync(string text, string? alias) => BeginSaveAsync(text, alias, null, null);

    /// <summary>Opens the name prompt for a LINQ entry (1.2): its predicate, target, ordering and archived selector.</summary>
    /// <param name="text">The predicate.</param>
    /// <param name="alias">The document alias, or the target picker's token for the event log.</param>
    /// <param name="orderBy">The ordering.</param>
    /// <param name="archived">An event-log entry's archived selector.</param>
    internal Task BeginSaveAsync(string text, string? alias, string? orderBy, string? archived)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return Task.CompletedTask;
        }

        pendingText = text;
        pendingAlias = alias;
        pendingOrderBy = orderBy;
        pendingArchived = archived;
        pendingName = SavedQueryStore.DefaultName(text);
        naming = true;

        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Puts a query that has just been run at the head of the recent list.</summary>
    /// <param name="text">The clause, predicate or statement that ran.</param>
    /// <param name="alias">The document alias, or a LINQ entry's target token.</param>
    public Task RecordRunAsync(string text, string? alias) => RecordRunAsync(text, alias, null, null);

    /// <summary>Puts a LINQ query that has just been run at the head of the recent list (1.2).</summary>
    /// <param name="text">The predicate that ran.</param>
    /// <param name="alias">The document alias, or the target picker's token for the event log.</param>
    /// <param name="orderBy">The ordering.</param>
    /// <param name="archived">An event-log entry's archived selector.</param>
    internal async Task RecordRunAsync(string text, string? alias, string? orderBy, string? archived)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        recent = [.. SavedQueryStore.AddRecent(
            recent, new SavedQuery(SavedQueryStore.DefaultName(text), CurrentMode, alias, text, orderBy, archived))];

        await WriteAsync(SavedQueryStore.RecentKey(StoreKey, CurrentMode), recent);
        await InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        // The mode or the store moved under an open prompt: what it holds was typed for the other list, so it closes, and a LINQ
        // predicate can never be saved into the SQL list (or the other way round). Nothing is kept of it.
        if (parametersSeen
            && (seenMode != CurrentMode || !string.Equals(seenStore, StoreKey, StringComparison.Ordinal)))
        {
            naming = false;
            importing = false;
            importMessage = null;
        }

        parametersSeen = true;
        seenMode = CurrentMode;
        seenStore = StoreKey;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string key = SavedQueryStore.RecentKey(StoreKey, CurrentMode);

        if (string.Equals(loadedKey, key, StringComparison.Ordinal))
        {
            return;
        }

        loadedKey = key;
        recent = [.. await ReadAsync(key)];
        saved = [.. await ReadAsync(SavedQueryStore.SavedKey(StoreKey, CurrentMode))];

        await InvokeAsync(StateHasChanged);
    }

    private QueryMode CurrentMode =>
        string.Equals(Mode, nameof(QueryMode.Sql), StringComparison.OrdinalIgnoreCase) ? QueryMode.Sql
        : string.Equals(Mode, nameof(QueryMode.Linq), StringComparison.OrdinalIgnoreCase) ? QueryMode.Linq
        : QueryMode.Marten;

    private async Task PickAsync(SavedQuery query)
    {
        if (OnPickDetailed.HasDelegate)
        {
            await OnPickDetailed.InvokeAsync((query.Text, query.Alias, query.OrderBy, query.Archived));
            return;
        }

        await OnPick.InvokeAsync((query.Text, query.Alias));
    }

    private Task OnNameChanged(ChangeEventArgs args)
    {
        pendingName = args.Value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnImportTextChanged(ChangeEventArgs args)
    {
        importText = args.Value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task ConfirmSaveAsync()
    {
        naming = false;

        saved = [.. SavedQueryStore.Save(saved, new SavedQuery(pendingName, CurrentMode, pendingAlias, pendingText, pendingOrderBy, pendingArchived))];

        await WriteAsync(SavedQueryStore.SavedKey(StoreKey, CurrentMode), saved);
        await InvokeAsync(StateHasChanged);
    }

    private void CancelSave() => naming = false;

    private void ToggleImport()
    {
        importing = !importing;
        importMessage = null;
    }

    private async Task RemoveAsync(SavedQuery query)
    {
        saved = [.. SavedQueryStore.Remove(saved, query.Name)];

        await WriteAsync(SavedQueryStore.SavedKey(StoreKey, CurrentMode), saved);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExportAsync()
    {
        string json = SavedQueryStore.Serialize([.. saved, .. recent]);

        try
        {
            await JsRuntime.InvokeAsync<bool>(
                "martenStudio.download.text",
                "marten-studio-queries.json",
                "application/json",
                json);
        }
        catch (Exception exception) when (StudioLiveUpdates.IsInteropUnavailable(exception))
        {
            // No browser to hand a file to (interop lost): there is nothing to report on a circuit that is going away.
        }
    }

    private async Task ImportAsync()
    {
        // An export holds the lists of the mode it came from (1.2): a LINQ entry is not offered to the SQL console or the
        // Marten clause box, and neither of those is offered to the LINQ editor. An entry written before 1.2 has no LINQ mode,
        // so it reads as a Marten clause and is kept out of LINQ's list here.
        IReadOnlyList<SavedQuery> imported = [.. SavedQueryStore.Deserialize(importText)
            .Where(query => (query.Mode == QueryMode.Linq) == (CurrentMode == QueryMode.Linq))];

        if (imported.Count == 0)
        {
            importMessage = CurrentMode == QueryMode.Linq
                ? "That is not a list of LINQ queries this studio wrote."
                : "That is not a list of queries this studio wrote.";
            return;
        }

        foreach (SavedQuery query in imported)
        {
            saved = [.. SavedQueryStore.Save(saved, query with { Mode = CurrentMode })];
        }

        await WriteAsync(SavedQueryStore.SavedKey(StoreKey, CurrentMode), saved);

        importMessage = imported.Count + " imported.";
        importing = false;
        importText = string.Empty;

        await InvokeAsync(StateHasChanged);
    }

    private async Task<IReadOnlyList<SavedQuery>> ReadAsync(string key)
    {
        try
        {
            string? stored = await JsRuntime.InvokeAsync<string?>("martenStudio.prefs.get", new object?[] { key });

            return SavedQueryStore.Deserialize(stored);
        }
        catch (Exception exception) when (StudioLiveUpdates.IsInteropUnavailable(exception))
        {
            if (exception is InvalidOperationException)
            {
                // Prerendering: there is no browser to ask yet, and the next render asks again.
                loadedKey = null;
            }

            return [];
        }
    }

    private async Task WriteAsync(string key, IReadOnlyList<SavedQuery> queries)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("martenStudio.prefs.set", key, SavedQueryStore.Serialize(queries));
        }
        catch (Exception exception) when (StudioLiveUpdates.IsInteropUnavailable(exception))
        {
            // No storage, or interop lost: the list is a convenience and stays as it is on screen.
        }
    }
}
