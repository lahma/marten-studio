@using PostgresStudio.Components.Json
@using PostgresStudio.Components.Shared
@*
    The SQL console's results.

    Everything it is given is already formatted and capped on the server by SqlValueFormatter: a select *
    over a table with a 40 MB bytea column must never push 40 MB down a SignalR circuit to be rendered as
    mojibake. So the grid's job is only to say what each cell *is* - NULL drawn as its own thing rather
    than as an empty string, binary as \x…, a Postgres type on every column header - and to let a JSON
    cell open in the viewer.

    The parameters are strings and tuples of strings rather than the studio's own result types because a
    Razor component's class is public: a public [Parameter] cannot have an internal type, and every data
    type in this project is internal on purpose (D12). Passing the rendering, not the model, is also what
    makes this grid reusable by any page that has a table to draw.
*@

@if (Columns.Count == 0)
{
    <div class="ms-empty ms-query-empty">
        <p class="ms-empty-title">@EmptyTitle</p>
        <p class="ms-empty-description">@EmptyText</p>
    </div>
}
else
{
    @* Already a scroll container of its own, so it is not wrapped in a <TableScroll> - that would be two
       nested scrollers, and the outer one would never scroll. It takes the shared class instead, which
       is what carries the edge cue, the focus ring and the keyboard reachability every other data table
       on the studio now has. *@
    <div class="ms-query-grid-scroll ms-table-scroll" role="region" aria-label="Query results table" tabindex="0">
        <table class="ms-table ms-query-grid">
            <thead>
                <tr>
                    <th class="ms-query-grid-ordinal" scope="col">#</th>
                    @for (int column = 0; column < Columns.Count; column++)
                    {
                        (string Name, string Type) header = Columns[column];
                        <th scope="col" @key="column">
                            <span class="ms-query-grid-name">@header.Name</span>
                            <span class="ms-query-grid-type">@header.Type</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int row = 0; row < Rows.Count; row++)
                {
                    int rowIndex = row;
                    IReadOnlyList<(string Text, string Kind)> cells = Rows[row];
                    <tr class="ms-table-row" @key="rowIndex">
                        <td class="ms-table-cell ms-query-grid-ordinal">@(rowIndex + 1)</td>
                        @for (int column = 0; column < Columns.Count; column++)
                        {
                            int columnIndex = column;
                            (string Text, string Kind) cell = columnIndex < cells.Count
                                ? cells[columnIndex]
                                : (string.Empty, NullKind);
                            @* ms-query-kind-, never ms-query-cell- + kind: for a text cell that spells
                               ms-query-cell-text, the class of the span inside a cell - an inline-block - and a
                               cell that is an inline-block is not a table cell. The row grid learnt the same
                               thing first (RowGrid's CellClass). *@
                            <td class="ms-table-cell ms-query-cell ms-query-kind-@cell.Kind" @key="columnIndex">
                                @* NULL, the JSON chip and plain text are SqlCellView's, shared with the database
                                   browser's row grid so the two grids never spell a cell two ways.
                                   A pgvector column (1.2-VEC) is the same cell the row grid draws: the console asks
                                   Postgres for such a column in text form, and the service knows it is pgvector's from
                                   the extension that owns its type (ReadOnlySqlSession), so the grid is handed its
                                   PgVectorColumn and SqlCellView collapses the value to its type and first components.
                                   Rich is set for those columns only - it also changes how a timestamp and a bytea are
                                   drawn, and every other column is exactly what it always was. *@
                                <SqlCellView Text="@cell.Text"
                                             Kind="@cell.Kind"
                                             Type="@Columns[columnIndex].Type"
                                             Rich="@IsVector(columnIndex)"
                                             Vector="@VectorOf(columnIndex)"
                                             IsTruncated="@IsCut(rowIndex, columnIndex)"
                                             OnOpen="() => OpenAsync(rowIndex, columnIndex)" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="ms-query-grid-footer ms-muted">
        @Rows.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) row@(Rows.Count == 1 ? "" : "s")
        @if (Truncated)
        {
            <span class="ms-chip ms-chip-warning ms-query-truncated">
                stopped at @RowLimit.ToString(System.Globalization.CultureInfo.InvariantCulture) rows
            </span>
            <span>
                - the reader was stopped rather than a <code>limit</code> appended, so the statement is
                still exactly what you typed.
            </span>
        }
    </p>

    @if (openJson is not null)
    {
        <div class="ms-query-json-panel">
            <div class="ms-query-json-panel-header">
                <span class="ms-query-json-panel-title">@openTitle</span>
                <button type="button" class="ms-btn ms-btn-sm" @onclick="CloseJson">Close</button>
            </div>
            <JsonView Json="@openJson"
                      Label="@openTitle"
                      AutoExpandDepth="1"
                      ShowSearch="false"
                      DownloadFileName="cell.json" />
        </div>
    }
    else if (openVector is not null)
    {
        @* The whole value of a pgvector cell, as Postgres prints it: the database browser's panel, in the console's. *@
        <div class="ms-query-json-panel ms-row-json-panel">
            <div class="ms-query-json-panel-header">
                <span class="ms-query-json-panel-title">@openTitle</span>
                <button type="button" class="ms-btn ms-btn-sm" @onclick="CloseJson">Close</button>
            </div>
            @if (openVectorCut)
            {
                <p class="ms-row-value-note">
                    This value was cut to fit the console's cell, so what is shown (and what the export carries) is not the whole
                    of it, and it is not offered for copying.
                </p>
            }
            else
            {
                <p class="ms-row-value-note ms-vector-panel-actions">
                    <CopyButton Value="@openVector" Label="@("Copy the whole value of " + openTitle)" />
                    <span>The whole value, as Postgres prints it.</span>
                </p>
            }
            <div class="ms-row-text-panel" role="region" aria-label="@openTitle" tabindex="0">
                <pre class="ms-row-text-panel-body ms-vector-whole">@openVector</pre>
            </div>
        </div>
    }
}

@code {
    /// <summary>The cell kind <c>SqlCellKind.Null</c> is passed as.</summary>
    public const string NullKind = SqlCellView.NullKind;

    /// <summary>The cell kind <c>SqlCellKind.Json</c> is passed as.</summary>
    public const string JsonKind = SqlCellView.JsonKind;

    private string? openJson;
    private string? openVector;
    private bool openVectorCut;
    private string openTitle = string.Empty;

    /// <summary>The columns, as name and Postgres type.</summary>
    [Parameter]
    public IReadOnlyList<(string Name, string Type)> Columns { get; set; } = [];

    /// <summary>The rows, as already-formatted text and the kind of each cell, lower-cased.</summary>
    [Parameter]
    public IReadOnlyList<IReadOnlyList<(string Text, string Kind)>> Rows { get; set; } = [];

    /// <summary>Whether the reader was stopped at the row cap.</summary>
    [Parameter]
    public bool Truncated { get; set; }

    /// <summary>The row cap that was in force.</summary>
    [Parameter]
    public int RowLimit { get; set; }

    /// <summary>The heading shown when there are no columns at all.</summary>
    [Parameter]
    public string EmptyTitle { get; set; } = "Nothing to show";

    /// <summary>What to say when there are no columns at all.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "This statement returned no result set.";

    /// <summary>
    /// For each column, in order: its <c>PgVectorColumn</c> when the column holds pgvector values and <see langword="null" />
    /// when it does not - the type the console learned from the extension that owns the column's type - together with the
    /// zero-based rows whose text was cut. A cut value is collapsed from what was read and is never offered for copying; the
    /// two travel as one so a caller cannot name the vectors and forget the cuts. Typed <see cref="object" /> for the reason
    /// <c>SqlCellView.Vector</c> gives: a public parameter cannot have an internal type. A list shorter than
    /// <see cref="Columns" /> (or none) means the rest are not vectors.
    /// </summary>
    [Parameter]
    public IReadOnlyList<(object? Vector, IReadOnlySet<int> CutRows)> VectorColumns { get; set; } = [];

    private object? VectorOf(int column) => column < VectorColumns.Count ? VectorColumns[column].Vector : null;

    private bool IsVector(int column) => VectorOf(column) is not null;

    private bool IsCut(int row, int column) =>
        column < VectorColumns.Count && VectorColumns[column].CutRows.Contains(row);

    private Task OpenAsync(int row, int column)
    {
        if (row < Rows.Count && column < Rows[row].Count)
        {
            string title = (column < Columns.Count ? Columns[column].Name : "value") +
                " (row " + (row + 1).ToString(System.Globalization.CultureInfo.InvariantCulture) + ")";

            CloseJson();
            openTitle = title;

            if (IsVector(column))
            {
                openVector = Rows[row][column].Text;
                openVectorCut = IsCut(row, column);
            }
            else
            {
                openJson = Rows[row][column].Text;
            }
        }

        return Task.CompletedTask;
    }

    private void CloseJson()
    {
        openJson = null;
        openVector = null;
        openVectorCut = false;
        openTitle = string.Empty;
    }
}
