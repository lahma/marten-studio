@using PostgresStudio.Services.Connection
@using PostgresStudio.Services.Live
@inject IJSRuntime JsRuntime

@*
    "Not visible from here" (NP3): what an application can configure in code, on the NpgsqlDataSourceBuilder, that is no part of a
    connection string and so is invisible to any page. Honest, and out of the way: an admin who sees a password row that says
    "not visible" or "not set" on an application that logs in to a cloud database should know a password provider may be the
    reason, but six paragraphs of small print are not what the page is for, so they are a <details> closed by default, with a one-line
    summary that says what is in it.

    Open or closed is remembered per browser in local storage, as the settings table's groups are (a convenience: a browser that
    refuses is drawn the default, closed). The platform opens and closes the element itself - a click, the keyboard, or the browser's
    find-in-page opening it to show a match - and the component follows its `toggle` event, asking the element whether it is open
    (the event carries no state), so what is drawn and what is remembered stay one value whoever changed it. Its own restoring of
    a remembered "open" raises the same event and finds nothing to change.
*@

@if (Model is ConnectionPageView view)
{
    <section class="ms-section ms-conn-hidden" id="conn-not-visible" aria-labelledby="conn-not-visible-title">
        <h2 class="ms-section-title" id="conn-not-visible-title">Not visible from here</h2>

        <details class="ms-conn-disclosure" id="conn-not-visible-details" open="@open" @ref="details" @ontoggle="OnToggledAsync">
            <summary class="ms-conn-disclosure-summary">
                @Summary
            </summary>

            <p class="ms-conn-note">
                Some of how an application connects is set in code, on its <code>NpgsqlDataSourceBuilder</code>, and is no part of the
                connection string this page reads.
            </p>

            <dl class="ms-conn-hidden-list">
                @foreach (ConnectionObservedLine line in view.NotVisible)
                {
                    <div class="ms-conn-hidden-row" @key="line.Label">
                        <dt>@line.Label</dt>
                        <dd>@line.Value</dd>
                    </div>
                }
            </dl>
        </details>
    </section>
}

@code {
    internal const string OpenKey = "ms_conn_not_visible_open";

    /// <summary>What is in the disclosure, by name, so a closed one still says what it holds (the six lines inside, in order).</summary>
    internal const string Summary =
        "Not in the connection string, so not shown: password providers, certificate callbacks, logging and tracing, type mappings "
        + "and a script per connection (all set in code on the NpgsqlDataSourceBuilder), and the default password file";

    private ElementReference details;
    private bool open;
    private bool prefsLoaded;

    /// <summary>The page's view, as a <c>ConnectionPageView</c>. Typed <see cref="object" /> - see <c>ComponentModel</c>.</summary>
    [Parameter]
    public object? Model { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (prefsLoaded || Model is not ConnectionPageView)
        {
            return;
        }

        prefsLoaded = true;

        try
        {
            string? stored = await JsRuntime.InvokeAsync<string?>("martenStudio.prefs.get", new object?[] { OpenKey });

            if (stored == "1" && !open)
            {
                open = true;
                StateHasChanged();
            }
        }
        catch (Exception exception) when (StudioLiveUpdates.IsInteropUnavailable(exception))
        {
            // Prerendering, a closed circuit, or a browser that refused: closed is the default, and it is a good one.
        }
    }

    /// <summary>
    /// The element opened or closed, by whatever means. The event has no state of its own, so the element is asked; when it agrees
    /// with the component (the echo of the component's own render) there is nothing to do.
    /// </summary>
    private async Task OnToggledAsync()
    {
        try
        {
            bool actual = await JsRuntime.InvokeAsync<bool>("martenStudio.disclosure.isOpen", new object?[] { details });

            if (actual == open)
            {
                return;
            }

            open = actual;
            await JsRuntime.InvokeVoidAsync("martenStudio.prefs.set", new object?[] { OpenKey, open ? "1" : "0" });
        }
        catch (Exception exception) when (StudioLiveUpdates.IsInteropUnavailable(exception))
        {
            // A closed circuit, or a browser that would not remember it: what is drawn is the element's own, which is all it was asked for.
        }
    }
}
