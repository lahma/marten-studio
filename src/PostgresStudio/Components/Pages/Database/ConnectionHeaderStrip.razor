@using PostgresStudio.Services.Connection
@using PostgresStudio.Services.Settings
@inject IStudioSettings Settings
@inject StudioDescriptor Descriptor
@inject StudioState State

@*
    The Connection page's strip of facts (NP3): one line an admin reads first - the server and database, the role, whether the
    connection is encrypted and whether the server's certificate is checked, the pool, the Npgsql loaded, and the platform or
    pooler in front. Each fact is a link to the row or section below that explains it. It wraps on a phone: the strip is a
    list, never a table.

    The tone of a fact is a border colour and nothing else - the fact's words carry the meaning ("encrypted, not verified"),
    so nothing here is told by colour alone.
*@

@if (Model is ConnectionPageView view)
{
    <section class="ms-conn-strip" aria-label="Connection at a glance">
        <dl class="ms-conn-facts">
            @foreach (ConnectionFact fact in view.Header)
            {
                <div class="@("ms-conn-fact ms-conn-fact-" + fact.Tone)" @key="fact.Label">
                    <dt>@fact.Label</dt>
                    <dd>
                        <a href="@ConnectionLinks.To(Settings, Descriptor, State.ActiveScope, fact.Anchor)" title="@(fact.Label == "TLS" ? view.Tls.Detail : "Show the detail below")">@fact.Value</a>
                    </dd>
                </div>
            }
        </dl>
    </section>
}

@code {
    /// <summary>The page's view, as a <c>ConnectionPageView</c>. Typed <see cref="object" /> - see <c>ComponentModel</c>.</summary>
    [Parameter]
    public object? Model { get; set; }
}
