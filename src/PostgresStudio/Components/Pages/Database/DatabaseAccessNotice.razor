@using PostgresStudio.Services.Database
@using PostgresStudio.Services.Settings
@inject IStudioSettings Settings

@*
    Which gate is shut, in the words of the gate itself (DatabaseGate's sentences, which the service hands
    over as DatabaseAccessState.Denial), and what opening it would add. The same shape CapabilityDisabled
    has, because it is the same kind of message: "not permitted" with nothing to act on is the failure mode
    of every feature-flagged admin UI (D4), so every one of these names the exact option or policy a host
    would change.

    Nothing is shown while the gate is open, and nothing while the state is unknown - a failed read says so
    through the page's own error, and a notice guessing at a gate it was not told about would be wrong half
    of the time.
*@

@if (Access is { IsOpen: false, Denial: { Length: > 0 } denial } access)
{
    <div class="ms-alert ms-alert-info ms-capability-disabled ms-db-access" role="note" data-refusal="@access.Refusal">
        <div class="ms-alert-content">
            @if (access.DefinitionsOpen)
            {
                @* The second way in: ViewDefinitions admits the definitions, and the structure around them, of the
                   schemas BrowsableSchemas names exactly; the rows are BrowseDatabase's, and it is not open. *@
                <p class="ms-db-access-title">@DefinitionsOnlyHeadline(access.Refusal)</p>
                @if (access.Refusal is DatabaseRefusal.WritePolicy or DatabaseRefusal.StorePolicy)
                {
                    <p class="ms-muted">@denial</p>
                }
                else
                {
                    <p class="ms-muted">
                        Rows, and everything in a schema <code>@Settings.OptionName("BrowsableSchemas")</code> admits only through
                        "*"@(WithheldPhrase(access)), need <code>@Settings.OptionName("Capabilities.BrowseDatabase")</code>.
                    </p>
                }
                <p class="ms-muted">
                    The structure and the definitions of views, functions, triggers, sequences and types in the schemas
                    <code>@Settings.OptionName("BrowsableSchemas")</code> names exactly are shown
                    (<code>Capabilities.ViewDefinitions</code>).
                </p>
            }
            else
            {
            <p class="ms-db-access-title">@(Settings.Text.Product == StudioProduct.MartenStudio ? Headline(access.Refusal) : SourceHeadline(access.Refusal))</p>
            <p class="ms-muted">@denial</p>
            @if ((access.Refusal is DatabaseRefusal.CapabilityOff or DatabaseRefusal.ReadOnly) && access.DefinitionDenial is { Length: > 0 } definitions && definitions != denial)
            {
                @* Said in the studio's own words (the sentence above, which MartenStudio pins, names BrowseDatabase alone):
                   what a definition needs is either of two capabilities. *@
                <p class="ms-muted">@definitions</p>
            }
            @if (Settings.Text.Product != StudioProduct.MartenStudio)
            {
                @* A studio over plain data sources: its own schemas are the ones BrowsableSchemas names exactly, and
                   nothing in them is any store's. *@
                <p class="ms-muted">
                    @switch (access.Refusal)
                    {
                        case DatabaseRefusal.CapabilityOff:
                        case DatabaseRefusal.ReadOnly:
                            <text>
                                What is shown is the structure of the schemas <code>@Settings.OptionName("BrowsableSchemas")</code>
                                names. With <code>Capabilities.ViewDefinitions</code> on, this screen would also show the
                                definitions of views, functions and triggers in them; with
                                <code>Capabilities.BrowseDatabase</code> on, also the rows of tables and the schemas it admits
                                through "*"@(WithheldPhrase(access)).
                            </text>
                            break;

                        default:
                            <text>
                                The structure of the schemas <code>@Settings.OptionName("BrowsableSchemas")</code> names is
                                still shown. The policy is asked about the database as a whole.
                            </text>
                            break;
                    }
                </p>
            }
            else
            {
            <p class="ms-muted">
                @switch (access.Refusal)
                {
                    case DatabaseRefusal.CapabilityOff:
                    case DatabaseRefusal.ReadOnly:
                        <text>
                            What is shown is the structure of this store's own schemas, as the Schema screen
                            shows it. With <code>Capabilities.ViewDefinitions</code> on, this screen would also
                            show the definitions of views, functions and triggers Marten does not own, and the
                            structure of the schemas <code>@Settings.OptionName("BrowsableSchemas")</code> names exactly;
                            with <code>Capabilities.BrowseDatabase</code> on, also the rows of tables it does not own
                            and the other schemas it admits@(WithheldPhrase(access)).
                        </text>
                        break;

                    case DatabaseRefusal.WritePolicy:
                    case DatabaseRefusal.StorePolicy:
                        <text>
                            The structure of this store's own schemas is still shown. The policy is asked about
                            the database as a whole with no tenant selected, because nothing filters a table
                            Marten does not own by tenant.
                        </text>
                        break;

                    default:
                        <text>
                            The structure of this store's own schemas is still shown. Definitions and rows of
                            objects Marten does not own need their schema listed there.
                        </text>
                        break;
                }
            </p>
            }
            }
        </div>
    </div>
}

@code {
    /// <summary>The gate, as a <c>DatabaseAccessState</c>. Typed <see cref="object" /> - see <c>ComponentModel</c>.</summary>
    [Parameter]
    public object? Model { get; set; }

    private DatabaseAccessState? Access => Model as DatabaseAccessState;

    private static string Headline(DatabaseRefusal refusal) => refusal switch
    {
        DatabaseRefusal.ReadOnly => "The database browser is limited to this store's own schemas: the studio is read-only.",
        DatabaseRefusal.CapabilityOff => "Browsing beyond this store's own schemas is not enabled.",
        DatabaseRefusal.WritePolicy or DatabaseRefusal.StorePolicy => "Your account may not browse beyond this store's own schemas.",
        DatabaseRefusal.SchemaNotBrowsable => "No schema is browsable yet.",
        _ => "The database browser is limited to this store's own schemas.",
    };

    /// <summary>The headline in a studio over plain data sources, whose own schemas are the ones BrowsableSchemas names.</summary>
    private static string SourceHeadline(DatabaseRefusal refusal) => refusal switch
    {
        DatabaseRefusal.ReadOnly => "The database browser shows only the structure of the browsable schemas: the studio is read-only.",
        DatabaseRefusal.CapabilityOff => "Browsing rows and definitions is not enabled.",
        DatabaseRefusal.WritePolicy or DatabaseRefusal.StorePolicy => "Your account may not browse rows and definitions here.",
        DatabaseRefusal.SchemaNotBrowsable => "No schema is browsable yet.",
        _ => "The database browser shows only the structure of the browsable schemas.",
    };

    /// <summary>The headline of a visitor who may read definitions but not rows: <c>ViewDefinitions</c> is open, <c>BrowseDatabase</c> is not.</summary>
    private static string DefinitionsOnlyHeadline(DatabaseRefusal refusal) => refusal switch
    {
        DatabaseRefusal.WritePolicy or DatabaseRefusal.StorePolicy => "Definitions are shown; your account may not browse rows here.",
        _ => "Definitions are shown; browsing rows is not enabled.",
    };

    /// <summary>How many schemas are withheld, as an aside - a count, never their names.</summary>
    private static string WithheldPhrase(DatabaseAccessState access) => access.WithheldSchemaCount switch
    {
        <= 0 => string.Empty,
        1 => " (this database has one more)",
        _ => " (this database has " + DatabasePresentation.Number(access.WithheldSchemaCount) + " more)",
    };
}
