@* A native modal (1.2-A11Y, ModalDialog): focus goes to the typed-confirmation box when there is one - the phrase is the safeguard,
   and it is what the visitor does next - and to Cancel when there is not, because every confirm button here is a destructive one
   (ms-button-danger). Esc is Cancel, Tab stays inside, and focus goes back to the control that opened the dialog. *@
<ModalDialog IsOpen="IsOpen" Role="alertdialog" Label="@Title" OnCancel="CancelAsync">
    <div class="ms-confirm-dialog">
        <h3>@Title</h3>
        <p>@Message</p>
        @ChildContent

        @if (RequiresTypedConfirmation)
        {
            @* Type-to-confirm. The point is not that it is hard to defeat - it is that the person has
               to read what they are about to change and write it out, which is what stops the wrong
               row being archived from a list of forty that look alike, and the wrong database having
               a migration applied to it. Where a service checks the same string again, this is the
               part a person reads, not the part that enforces it. *@
            <label class="ms-confirm-label" for="ms-confirm-input">
                Type <code>@ConfirmationPhrase</code> to confirm.
            </label>
            <input id="ms-confirm-input"
                   class="ms-input ms-input-mono ms-confirm-input"
                   type="text"
                   autocomplete="off"
                   spellcheck="false"
                   value="@typed"
                   data-ms-dialog-focus
                   @oninput="OnTypedAsync"
                   @onkeydown="OnTypedKeyAsync" />
        }

        <div class="ms-confirm-actions">
            @* While the phrase does not match, Confirm is aria-disabled and not disabled (1.2-UX-FIX-FU): a disabled button is skipped by Tab,
               so Tab pressed before the round trip that enables it landed on Cancel. It stays focusable, looks disabled, and ConfirmAsync
               refuses until CanConfirm. A blocked reason from the owner (an action that is a no-op) still disables it outright. *@
            <button type="button"
                    class="ms-button ms-button-danger"
                    disabled="@HardBlocked"
                    aria-disabled="@(AwaitsPhrase ? "true" : null)"
                    title="@ConfirmBlockedReason"
                    @onclick="ConfirmAsync">
                @ConfirmText
            </button>
            <button type="button"
                    class="ms-button"
                    data-ms-dialog-focus="@(RequiresTypedConfirmation ? null : "true")"
                    @onclick="CancelAsync">Cancel</button>
        </div>
    </div>
</ModalDialog>

@code {
    private string typed = string.Empty;
    private bool wasOpen;
    private bool confirming;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirm action";

    [Parameter]
    public string Message { get; set; } = "Are you sure?";

    /// <summary>
    /// Optional detail between the message and the confirmation, for an action whose scope is a table
    /// rather than a sentence - the tables a rebuild rewrites, the shards it restarts.
    /// </summary>
    /// <remarks>
    /// A slot here rather than a second dialog: a screen that grew its own copy of type-to-confirm is a
    /// screen where the rule can be got wrong one more time.
    /// </remarks>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// What the visitor has to type before the confirm button works, or <see langword="null" /> for a
    /// plain confirmation.
    /// </summary>
    /// <remarks>
    /// The stream detail screen asks for the stream id before archiving it; the schema screen asks for
    /// the database identity before applying a migration to it. Where a service checks the same string
    /// again, the dialog is the convenience and the service is the refusal.
    /// </remarks>
    [Parameter]
    public string? ConfirmationPhrase { get; set; }

    /// <summary>What the confirm button says.</summary>
    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    /// <summary>
    /// Why the confirm button cannot be used, or <see langword="null" /> when it can. A dialog whose action turned out to be
    /// a no-op, or is still being checked, says why here: the button is disabled and carries the reason as its title.
    /// </summary>
    [Parameter]
    public string? ConfirmBlockedReason { get; set; }

    /// <summary>
    /// Raised with <em>what the visitor typed</em>, so a caller can pass that on to the service.
    /// </summary>
    /// <remarks>
    /// The argument is the whole point. A service that re-checks a typed confirmation is only checking
    /// anything if the string it receives came from the input box; a page that passed its own copy of the
    /// phrase would be handing the service the answer, and the second check would be a tautology. A
    /// parameterless handler still binds - <c>EventCallback.Factory.Create&lt;string&gt;</c> has a
    /// <c>Func&lt;Task&gt;</c> overload - which is what the dialogs with no typed confirmation use.
    /// </remarks>
    [Parameter]
    public EventCallback<string> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool RequiresTypedConfirmation => !string.IsNullOrWhiteSpace(ConfirmationPhrase);

    private bool HardBlocked => !string.IsNullOrEmpty(ConfirmBlockedReason);

    private bool AwaitsPhrase => !HardBlocked && RequiresTypedConfirmation && !string.Equals(typed.Trim(), ConfirmationPhrase, StringComparison.Ordinal);

    private bool CanConfirm =>
        string.IsNullOrEmpty(ConfirmBlockedReason)
        && (!RequiresTypedConfirmation || string.Equals(typed.Trim(), ConfirmationPhrase, StringComparison.Ordinal));

    protected override void OnParametersSet()
    {
        // Re-opening the dialog starts from an empty box: a typed confirmation that survived the last
        // cancel would be a typed confirmation nobody typed.
        if (IsOpen && !wasOpen)
        {
            typed = string.Empty;
            confirming = false;
        }

        wasOpen = IsOpen;
    }

    private Task OnTypedAsync(ChangeEventArgs args)
    {
        typed = args.Value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Enter in the box confirms - when, and only when, the phrase matches (the button is the same gate). The box is bound on
    /// <c>input</c>, so what is typed has reached the component before the key that follows it (1.2-UX-FIX).
    /// </summary>
    private async Task OnTypedKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && CanConfirm)
        {
            await ConfirmAsync();
        }
    }

    private async Task ConfirmAsync()
    {
        // Once per opening (1.2-UX-FIX-FU3). Blazor keeps a removed handler's id until the client acknowledges the batch that removed it,
        // so a double click, or Enter held down, reaches here twice for one dialog: the second finds the flag set, or the dialog closed.
        // It is reset when the dialog is opened again, and if the owner's handler throws (nothing was confirmed).
        if (!IsOpen || confirming || !CanConfirm)
        {
            return;
        }

        confirming = true;

        try
        {
            await OnConfirm.InvokeAsync(typed.Trim());
        }
        catch
        {
            confirming = false;
            throw;
        }
    }

    private async Task CancelAsync()
    {
        await OnCancel.InvokeAsync();
    }
}
