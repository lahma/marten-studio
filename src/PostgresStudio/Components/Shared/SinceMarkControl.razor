@using PostgresStudio.Services.Live
@inject StudioState State

@* The Mark control of Statements, Storage and Maintenance (1.2-H-A, X6): "count from now".

   Unmarked it is one button. Marked it is a chip - "Counting since 14:02:05" - with Clear; a mark that no longer holds (a
   statistics reset or a restart began the counters again) says so on the chip and offers "Mark again". The page keeps the mark
   (in the circuit, SinceMarks) and does the counting; this draws the control and raises the two events, and makes no interop
   call of its own. Mark is inert while the page has nothing to remember; Clear is inert only before the page is interactive,
   so a mark can always be put down. *@

<div class="ms-mark" role="group" aria-label="Count from now">
    @if (MarkedAt is { } at)
    {
        bool ended = Invalid is { Length: > 0 };

        <span class="ms-mark-chip @(ended ? "ms-mark-chip-invalid" : null)"
              title="@(ended ? Invalid : "Counted from the read at " + SinceMarkTime.When(State, at, seconds: true) + ": the counters on screen when you pressed Mark.")">
            @(ended ? "Mark no longer holds (" + SinceMarkTime.When(State, at, seconds: true) + ")" : "Counting since " + SinceMarkTime.When(State, at, seconds: true))
        </span>

        @if (ended)
        {
            <button type="button" class="ms-button ms-mark-button ms-mark-again" disabled="@Disabled" @onclick="OnMark">Mark again</button>
        }

        <button type="button" class="ms-button ms-mark-clear" disabled="@ClearDisabled" @onclick="OnClear">Clear</button>
    }
    else
    {
        <button type="button"
                class="ms-button ms-mark-button"
                disabled="@Disabled"
                title="Remember these counters and show what changes from here. Kept in this tab only, until you clear it or reload."
                @onclick="OnMark">
            Mark
        </button>
    }
</div>

@code {
    /// <summary>When the counters were read that the mark holds, or <see langword="null" /> while there is no mark.</summary>
    [Parameter]
    public DateTimeOffset? MarkedAt { get; set; }

    /// <summary>Whether Mark (and Mark again) is inert: the page is not interactive yet, is loading, or shows no read to mark.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Whether Clear is inert: only before the page is interactive.</summary>
    [Parameter]
    public bool ClearDisabled { get; set; }

    /// <summary>What the chip says when the mark no longer holds, and what the page does instead; <see langword="null" /> while it holds (or there is none).</summary>
    [Parameter]
    public string? Invalid { get; set; }

    /// <summary>Raised when the visitor presses Mark, or Mark again.</summary>
    [Parameter]
    public EventCallback OnMark { get; set; }

    /// <summary>Raised when the visitor presses Clear.</summary>
    [Parameter]
    public EventCallback OnClear { get; set; }
}
