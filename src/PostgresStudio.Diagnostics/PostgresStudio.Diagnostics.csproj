<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>PostgresStudio.Diagnostics</AssemblyName>
    <RootNamespace>PostgresStudio</RootNamespace>
    <PackageId>PostgresStudio.Diagnostics</PackageId>
    <IsPackable>true</IsPackable>
    <Product>Postgres Studio Diagnostics</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>postgresql;npgsql;database;diagnostics;health;monitoring</PackageTags>
    <Description>The diagnostics engine of Postgres Studio and Marten Studio, with no ASP.NET Core: the health sweep and its checks, the facts they read and IPostgresDiagnostics, for any host that registers an NpgsqlDataSource.</Description>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Selects the conditional Npgsql PackageVersion row in Directory.Packages.props (AGENTS.md D30). -->
    <PostgresStudioPinsNpgsql>true</PostgresStudioPinsNpgsql>
    <!-- Selects the conditional Microsoft.Extensions.* rows in Directory.Packages.props (0.11-C). -->
    <PostgresStudioDiagnosticsPinsExtensions>true</PostgresStudioDiagnosticsPinsExtensions>
  </PropertyGroup>

  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- No FrameworkReference: this assembly is the engine alone, and a worker or console host must not need ASP.NET Core
       to use it. PostgresStudioFenceTests holds that at this file, the assets file and the built references. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PostgresStudio" />
    <InternalsVisibleTo Include="MartenStudio" />
    <InternalsVisibleTo Include="MartenStudio.Tests" />
    <InternalsVisibleTo Include="MartenStudio.Integration.Tests" />
    <InternalsVisibleTo Include="PostgresStudio.Tests" />
    <InternalsVisibleTo Include="PostgresStudio.Integration.Tests" />
    <InternalsVisibleTo Include="KStudio.Tests" />
  </ItemGroup>

  <!--
    The package is packed at the Npgsql floor and nowhere else - the same refusal, for the same reason, as
    MartenStudioPackOnlyAtTheMartenFloor in src/MartenStudio/MartenStudio.csproj. A nupkg packed after a
    restore at Npgsql 10.0.3 would say `Npgsql >= 10.0.3` and raise every host's Npgsql, every PostgresStudio and MartenStudio
    host's included, since PostgresStudio depends on exactly this package. The build's Pack target refuses
    first and names the Fallout parameter; this is the refusal for a bare `dotnet pack`.

    Two checks, because the property is not what NuGet packs from: the dependency range comes from
    project.assets.json, so a restore at the latest Npgsql (the second pass over postgres-studio.slnf)
    followed by a pack with no-restore would pass a property-only check. The library key "Npgsql/<floor>",
    quotes included (\x22 in the pattern), must be in that file. No assets file is a refusal, not a pass.
  -->
  <Target Name="PostgresStudioDiagnosticsPackOnlyAtTheNpgsqlFloor" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_PostgresStudioDiagnosticsAssetsFileExists>false</_PostgresStudioDiagnosticsAssetsFileExists>
      <_PostgresStudioDiagnosticsAssetsFileExists Condition="'$(ProjectAssetsFile)' != '' and Exists('$(ProjectAssetsFile)')">true</_PostgresStudioDiagnosticsAssetsFileExists>
      <_PostgresStudioDiagnosticsFloorLibraryKey>"Npgsql/$(PostgresStudioNpgsqlFloor)"</_PostgresStudioDiagnosticsFloorLibraryKey>
      <_PostgresStudioDiagnosticsFloorLibraryPattern>\x22Npgsql/$(PostgresStudioNpgsqlFloor.Replace('.', '\.'))\x22</_PostgresStudioDiagnosticsFloorLibraryPattern>
      <_PostgresStudioDiagnosticsAssets Condition="'$(_PostgresStudioDiagnosticsAssetsFileExists)' == 'true'">$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)'))</_PostgresStudioDiagnosticsAssets>
      <_PostgresStudioDiagnosticsAssetsAtFloor>false</_PostgresStudioDiagnosticsAssetsAtFloor>
      <_PostgresStudioDiagnosticsAssetsAtFloor Condition="'$(_PostgresStudioDiagnosticsAssetsFileExists)' == 'true' and $([System.Text.RegularExpressions.Regex]::IsMatch($(_PostgresStudioDiagnosticsAssets), $(_PostgresStudioDiagnosticsFloorLibraryPattern)))">true</_PostgresStudioDiagnosticsAssetsAtFloor>
    </PropertyGroup>

    <Error Condition="'$(PostgresStudioNpgsqlVersion)' != '$(PostgresStudioNpgsqlFloor)'"
           Text="PostgresStudio.Diagnostics is packed only at the Npgsql floor ($(PostgresStudioNpgsqlFloor), Directory.Packages.props), and this pack asks for Npgsql $(PostgresStudioNpgsqlVersion). A package packed here would depend on Npgsql &gt;= $(PostgresStudioNpgsqlVersion) and raise every host's Npgsql. Pack without PostgresStudioNpgsqlVersion, or raise PostgresStudioNpgsqlFloor deliberately and record why in AGENTS.md, Package budget changes." />
    <Error Condition="'$(_PostgresStudioDiagnosticsAssetsFileExists)' != 'true'"
           Text="PostgresStudio.Diagnostics is packed only at the Npgsql floor ($(PostgresStudioNpgsqlFloor)), and there is no restore output to prove it ('$(ProjectAssetsFile)' does not exist). NuGet writes the package's dependency range from that file, so the guard refuses rather than guess. Pack with a restore (without --no-restore) at the floor." />
    <Error Condition="'$(_PostgresStudioDiagnosticsAssetsFileExists)' == 'true' and '$(_PostgresStudioDiagnosticsAssetsAtFloor)' != 'true'"
           Text="PostgresStudio.Diagnostics is packed only at the Npgsql floor ($(PostgresStudioNpgsqlFloor)), but the last restore ('$(ProjectAssetsFile)') resolved another Npgsql - it has no $(_PostgresStudioDiagnosticsFloorLibraryKey) library. NuGet writes the package's dependency range from that file, so this pack would raise every host's Npgsql. Restore at the floor first: pack without --no-restore and without PostgresStudioNpgsqlVersion." />
  </Target>

</Project>
