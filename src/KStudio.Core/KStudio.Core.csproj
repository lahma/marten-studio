<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>KStudio.Core</AssemblyName>
    <RootNamespace>KStudio</RootNamespace>
    <PackageId>KStudio.Core</PackageId>
    <IsPackable>true</IsPackable>
    <!-- No baseline: the package is not on nuget.org yet, so Directory.Build.props' PackageValidationBaselineVersion (the family's) must not apply. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageTags>kafka;blazor;studio;admin</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Product>KStudio</Product>
    <Description>The engine of KStudio, with no ASP.NET Core: the catalog, window resolution, the scan engine, predicates, decoders, the governor and redaction, over Confluent.Kafka behind an internal wire seam. Apache Kafka is a trademark of the Apache Software Foundation. KStudio is not affiliated with or endorsed by the Apache Software Foundation.</Description>
    <!-- Selects the conditional Microsoft.Extensions.* rows in Directory.Packages.props (AGENTS.md D36). -->
    <KStudioCorePinsExtensions>true</KStudioCorePinsExtensions>
  </PropertyGroup>

  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!-- K8: the preview label (Directory.Build.props, KStudioPrereleaseLabel). Only the three KStudio projects read it. The package and the
       informational version are `<version>-<label>`; AssemblyVersion and FileVersion stay numeric. `Version` is the CHANGELOG's, passed by Pack
       as a global property, so it is read here and never set. An empty label packs at the family version (the graduation path). The
       label is also stamped into the assembly, so the version guards can tell the preview suffix from the family's own version. -->
  <PropertyGroup>
    <KStudioBaseVersion>$(Version)</KStudioBaseVersion>
    <KStudioBaseVersion Condition="'$(KStudioBaseVersion)' == ''">$(VersionPrefix)</KStudioBaseVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(KStudioPrereleaseLabel)' != ''">
    <PackageVersion>$(KStudioBaseVersion)-$(KStudioPrereleaseLabel)</PackageVersion>
    <InformationalVersion>$(KStudioBaseVersion)-$(KStudioPrereleaseLabel)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(KStudioPrereleaseLabel)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KStudioPrereleaseLabel</_Parameter1>
      <_Parameter2>$(KStudioPrereleaseLabel)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- No FrameworkReference: the engine has no ASP.NET Core (KStudioCoreFenceTests). -->

  <ItemGroup>
    <None Include="../KStudio/README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KStudio" />
    <InternalsVisibleTo Include="KStudio.Tests" />
    <InternalsVisibleTo Include="KStudio.Integration.Tests" />
    <!-- D43: the one cluster source, and its fast suite. KStudio.Wolverine checks its own build against this one's before it uses any of it. -->
    <InternalsVisibleTo Include="KStudio.Wolverine" />
    <InternalsVisibleTo Include="KStudio.Wolverine.Tests" />
  </ItemGroup>

</Project>
