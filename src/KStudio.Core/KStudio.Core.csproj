<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>KStudio.Core</AssemblyName>
    <RootNamespace>KStudio</RootNamespace>
    <PackageId>KStudio.Core</PackageId>
    <IsPackable>true</IsPackable>
    <!-- No baseline: the package is not on nuget.org yet, so Directory.Build.props' PackageValidationBaselineVersion (the family's) must not apply. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageTags>kafka;blazor;studio;admin</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Product>KStudio</Product>
    <Description>The engine of KStudio, with no ASP.NET Core: the catalog, window resolution, the scan engine, predicates, decoders, the governor and redaction, over Confluent.Kafka behind an internal wire seam. Apache Kafka is a trademark of the Apache Software Foundation. KStudio is not affiliated with or endorsed by the Apache Software Foundation.</Description>
    <!-- Selects the conditional Microsoft.Extensions.* rows in Directory.Packages.props (AGENTS.md D36). -->
    <KStudioCorePinsExtensions>true</KStudioCorePinsExtensions>
  </PropertyGroup>

  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!-- K8: the preview label (Directory.Build.props, KStudioPrereleaseLabel). Only the three KStudio projects read it. The package and the
       informational version are `<version>-<label>`; AssemblyVersion and FileVersion stay numeric. `Version` is the CHANGELOG's, passed by Pack
       as a global property, so it is read here and never set. An empty label packs at the family version (the graduation path). The
       label is also stamped into the assembly, so the version guards can tell the preview suffix from the family's own version. -->
  <PropertyGroup>
    <KStudioBaseVersion>$(Version)</KStudioBaseVersion>
    <KStudioBaseVersion Condition="'$(KStudioBaseVersion)' == ''">$(VersionPrefix)</KStudioBaseVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(KStudioPrereleaseLabel)' != ''">
    <PackageVersion>$(KStudioBaseVersion)-$(KStudioPrereleaseLabel)</PackageVersion>
    <InformationalVersion>$(KStudioBaseVersion)-$(KStudioPrereleaseLabel)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(KStudioPrereleaseLabel)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KStudioPrereleaseLabel</_Parameter1>
      <_Parameter2>$(KStudioPrereleaseLabel)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- No FrameworkReference: the engine has no ASP.NET Core (KStudioCoreFenceTests). -->

  <ItemGroup>
    <None Include="../KStudio/README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KStudio" />
    <InternalsVisibleTo Include="KStudio.Tests" />
    <InternalsVisibleTo Include="KStudio.Integration.Tests" />
    <!-- D43: the one cluster source, and its fast suite. KStudio.Wolverine checks its own build against this one's before it uses any of it. -->
    <InternalsVisibleTo Include="KStudio.Wolverine" />
    <InternalsVisibleTo Include="KStudio.Wolverine.Tests" />
  </ItemGroup>

  <!--
    The package is packed at the Confluent.Kafka floor and nowhere else - the same refusal, for the same reason, as
    PostgresStudioDiagnosticsPackOnlyAtTheNpgsqlFloor in src/PostgresStudio.Diagnostics. A nupkg packed after a restore at
    Confluent.Kafka 2.16.0 would say `Confluent.Kafka >= 2.16.0` and raise every Wolverine host's Confluent.Kafka (WolverineFx.Kafka
    pins the floor). The build's Pack target refuses first and names the Fallout parameter (AssertPackingAtTheConfluentFloor); this is
    the refusal for a bare `dotnet pack`, by property and by project.assets.json (the dependency range is written from that file, so a
    restore at the latest followed by a pack with no-restore would pass a property-only check). KStudio and KStudio.Wolverine take the
    same range transitively; Pack asserts their nuspecs.
  -->
  <Target Name="KStudioCorePackOnlyAtTheConfluentFloor" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_KStudioCoreAssetsFileExists>false</_KStudioCoreAssetsFileExists>
      <_KStudioCoreAssetsFileExists Condition="'$(ProjectAssetsFile)' != '' and Exists('$(ProjectAssetsFile)')">true</_KStudioCoreAssetsFileExists>
      <_KStudioCoreFloorLibraryKey>"Confluent.Kafka/$(KStudioConfluentFloor)"</_KStudioCoreFloorLibraryKey>
      <_KStudioCoreFloorLibraryPattern>\x22Confluent\.Kafka/$(KStudioConfluentFloor.Replace('.', '\.'))\x22</_KStudioCoreFloorLibraryPattern>
      <_KStudioCoreAssets Condition="'$(_KStudioCoreAssetsFileExists)' == 'true'">$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)'))</_KStudioCoreAssets>
      <_KStudioCoreAssetsAtFloor>false</_KStudioCoreAssetsAtFloor>
      <_KStudioCoreAssetsAtFloor Condition="'$(_KStudioCoreAssetsFileExists)' == 'true' and $([System.Text.RegularExpressions.Regex]::IsMatch($(_KStudioCoreAssets), $(_KStudioCoreFloorLibraryPattern)))">true</_KStudioCoreAssetsAtFloor>
    </PropertyGroup>

    <Error Condition="'$(KStudioConfluentVersion)' != '$(KStudioConfluentFloor)'"
           Text="KStudio.Core is packed only at the Confluent.Kafka floor ($(KStudioConfluentFloor), Directory.Packages.props), and this pack asks for Confluent.Kafka $(KStudioConfluentVersion). A package packed here would depend on Confluent.Kafka &gt;= $(KStudioConfluentVersion) and raise every host's Confluent.Kafka. Pack without KStudioConfluentVersion, or raise KStudioConfluentFloor deliberately and record why in AGENTS.md, Package budget changes." />
    <Error Condition="'$(_KStudioCoreAssetsFileExists)' != 'true'"
           Text="KStudio.Core is packed only at the Confluent.Kafka floor ($(KStudioConfluentFloor)), and there is no restore output to prove it ('$(ProjectAssetsFile)' does not exist). NuGet writes the package's dependency range from that file, so the guard refuses rather than guess. Pack with a restore (without --no-restore) at the floor." />
    <Error Condition="'$(_KStudioCoreAssetsFileExists)' == 'true' and '$(_KStudioCoreAssetsAtFloor)' != 'true'"
           Text="KStudio.Core is packed only at the Confluent.Kafka floor ($(KStudioConfluentFloor)), but the last restore ('$(ProjectAssetsFile)') resolved another Confluent.Kafka - it has no $(_KStudioCoreFloorLibraryKey) library. NuGet writes the package's dependency range from that file, so this pack would raise every host's Confluent.Kafka. Restore at the floor first: pack without --no-restore and without KStudioConfluentVersion." />
  </Target>

</Project>
