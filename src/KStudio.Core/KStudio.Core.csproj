<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>KStudio.Core</AssemblyName>
    <RootNamespace>KStudio</RootNamespace>
    <!-- Plan K8: nothing KStudio ships is packed before M4, and the build's Pack target does not list this project. -->
    <IsPackable>false</IsPackable>
    <Product>KStudio</Product>
    <Description>The engine of KStudio, with no ASP.NET Core: the catalog, window resolution, the scan engine, predicates, decoders, the governor and redaction, over Confluent.Kafka behind an internal wire seam.</Description>
    <!-- Selects the conditional Microsoft.Extensions.* rows in Directory.Packages.props (AGENTS.md D36). -->
    <KStudioCorePinsExtensions>true</KStudioCorePinsExtensions>
  </PropertyGroup>

  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!-- No FrameworkReference: the engine has no ASP.NET Core (KStudioCoreFenceTests). -->
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KStudio" />
    <InternalsVisibleTo Include="KStudio.Tests" />
    <InternalsVisibleTo Include="KStudio.Integration.Tests" />
  </ItemGroup>

</Project>
