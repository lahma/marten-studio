<Project Sdk="Microsoft.NET.Sdk">

  <!-- KStudio.Wolverine (AGENTS.md D43): lists the Kafka clusters and topics of a Wolverine application's configuration in KStudio. It reads
       the built WolverineOptions once and starts, connects and writes nothing. It references KStudio.Core and WolverineFx.Kafka only: no
       studio, no KStudio, no Marten, Weasel or Npgsql (KStudioWolverineFenceTests). Ships as a preview with the other two (K8). -->
  <PropertyGroup>
    <AssemblyName>KStudio.Wolverine</AssemblyName>
    <RootNamespace>KStudio</RootNamespace>
    <PackageId>KStudio.Wolverine</PackageId>
    <IsPackable>true</IsPackable>
    <!-- No baseline: the package is not on nuget.org yet, so Directory.Build.props' PackageValidationBaselineVersion (the family's) must not apply. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageTags>kafka;blazor;studio;admin;wolverine</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Product>KStudio</Product>
    <Description>KStudio.Wolverine lists the Kafka clusters and topics of a Wolverine application in KStudio, by reading its configuration and nothing else. Apache Kafka is a trademark of the Apache Software Foundation. KStudio is not affiliated with or endorsed by the Apache Software Foundation.</Description>
    <!-- Selects the conditional Microsoft.Extensions.* rows in Directory.Packages.props, as KStudio.Core does. -->
    <KStudioCorePinsExtensions>true</KStudioCorePinsExtensions>
  </PropertyGroup>

  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!-- K8: the preview label (Directory.Build.props, KStudioPrereleaseLabel). Only the three KStudio projects read it. The package and the
       informational version are `<version>-<label>`; AssemblyVersion and FileVersion stay numeric. `Version` is the CHANGELOG's, passed by Pack
       as a global property, so it is read here and never set. An empty label packs at the family version (the graduation path). The
       label is also stamped into the assembly, so the version guards can tell the preview suffix from the family's own version. -->
  <PropertyGroup>
    <KStudioBaseVersion>$(Version)</KStudioBaseVersion>
    <KStudioBaseVersion Condition="'$(KStudioBaseVersion)' == ''">$(VersionPrefix)</KStudioBaseVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(KStudioPrereleaseLabel)' != ''">
    <PackageVersion>$(KStudioBaseVersion)-$(KStudioPrereleaseLabel)</PackageVersion>
    <InformationalVersion>$(KStudioBaseVersion)-$(KStudioPrereleaseLabel)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(KStudioPrereleaseLabel)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KStudioPrereleaseLabel</_Parameter1>
      <_Parameter2>$(KStudioPrereleaseLabel)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="../KStudio/README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KStudio.Core/KStudio.Core.csproj" />
    <PackageReference Include="WolverineFx.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KStudio.Wolverine.Tests" />
    <InternalsVisibleTo Include="KStudio.Integration.Tests" />
  </ItemGroup>

  <!--
    WolverineFx references the JasperFx source generator with PrivateAssets="none", so it would run over this compilation. It has nothing to
    generate here (this assembly has no handler and no aggregate), and its marker attribute would put a JasperFx type on a shipped assembly,
    which is the reason src/MartenStudio/MartenStudio.csproj drops Marten's. Dropped by file name at CoreCompile, the same way.
  -->
  <Target Name="KStudioWolverineWithoutTheJasperFxSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_KStudioWolverineJasperFxGenerator Include="@(Analyzer)"
                                          Condition="$([System.String]::Copy('%(Filename)').StartsWith('JasperFx')) and $([System.String]::Copy('%(Filename)').EndsWith('SourceGenerator'))" />
      <Analyzer Remove="@(_KStudioWolverineJasperFxGenerator)" />
    </ItemGroup>
  </Target>

  <!-- Exactly its own build of what sits below it, as MartenStudio's MartenStudioPinsPostgresStudioExactly does: `KStudio.Core [x.y.z]`
       in the nuspec, not NuGet's default `>=`, and carrying the preview label: the version NuGet reads is KStudio.Core's PackageVersion. -->
  <Target Name="KStudioWolverinePinsCoreExactly" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'KStudio.Core'">
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
    <Error Condition="'@(_ProjectReferencesWithVersions->WithMetadataValue('Filename', 'KStudio.Core'))' == ''"
           Text="KStudio.Wolverine must depend on exactly its own KStudio.Core build, and pack found no KStudio.Core project reference to pin." />
  </Target>

</Project>
