<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The Kafka module's Razor Class Library (AGENTS.md D34, D35): AddKafkaStudio() adds a Kafka section to the studio the host
       registered. It has no Marten (hard rule 16), no static web assets (its CSS is a section of PostgresStudio's one stylesheet)
       and it ships as a preview (K8; the label is Directory.Build.props' KStudioPrereleaseLabel). -->
  <PropertyGroup>
    <AssemblyName>KStudio</AssemblyName>
    <RootNamespace>KStudio</RootNamespace>
    <PackageId>KStudio</PackageId>
    <IsPackable>true</IsPackable>
    <!-- No baseline: the family's PackageValidationBaselineVersion (Directory.Build.props) must not apply; this package's own baseline stays empty until one release after it graduates from preview (K8). -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageTags>kafka;blazor;studio;admin</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Product>KStudio</Product>
    <Description>KStudio for Apache Kafka: a Kafka section for Marten Studio or Postgres Studio, over the application's own Kafka credentials. Apache Kafka is a trademark of the Apache Software Foundation. KStudio is not affiliated with or endorsed by the Apache Software Foundation.</Description>
  </PropertyGroup>

  <!-- Components are bound by name, as in the other studios (D2). -->
  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The shell this module joins, and the engine it shows. Confluent.Kafka reaches this project only through KStudio.Core: the
       built KStudio.dll references no Confluent assembly (KStudioFenceTests). -->
  <ItemGroup>
    <ProjectReference Include="../PostgresStudio/PostgresStudio.csproj" />
    <ProjectReference Include="../KStudio.Core/KStudio.Core.csproj" />
  </ItemGroup>

  <!-- K8: the preview label (Directory.Build.props, KStudioPrereleaseLabel). Only the three KStudio projects read it. The package and the
       informational version are `<version>-<label>`; AssemblyVersion and FileVersion stay numeric. `Version` is the CHANGELOG's, passed by Pack
       as a global property, so it is read here and never set. An empty label packs at the family version (the graduation path). The
       label is also stamped into the assembly, so the version guards can tell the preview suffix from the family's own version. -->
  <PropertyGroup>
    <KStudioBaseVersion>$(Version)</KStudioBaseVersion>
    <KStudioBaseVersion Condition="'$(KStudioBaseVersion)' == ''">$(VersionPrefix)</KStudioBaseVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(KStudioPrereleaseLabel)' != ''">
    <PackageVersion>$(KStudioBaseVersion)-$(KStudioPrereleaseLabel)</PackageVersion>
    <InformationalVersion>$(KStudioBaseVersion)-$(KStudioPrereleaseLabel)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(KStudioPrereleaseLabel)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KStudioPrereleaseLabel</_Parameter1>
      <_Parameter2>$(KStudioPrereleaseLabel)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="../KStudio/README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KStudio.Tests" />
    <InternalsVisibleTo Include="KStudio.Integration.Tests" />
  </ItemGroup>

  <!-- Exactly its own build of what sits below it, as MartenStudio's MartenStudioPinsPostgresStudioExactly does: `PostgresStudio [x.y.z]` and `KStudio.Core [x.y.z]`
       in the nuspec, not NuGet's default `>=`. KStudio.Core's range carries the preview label: the version NuGet reads is that project's PackageVersion. -->
  <Target Name="KStudioPinsFamilyExactly" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'PostgresStudio' or '%(Filename)' == 'KStudio.Core'">
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
    <Error Condition="'@(_ProjectReferencesWithVersions->WithMetadataValue('Filename', 'PostgresStudio'))' == ''"
           Text="KStudio must depend on exactly its own PostgresStudio build, and pack found no PostgresStudio project reference to pin." />
    <Error Condition="'@(_ProjectReferencesWithVersions->WithMetadataValue('Filename', 'KStudio.Core'))' == ''"
           Text="KStudio must depend on exactly its own KStudio.Core build, and pack found no KStudio.Core project reference to pin." />
  </Target>

</Project>
