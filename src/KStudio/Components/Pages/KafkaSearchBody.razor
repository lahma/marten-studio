@implements IAsyncDisposable
@using System.Globalization
@using KStudio.Core.Clusters
@using KStudio.Core.Predicates
@using KStudio.Core.Scanning
@using KStudio.Core.Decoding
@using Microsoft.Extensions.Logging
@using PostgresStudio.Services
@using PostgresStudio.Services.Live
@using PostgresStudio.Services.Settings
@inject KafkaState State
@inject KafkaSearchService Search
@inject KafkaRecordService Records
@inject KafkaCatalogService Catalog
@inject KafkaCapabilityGuard Capabilities
@inject NavigationManager Navigation
@inject IStudioSettings Settings
@inject StudioState Studio
@inject TimeProvider Time
@inject ILogger<KafkaSearchBody> Logger

@* Search (D-UI decisions 10 to 14). The page never runs a search by itself: a pasted link fills the form and waits for the visitor's click, so a link
   cannot spend a budget or a confirmation on their behalf. Everything the form needs from a broker is read after the frame's Ready, and the body exists
   only after it, so prerendering makes no call. Results stream in through the engine's batcher (at most four a second) and are drawn through
   InvokeAsync; leaving the page ends the loop and records the scan exactly once. *@

<div class="ms-page ms-k-search">
    <nav class="ms-db-breadcrumb" aria-label="Breadcrumb">
        <a href="@TopicsHref">Topics</a>
        <span class="ms-db-breadcrumb-sep" aria-hidden="true">/</span>
        <span>Search</span>
    </nav>

    <div class="ms-page-header">
        <h1 class="ms-page-title">Search</h1>
    </div>

    @if (!Capabilities.IsEnabled(KafkaCapability.SearchRecords))
    {
        <KafkaCapabilityDisabled Capability="@nameof(KafkaStudioCapabilities.SearchRecords)" Action="search records" />
    }
    else if (error is not null)
    {
        <ErrorAlert Message="@error" />
    }
    else if (loadingTopics)
    {
        <LoadingSpinner />
    }
    else
    {
        @if (droppedFromLink > 0)
        {
            <p class="ms-k-note" role="note">@KafkaStudioText.LinkTopicsDropped(droppedFromLink)</p>
        }

        @if (topicsRefusal is not null)
        {
            <p class="ms-k-note" role="note">@topicsRefusal</p>
        }

        <div class="ms-k-search-form" aria-busy="@(busy ? "true" : "false")">
            <fieldset class="ms-k-topics" disabled="@busy">
                <legend>Topics</legend>
                <div class="ms-k-topics-header">
                    <KafkaFilterBox Placeholder="Filter topics" Value="@topicFilter" OnFilterChanged="OnTopicFilterAsync" />
                    <span class="ms-muted ms-k-topic-count" aria-live="polite">@selected.Count of @KafkaStudioText.MaxSearchTopics</span>
                </div>
                @if (VisibleTopics().ToList() is { Count: > 0 } shown)
                {
                    <div class="ms-k-topic-list">
                        @foreach (string name in shown)
                        {
                            bool isSelected = selected.Contains(name);
                            <label class="ms-k-topic-option" @key="name">
                                <input type="checkbox"
                                       checked="@isSelected"
                                       disabled="@(!isSelected && selected.Count >= KafkaStudioText.MaxSearchTopics)"
                                       @onchange="e => ToggleTopic(name, e.Value is true)" />
                                <span>@name</span>
                            </label>
                        }
                    </div>
                    @if (hiddenTopics > 0)
                    {
                        <p class="ms-muted">@KafkaDisplay.Count(hiddenTopics, "more topic matches", "more topics match"); narrow the filter.</p>
                    }
                }
                else
                {
                    <p class="ms-muted">No topic to search@(string.IsNullOrWhiteSpace(topicFilter) ? "." : " matches the filter.")</p>
                }
            </fieldset>

            <fieldset class="ms-k-window" disabled="@busy">
                <legend>Window</legend>
                <div class="ms-k-window-mode" role="radiogroup" aria-label="Window mode">
                    <label><input type="radio" name="ms-k-window-mode" checked="@(mode == WindowMode.Relative)" @onchange="() => SetMode(WindowMode.Relative)" /> Relative</label>
                    <label><input type="radio" name="ms-k-window-mode" checked="@(mode == WindowMode.Absolute)" @onchange="() => SetMode(WindowMode.Absolute)" /> Absolute</label>
                </div>

                @if (mode == WindowMode.Relative)
                {
                    <div class="ms-k-presets" role="group" aria-label="Relative window">
                        @foreach ((string label, int minutes) in Presets)
                        {
                            <button type="button"
                                    class="ms-btn ms-btn-sm"
                                    aria-pressed="@(presetMinutes == minutes ? "true" : "false")"
                                    @onclick="() => SetPreset(minutes)">@label</button>
                        }
                    </div>
                }
                else
                {
                    <div class="ms-k-absolute">
                        <label>From <input type="datetime-local" class="ms-input" value="@absoluteFrom" @onchange="e => absoluteFrom = e.Value?.ToString() ?? string.Empty" /></label>
                        <label>To <input type="datetime-local" class="ms-input" value="@absoluteTo" @onchange="e => absoluteTo = e.Value?.ToString() ?? string.Empty" /></label>
                        <label>
                            Zone
                            <select class="ms-input" @onchange="e => SetZone(e.Value?.ToString())">
                                <option value="utc" selected="@(zone == ZoneChoice.Utc)">UTC</option>
                                <option value="preference" selected="@(zone == ZoneChoice.Preference)">@PreferenceZoneId</option>
                            </select>
                        </label>
                    </div>
                }

                @if (WindowText() is { } windowText)
                {
                    <p class="ms-k-window-text" aria-live="polite">@windowText</p>
                }

                @if (windowProblem is not null)
                {
                    <p class="ms-k-note ms-k-note-warning" role="alert">@windowProblem</p>
                }
            </fieldset>

            <label class="ms-k-isolation">
                <input type="checkbox" checked="@includeUncommitted" disabled="@busy" @onchange="e => includeUncommitted = e.Value is true" />
                Include uncommitted records
                <span class="ms-muted">@KafkaStudioText.UncommittedHelp</span>
            </label>

            <div class="ms-k-predicate-field">
                <label for="ms-k-predicate">Search for</label>
                <textarea id="ms-k-predicate"
                          class="ms-input ms-k-predicate"
                          spellcheck="false"
                          autocomplete="off"
                          rows="3"
                          maxlength="@KafkaStudioText.MaxPredicateLength"
                          placeholder="key = 'order-42' and header.tenant-id = 'acme'"
                          disabled="@busy"
                          value="@predicate"
                          @oninput="OnPredicateInput"
                          @onkeydown="OnPredicateKeyAsync"></textarea>
            </div>

            @if (errors.Count > 0)
            {
                <ul class="ms-k-predicate-errors" aria-live="polite">
                    @foreach (PredicateError problem in errors)
                    {
                        <li>Position @(problem.Start + 1): @problem.Message</li>
                    }
                </ul>
                <pre class="ms-k-predicate-marks" aria-hidden="true">@MarkedText()</pre>
            }

            <details class="ms-k-syntax">
                <summary>Search syntax</summary>
                <p>
                    Fields: <code>key</code>, <code>header.&lt;name&gt;</code>, <code>ce.&lt;attribute&gt;</code> and <code>any</code>. Operators:
                    <code>=</code>, <code>in (…)</code>, <code>^=</code> (starts with), <code>~</code> (contains), <code>is null</code>, <code>is not null</code>.
                    Combine with <code>and</code>, <code>or</code>, <code>not</code> and parentheses.
                </p>
                <ul class="ms-k-syntax-examples">
                    @foreach (string example in SyntaxExamples)
                    {
                        <li><code>@example</code></li>
                    }
                </ul>
                @if (Capabilities.IsEnabled(KafkaCapability.ReadPayloads))
                {
                    <p>@KafkaStudioText.SearchSyntaxValues</p>
                    <ul class="ms-k-syntax-examples">
                        @foreach (string example in ValueSyntaxExamples)
                        {
                            <li><code>@example</code></li>
                        }
                    </ul>
                }
                else
                {
                    <p class="ms-muted">@KafkaStudioText.SearchSyntaxNeedsReadPayloads</p>
                }
            </details>

            <div class="ms-k-search-actions">
                @if (running)
                {
                    <button type="button" class="ms-button" @onclick="StopAsync">Stop</button>
                }
                else
                {
                    <button type="button" class="ms-button ms-button-primary" disabled="@(!CanSearch)" @onclick="SearchAsync">@(planning ? "Estimating…" : "Search")</button>
                }
            </div>

            <p class="ms-muted ms-k-allowance">Hourly allowance left: @(allowanceLeft is { } left ? KafkaDisplay.Bytes(left) : "—")</p>

            @if (refusal is not null)
            {
                <p class="ms-k-note ms-k-note-warning" role="alert">@refusal</p>
            }
        </div>

        @if (planned is { Plan.IsValid: true } shownPlan)
        {
            <details class="ms-k-verdicts">
                <summary>How this search runs</summary>
                @if (shownPlan.Plan.Verdicts.Count == 0)
                {
                    <p class="ms-muted">No clause: every record in the window is read.</p>
                }
                else
                {
                    <ul>
                        @foreach (ClauseVerdict verdict in shownPlan.Plan.Verdicts)
                        {
                            <li class="@(verdict.Kind is ClauseVerdictKind.PartitionPruned or ClauseVerdictKind.PointLookup ? "ms-k-pruned" : null)">@verdict.Topic · @verdict.Field: @verdict.Description</li>
                        }
                    </ul>
                }
            </details>

            @if (PlanNotes(shownPlan).Count > 0)
            {
                <section class="ms-k-plan-notes" aria-label="Before you search">
                    <h2 class="ms-section-title">Before you search</h2>
                    <ul>
                        @foreach (string note in PlanNotes(shownPlan))
                        {
                            <li>@note</li>
                        }
                    </ul>
                </section>
            }

            <p class="ms-k-estimate">@EstimateText(shownPlan)</p>
        }

        @if (progress is not null)
        {
            <div class="ms-stat-grid ms-k-stats">
                <StatCard Title="Records read" Value="@KafkaDisplay.Number(progress.Records)" />
                <StatCard Title="Bytes read" Value="@KafkaDisplay.Bytes(progress.Bytes)" />
                <StatCard Title="Matches" Value="@KafkaDisplay.Number(progress.Matches)" />
                <StatCard Title="Undecidable" Value="@KafkaDisplay.Number(progress.Undecidable)" />
                <StatCard Title="Elapsed" Value="@progress.Elapsed.ToString(@"m\:ss", CultureInfo.InvariantCulture)" />
                <StatCard Title="MiB/s" Value="@((progress.BytesPerSecond / 1_048_576d).ToString("0.0", CultureInfo.InvariantCulture))" />
            </div>

            <details class="ms-k-progress" open="@running">
                <summary>Progress by partition</summary>
                <TableScroll Label="Progress by partition">
                    <table class="ms-table">
                        <thead>
                            <tr>
                                <th>Topic</th>
                                <th>Partition</th>
                                <th>Of range</th>
                                <th>Records</th>
                                <th>Bytes</th>
                                <th>Matches</th>
                                <th>Undecidable</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (KafkaPartitionProgress partition in progress.Partitions)
                            {
                                <tr class="ms-table-row" @key="@(partition.Topic + "/" + partition.Partition)">
                                    <td class="ms-table-cell">@partition.Topic</td>
                                    <td class="ms-table-cell">@partition.Partition</td>
                                    <td class="ms-table-cell">
                                        <progress max="100" value="@partition.Percent.ToString("0", CultureInfo.InvariantCulture)"></progress>
                                        @partition.Percent.ToString("0", CultureInfo.InvariantCulture)%
                                    </td>
                                    <td class="ms-table-cell">@KafkaDisplay.Number(partition.Records)</td>
                                    <td class="ms-table-cell">@KafkaDisplay.Bytes(partition.Bytes)</td>
                                    <td class="ms-table-cell">@KafkaDisplay.Number(partition.Matches)</td>
                                    <td class="ms-table-cell">@KafkaDisplay.Number(partition.Undecidable)</td>
                                    <td class="ms-table-cell">@(partition.State is { } state ? KafkaSearchText.State(state, partition.Records) : string.Empty)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </TableScroll>
            </details>
        }

        @if (result is not null && planned is not null)
        {
            <div class="ms-k-result-banner" role="status">
                <p>@KafkaSearchText.Stop(result, planned.Plan.Limits)</p>
                @if (continuedAfter is { } previous)
                {
                    <p class="ms-muted">@KafkaStudioText.ContinuedAfter(previous)</p>
                }
                @if (KafkaSearchText.CanContinue(result.StopReason) && !result.Cursor.IsEmpty)
                {
                    <button type="button" class="ms-button" disabled="@busy" @onclick="ContinueAsync">Continue</button>
                }
                @if (result.Matches == 0 && result.Pruning.Any(static x => x.IsPruned))
                {
                    <button type="button" class="ms-button" disabled="@busy" @onclick="SearchAllPartitionsAsync">@KafkaStudioText.SearchAllPartitions</button>
                }
            </div>

            @if (KafkaSearchText.Caveats(result) is { Count: > 0 } caveats)
            {
                <section class="ms-k-caveats" aria-label="What this result does not cover">
                    <h2 class="ms-section-title">What this result does not cover</h2>
                    <ul>
                        @foreach (string caveat in caveats)
                        {
                            <li>@caveat</li>
                        }
                    </ul>
                </section>
            }
        }

        @if (matches.Count > 0)
        {
            <div class="ms-k-sort" role="group" aria-label="Sort the matches">
                <span class="ms-muted">Sort</span>
                <button type="button" class="ms-btn ms-btn-sm" aria-pressed="@(sort == MatchSort.Arrival ? "true" : "false")" @onclick="() => SetSort(MatchSort.Arrival)">Arrival</button>
                <button type="button" class="ms-btn ms-btn-sm" aria-pressed="@(sort == MatchSort.Time ? "true" : "false")" @onclick="() => SetSort(MatchSort.Time)">Time</button>
                <button type="button" class="ms-btn ms-btn-sm" aria-pressed="@(sort == MatchSort.Position ? "true" : "false")" @onclick="() => SetSort(MatchSort.Position)">Topic, partition, offset</button>
            </div>

            @if (compareKeys.Count > 0)
            {
                <div class="ms-k-compare-bar" role="group" aria-label="Compare records">
                    <button type="button" class="ms-btn ms-btn-sm" disabled="@(compareKeys.Count != 2 || busy)" @onclick="OpenCompareAsync">Compare 2 records</button>
                    @if (compareKeys.Count < 2)
                    {
                        <span class="ms-muted">Check a second record to compare.</span>
                    }
                </div>
            }

            <TableScroll Label="Matches">
                <table class="ms-table ms-k-matches">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Topic</th>
                            <th>Partition / offset</th>
                            <th>Key</th>
                            <th>Type</th>
                            <th>Correlation</th>
                            <th>Size</th>
                            <th><span class="ms-sr-only">Details</span></th>
                            <th><span class="ms-sr-only">Compare</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (KafkaMatch match in CurrentPage())
                        {
                            string rowKey = RowKey(match);
                            <tr class="ms-table-row" @key="rowKey">
                                <td class="ms-table-cell" title="@TimeTitle(match)">@Studio.FormatInSelectedTimeZone(match.Timestamp, "yyyy-MM-dd HH:mm:ss")</td>
                                <td class="ms-table-cell">@match.Topic</td>
                                <td class="ms-table-cell"><a href="@RecordHref(match)">@match.Partition / @KafkaDisplay.Number(match.Offset)</a></td>
                                <td class="ms-table-cell" title="@(match.Key.Text)">
                                    <span class="@KeyClass(match)">@KafkaMatchView.KeyDisplay(match.Key)</span>
                                    @if (match.Key.Truncated)
                                    {
                                        <span class="ms-muted"> (cut)</span>
                                    }
                                </td>
                                <td class="ms-table-cell">@KafkaMatchView.TypeOf(match)</td>
                                <td class="ms-table-cell">
                                    @foreach (KafkaChip chip in KafkaMatchView.Chips(match))
                                    {
                                        <button type="button" class="ms-chip ms-k-chip" title="@chip.Value" @onclick="() => UseChip(chip)">@chip.Display</button>
                                    }
                                </td>
                                <td class="ms-table-cell">
                                    @if (match.ValueKind == KafkaValueKind.Tombstone)
                                    {
                                        <span class="ms-chip ms-k-tombstone">tombstone</span>
                                    }
                                    else
                                    {
                                        @KafkaDisplay.Bytes(match.ValueLength)
                                    }
                                </td>
                                <td class="ms-table-cell">
                                    <button type="button"
                                            class="ms-btn ms-btn-sm"
                                            aria-expanded="@(expanded.Contains(rowKey) ? "true" : "false")"
                                            @onclick="() => ToggleDetailAsync(rowKey)">Details</button>
                                </td>
                                <td class="ms-table-cell">
                                    <input type="checkbox"
                                           aria-label="@($"Compare {match.Topic} {match.Partition}/{match.Offset}")"
                                           checked="@compareKeys.Contains(rowKey)"
                                           disabled="@(!compareKeys.Contains(rowKey) && compareKeys.Count >= 2)"
                                           @onchange="e => ToggleCompare(rowKey, e.Value is true)" />
                                </td>
                            </tr>
                            @if (expanded.Contains(rowKey))
                            {
                                <tr class="ms-k-match-detail" @key="@(rowKey + "#detail")">
                                    <td colspan="9">
                                        <KafkaRecordDetail Model="@match" Cluster="@State.ActiveCluster?.Key" Kcat="@KcatFor(match)" Access="@AccessOf(match)" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </TableScroll>

            @if (matches.Count > PagingThreshold)
            {
                <Pagination TotalItems="@matches.Count" PageSize="@PageRows" CurrentPage="@pageNumber" OnPageChanged="OnPageAsync" />
            }

            @if (compareOpen && ComparedPair() is { } pair)
            {
                <KafkaRecordCompare Left="@pair.Left"
                                    Right="@pair.Right"
                                    LeftAccess="@AccessOf(pair.Left)"
                                    RightAccess="@AccessOf(pair.Right)"
                                    OnClose="CloseCompareAsync" />
            }
        }
    }

    <ConfirmDialog IsOpen="@confirmOpen"
                   Title="@ConfirmTitle()"
                   Message="@ConfirmMessage()"
                   ConfirmText="Search"
                   OnConfirm="ConfirmedAsync"
                   OnCancel="CancelledAsync" />
</div>

@code {
    private enum WindowMode
    {
        Relative,
        Absolute,
    }

    private enum ZoneChoice
    {
        Utc,
        Preference,
    }

    private enum MatchSort
    {
        Arrival,
        Time,
        Position,
    }

    /// <summary>The examples of the syntax help; <c>SearchHelpExamplesTests</c> parses each, so the help cannot drift from the grammar.</summary>
    internal static readonly IReadOnlyList<string> SyntaxExamples =
    [
        "key = 'order-42'",
        "header.correlation-id = '7f3c2a'",
        "ce.type ^= 'Orders.' and not header.tenant-id = 'test'",
        "header.tenant-id in ('acme', 'globex')",
        "any ~ 'ORD-2026-'",
    ];

    /// <summary>The examples of the value syntax, shown with <c>ReadPayloads</c>; <c>SearchHelpExamplesTests</c> parses each one as well.</summary>
    internal static readonly IReadOnlyList<string> ValueSyntaxExamples =
    [
        "value ~ 'refund'",
        "$.customer.id = 'customer-042'",
        "$.items[*].sku in ('A-1', 'B-2')",
        "$.total >= 100",
    ];

    private static readonly (string Label, int Minutes)[] Presets = [("15 min", 15), ("1 h", 60), ("6 h", 360), ("24 h", 1_440), ("7 days", 10_080)];

    private const int MaxListedTopics = 200;
    private const int PagingThreshold = 1_000;
    private const int PageRows = 200;
    private const string LocalFormat = "yyyy-MM-dd'T'HH:mm";

    private readonly CancellationTokenSource lifetime = new();
    private readonly List<KafkaMatch> matches = [];
    private readonly List<string> selected = [];
    private readonly HashSet<string> expanded = new(StringComparer.Ordinal);
    private readonly List<string> compareKeys = [];
    private readonly HashSet<string> valueRefused = new(StringComparer.Ordinal);

    private IReadOnlyList<string> topicNames = [];
    private IReadOnlyList<PredicateError> errors = [];
    private IReadOnlyList<string> addressTopics = [];
    private KafkaSearchPlanned? planned;
    private KafkaGrantDecision? runGrant;
    private KafkaSearchRun? run;
    private KafkaScanProgress? progress;
    private KafkaScanResult? result;
    private KafkaClusterSettingsView? clusterSettings;
    private string? error;
    private string? refusal;
    private string? topicsRefusal;
    private string? windowProblem;
    private string? lastWritten;
    private string topicFilter = string.Empty;
    private string predicate = string.Empty;
    private string absoluteFrom = string.Empty;
    private string absoluteTo = string.Empty;
    private WindowMode mode = WindowMode.Relative;
    private ZoneChoice zone = ZoneChoice.Utc;
    private MatchSort sort = MatchSort.Arrival;
    private int presetMinutes = 60;
    private int droppedFromLink;
    private int hiddenTopics;
    private int pageNumber = 1;
    private long? continuedAfter;

    /// <summary>
    /// The records the search being planned continues after, held until it starts. "Continued after ..." says what a scan did, so it is drawn when the continued scan
    /// starts - not while its confirmation still waits, when the rows on screen are still the previous search's.
    /// </summary>
    private long? pendingContinuation;
    private long? allowanceLeft;
    private bool includeUncommitted;
    private bool loadingTopics = true;
    private bool planning;
    private bool running;
    private bool confirmOpen;
    private bool compareOpen;
    private bool disposed;
    private bool ready;
    private bool started;

    /// <summary>Completed by the frame once the cluster policy passed and the circuit is interactive: a body reads nothing before it.</summary>
    [CascadingParameter(Name = KafkaPageFrame.ReadyName)]
    public Task? Ready { get; set; }

    // The confirmation dialog counts: while it waits, nothing else may plan or continue and replace the plan it is about to start.
    private bool busy => planning || running || confirmOpen;

    private string TopicsHref => KafkaAddress.Href(Settings, KafkaAddress.TopicsRoute, State.ActiveCluster?.Key);

    private bool CanSearch => !busy && selected.Count > 0 && windowProblem is null;

    private string PreferenceZoneId => Studio.SelectedTimeZoneId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Ready is not null)
            {
                await Ready;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (disposed)
        {
            return;
        }

        // Read once the frame is Ready: in an interactive circuit NavigationManager.Uri is the browser's own address, fragment included, while the
        // prerendering request had none (a browser never sends one).
        ApplyAddress();
        State.ClusterChanged += OnClusterChangedAsync;
        Navigation.LocationChanged += OnLocationChanged;
        ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not keyed on firstRender: a body created before the frame released reads becomes ready after its first render.
        if (disposed || !ready || started)
        {
            return;
        }

        started = true;
        await LoadTopicsAsync();
    }

    private async Task LoadTopicsAsync()
    {
        if (State.ActiveCluster is not { } active)
        {
            loadingTopics = false;
            return;
        }

        try
        {
            KafkaTopicListing? listing = await Catalog.ListTopicsAsync(active, null, KafkaCapability.SearchRecords, lifetime.Token);

            if (disposed)
            {
                return;
            }

            topicsRefusal = listing?.RefusalText;
            topicNames = listing is null ? [] : [.. listing.Rows.Where(static x => x.Listed && !x.IsInternal).Select(static x => x.Name)];

            HashSet<string> visible = new(topicNames, StringComparer.Ordinal);
            selected.Clear();
            selected.AddRange(addressTopics.Where(visible.Contains).Distinct(StringComparer.Ordinal).Take(KafkaStudioText.MaxSearchTopics));
            droppedFromLink = addressTopics.Distinct(StringComparer.Ordinal).Count() - selected.Count;
            allowanceLeft = await Search.OwnerBytesLeftThisHourAsync();
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception e) when (!disposed)
        {
            Logger.LogWarning(e, "The Kafka search page failed to read the catalog");
            error = KafkaStudioText.ReadFailed;
        }

        loadingTopics = false;

        if (!disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Fills the form from the address: topics, window, isolation and the fragment's predicate. It never starts a search.</summary>
    private void ApplyAddress()
    {
        string uri = Navigation.Uri;

        addressTopics = [.. KafkaAddress.GetAll(uri, KafkaAddress.TopicParameter).Take(KafkaStudioText.MaxSearchTopics)];
        includeUncommitted = string.Equals(KafkaAddress.Get(uri, KafkaAddress.IsolationParameter), KafkaAddress.UncommittedValue, StringComparison.Ordinal);
        predicate = KafkaAddress.ReadPredicate(uri, KafkaStudioText.MaxPredicateLength) ?? string.Empty;

        if (KafkaAddress.TryParseWindow(KafkaAddress.Get(uri, KafkaAddress.FromParameter), out DateTimeOffset from)
            && KafkaAddress.TryParseWindow(KafkaAddress.Get(uri, KafkaAddress.ToParameter), out DateTimeOffset to))
        {
            mode = WindowMode.Absolute;
            zone = ZoneChoice.Utc;
            absoluteFrom = FormatLocal(from);
            absoluteTo = FormatLocal(to);
        }

        planned = null;
        errors = [];
        refusal = null;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // The page's own rewrite of the address (after a plan) is not a new address.
        if (disposed || !KafkaAddress.IsPage(e.Location, KafkaAddress.SearchRoute) || IsOwnWrite(e.Location) || running)
        {
            return;
        }

        _ = InvokeAsync(ApplyAddressAndReloadAsync);
    }

    /// <summary>Whether <paramref name="location" /> is the address this page just wrote (compared unescaped: a browser and a <c>Uri</c> disagree about which characters stay escaped).</summary>
    private bool IsOwnWrite(string location) =>
        lastWritten is not null && string.Equals(Uri.UnescapeDataString(location), Uri.UnescapeDataString(lastWritten), StringComparison.Ordinal);

    private async Task ApplyAddressAndReloadAsync()
    {
        if (disposed)
        {
            return;
        }

        ApplyAddress();
        loadingTopics = true;
        await InvokeAsync(StateHasChanged);
        await LoadTopicsAsync();
    }

    private async Task OnClusterChangedAsync()
    {
        if (disposed || running)
        {
            return;
        }

        selected.Clear();
        addressTopics = [];
        planned = null;
        result = null;
        progress = null;
        matches.Clear();
        compareKeys.Clear();
        compareOpen = false;
        loadingTopics = true;
        await InvokeAsync(StateHasChanged);
        await LoadTopicsAsync();
    }

    // ------------------------------------------------------------------------------------------------
    // The form
    // ------------------------------------------------------------------------------------------------

    private IEnumerable<string> VisibleTopics()
    {
        List<string> matching = [.. topicNames.Where(name => string.IsNullOrWhiteSpace(topicFilter) || name.Contains(topicFilter.Trim(), StringComparison.OrdinalIgnoreCase))];
        hiddenTopics = Math.Max(0, matching.Count - MaxListedTopics);

        // A selected topic stays visible, whatever the filter says.
        return selected.Union(matching.Take(MaxListedTopics), StringComparer.Ordinal).Where(topicNames.Contains).OrderBy(static x => x, StringComparer.Ordinal).Take(MaxListedTopics + KafkaStudioText.MaxSearchTopics);
    }

    private Task OnTopicFilterAsync(string text)
    {
        topicFilter = text;
        return InvokeAsync(StateHasChanged);
    }

    private void ToggleTopic(string name, bool on)
    {
        if (on && !selected.Contains(name, StringComparer.Ordinal) && selected.Count < KafkaStudioText.MaxSearchTopics)
        {
            selected.Add(name);
        }
        else if (!on)
        {
            selected.Remove(name);
        }
    }

    private void SetMode(WindowMode next)
    {
        if (next == WindowMode.Absolute && mode == WindowMode.Relative && string.IsNullOrEmpty(absoluteFrom))
        {
            // Start the absolute fields from what the relative choice means now.
            DateTimeOffset now = Truncate(Time.GetUtcNow());
            absoluteFrom = FormatLocal(now.AddMinutes(-presetMinutes));
            absoluteTo = FormatLocal(now);
        }

        mode = next;
        windowProblem = null;
    }

    private void SetPreset(int minutes)
    {
        presetMinutes = minutes;
        windowProblem = null;
    }

    private void SetZone(string? value)
    {
        ZoneChoice next = string.Equals(value, "preference", StringComparison.Ordinal) ? ZoneChoice.Preference : ZoneChoice.Utc;
        if (next == zone)
        {
            return;
        }

        // The instants stay; their reading in the other zone changes.
        bool hadFrom = TryParseLocal(absoluteFrom, out DateTimeOffset from, out _);
        bool hadTo = TryParseLocal(absoluteTo, out DateTimeOffset to, out _);
        zone = next;
        absoluteFrom = hadFrom ? FormatLocal(from) : absoluteFrom;
        absoluteTo = hadTo ? FormatLocal(to) : absoluteTo;
    }

    private TimeZoneInfo PreferenceZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(Studio.SelectedTimeZoneId);
        }
        catch (Exception e) when (e is TimeZoneNotFoundException or InvalidTimeZoneException)
        {
            return TimeZoneInfo.Local;
        }
    }

    private TimeZoneInfo ChosenZone() => zone == ZoneChoice.Utc ? TimeZoneInfo.Utc : PreferenceZone();

    private string FormatLocal(DateTimeOffset instant) =>
        TimeZoneInfo.ConvertTime(instant, ChosenZone()).ToString(LocalFormat, CultureInfo.InvariantCulture);

    private bool TryParseLocal(string text, out DateTimeOffset instant, out string? problem)
    {
        instant = default;
        problem = null;

        if (!DateTime.TryParseExact(text, [LocalFormat, "yyyy-MM-dd'T'HH:mm:ss"], CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime local))
        {
            problem = "Enter both times of the window.";
            return false;
        }

        TimeZoneInfo chosen = ChosenZone();

        if (chosen.IsInvalidTime(local))
        {
            problem = $"{local.ToString(LocalFormat, CultureInfo.InvariantCulture)} does not exist in {chosen.Id} (the clocks skip it).";
            return false;
        }

        instant = new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), chosen), TimeSpan.Zero);
        return true;
    }

    private static DateTimeOffset Truncate(DateTimeOffset value) => new(value.UtcTicks - (value.UtcTicks % TimeSpan.TicksPerSecond), TimeSpan.Zero);

    /// <summary>The window the form means right now; a relative one is <c>[now − d, now)</c>.</summary>
    private bool TryWindow(out DateTimeOffset from, out DateTimeOffset to, out string? problem)
    {
        from = to = default;
        problem = null;

        if (mode == WindowMode.Relative)
        {
            to = Truncate(Time.GetUtcNow());
            from = to.AddMinutes(-presetMinutes);
            return true;
        }

        if (!TryParseLocal(absoluteFrom, out from, out problem) || !TryParseLocal(absoluteTo, out to, out problem))
        {
            return false;
        }

        problem = new KStudio.Core.Windows.KafkaWindow(from, to).Problem;
        return problem is null;
    }

    /// <summary>The window repeated in both zones, so a visitor never guesses which zone a time is in.</summary>
    private string? WindowText()
    {
        if (!TryWindow(out DateTimeOffset from, out DateTimeOffset to, out string? problem))
        {
            windowProblem = problem;
            return null;
        }

        windowProblem = null;
        return KafkaSearchText.WindowLine(from, to, PreferenceZone());
    }

    /// <summary>Set by an input event whose only effect is the text in the box: the browser already shows it, so the whole page is not rendered again for each keystroke.</summary>
    private bool skipNextRender;

    protected override bool ShouldRender()
    {
        if (skipNextRender)
        {
            skipNextRender = false;
            return false;
        }

        return true;
    }

    private void OnPredicateInput(ChangeEventArgs e)
    {
        predicate = e.Value?.ToString() ?? string.Empty;
        skipNextRender = true;
    }

    private async Task OnPredicateKeyAsync(KeyboardEventArgs e)
    {
        if (e.CtrlKey && string.Equals(e.Key, "Enter", StringComparison.Ordinal) && CanSearch)
        {
            await SearchAsync();
        }
    }

    private void UseChip(KafkaChip chip)
    {
        if (running)
        {
            return;
        }

        // Fills the box and does not run it: every scan stays the visitor's own decision.
        if (string.IsNullOrWhiteSpace(predicate))
        {
            predicate = chip.Predicate;
        }
        else if (!predicate.Contains(chip.Predicate, StringComparison.Ordinal))
        {
            // Wrapped, so that an "or" already in the box does not swallow the chip: (what was there) and chip.
            predicate = "(" + predicate.Trim() + ") and " + chip.Predicate;
        }
    }

    /// <summary>The visitor's own text with each error's range in <c>&lt;mark&gt;</c>: it is echoed on their own screen and sent nowhere.</summary>
    private RenderFragment MarkedText() => builder =>
    {
        string text = planned?.Input.PredicateText ?? predicate;
        int position = 0;
        int sequence = 0;

        foreach (PredicateError problem in errors.OrderBy(static x => x.Start))
        {
            int start = Math.Clamp(problem.Start, position, text.Length);
            int end = Math.Clamp(problem.Start + Math.Max(1, problem.Length), start, text.Length);

            builder.AddContent(sequence++, text[position..start]);

            if (end > start)
            {
                builder.OpenElement(sequence++, "mark");
                builder.AddContent(sequence++, text[start..end]);
                builder.CloseElement();
            }

            position = end;
        }

        builder.AddContent(sequence, text[position..]);
    };

    // ------------------------------------------------------------------------------------------------
    // Planning and starting
    // ------------------------------------------------------------------------------------------------

    private async Task SearchAsync()
    {
        if (!CanSearch || State.ActiveCluster is not { } active)
        {
            return;
        }

        if (!TryWindow(out DateTimeOffset from, out DateTimeOffset to, out string? problem))
        {
            windowProblem = problem;
            return;
        }

        KafkaSearchInput input = new(active, [.. selected], from, to, predicate, includeUncommitted);
        await PlanAndStartAsync(input);
    }

    private async Task ContinueAsync()
    {
        if (busy || result is null || planned is null || result.Cursor.IsEmpty)
        {
            return;
        }

        // The same cluster, topics, window, isolation and predicate; the cursor stays in memory and never enters the address.
        long records = result.Records;
        await PlanAndStartAsync(planned.Input with { ContinueFrom = result.Cursor }, records);
    }

    private async Task SearchAllPartitionsAsync()
    {
        if (busy || planned is null)
        {
            return;
        }

        // The same search with pruning off: verdicts, estimate and confirmation again, a new scan and a new audit entry.
        await PlanAndStartAsync(planned.Input with { ContinueFrom = null, SearchAllPartitions = true });
    }

    private async Task PlanAndStartAsync(KafkaSearchInput input, long? continuing = null)
    {
        planning = true;
        refusal = null;
        errors = [];
        await InvokeAsync(StateHasChanged);

        try
        {
            KafkaSearchPlanResult plan = await Search.PlanAsync(input, lifetime.Token);

            if (plan is KafkaSearchPlanResult.Refused refused)
            {
                refusal = refused.Text;
                return;
            }

            planned = ((KafkaSearchPlanResult.Planned) plan).Value;
            errors = planned.Plan.Errors;
            pendingContinuation = continuing;

            if (!planned.Plan.IsValid)
            {
                refusal = KafkaStudioText.PredicateInvalid;
                return;
            }

            WriteAddress(planned);

            if (planned.Plan.Estimate.NeedsConfirmation)
            {
                confirmOpen = true;
                return;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception e) when (!disposed)
        {
            Logger.LogWarning(e, "The Kafka search page failed to plan a search");
            refusal = KafkaStudioText.SearchFailed;
            return;
        }
        finally
        {
            planning = false;

            if (!disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }

        await StartRunAsync(planned, confirmed: false);
    }

    private async Task ConfirmedAsync(string _)
    {
        confirmOpen = false;
        await InvokeAsync(StateHasChanged);

        if (planned is not null)
        {
            await StartRunAsync(planned, confirmed: true);
        }
    }

    private async Task CancelledAsync()
    {
        confirmOpen = false;
        pendingContinuation = null;

        try
        {
            if (planned is not null)
            {
                await Search.NotConfirmedAsync(planned);
            }
        }
        catch (Exception e) when (!disposed && e is not OperationCanceledException)
        {
            Logger.LogWarning(e, "The Kafka search page failed to record a cancelled confirmation");
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Starts the planned search and reads its batches until it ends. Rendering never paces the reader: the engine's batcher sends at most four a second.</summary>
    private async Task StartRunAsync(KafkaSearchPlanned toStart, bool confirmed)
    {
        KafkaSearchRun? started = null;

        try
        {
            KafkaSearchStartResult start = await Search.StartAsync(toStart, confirmed, lifetime.Token);

            if (start is KafkaSearchStartResult.Refused refused)
            {
                refusal = refused.Text;
                await InvokeAsync(StateHasChanged);
                return;
            }

            started = run = ((KafkaSearchStartResult.Running) start).Run;
            running = true;
            matches.Clear();
            expanded.Clear();
            compareKeys.Clear();
            valueRefused.Clear();
            compareOpen = false;
            runGrant = toStart.Grant;
            result = null;
            progress = null;
            continuedAfter = pendingContinuation;
            pendingContinuation = null;
            pageNumber = 1;
            await InvokeAsync(StateHasChanged);

            await foreach (KafkaScanBatch batch in started.ReadBatchesAsync(lifetime.Token))
            {
                matches.AddRange(batch.NewMatches);
                progress = batch.Progress;

                if (batch.Final is { } final)
                {
                    result = final;
                    started.Complete(final);
                }

                if (disposed)
                {
                    break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The visitor left the page: the run is disposed below, which records the scan.
        }
        catch (Exception e) when (disposed && StudioLiveUpdates.IsInteropUnavailable(e))
        {
            // The tab went away while drawing: nothing left to draw to. A live page logs the failure and says so below.
        }
        catch (Exception e) when (!disposed)
        {
            Logger.LogWarning(e, "The Kafka search page failed while reading a search");
            refusal = KafkaStudioText.SearchFailed;
        }
        finally
        {
            running = false;
            run = null;

            if (started is not null)
            {
                await started.DisposeAsync();
            }
        }

        if (!disposed)
        {
            try
            {
                allowanceLeft = await Search.OwnerBytesLeftThisHourAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception e) when (e is OperationCanceledException or ObjectDisposedException || StudioLiveUpdates.IsInteropUnavailable(e))
            {
                // Gone while the line refreshed.
            }
        }
    }

    private Task StopAsync()
    {
        run?.Stop();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Writes the absolute window to the query string and <see cref="KafkaScanPlan.AuditText" /> to the fragment, so the link reopens the same search
    /// and a literal on a redacted field is already <c>&lt;redacted&gt;</c>. The page remembers what it wrote, so the change is not taken for a new address.
    /// </summary>
    private void WriteAddress(KafkaSearchPlanned toWrite)
    {
        KafkaSearchInput input = toWrite.Input;

        string uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [KafkaState.ClusterParameter] = input.Cluster.Key,
            [KafkaAddress.TopicParameter] = input.Topics.ToArray(),
            [KafkaAddress.FromParameter] = KafkaAddress.FormatWindow(input.From),
            [KafkaAddress.ToParameter] = KafkaAddress.FormatWindow(input.To),
            [KafkaAddress.IsolationParameter] = input.IncludeUncommitted ? KafkaAddress.UncommittedValue : null,
        });

        int hash = uri.IndexOf('#', StringComparison.Ordinal);
        if (hash >= 0)
        {
            uri = uri[..hash];
        }

        string audit = toWrite.Plan.AuditText;
        if (audit.Length > 0)
        {
            uri += "#" + KafkaAddress.PredicateFragmentKey + "=" + Uri.EscapeDataString(audit);
        }

        if (!string.Equals(uri, Navigation.Uri, StringComparison.Ordinal))
        {
            lastWritten = uri;
            Navigation.NavigateTo(uri, replace: true);
        }
    }

    private string ConfirmTitle() =>
        planned is null ? "Confirm" : $"Read about {KafkaDisplay.Count(planned.Plan.Estimate.Offsets, "offset")}?";

    private string ConfirmMessage() =>
        planned is null
            ? string.Empty
            : $"About {(planned.Plan.Estimate.Bytes is { } bytes ? KafkaDisplay.Bytes(bytes) : "an unknown number of bytes")} will be read from the cluster, "
              + $"which counts against your hourly allowance ({(allowanceLeft is { } left ? KafkaDisplay.Bytes(left) : "—")} left) and may cost money on a managed cluster.";

    /// <summary>
    /// What the plan says about the window before the search runs. Once a result is drawn, its "what this result does not cover" list carries the same
    /// sentences, and a caveat is drawn once: they are left out here then.
    /// </summary>
    private IReadOnlyList<string> PlanNotes(KafkaSearchPlanned shown)
    {
        IEnumerable<string> drawnBelow = result is null ? [] : KafkaSearchText.Caveats(result);

        return [.. shown.Plan.Notes.Select(static x => x.Text).Distinct(StringComparer.Ordinal).Except(drawnBelow, StringComparer.Ordinal)];
    }

    private static string EstimateText(KafkaSearchPlanned shown)
    {
        KafkaScanEstimate estimate = shown.Plan.Estimate;
        string bytes = estimate.Bytes is { } size ? ", about " + KafkaDisplay.Bytes(size) : string.Empty;

        return $"{estimate.Basis} About {KafkaDisplay.Count(estimate.Offsets, "offset")}{bytes} in {KafkaDisplay.Count(estimate.Partitions, "partition")}.";
    }

    // ------------------------------------------------------------------------------------------------
    // The results
    // ------------------------------------------------------------------------------------------------

    private void SetSort(MatchSort next)
    {
        sort = next;
        pageNumber = 1;
    }

    private IEnumerable<KafkaMatch> Sorted() => sort switch
    {
        MatchSort.Time => matches.OrderBy(static x => x.Timestamp),
        MatchSort.Position => matches.OrderBy(static x => x.Topic, StringComparer.Ordinal).ThenBy(static x => x.Partition).ThenBy(static x => x.Offset),
        _ => matches,
    };

    private IEnumerable<KafkaMatch> CurrentPage() =>
        matches.Count > PagingThreshold ? Sorted().Skip((pageNumber - 1) * PageRows).Take(PageRows) : Sorted();

    private Task OnPageAsync(int next)
    {
        pageNumber = next;
        return InvokeAsync(StateHasChanged);
    }

    private static string RowKey(KafkaMatch match) => $"{match.Topic}/{match.Partition}/{match.Offset}";

    private async Task ToggleDetailAsync(string rowKey)
    {
        if (expanded.Remove(rowKey))
        {
            return;
        }

        expanded.Add(rowKey);
        await EnsureSettingsAsync();

        // Showing a value is a view of it, recorded here and never during a render (D-PAYLOAD decision 1.4).
        KafkaMatch? shown = matches.FirstOrDefault(x => string.Equals(RowKey(x), rowKey, StringComparison.Ordinal));
        if (shown is not null)
        {
            await RecordValueViewsAsync(shown);
        }
    }

    /// <summary>Records the view of each value about to be shown; a refusal marks the record as not the visitor's to read.</summary>
    private async Task RecordValueViewsAsync(params KafkaMatch[] shown)
    {
        if (State.ActiveCluster is not { } active)
        {
            return;
        }

        foreach (KafkaMatch match in shown)
        {
            if (runGrant is not { HasPayload: true })
            {
                continue;
            }

            try
            {
                if (!await Records.RecordValueViewAsync(active, match, lifetime.Token))
                {
                    valueRefused.Add(RowKey(match));
                }
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (Exception e) when (!disposed)
            {
                Logger.LogWarning(e, "The Kafka search page failed to record a value view");
                valueRefused.Add(RowKey(match));
            }
        }
    }

    /// <summary>How a match's value reads to this visitor: the search's grant, then a refusal of the view itself.</summary>
    private KafkaValueAccess AccessOf(KafkaMatch match) =>
        valueRefused.Contains(RowKey(match))
            ? KafkaValueAccess.PolicyRefused
            : (runGrant ?? KafkaGrantDecision.EnvelopeOnly).AccessFor(match.Topic);

    private void ToggleCompare(string rowKey, bool on)
    {
        if (on && !compareKeys.Contains(rowKey, StringComparer.Ordinal) && compareKeys.Count < 2)
        {
            compareKeys.Add(rowKey);
        }
        else if (!on)
        {
            compareKeys.Remove(rowKey);
            compareOpen = false;
        }
    }

    private (KafkaMatch Left, KafkaMatch Right)? ComparedPair()
    {
        if (compareKeys.Count != 2)
        {
            return null;
        }

        KafkaMatch? left = matches.FirstOrDefault(x => string.Equals(RowKey(x), compareKeys[0], StringComparison.Ordinal));
        KafkaMatch? right = matches.FirstOrDefault(x => string.Equals(RowKey(x), compareKeys[1], StringComparison.Ordinal));

        return left is null || right is null ? null : (left, right);
    }

    private async Task OpenCompareAsync()
    {
        if (ComparedPair() is not { } pair)
        {
            return;
        }

        // Compare reads nothing; showing both values is a view of each, recorded once per record in this circuit.
        await RecordValueViewsAsync(pair.Left, pair.Right);
        compareOpen = true;
    }

    private Task CloseCompareAsync()
    {
        compareOpen = false;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Reads the cluster's settings once, for the kcat line of an opened record.</summary>
    private async Task EnsureSettingsAsync()
    {
        if (clusterSettings is not null || State.ActiveCluster is not { } active)
        {
            return;
        }

        try
        {
            clusterSettings = await Catalog.GetSettingsAsync(active, lifetime.Token);
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            Logger.LogDebug(e, "The Kafka search page could not read the cluster's settings");
        }
    }

    private string KcatFor(KafkaMatch match) => KafkaMatchView.Kcat(match.Topic, match.Partition, match.Offset, clusterSettings);

    private string RecordHref(KafkaMatch match) =>
        KafkaAddress.Href(
            Settings,
            KafkaAddress.RecordRoute,
            State.ActiveCluster?.Key,
            (KafkaAddress.TopicParameter, match.Topic),
            (KafkaAddress.PartitionParameter, match.Partition.ToString(CultureInfo.InvariantCulture)),
            (KafkaAddress.OffsetParameter, match.Offset.ToString(CultureInfo.InvariantCulture)));

    private static string TimeTitle(KafkaMatch match) =>
        match.Timestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss'Z'", CultureInfo.InvariantCulture) + " (" + match.TimestampType + ")";

    private static string KeyClass(KafkaMatch match) => match.Key.IsRedacted ? "ms-k-redacted" : match.Key.IsNull ? "ms-k-null" : string.Empty;

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        State.ClusterChanged -= OnClusterChangedAsync;
        Navigation.LocationChanged -= OnLocationChanged;

        try
        {
            await lifetime.CancelAsync();

            // The visitor left mid-scan: stop it and record it, once (the run's own flag holds if the reading loop got there first).
            if (run is { } current)
            {
                await current.DisposeAsync();
            }
        }
        finally
        {
            lifetime.Dispose();
        }
    }
}
