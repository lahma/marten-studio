@using KStudio.Services

@* What a Kafka page renders where a page-level feature is off. One neutral sentence for the visitor with no option name (#74): the property that
   turns a capability on is on Cluster settings, where an operator looks, and in the audit entry of the refusal. Same markup and classes as the
   shared CapabilityDisabled, whose capabilities are the studio's own; KStudio's are its own (D35). The service refuses regardless of what is
   rendered. *@

<div class="ms-alert ms-alert-info ms-capability-disabled" role="note" data-capability="@Capability">
    <div class="ms-alert-content">
        <p>@KafkaStudioText.CapabilityNotAvailable(string.IsNullOrWhiteSpace(Action) ? Capability : Action)</p>
    </div>
</div>

@code {
    /// <summary>The capability the hidden control would have needed, by name (<c>nameof(KafkaStudioCapabilities.SearchRecords)</c>).</summary>
    [Parameter]
    [EditorRequired]
    public string Capability { get; set; } = string.Empty;

    /// <summary>What the control would have done, in the page's own words ("Searching records"). Falls back to the capability's name.</summary>
    [Parameter]
    public string? Action { get; set; }
}
