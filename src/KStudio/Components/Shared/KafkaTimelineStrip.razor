@using System.Globalization
@using KStudio.Services

@* The time strip of the related-records page (decision 3.5 of D-CORR): one row per lane and a dot per record, placed along the window. It is
   decorative - the table below it is the accessible form - so it is hidden from assistive technology and its text summary sits beside it. *@

@if (model is { Lanes.Count: > 0 })
{
    <div class="ms-k-strip">
        <div class="ms-k-strip-lanes" aria-hidden="true">
            @for (int lane = 0; lane < model.Lanes.Count; lane++)
            {
                int index = lane;
                <div class="ms-k-strip-lane" @key="model.Lanes[index]">
                    <span class="ms-k-strip-label" title="@model.Lanes[index]">@model.Lanes[index]</span>
                    <span class="ms-k-strip-track">
                        @foreach (KafkaTimelineDot dot in model.Dots.Where(x => x.Lane == index))
                        {
                            <span class="ms-k-strip-dot@(dot.IsAnchor ? " ms-k-strip-anchor" : string.Empty)" style="left: @dot.Percent.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                        }
                    </span>
                </div>
            }
        </div>
        <p class="ms-muted ms-k-strip-summary" aria-live="polite">@model.Summary</p>
    </div>
}

@code {
    private KafkaTimelineModel? model;

    /// <summary>The strip's lanes and dots: a <c>KafkaTimelineModel</c>, typed <see cref="object" /> because the engine's types are internal and a component's parameters are public.</summary>
    [Parameter]
    public object? Model { get; set; }

    protected override void OnParametersSet() => model = Model as KafkaTimelineModel;
}
