<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DataStudio.Postgres.Diagnostics</AssemblyName>
    <RootNamespace>DataStudio.Postgres</RootNamespace>
    <PackageId>DataStudio.Postgres.Diagnostics</PackageId>
    <Title>Data Studio PostgreSQL diagnostics</Title>
    <IsPackable>true</IsPackable>
    <Product>Data Studio</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>postgresql;npgsql;database;diagnostics;health;monitoring</PackageTags>
    <Description>The PostgreSQL diagnostics engine of Data Studio, with no ASP.NET Core: the health sweep and its checks, the facts they read and IPostgresDiagnostics, for any host that registers an NpgsqlDataSource.</Description>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Selects the conditional Npgsql PackageVersion row in Directory.Packages.props (AGENTS.md D30). -->
    <DataStudioPostgresPinsNpgsql>true</DataStudioPostgresPinsNpgsql>
    <!-- Selects the conditional Microsoft.Extensions.* rows in Directory.Packages.props (0.11-C). -->
    <DataStudioDiagnosticsPinsExtensions>true</DataStudioDiagnosticsPinsExtensions>
  </PropertyGroup>

  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- No FrameworkReference: this assembly is the engine alone, and a worker or console host must not need ASP.NET Core
       to use it. PostgresFenceTests holds that at this file, the assets file and the built references. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataStudio.Postgres" />
    <InternalsVisibleTo Include="DataStudio.Marten" />
    <InternalsVisibleTo Include="DataStudio.Marten.Tests" />
    <InternalsVisibleTo Include="DataStudio.Marten.Integration.Tests" />
    <InternalsVisibleTo Include="DataStudio.Postgres.Tests" />
    <InternalsVisibleTo Include="DataStudio.Postgres.Integration.Tests" />
    <InternalsVisibleTo Include="DataStudio.Kafka.Integration.Tests" />
  </ItemGroup>

  <!--
    The package is packed at the Npgsql floor and nowhere else - the same refusal, for the same reason, as
    MartenPackOnlyAtTheMartenFloor in src/DataStudio.Marten/DataStudio.Marten.csproj. A nupkg packed after a
    restore at Npgsql 10.0.3 would say `Npgsql >= 10.0.3` and raise every host's Npgsql, every Postgres module and the Marten module
    host's included, since the Postgres module depends on exactly this package. The build's Pack target refuses
    first and names the Fallout parameter; this is the refusal for a bare `dotnet pack`.

    Two checks, because the property is not what NuGet packs from: the dependency range comes from
    project.assets.json, so a restore at the latest Npgsql (the second pass over data-studio-postgres.slnf)
    followed by a pack with no-restore would pass a property-only check. The library key "Npgsql/<floor>",
    quotes included (\x22 in the pattern), must be in that file. No assets file is a refusal, not a pass.
  -->
  <Target Name="PostgresDiagnosticsPackOnlyAtTheNpgsqlFloor" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_PostgresDiagnosticsAssetsFileExists>false</_PostgresDiagnosticsAssetsFileExists>
      <_PostgresDiagnosticsAssetsFileExists Condition="'$(ProjectAssetsFile)' != '' and Exists('$(ProjectAssetsFile)')">true</_PostgresDiagnosticsAssetsFileExists>
      <_PostgresDiagnosticsFloorLibraryKey>"Npgsql/$(DataStudioNpgsqlFloor)"</_PostgresDiagnosticsFloorLibraryKey>
      <_PostgresDiagnosticsFloorLibraryPattern>\x22Npgsql/$(DataStudioNpgsqlFloor.Replace('.', '\.'))\x22</_PostgresDiagnosticsFloorLibraryPattern>
      <_PostgresDiagnosticsAssets Condition="'$(_PostgresDiagnosticsAssetsFileExists)' == 'true'">$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)'))</_PostgresDiagnosticsAssets>
      <_PostgresDiagnosticsAssetsAtFloor>false</_PostgresDiagnosticsAssetsAtFloor>
      <_PostgresDiagnosticsAssetsAtFloor Condition="'$(_PostgresDiagnosticsAssetsFileExists)' == 'true' and $([System.Text.RegularExpressions.Regex]::IsMatch($(_PostgresDiagnosticsAssets), $(_PostgresDiagnosticsFloorLibraryPattern)))">true</_PostgresDiagnosticsAssetsAtFloor>
    </PropertyGroup>

    <Error Condition="'$(DataStudioNpgsqlVersion)' != '$(DataStudioNpgsqlFloor)'"
           Text="DataStudio.Postgres.Diagnostics is packed only at the Npgsql floor ($(DataStudioNpgsqlFloor), Directory.Packages.props), and this pack asks for Npgsql $(DataStudioNpgsqlVersion). A package packed here would depend on Npgsql &gt;= $(DataStudioNpgsqlVersion) and raise every host's Npgsql. Pack without DataStudioNpgsqlVersion, or raise DataStudioNpgsqlFloor deliberately and record why in AGENTS.md, Package budget changes." />
    <Error Condition="'$(_PostgresDiagnosticsAssetsFileExists)' != 'true'"
           Text="DataStudio.Postgres.Diagnostics is packed only at the Npgsql floor ($(DataStudioNpgsqlFloor)), and there is no restore output to prove it ('$(ProjectAssetsFile)' does not exist). NuGet writes the package's dependency range from that file, so the guard refuses rather than guess. Pack with a restore (without --no-restore) at the floor." />
    <Error Condition="'$(_PostgresDiagnosticsAssetsFileExists)' == 'true' and '$(_PostgresDiagnosticsAssetsAtFloor)' != 'true'"
           Text="DataStudio.Postgres.Diagnostics is packed only at the Npgsql floor ($(DataStudioNpgsqlFloor)), but the last restore ('$(ProjectAssetsFile)') resolved another Npgsql - it has no $(_PostgresDiagnosticsFloorLibraryKey) library. NuGet writes the package's dependency range from that file, so this pack would raise every host's Npgsql. Restore at the floor first: pack without --no-restore and without DataStudioNpgsqlVersion." />
  </Target>

</Project>
