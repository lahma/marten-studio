@using DataStudio.Postgres.Services
@using DataStudio.Postgres.Components.Shared
@implements IDisposable
@inject StudioState State
@inject DatabaseScopeAccess Access

@* The page frame is where a per-store refusal belongs: a page that is never rendered never
   runs its OnInitializedAsync, so nothing about a store the visitor may not see is read on
   their behalf. The header above stays, so they can pick one they may. The layout draws this around the body of a page of the
   database module only (IStudioModule.ScopeGate); a module's page is gated by the module's own frame, never by this one (D34). *@
@if (Access.Value is ScopeAccess.Granted)
{
    @ChildContent
}
else if (Access.Value is ScopeAccess.Denied)
{
    <ScopeNotAuthorized StoreName="@State.ActiveScope?.StoreKey" />
}
else
{
    <LoadingSpinner />
}

@code {
    private bool disposed;

    /// <summary>The page's body, drawn once the policy has admitted the visitor to the scope.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Access.Changed += OnAccessChanged;
    }

    private void OnAccessChanged()
    {
        if (disposed)
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        disposed = true;
        Access.Changed -= OnAccessChanged;
    }
}
