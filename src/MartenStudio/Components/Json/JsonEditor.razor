@using System.Text.Json
@using MartenStudio.Components.Json
@using MartenStudio.Services.Json
@implements IDisposable
@inject IJSRuntime JsRuntime

@*
    A textarea, and deliberately nothing more. CodeMirror and Monaco are both out: an embeddable Razor
    class library that fetches a megabyte of editor from a CDN, or bundles one, has changed its host's
    page - which is the single thing this project refuses to do (AGENTS.md hard rule 3, D2).

    The textarea is bound on `change`, never on `input`, and it has no `@@onkeydown` either. A Blazor
    Server circuit that handles a keystroke sends a round trip per key and re-renders the whole component
    on the way back - including the gutter, which is one div per line. That is one keystroke costing three
    thousand diffed elements on a three-thousand-line document, and it is why the two shortcuts the editor
    does answer to, Ctrl+Enter and Esc, are recognised in the browser and only cross the wire once they
    have happened - carrying the textarea's live text with them.
*@

<div class="ms-editor">
    <div class="ms-toolbar ms-editor-toolbar">
        <button type="button" class="ms-btn ms-btn-sm" @onclick="FormatAsync">Format</button>
        <button type="button" class="ms-btn ms-btn-sm" @onclick="ValidateAsync">Validate</button>
        <div class="ms-toolbar-spacer"></div>
        @if (IsDirty)
        {
            <span class="ms-pill ms-editor-dirty">unsaved changes</span>
        }
        <button type="button" class="ms-btn ms-btn-sm" @onclick="CancelAsync">Cancel</button>
        <button type="button" class="ms-btn ms-btn-sm ms-btn-primary" @onclick="SaveAsync">Save</button>
    </div>

    <div class="ms-editor-body">
        <div class="ms-editor-gutter" @ref="_gutter" aria-hidden="true">
            @for (var line = 1; line <= GutterLines; line++)
            {
                <div class="ms-editor-gutter-line" @key="line">@line</div>
            }
            @if (LineCount > GutterLines)
            {
                <div class="ms-editor-gutter-line ms-editor-gutter-more" @key="'…'">…</div>
            }
        </div>
        <textarea @ref="_textArea"
                  class="ms-editor-input"
                  rows="@Rows"
                  spellcheck="false"
                  autocapitalize="off"
                  autocomplete="off"
                  autocorrect="off"
                  aria-label="@Label"
                  aria-describedby="@_statusId"
                  value="@_text"
                  @onchange="OnChangedAsync"></textarea>
    </div>

    <div id="@_statusId" class="ms-editor-status" role="status" aria-live="polite">
        @if (_error is not null)
        {
            <div class="ms-alert ms-alert-error ms-editor-error">
                <div class="ms-editor-error-message">@_error</div>
                @if (_caretSource is not null)
                {
                    <pre class="ms-code ms-editor-caret"><code>@_caretSource
@_caretLine</code></pre>
                }
            </div>
        }
        else if (_status is { Length: > 0 })
        {
            <span class="ms-editor-ok">@_status</span>
        }
        else
        {
            <span class="ms-editor-hint">Ctrl+Enter saves, Esc cancels. jsonb does not keep member order or whitespace.</span>
        }
    </div>

    @if (_confirmingDiscard)
    {
        <div class="ms-alert ms-alert-warning ms-editor-confirm" role="alert">
            <span>Discard your changes?</span>
            <button type="button" class="ms-btn ms-btn-sm" @onclick="KeepEditingAsync">Keep editing</button>
            <button type="button" class="ms-btn ms-btn-sm ms-btn-danger" @onclick="DiscardAsync">Discard</button>
        </div>
    }
</div>

@code {
    private static readonly JsonDocumentOptions ParseOptions = new() { MaxDepth = 64 };

    private readonly string _statusId = "ms-editor-status-" + Guid.NewGuid().ToString("N")[..8];

    private DotNetObjectReference<JsonEditor>? _self;
    private ElementReference _textArea;
    private ElementReference _gutter;
    private string _text = string.Empty;
    private string _original = string.Empty;
    private string? _error;
    private string? _caretSource;
    private string? _caretLine;
    private string _status = string.Empty;
    private bool _confirmingDiscard;
    private bool _loaded;
    private string? _loadedFrom;

    /// <summary>The document to edit.</summary>
    [Parameter]
    public string? Json { get; set; }

    /// <summary>The accessible name of the textarea.</summary>
    [Parameter]
    public string Label { get; set; } = "Document JSON";

    /// <summary>How tall the textarea is, in rows.</summary>
    [Parameter]
    public int Rows { get; set; } = 18;

    /// <summary>Whether a dirty editor asks before discarding.</summary>
    [Parameter]
    public bool ConfirmDiscard { get; set; } = true;

    /// <summary>Whether Save refuses while the text is not valid JSON.</summary>
    [Parameter]
    public bool ValidateBeforeSave { get; set; } = true;

    /// <summary>The most line numbers to put in the gutter.</summary>
    /// <remarks>
    /// The gutter is one element per line and it is re-rendered whenever the component is, so an
    /// unbounded one turns a large document into thousands of diffed elements for every status message.
    /// Past the clamp the gutter ends in an ellipsis; the text itself is never clamped.
    /// </remarks>
    [Parameter]
    public int MaxLines { get; set; } = 2_000;

    /// <summary>Raised with the edited text.</summary>
    [Parameter]
    public EventCallback<string> OnSave { get; set; }

    /// <summary>Raised when the edit is abandoned.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>Raised whenever the dirty state changes, so a page can guard navigation.</summary>
    [Parameter]
    public EventCallback<bool> OnDirtyChanged { get; set; }

    /// <summary>The current text, which is what the round-trip dialog diffs.</summary>
    public string Text => _text;

    /// <summary>Whether the text differs from what was loaded.</summary>
    public bool IsDirty => !string.Equals(_text, _original, StringComparison.Ordinal);

    private int LineCount
    {
        get
        {
            var lines = 1;
            foreach (var c in _text)
            {
                if (c == '\n')
                {
                    lines++;
                }
            }

            return Math.Max(lines, Rows);
        }
    }

    private int GutterLines => Math.Min(LineCount, Math.Max(MaxLines, 1));

    protected override void OnParametersSet()
    {
        if (_loaded && ReferenceEquals(_loadedFrom, Json))
        {
            return;
        }

        _loaded = true;
        _loadedFrom = Json;
        _text = Json ?? string.Empty;
        _original = _text;
        _error = null;
        _caretSource = null;
        _caretLine = null;
        _status = string.Empty;
        _confirmingDiscard = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            // Soft tabs, a gutter that scrolls with the text, and the two keyboard shortcuts. The first
            // two are pure convenience; the shortcuts are why the reference goes across. Recognising
            // Ctrl+Enter and Esc in the browser is what keeps every *other* keystroke off the wire, and
            // the call back carries the textarea's live value, so the keyboard save can never save the
            // text as it was one round trip ago.
            _self ??= DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("martenStudio.json.enhanceTextarea", _textArea, _gutter, _self);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    /// <summary>Saves the text the browser has, sent by the Ctrl+Enter handler in the lib module.</summary>
    /// <param name="text">The textarea's live value at the moment the shortcut was pressed.</param>
    [JSInvokable]
    public async Task OnEditorSaveAsync(string? text)
    {
        _text = text ?? string.Empty;

        if (ValidateBeforeSave && !Validate())
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        await OnSave.InvokeAsync(_text);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Cancels the edit, sent by the Esc handler in the lib module.</summary>
    /// <param name="text">
    /// The textarea's live value, for the same reason the save path carries it: Esc pressed on text the
    /// <c>change</c> event has not reported yet would otherwise look like a clean editor and discard what
    /// was typed without asking.
    /// </param>
    [JSInvokable]
    public async Task OnEditorCancelAsync(string? text = null)
    {
        if (text is not null)
        {
            _text = text;
        }

        await CancelAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Releases the reference the lib module holds. Without this the component stays reachable from the
    /// JS side for the life of the circuit, which on a page that opens an editor per document is a leak
    /// with a shape - one live component per document ever edited.
    /// </summary>
    public void Dispose()
    {
        _self?.Dispose();
        _self = null;
    }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var wasDirty = IsDirty;
        _text = args.Value?.ToString() ?? string.Empty;
        _status = string.Empty;
        _error = null;
        _caretSource = null;
        _caretLine = null;

        if (wasDirty != IsDirty)
        {
            await OnDirtyChanged.InvokeAsync(IsDirty);
        }
    }

    /// <summary>
    /// Pulls the textarea's live value across before acting on it, and says whether it got one.
    /// </summary>
    /// <remarks>
    /// The binding is on <c>change</c>. Pressing a toolbar button blurs the textarea and so does fire it -
    /// but only if the browser thinks the value changed, and the order in which the two events reach the
    /// circuit is the browser's business, not ours. Reading the value back is the only way to be sure
    /// what is about to be saved is what is on screen, which is why <see cref="SaveAsync"/> refuses when
    /// this returns <see langword="false"/> rather than saving whatever it happens to be holding.
    /// </remarks>
    private async Task<bool> CommitAsync()
    {
        try
        {
            var live = await JsRuntime.InvokeAsync<string?>("martenStudio.json.readValue", new object?[] { _textArea });
            if (live is not null)
            {
                _text = live;
                return true;
            }
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        return false;
    }

    private async Task FormatAsync()
    {
        await CommitAsync();
        try
        {
            _text = JsonPrettyPrinter.PrettyPrint(_text);
            _error = null;
            _caretSource = null;
            _caretLine = null;
            _status = "Formatted.";
        }
        catch (JsonException ex)
        {
            ShowParseError(ex);
        }
    }

    private async Task ValidateAsync()
    {
        await CommitAsync();
        Validate();
    }

    private bool Validate()
    {
        try
        {
            using var document = JsonDocument.Parse(_text, ParseOptions);
            _error = null;
            _caretSource = null;
            _caretLine = null;
            _status = "Valid JSON.";
            return true;
        }
        catch (JsonException ex)
        {
            ShowParseError(ex);
            return false;
        }
    }

    /// <summary>
    /// Turns a <see cref="JsonException"/> into a line, a column and a caret under the offending
    /// character. <c>BytePositionInLine</c> is a UTF-8 byte offset, so the caret can sit a place or two
    /// off on a line with non-ASCII text - which is still far more useful than a bare message.
    /// </summary>
    private void ShowParseError(JsonException exception)
    {
        _status = string.Empty;

        var line = (int)(exception.LineNumber ?? 0);
        var column = (int)(exception.BytePositionInLine ?? 0);
        _error = "Line " + (line + 1) + ", column " + (column + 1) + ": " + exception.Message;

        var lines = _text.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        if (line < 0 || line >= lines.Length)
        {
            _caretSource = null;
            _caretLine = null;
            return;
        }

        _caretSource = lines[line];
        _caretLine = new string(' ', Math.Clamp(column, 0, _caretSource.Length)) + "^";
    }

    private async Task SaveAsync()
    {
        if (!await CommitAsync())
        {
            // Saving text that might be a round trip out of date is how an edit silently reverts a
            // character somebody typed. Refusing and saying so is the only honest answer.
            _status = string.Empty;
            _caretSource = null;
            _caretLine = null;
            _error = "The editor's current text could not be read from the browser, so nothing was saved. " +
                "Click in the document and press Save again.";
            return;
        }

        if (ValidateBeforeSave && !Validate())
        {
            return;
        }

        await OnSave.InvokeAsync(_text);
    }

    private async Task CancelAsync()
    {
        if (ConfirmDiscard && IsDirty)
        {
            _confirmingDiscard = true;
            return;
        }

        await OnCancel.InvokeAsync();
    }

    private Task KeepEditingAsync()
    {
        _confirmingDiscard = false;
        return Task.CompletedTask;
    }

    private async Task DiscardAsync()
    {
        _confirmingDiscard = false;
        _text = _original;
        _error = null;
        _caretSource = null;
        _caretLine = null;
        await OnDirtyChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }
}
