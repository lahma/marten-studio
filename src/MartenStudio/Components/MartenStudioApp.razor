@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<MartenStudioOptions> Options
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Options.Value.Title</title>
    <base href="@BaseHref" />
    @*
        Static markup in the shell's own <head>, deliberately not a <HeadContent> in the layout. The
        studio renders its whole document, so it has a <head> to write into and needs no section for
        this - and putting it in one was a real bug: the prerendered <link> lived inside the
        <HeadOutlet> marker, and the interactive HeadOutlet renders before the layout has registered
        its section content. On a page whose first load is slow (Overview waits for Marten) the outlet
        emitted an empty head, the stylesheet was removed from the live DOM and never came back, and
        the studio rendered unstyled the moment the circuit attached. HeadOutlet stays for <PageTitle>,
        which is per-page and genuinely is a section.
    *@
    <link rel="stylesheet" href="_content/MartenStudio/css/marten-studio.css" />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    @*
        No <AntiforgeryToken />, and the studio's endpoints say DisableAntiforgery().

        The studio has no <form> and no <EditForm>: every mutation is a Blazor event over the circuit,
        which SignalR's own origin check already covers. The token was therefore protecting nothing - and
        it cost the host a hard requirement, because rendering it needs the antiforgery middleware in the
        pipeline and MapRazorComponents stamps IAntiforgeryMetadata on the page endpoints, so a host that
        never called app.UseAntiforgery() answered 500 for GET /marten. "Registering the studio must never
        change host behaviour" includes not dictating the host's middleware order, so the requirement is
        dropped rather than documented. If a future screen ever grows a real form, it brings the token
        back with it - scoped to that endpoint, not to the whole studio.
    *@
    <Routes @rendermode="RenderMode.InteractiveServer" />
    @*
        Relative, so it resolves against the studio-rooted <base href> above: every mount serves its own
        copy of the framework script at {Path}/_framework/blazor.web.js.
    *@
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code
{
    /// <summary>
    /// The studio root, always: <c>{PathBase}{Path}/</c>.
    /// </summary>
    /// <remarks>
    /// Every mount is studio-rooted, the default <c>/marten</c> included, because the studio always takes
    /// its own <c>/_blazor</c>, its framework script and its asset mirror under <see
    /// cref="MartenStudioOptions.Path" /> - a second <c>/_blazor</c> at the application root is an
    /// <c>AmbiguousMatchException</c> in any host that has a Blazor app of its own. Rooting the document
    /// here is what makes every relative URL in it resolve to those copies, and it is the only prefix a
    /// path-forwarding reverse proxy is guaranteed to expose.
    /// </remarks>
    private string BaseHref
    {
        get
        {
            // Path base of the host application ("/" when none); this shell only renders during static
            // server-side rendering, where Navigation.BaseUri reflects HttpRequest.PathBase.
            string pathBase = new Uri(Navigation.BaseUri).AbsolutePath;

            MartenStudioOptions options = Options.Value;

            // The percent-encoded form keeps the browser's document.baseURI comparable to the configured
            // path (the path base from Navigation.BaseUri is already encoded).
            string baseHrefPath = pathBase.TrimEnd('/') + options.EscapedPath;

            // Server-side route matching is case-insensitive, so the request URL may carry different
            // casing than the configured path; keep the request's casing in the <base href> so the
            // document base URI stays an ordinal prefix of the browser URL (relative navigations and
            // NavigationManager.ToBaseRelativePath depend on that).
            string requestPath = new Uri(Navigation.Uri).AbsolutePath;
            if (requestPath.StartsWith(baseHrefPath, StringComparison.OrdinalIgnoreCase)
                && (requestPath.Length == baseHrefPath.Length || requestPath[baseHrefPath.Length] == '/'))
            {
                return requestPath.Substring(0, baseHrefPath.Length) + "/";
            }

            return baseHrefPath + "/";
        }
    }
}
