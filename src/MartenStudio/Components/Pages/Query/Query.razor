@using System.Globalization
@using MartenStudio.Internal.Sql
@using MartenStudio.Services.Live
@using MartenStudio.Services.Query
@using PostgresStudio.Services.Settings
@using PostgresStudio.Components
@using PostgresStudio.Components.Json
@using PostgresStudio.Components.Pages.Query
@using PostgresStudio.Components.Shared
@using PostgresStudio.Internal.Sql
@using PostgresStudio.Services
@using PostgresStudio.Services.Live
@using PostgresStudio.Services.Query
@implements IAsyncDisposable
@inject IQueryService Queries
@inject StudioState State
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject IStudioSettings Settings

@*
    Two modes, and the asymmetry between them is the design.

    A Marten `where` clause is a read against one document type the host registered: no capability needed,
    the same thing the documents list does with a search box. Because it needs no capability, the service
    holds it to being a *clause* that reads only the table it filters - no second statement, no statement of
    its own, balanced brackets, a tail the composer can place, no function that reaches outside the row, and
    without RunSql no subquery, union or join either. That is what keeps this mode from being an ungated SQL
    console (QuerySqlComposer.CheckClause), and it runs inside the same read-only transaction the console
    does. A visitor who may run SQL gets the *nested-read* rules lifted and only those, because everything
    they refuse that person could type into the console instead - where the denylist and the transaction
    still apply.

    The SQL console is arbitrary SQL against the whole database, so it is gated on RunSql, resolved with
    write-policy semantics against the database as a whole - never the tenant on screen, which nothing puts
    into a typed statement (SqlConsoleService.SqlScope) - checked by the statement guard, run inside a read-only
    transaction and audited statement by statement (D13). The README says it plainly: grant RunSql to
    people you would give psql to. It is the shared SqlConsolePanel over the shared SqlConsoleService; this page
    keeps its state (SqlConsoleSession) so a tab switch does not lose it, and owns its deep link and its drawer.

    This component is the body of the studio's shared Query page (QueryPage renders the descriptor's
    QueryComponent), so it has no @page of its own; its query parameters still come from the URL.

    LINQ mode (F7) is a third thing: a typed predicate evaluated in this process under an allow-list and
    translated by Marten's own Query<T>(), gated on RunLinqQueries. It is its own component with its own
    service (LinqQueryPanel, ILinqQueryService), so neither mode above ever resolves it.
*@

<PageTitle>Query</PageTitle>

<div class="ms-page ms-query-page">
    <div class="ms-page-header">
        <h1 class="ms-page-title">Query</h1>
    </div>

    <div class="ms-query-modes" role="tablist" aria-label="Query mode">
        <button type="button"
                role="tab"
                id="ms-query-mode-marten"
                class="ms-query-mode @(mode == QueryMode.Marten ? "ms-query-mode-active" : "")"
                aria-selected="@(mode == QueryMode.Marten ? "true" : "false")"
                @onclick="() => SwitchModeAsync(QueryMode.Marten)">
            Marten where clause
        </button>
        <button type="button"
                role="tab"
                id="ms-query-mode-sql"
                class="ms-query-mode @(mode == QueryMode.Sql ? "ms-query-mode-active" : "")"
                aria-selected="@(mode == QueryMode.Sql ? "true" : "false")"
                @onclick="() => SwitchModeAsync(QueryMode.Sql)">
            SQL console
        </button>
        <button type="button"
                role="tab"
                id="ms-query-mode-linq"
                class="ms-query-mode @(mode == QueryMode.Linq ? "ms-query-mode-active" : "")"
                aria-selected="@(mode == QueryMode.Linq ? "true" : "false")"
                @onclick="() => SwitchModeAsync(QueryMode.Linq)">
            LINQ
        </button>
    </div>

    @if (pageError is { Length: > 0 })
    {
        <ErrorAlert Message="@pageError" OnRetry="ReloadAsync" />
    }

    <div class="ms-query-layout">
        <div class="ms-query-main">
            @if (!loaded)
            {
                <LoadingSpinner />
            }
            else if (mode == QueryMode.Marten)
            {
                <div class="ms-query-mode-panel ms-query-panel-marten">
                    <div class="ms-query-toolbar">
                        <label class="ms-form-label" for="ms-query-type">Document type</label>
                        <select id="ms-query-type" class="ms-select ms-query-type" value="@alias" @onchange="OnTypeChangedAsync">
                            @foreach (QueryDocumentTypeInfo type in documentTypes)
                            {
                                <option value="@type.Alias" title="@type.FullTypeName" @key="type.Alias">
                                    @type.Alias - @type.TypeName
                                </option>
                            }
                        </select>

                        <label class="ms-form-label" for="ms-query-page-size">Rows</label>
                        <select id="ms-query-page-size" class="ms-select ms-query-page-size" value="@pageSize" @onchange="OnPageSizeChangedAsync">
                            @foreach (int size in PageSizes)
                            {
                                <option value="@size" @key="size">@size.ToString(CultureInfo.InvariantCulture)</option>
                            }
                        </select>

                        @if (SelectedType is { SoftDeleted: true })
                        {
                            <label class="ms-form-label" for="ms-query-deleted">Deleted</label>
                            <select id="ms-query-deleted" class="ms-select ms-query-deleted" value="@deletedFilter" @onchange="OnDeletedChangedAsync">
                                <option value="@nameof(DeletedFilter.Exclude)">Live only</option>
                                <option value="@nameof(DeletedFilter.Include)">Live and deleted</option>
                                <option value="@nameof(DeletedFilter.Only)">Deleted only</option>
                            </select>
                        }
                    </div>

                    <QueryEditor EditorId="ms-query-where"
                                 Label="Marten where clause"
                                 Placeholder="where data ->> 'Name' = 'Alice'"
                                 Rows="6"
                                 Value="@whereText"
                                 ValueChanged="OnWhereChangedAsync"
                                 Running="running"
                                 ElapsedMilliseconds="elapsedMilliseconds"
                                 Disabled="@(documentTypes.Count == 0)"
                                 ErrorMessage="@martenError"
                                 ErrorPosition="martenErrorPosition"
                                 Status="@status"
                                 OnRun="RunMartenAsync"
                                 OnCancel="CancelAsync"
                                 OnSave="BeginSaveAsync" />

                    <p class="ms-muted ms-query-note">
                        Your predicate is parenthesised, with the studio's own terms on both sides of it -
                        the tenant when this collection is tenanted, and <code>mt_deleted = false</code>
                        when it is soft-deleted - so a clause can narrow what you see but never widen it.
                        Your brackets have to balance, because a <code>)</code> with nothing to close would
                        close the studio's. A trailing <code>order by …</code>, <code>limit n</code> or
                        <code>offset n</code> is lifted out of the predicate and placed on the statement;
                        a <code>limit</code> of your own is clamped down to the Rows selector, never up.
                        Everything else is SQL against this one table, run inside a read-only transaction,
                        values written into the clause rather than bound.
                    </p>

                    @if (documentTypes.Count == 0)
                    {
                        <div class="ms-empty ms-query-empty">
                            <p class="ms-empty-title">No document type to query</p>
                            <p class="ms-empty-description">
                                This store registered no document type you are allowed to see. Marten learns
                                them from the host's <code>StoreOptions</code>;
                                <code>MartenStudioOptions.IsDocumentTypeVisible</code> can also be hiding them.
                            </p>
                        </div>
                    }
                    else if (martenResult is { } result)
                    {
                        <QueryStats RowCount="result.Rows.Count"
                                    DurationMilliseconds="result.Duration.TotalMilliseconds"
                                    Truncated="result.Truncated"
                                    Chips="@ScopeChips(result)"
                                    Sql="@result.GeneratedSql"
                                    SqlNote="@MartenSqlNote(result)"
                                    Plan="@result.Plan?.PlanJson"
                                    PlanUnavailable="@PlanNote(result.Plan)"
                                    Messages="@MartenMessages(result)"
                                    WhatIf="@martenWhatIf" />

                        @if (result.Succeeded)
                        {
                            <div class="ms-query-toolbar ms-query-export">
                                <button type="button" class="ms-btn ms-btn-sm" @onclick="ExportMartenJsonAsync">Export JSON</button>
                                <button type="button" class="ms-btn ms-btn-sm" @onclick="ExportMartenCsvAsync">Export CSV</button>
                            </div>

                            @if (result.Rows.Count == 0)
                            {
                                <div class="ms-empty ms-query-empty">
                                    <p class="ms-empty-title">No document matched</p>
                                    <p class="ms-empty-description">
                                        The clause ran; nothing in this collection satisfies it.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <TableScroll Label="Query results table">
                                    <table class="ms-table ms-query-marten-rows">
                                        <thead>
                                            <tr>
                                                <th scope="col">id</th>
                                                <th scope="col">document</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (MartenQueryRow row in result.Rows)
                                            {
                                                MartenQueryRow current = row;
                                                <tr class="ms-table-row" @key="current.Id">
                                                    <td class="ms-table-cell ms-table-cell-mono ms-query-row-id">
                                                        <a class="ms-details-link" href="@DocumentLink(result.Alias, current.Id)">@current.Id</a>
                                                        @if (current.TenantId is { Length: > 0 } rowTenant)
                                                        {
                                                            <span class="ms-chip ms-query-row-tenant">@rowTenant</span>
                                                        }
                                                        @if (current.IsDeleted == true)
                                                        {
                                                            <span class="ms-chip ms-chip-warning ms-query-row-deleted">deleted</span>
                                                        }
                                                    </td>
                                                    <td class="ms-table-cell ms-query-row-document">
                                                        <JsonView Json="@current.Json"
                                                                  Label="Document"
                                                                  AutoExpandDepth="1"
                                                                  ShowSearch="false"
                                                                  ShowToolbar="false"
                                                                  DownloadFileName="document.json" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </TableScroll>
                            }
                        }
                    }
                    else
                    {
                        <ExamplesPanel Title="Try one of these"
                                       Examples="@ExampleTuples(examples.Where)"
                                       OnPick="OnExamplePickedAsync" />
                    }
                </div>
            }
            else if (mode == QueryMode.Linq)
            {
                @* F7: a component of its own, with its own service, so the two modes above never resolve it. *@
                <LinqQueryPanel Alias="@linqAlias"
                                Where="@linqWhere"
                                OrderBy="@linqOrderBy"
                                OnChanged="OnLinqChangedAsync" />
            }
            else
            {
                @* The shared console: its gate, its editor, its grid. The page keeps what it shows and hears about
                   runs and saves, for the deep link and the drawer. *@
                <SqlConsolePanel Session="@sqlSession"
                                 Examples="@ExampleTuples(examples.Sql)"
                                 OnChanged="OnSqlChangedAsync"
                                 OnSave="BeginSaveAsync"
                                 OnRan="OnSqlRanAsync" />
            }
        </div>

        @if (mode != QueryMode.Linq)
        {
            <aside class="ms-query-side" aria-label="Saved and recent queries">
                <SavedQueryDrawer @ref="drawer"
                                  StoreKey="@State.ActiveScope?.StoreKey"
                                  Mode="@mode.ToString()"
                                  OnPick="OnPickedAsync" />
            </aside>
        }
    </div>
</div>

@code {
    /// <summary>The longest query text that is put into the deep link; a longer one is simply omitted.</summary>
    internal const int MaxUrlQueryLength = 4 * 1024;

    private static readonly int[] PageSizes = [25, 50, 100, 250, 500];

    private readonly CancellationTokenSource pageCts = new();

    private SavedQueryDrawer? drawer;
    private CancellationTokenSource? runCts;
    private CancellationTokenSource? tickCts;

    private QueryMode mode = QueryMode.Marten;
    private string? alias;
    private string whereText = string.Empty;
    private int pageSize;
    private DeletedFilter deletedFilter = DeletedFilter.Exclude;

    private IReadOnlyList<QueryDocumentTypeInfo> documentTypes = [];
    private QueryExamples examples = QueryExamples.None;
    private MartenQueryResult? martenResult;
    private WhatIfSource? martenWhatIf;

    /// <summary>
    /// X2: Mode A's "What if?" - the indexes its plan suggests, each planned again from the clause through the console's gate, as
    /// Mode A's plan is (<see cref="IQueryService.WhatIfAsync" />).
    /// </summary>
    private WhatIfSource MartenWhatIf(MartenQueryRequest request) => new()
    {
        RunAsync = async (index, token) =>
        {
            StudioScope? scope = State.ActiveScope;
            return scope is null
                ? WhatIfResult.NotCompared(index, "Not compared: no database is selected.")
                : await Queries.WhatIfAsync(scope, request, index, token);
        },
    };

    /// <summary>What the SQL tab shows - kept here, so leaving the tab and coming back finds it as it was.</summary>
    private readonly SqlConsoleSession sqlSession = new();

    private string? pageError;
    private string? martenError;
    private int martenErrorPosition = -1;
    private string? status;

    private bool running;
    private long elapsedMilliseconds;
    private bool loaded;

    private string? appliedMode;
    private string? appliedType;
    private string? appliedWhere;
    private string? appliedSql;
    private string? appliedPredicate;
    private string? appliedOrderBy;

    private string? linqAlias;
    private string linqWhere = string.Empty;
    private string linqOrderBy = string.Empty;

    /// <summary>The mode from the deep link: <c>marten</c>, <c>sql</c> or <c>linq</c>.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "mode")]
    public string? ModeParameter { get; set; }

    /// <summary>The document alias from the deep link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeParameter { get; set; }

    /// <summary>The where clause from the deep link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "where")]
    public string? WhereParameter { get; set; }

    /// <summary>The SQL statement from the deep link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "sql")]
    public string? SqlParameter { get; set; }

    /// <summary>The LINQ predicate from the deep link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "predicate")]
    public string? PredicateParameter { get; set; }

    /// <summary>The LINQ ordering from the deep link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "orderby")]
    public string? OrderByParameter { get; set; }

    /// <summary>
    /// The picked document type, which is what says whether this collection is tenanted or soft-deleted.
    /// </summary>
    private QueryDocumentTypeInfo? SelectedType
    {
        get
        {
            foreach (QueryDocumentTypeInfo type in documentTypes)
            {
                if (string.Equals(type.Alias, alias, StringComparison.OrdinalIgnoreCase))
                {
                    return type;
                }
            }

            return null;
        }
    }

    protected override void OnInitialized()
    {
        pageSize = Settings.DefaultPageSize;
        State.ScopeChanged += OnScopeChangedAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureInitializedAsync(pageCts.Token);
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        // Only what actually changed in the URL is applied, so pushing the deep link after a run does not
        // overwrite an editor holding text too long to travel in a query string.
        if (!string.Equals(ModeParameter, appliedMode, StringComparison.Ordinal))
        {
            appliedMode = ModeParameter;
            mode = ParseMode(ModeParameter);
        }

        if (!string.Equals(TypeParameter, appliedType, StringComparison.Ordinal))
        {
            appliedType = TypeParameter;

            if (!string.IsNullOrWhiteSpace(TypeParameter))
            {
                alias = TypeParameter;
                linqAlias = TypeParameter;
            }
        }

        if (!string.Equals(PredicateParameter, appliedPredicate, StringComparison.Ordinal))
        {
            appliedPredicate = PredicateParameter;

            if (PredicateParameter is not null)
            {
                linqWhere = PredicateParameter;
            }
        }

        if (!string.Equals(OrderByParameter, appliedOrderBy, StringComparison.Ordinal))
        {
            appliedOrderBy = OrderByParameter;

            if (OrderByParameter is not null)
            {
                linqOrderBy = OrderByParameter;
            }
        }

        if (!string.Equals(WhereParameter, appliedWhere, StringComparison.Ordinal))
        {
            appliedWhere = WhereParameter;

            if (WhereParameter is not null)
            {
                whereText = WhereParameter;
            }
        }

        if (!string.Equals(SqlParameter, appliedSql, StringComparison.Ordinal))
        {
            appliedSql = SqlParameter;

            if (SqlParameter is not null)
            {
                sqlSession.Text = SqlParameter;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        State.ScopeChanged -= OnScopeChangedAsync;

        await pageCts.CancelAsync();
        pageCts.Dispose();

        if (runCts is not null)
        {
            try
            {
                await runCts.CancelAsync();
            }
            catch (ObjectDisposedException)
            {
                // The run finished and disposed it between the check and the cancel.
            }

            runCts = null;
        }

        StopTicker();
    }

    private async Task OnScopeChangedAsync()
    {
        martenResult = null;
        sqlSession.ForgetResult();

        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync() => await LoadAsync();

    /// <summary>
    /// The document types and the examples for whatever the studio is currently pointed at. A store that
    /// cannot be reached breaks this region and nothing else (plan §4.8).
    /// </summary>
    private async Task LoadAsync()
    {
        StudioScope? scope = State.ActiveScope;

        pageError = null;
        loaded = false;

        if (scope is null)
        {
            documentTypes = [];
            examples = QueryExamples.None;
            loaded = true;
            return;
        }

        try
        {
            documentTypes = await Queries.ListDocumentTypesAsync(scope, pageCts.Token);
            examples = await Queries.BuildExamplesAsync(scope, pageCts.Token);

            bool known = false;
            foreach (QueryDocumentTypeInfo type in documentTypes)
            {
                known |= string.Equals(type.Alias, alias, StringComparison.OrdinalIgnoreCase);
            }

            if (!known && documentTypes.Count > 0)
            {
                alias = documentTypes[0].Alias;
            }
        }
        catch (OperationCanceledException)
        {
            // The circuit is going away, or the scope moved under us.
        }
        catch (StudioNotAuthorizedException)
        {
            documentTypes = [];
            examples = QueryExamples.None;
            pageError = "You are not authorized to read this store.";
        }
        catch (Exception exception)
        {
            documentTypes = [];
            examples = QueryExamples.None;
            pageError = exception.Message;
        }
        finally
        {
            loaded = true;
        }
    }

    private async Task SwitchModeAsync(QueryMode next)
    {
        if (mode == next)
        {
            return;
        }

        mode = next;

        // The where clause's status line is the page's; the console keeps its own with its result, so coming back to
        // the SQL tab finds what its last run said - "Cancelled." for a statement leaving the tab stopped.
        status = null;
        PushUrl();

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnTypeChangedAsync(ChangeEventArgs args)
    {
        alias = args.Value?.ToString();
        martenResult = null;

        // A different collection is a different question about deleted rows, and the control that answers
        // it may not even be on screen for the new type. Carrying "deleted only" across would run a query
        // nobody asked for against a table that may not be soft-deleted at all.
        deletedFilter = DeletedFilter.Exclude;

        PushUrl();

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnDeletedChangedAsync(ChangeEventArgs args)
    {
        deletedFilter = Enum.TryParse(args.Value?.ToString(), ignoreCase: true, out DeletedFilter parsed)
            ? parsed
            : DeletedFilter.Exclude;

        martenResult = null;

        await InvokeAsync(StateHasChanged);
    }

    private Task OnPageSizeChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int parsed))
        {
            pageSize = parsed;
        }

        return Task.CompletedTask;
    }

    private Task OnWhereChangedAsync(string value)
    {
        whereText = value;
        return Task.CompletedTask;
    }

    /// <summary>The console put a statement into its editor, or is about to run one: keep the deep link in step.</summary>
    private Task OnSqlChangedAsync()
    {
        PushUrl();
        return Task.CompletedTask;
    }

    /// <summary>A console statement ran without an error: it goes into the drawer's recent list.</summary>
    private async Task OnSqlRanAsync(string text)
    {
        if (drawer is not null)
        {
            await drawer.RecordRunAsync(text, null);
        }
    }

    private async Task OnExamplePickedAsync((string Snippet, string? Alias) example)
    {
        Apply(example.Snippet, example.Alias);

        PushUrl();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPickedAsync((string Text, string? Alias) picked)
    {
        Apply(picked.Text, picked.Alias);

        PushUrl();
        await InvokeAsync(StateHasChanged);
    }

    private void Apply(string text, string? pickedAlias)
    {
        if (mode == QueryMode.Marten)
        {
            whereText = text;

            if (!string.IsNullOrWhiteSpace(pickedAlias))
            {
                alias = pickedAlias;
            }
        }
        else
        {
            sqlSession.Text = text;
        }
    }

    private async Task BeginSaveAsync(string text)
    {
        if (drawer is not null)
        {
            await drawer.BeginSaveAsync(text, mode == QueryMode.Marten ? alias : null);
        }
    }

    private async Task CancelAsync()
    {
        if (runCts is null)
        {
            return;
        }

        // A real cancellation: the token is the one handed to Npgsql, so the command itself is cancelled
        // rather than the page merely forgetting about it.
        try
        {
            await runCts.CancelAsync();
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RunMartenAsync(string text)
    {
        whereText = text;
        StudioScope? scope = State.ActiveScope;

        if (scope is null || string.IsNullOrWhiteSpace(alias) || running)
        {
            return;
        }

        martenError = null;
        martenErrorPosition = -1;
        status = null;
        PushUrl();

        using CancellationTokenSource cts = StartRun();

        try
        {
            MartenQueryRequest request = new(alias, whereText, pageSize, deletedFilter);
            MartenQueryResult result = await Queries.RunMartenQueryAsync(scope, request, cts.Token);

            martenResult = result;
            martenWhatIf = MartenWhatIf(request);

            if (result.Rejection is { } rejection)
            {
                martenError = rejection.Message;
                martenErrorPosition = rejection.Position;
            }
            else if (result.Error is { } error)
            {
                martenError = Describe(error);
                martenErrorPosition = ClausePosition(error.Position, result.GeneratedSql, result.Predicate, whereText);
            }
            else
            {
                status = Summary(result.Rows.Count, result.Duration);

                if (drawer is not null)
                {
                    await drawer.RecordRunAsync(whereText, alias);
                }
            }
        }
        catch (OperationCanceledException)
        {
            status = "Cancelled.";
        }
        catch (StudioNotAuthorizedException)
        {
            martenError = "You are not authorized to read this store.";
        }
        catch (KeyNotFoundException exception)
        {
            martenError = exception.Message;
        }
        catch (Exception exception)
        {
            martenError = exception.Message;
            await Toasts.Error(exception.Message);
        }
        finally
        {
            EndRun();
            await InvokeAsync(StateHasChanged);
        }
    }

    private CancellationTokenSource StartRun()
    {
        CancellationTokenSource cts = CancellationTokenSource.CreateLinkedTokenSource(pageCts.Token);

        runCts = cts;
        running = true;
        elapsedMilliseconds = 0;

        // The ticker has a token of its own, cancelled the moment the run ends (as the SQL console's is).
        StopTicker();
        tickCts = CancellationTokenSource.CreateLinkedTokenSource(pageCts.Token);
        _ = TickAsync(tickCts.Token);

        return cts;
    }

    /// <summary>Ends the run on the renderer, stopping the ticker before the run's last render.</summary>
    private void EndRun()
    {
        running = false;
        runCts = null;
        StopTicker();
    }

    private void StopTicker()
    {
        if (tickCts is { } ticking)
        {
            tickCts = null;
            ticking.Cancel();
            ticking.Dispose();
        }
    }

    /// <summary>
    /// Keeps the "Running… N ms" label moving while a query is in flight.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A <see cref="Task" /> that is deliberately not awaited, and never an <c>async void</c>: everything
    /// it can throw is caught here, so nothing escapes to the synchronization context and kills the
    /// circuit (AGENTS.md hard rule 6).
    /// </para>
    /// <para>
    /// It never renders after the run has ended: the wait is off the renderer, and the render is asked on the
    /// renderer only while the run is still in flight - the same rule as <c>SqlConsolePanel</c>'s ticker.
    /// </para>
    /// </remarks>
    private async Task TickAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(200));
            System.Diagnostics.Stopwatch stopwatch = System.Diagnostics.Stopwatch.StartNew();

            while (await timer.WaitForNextTickAsync(cancellationToken).ConfigureAwait(false))
            {
                await InvokeAsync(() =>
                {
                    if (!running || cancellationToken.IsCancellationRequested)
                    {
                        return;
                    }

                    elapsedMilliseconds = stopwatch.ElapsedMilliseconds;
                    StateHasChanged();
                }).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
            // The circuit went away while the timer was waiting.
        }
    }

    private async Task ExportMartenJsonAsync()
    {
        if (martenResult is { } result)
        {
            await DownloadAsync("marten-query.json", "application/json", QueryExport.ToJson(result.Rows));
        }
    }

    private async Task ExportMartenCsvAsync()
    {
        if (martenResult is { } result)
        {
            await DownloadAsync("marten-query.csv", "text/csv", QueryExport.ToCsv(result.Rows));
        }
    }

    private async Task DownloadAsync(string fileName, string mime, string content)
    {
        try
        {
            await JsRuntime.InvokeAsync<bool>("martenStudio.download.text", fileName, mime, content);
        }
        catch (JSException)
        {
            // The browser answered and said no - the only one of these a person can do anything about, so
            // it is the only one that is toasted. Listed first, so the filter below never sees it.
            await Toasts.Error("This browser would not take the download.");
        }
        catch (Exception exception)
            when (StudioLiveUpdates.IsInteropUnavailable(exception) && exception is not JSException)
        {
            // The circuit went away between the click and the call. There is nobody left to toast at, and
            // JSDisconnectedException derives from Exception rather than from JSException, so it has to go
            // through the shared predicate (AGENTS.md hard rule 15) or it escapes the handler and kills
            // what is left of the circuit.
        }
    }

    private void PushUrl()
    {
        string modeValue = mode.ToString().ToLowerInvariant();
        string? typeValue = mode switch
        {
            QueryMode.Marten => NullIfBlank(alias),
            QueryMode.Linq => NullIfBlank(linqAlias),
            _ => null,
        };
        string? whereValue = mode == QueryMode.Marten ? Capped(whereText) : null;
        string? sqlValue = mode == QueryMode.Sql ? Capped(sqlSession.Text) : null;
        string? predicateValue = mode == QueryMode.Linq ? Capped(linqWhere) : null;
        string? orderByValue = mode == QueryMode.Linq ? Capped(linqOrderBy) : null;

        // Recorded before navigating, so OnParametersSet sees its own values arrive and leaves the editor
        // alone - including when the text was too long to travel and the parameter is absent.
        appliedMode = modeValue;
        appliedType = typeValue;
        appliedWhere = whereValue;
        appliedSql = sqlValue;
        appliedPredicate = predicateValue;
        appliedOrderBy = orderByValue;

        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>(StringComparer.Ordinal)
            {
                ["mode"] = modeValue,
                ["type"] = typeValue,
                ["where"] = whereValue,
                ["sql"] = sqlValue,
                ["predicate"] = predicateValue,
                ["orderby"] = orderByValue,
            }),
            replace: true);
    }

    /// <summary>The LINQ panel's type, predicate or ordering moved: keep the deep link in step.</summary>
    private Task OnLinqChangedAsync((string? Alias, string Where, string OrderBy) changed)
    {
        linqAlias = changed.Alias;
        linqWhere = changed.Where;
        linqOrderBy = changed.OrderBy;

        PushUrl();
        return Task.CompletedTask;
    }

    private static string Summary(int rows, TimeSpan duration) =>
        rows.ToString(CultureInfo.InvariantCulture) + " rows in " +
        duration.TotalMilliseconds.ToString("0.##", CultureInfo.InvariantCulture) + " ms";

    private static string? Capped(string? text) =>
        string.IsNullOrEmpty(text) || text.Length > MaxUrlQueryLength ? null : text;

    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private static QueryMode ParseMode(string? value) =>
        string.Equals(value, "sql", StringComparison.OrdinalIgnoreCase) ? QueryMode.Sql
        : string.Equals(value, "linq", StringComparison.OrdinalIgnoreCase) ? QueryMode.Linq
        : QueryMode.Marten;

    private string Describe(SqlError error)
    {
        string? headline = QuerySqlErrors.Describe(error, Settings.QueryTimeout, Settings.Text);

        return headline is null
            ? QuerySqlErrors.Summarize(error)
            : headline + " (" + QuerySqlErrors.Summarize(error) + ")";
    }

    /// <summary>
    /// Where a Postgres error in the composed statement falls in the clause the person actually typed.
    /// </summary>
    /// <remarks>
    /// Two hops, because the studio composes rather than appends. Postgres reports a one-based position
    /// into the whole statement; the visitor's predicate sits at a known offset inside it, after the select
    /// clause and the studio's own tenant and soft-delete terms; and the predicate itself sits at a known
    /// offset inside what they typed, after any <c>where</c> they wrote. Subtracting the first and adding
    /// the second puts the caret under their own character. Anything that cannot be worked out - an error
    /// in the composed part of the statement, a predicate the composer rewrote - is simply no caret, which
    /// is better than a caret pointing at the wrong thing.
    /// </remarks>
    internal static int ClausePosition(int postgresPosition, string statement, string predicate, string clause)
    {
        if (postgresPosition <= 0 || string.IsNullOrEmpty(clause) || string.IsNullOrEmpty(predicate))
        {
            return -1;
        }

        int inStatement = statement.IndexOf(predicate, StringComparison.Ordinal);
        int predicateInClause = clause.IndexOf(predicate, StringComparison.Ordinal);

        if (inStatement < 0 || predicateInClause < 0)
        {
            return -1;
        }

        int inPredicate = postgresPosition - 1 - inStatement;

        if (inPredicate < 0 || inPredicate > predicate.Length)
        {
            return -1;
        }

        int inClause = predicateInClause + inPredicate;

        return inClause <= clause.Length ? inClause : -1;
    }

    private string DocumentLink(string documentAlias, string id) =>
        StudioLink.To(Settings, "documents/" + Uri.EscapeDataString(documentAlias) + "/doc") +
        "?id=" + Uri.EscapeDataString(id);

    private static IReadOnlyList<(string Title, string Snippet, string? Alias)> ExampleTuples(
        IReadOnlyList<QueryExample> source)
    {
        List<(string Title, string Snippet, string? Alias)> tuples = new(source.Count);

        foreach (QueryExample example in source)
        {
            tuples.Add((example.Title, example.Snippet, example.Alias));
        }

        return tuples;
    }

    /// <summary>
    /// The chips beside the row count: which tenant, and what happened to soft-deleted rows.
    /// </summary>
    /// <remarks>
    /// The cross-tenant chip is a warning on purpose. Reading every tenant at once is a thing the store
    /// policy may well allow, and it is still the single most misreadable grid the studio can draw.
    /// </remarks>
    internal static IReadOnlyList<(string Text, bool Warning)> ScopeChips(MartenQueryResult result)
    {
        List<(string Text, bool Warning)> chips = [];
        MartenQueryScope scope = result.ScopeOrPlain;

        if (scope.CrossTenant)
        {
            chips.Add(("all tenants", true));
        }
        else if (scope.TenantId is { Length: > 0 } tenant)
        {
            chips.Add(("tenant " + tenant, false));
        }

        if (scope.SoftDeleted)
        {
            chips.Add(scope.Deleted switch
            {
                DeletedFilter.Only => ("deleted only", true),
                DeletedFilter.Include => ("live and deleted", true),
                _ => ("live only", false),
            });
        }

        return chips;
    }

    private static string MartenSqlNote(MartenQueryResult result)
    {
        string note = "This is the statement that ran, character for character - the studio composes it " +
            "rather than handing the clause to Marten, which composes neither the tenant nor the " +
            "soft-delete predicate for a string query. The plan below is for this same statement.";

        if (result.Parameters.Count > 0)
        {
            note += " Bound: " + string.Join(", ", result.Parameters) + ".";
        }

        if (!result.LimitApplied)
        {
            note += " The row cap is the limit your clause carried, clamped to the Rows selector.";
        }

        return note;
    }

    private static string? PlanNote(ExplainResult? plan)
    {
        if (plan is null)
        {
            return "No plan was fetched for this query.";
        }

        if (plan.Error is { } error)
        {
            return "The plan could not be fetched: " + QuerySqlErrors.Summarize(error);
        }

        return plan.UnavailableReason;
    }

    private static IReadOnlyList<string> MartenMessages(MartenQueryResult result)
    {
        List<string> messages = [];
        MartenQueryScope scope = result.ScopeOrPlain;

        if (scope.CrossTenant)
        {
            messages.Add(
                "This collection is tenanted and no tenant is selected, so these rows come from every " +
                "tenant. Pick one in the scope selector to filter them.");
        }

        if (scope.SoftDeleted && scope.Deleted != DeletedFilter.Exclude)
        {
            messages.Add(scope.Deleted == DeletedFilter.Only
                ? "Only soft-deleted documents are shown."
                : "Soft-deleted documents are included; each one carries a 'deleted' chip.");
        }

        if (result.Rejection is { } rejection)
        {
            messages.Add(rejection.Message);
        }

        if (result.Error is { } error)
        {
            messages.Add(QuerySqlErrors.Summarize(error));
        }

        if (result.Plan?.UnavailableReason is { Length: > 0 } reason)
        {
            messages.Add(reason);
        }

        return messages;
    }
}
