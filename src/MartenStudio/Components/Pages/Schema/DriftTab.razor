@using MartenStudio.Services.Schema
@implements IDisposable
@inject ISchemaDataService SchemaData
@inject StudioState State
@inject StudioCapabilityGuard Capabilities
@inject StudioAuthorization Authorization
@inject ToastService Toasts

@*
    Nothing here runs on navigation, and the reason is stronger than "it is slow".

    Both buttons reach Weasel through IMartenDatabase, which builds every feature schema in the store to
    get there - and Marten's feature list includes the lazy HiLo Sequences feature, whose initialiser
    applies a migration under the database's own AutoCreate. So asking either question can create
    Marten's own bookkeeping objects (mt_hilo, mt_get_next_hi) in a schema that did not have them. That
    is a fine thing to do on purpose and an indefensible thing to do because somebody opened a tab, so
    the tab arrives with two buttons that say what pressing them may do (packet P7-fix, finding B1).
*@

<div class="ms-schema-toolbar">
    <span class="ms-drift-badge @BadgeClass">@check.BadgeText</span>
    <button type="button" class="ms-button ms-button-primary" disabled="@busy" @onclick="CheckAsync">
        Check schema
    </button>
    <button type="button" class="ms-button" disabled="@busy" @onclick="PreviewAsync">
        Preview migration
    </button>
    <span class="ms-schema-toolbar-spacer"></span>
    @if (busy)
    {
        <span class="ms-schema-progress">
            <span class="ms-spinner ms-spinner-sm"></span>
            <span>@progress</span>
        </span>
    }
</div>

@if (error is { Length: > 0 })
{
    <ErrorAlert Message="@error" OnRetry="CheckAsync" />
}

@if (check.Status is SchemaCheckStatus.NotChecked && !previewed)
{
    <div class="ms-empty">
        <p class="ms-empty-title">Not checked yet</p>
        <p class="ms-empty-description">
            <strong>Check schema</strong> asks Marten whether this database matches its configuration
            (<code>AssertDatabaseMatchesConfigurationAsync</code>) and lists the objects that differ.
            <strong>Preview migration</strong> renders the SQL that would bring it into line, without
            running any of it.
        </p>
        <p class="ms-empty-description ms-schema-caution">
            Both ask Marten to build its feature schemas, and that step can create Marten's own
            bookkeeping objects - the HiLo sequence table <code>mt_hilo</code> and
            <code>mt_get_next_hi</code> - in a schema that does not have them yet. Neither applies
            anything else, and nothing on this page runs until you press a button.
        </p>
    </div>
}

@if (check.Status is not SchemaCheckStatus.NotChecked)
{
    <div class="ms-kv">
        <div class="ms-kv-row">
            <span class="ms-kv-key">Verdict</span>
            <span class="ms-kv-value">@check.BadgeText</span>
        </div>
        @if (check.Schemas.Count > 0)
        {
            <div class="ms-kv-row">
                <span class="ms-kv-key">Schemas</span>
                <span class="ms-kv-value ms-mono">@string.Join(", ", check.Schemas)</span>
            </div>
        }
        @if (check.AssertionMessage is { Length: > 0 } assertion)
        {
            <div class="ms-kv-row">
                <span class="ms-kv-key">Marten says</span>
                <span class="ms-kv-value">@assertion</span>
            </div>
        }
        @if (check.Reason is { Length: > 0 } reason)
        {
            <div class="ms-kv-row">
                <span class="ms-kv-key">Could not report</span>
                <span class="ms-kv-value">@reason</span>
            </div>
        }
    </div>

    @if (check.Objects.Count > 0)
    {
        <table class="ms-table">
            <thead>
                <tr>
                    <th>Object</th>
                    <th>Kind</th>
                    <th>Difference</th>
                </tr>
            </thead>
            <tbody>
                @foreach (SchemaObjectDifference difference in check.Objects)
                {
                    <tr class="ms-table-row" @key="difference.Name">
                        <td class="ms-table-cell ms-table-cell-mono">@difference.Name</td>
                        <td class="ms-table-cell">@difference.Kind</td>
                        <td class="ms-table-cell">@difference.Difference</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (previewed)
{
    <h2 class="ms-section-title">Migration preview</h2>
    <MigrationPreviewPanel Sql="@preview.Sql"
                           ObjectCount="@preview.ObjectCount"
                           Notice="@preview.Notice"
                           FileName="@FileName" />

    @if (preview.Deltas.Count > 0)
    {
        <table class="ms-table">
            <thead>
                <tr>
                    <th>Object</th>
                    <th>Kind</th>
                    <th>Difference</th>
                </tr>
            </thead>
            <tbody>
                @foreach (SchemaObjectDifference delta in preview.Deltas)
                {
                    <tr class="ms-table-row" @key="delta.Name">
                        <td class="ms-table-cell ms-table-cell-mono">@delta.Name</td>
                        <td class="ms-table-cell">@delta.Kind</td>
                        <td class="ms-table-cell">@delta.Difference</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<h2 class="ms-section-title">Apply</h2>

@if (!Capabilities.IsEnabled(StudioCapability.ApplySchemaChanges))
{
    <CapabilityDisabled Capability="@nameof(StudioCapability.ApplySchemaChanges)" Action="Applying schema changes" />
}
else
{
    <p class="ms-schema-note">
        Applying runs Marten's own migration for <strong>this database only</strong>, with
        <code>AutoCreate.CreateOrUpdate</code> - the same mode the preview above was rendered with, so what
        runs is what you read. It never uses <code>AutoCreate.All</code>, which would drop and recreate
        every object Marten manages. The SQL is written to the audit log under event id 9206.
    </p>

    <p class="ms-schema-note ms-schema-caution">
        <strong><code>CreateOrUpdate</code> is not additive.</strong> It can
        <strong>drop an index or a column</strong> that exists on a Marten table and is not in
        <code>StoreOptions</code>, <strong>change a column's type</strong>, <strong>drop and recreate a
        changed primary key</strong> with <code>CASCADE</code>, and <strong>rebuild a repartitioned
        table</strong> by copying it out and back. Read the SQL above; the preview is the whole of what
        runs. To keep an index the configuration does not declare, name it in
        <code>opts.Schema.For&lt;T&gt;().IgnoreIndex("...")</code> - or
        <code>opts.Events.IgnoreIndex("...")</code> on an event table.
    </p>

    @if (preview.IsDestructive)
    {
        <div class="ms-alert ms-alert-error ms-schema-destructive" role="alert">
            <div class="ms-alert-content">
                <p><strong>This migration removes or rewrites objects.</strong> @MigrationRisk.Warning</p>
                @* Keyed on the ordinal: nothing guarantees two destructive statements differ as text,
                   and this is the one list that must never fail to render - it is what somebody reads
                   before typing the confirmation. *@
                <ul class="ms-destructive-list">
                    @for (int ordinal = 0; ordinal < preview.DestructiveStatements.Count; ordinal++)
                    {
                        DestructiveStatement statement = preview.DestructiveStatements[ordinal];

                        <li @key="ordinal">
                            <span class="ms-destructive-kind">@statement.Kind</span>
                            <code class="ms-destructive-statement">@statement.Statement</code>
                        </li>
                    }
                </ul>
                <label class="ms-destructive-ack">
                    <input type="checkbox"
                           checked="@acknowledged"
                           @onchange="OnAcknowledgedAsync" />
                    <span>
                        I have read the @preview.DestructiveStatements.Count statement(s) above and accept
                        that applying this removes or rewrites them.
                    </span>
                </label>
            </div>
        </div>
    }

    @* Disabled and not hidden for a visitor the write policy refuses: "this studio can apply schema
       changes and your account may not" is a different fact from "this studio cannot apply schema
       changes". ISchemaDataService refuses regardless (AGENTS.md hard rule 5). *@
    <button type="button"
            class="ms-button ms-button-danger ms-schema-apply"
            disabled="@(busy || !preview.HasSql || !Acknowledged || !mayApply)"
            title="@ApplyTitle"
            @onclick="OpenApplyAsync">
        Apply @(preview.HasSql ? preview.ObjectCount.ToString(System.Globalization.CultureInfo.InvariantCulture) + " change(s)" : "changes")
    </button>

    <WriteRefusal Refused="!mayApply" Capability="@nameof(StudioCapability.ApplySchemaChanges)" />

    @if (!preview.HasSql)
    {
        <p class="ms-schema-note">Preview the migration first; there is nothing to apply until there is.</p>
    }

    @if (applyResult is { } result)
    {
        <div class="ms-alert @(result.Succeeded ? "ms-alert-success" : "ms-alert-error")" role="status">
            <div class="ms-alert-content">
                <p>@result.Message</p>
                @if (result.IsInsufficientPrivilege)
                {
                    <p class="ms-muted">
                        PostgreSQL refused this with <code>42501</code>, which means the role this
                        application connects as may not change the schema. Grant that role rights on the
                        schema, or run the migration from a deployment step that connects as an owner -
                        nothing about Marten Studio's own configuration will change this.
                    </p>
                }
            </div>
        </div>
    }
}

<ConfirmDialog IsOpen="@applyOpen"
               Title="Apply schema changes"
               Message="@ConfirmMessage"
               ConfirmationPhrase="@databaseIdentity"
               OnConfirm="ApplyAsync"
               OnCancel="CancelApply" />

@code {
    private readonly CancellationTokenSource lifetime = new();

    private SchemaCheck check = SchemaCheck.NotChecked;
    private MigrationPreview preview = MigrationPreview.None;
    private SchemaApplyResult? applyResult;
    private string? error;
    private string progress = string.Empty;
    private string databaseIdentity = string.Empty;
    private bool previewed;
    private bool busy;
    private bool applyOpen;
    private bool acknowledged;

    /// <summary>
    /// Whether the destructive-statement block has been ticked, when there is one.
    /// </summary>
    /// <remarks>
    /// A migration that only creates things needs no acknowledgement - making people tick a box for the
    /// harmless case is how a box stops being read.
    /// </remarks>
    private bool Acknowledged => !preview.IsDestructive || acknowledged;

    /// <summary>
    /// Whether <see cref="MartenStudioOptions.WriteAuthorizationPolicy" /> lets <em>this</em> visitor
    /// apply a migration to the database on screen.
    /// </summary>
    /// <remarks>
    /// Asked once, when this tab is first rendered, and never memoised: the answer is about this
    /// circuit's user. It defaults to <see langword="true" /> because the common case is a host that
    /// configured no write policy at all, and fail-open is safe because this is not the enforcement -
    /// <c>ISchemaDataService.ApplyAsync</c> resolves the scope with the same capability and throws
    /// (AGENTS.md hard rule 5).
    /// </remarks>
    private bool mayApply = true;

    private string ApplyTitle => mayApply
        ? "Runs the previewed migration against this database"
        : WritePolicyRefusal.For(StudioCapability.ApplySchemaChanges);

    protected override async Task OnInitializedAsync()
    {
        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            return;
        }

        try
        {
            mayApply = await Authorization.IsAuthorizedAsync(
                scope,
                StudioCapability.ApplySchemaChanges,
                lifetime.Token);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private string BadgeClass => check.Status switch
    {
        SchemaCheckStatus.Matches => "ms-drift-badge-ok",
        SchemaCheckStatus.Differences => "ms-drift-badge-warn",
        _ => "ms-drift-badge-unknown",
    };

    private string FileName => "marten-migration-" + Sanitize(databaseIdentity) + ".sql";

    private string ConfirmMessage
    {
        get
        {
            string message =
                $"This runs {preview.ObjectCount} schema change(s) against {databaseIdentity}. " +
                "It cannot be undone from here.";

            return preview.IsDestructive
                ? message + $" {preview.DestructiveStatements.Count} of its statements remove or rewrite " +
                  "an object: " + string.Join(", ", MigrationRisk.KindsIn(preview.Sql)) + "."
                : message;
        }
    }

    private async Task CheckAsync()
    {
        await RunAsync("Reading the catalog...", async token =>
        {
            StudioScope? scope = State.ActiveScope;
            if (scope is null)
            {
                return;
            }

            check = await SchemaData.CheckAsync(scope, token);
            databaseIdentity = await SchemaData.DatabaseIdentityAsync(scope, token);
        });
    }

    private async Task PreviewAsync()
    {
        await RunAsync("Building the migration...", async token =>
        {
            StudioScope? scope = State.ActiveScope;
            if (scope is null)
            {
                return;
            }

            preview = await SchemaData.PreviewAsync(scope, token);
            databaseIdentity = await SchemaData.DatabaseIdentityAsync(scope, token);
            previewed = true;

            // A fresh preview is a fresh decision: an acknowledgement carried over from a script the
            // visitor is no longer looking at would be an acknowledgement of nothing.
            acknowledged = false;
        });
    }

    private Task OnAcknowledgedAsync(ChangeEventArgs args)
    {
        acknowledged = args.Value is true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OpenApplyAsync()
    {
        if (string.IsNullOrEmpty(databaseIdentity))
        {
            StudioScope? scope = State.ActiveScope;
            if (scope is not null)
            {
                databaseIdentity = await SchemaData.DatabaseIdentityAsync(scope, lifetime.Token);
            }
        }

        applyOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task CancelApply()
    {
        applyOpen = false;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Applies the migration, with <paramref name="typed" /> being what the visitor wrote in the dialog.
    /// </summary>
    /// <remarks>
    /// The dialog hands the typed string out rather than the page handing its own copy of the identity
    /// in. Passing <c>databaseIdentity</c> here would mean the service's second check compared the
    /// server's own value against itself, which proves nothing about what anybody typed.
    /// </remarks>
    private async Task ApplyAsync(string typed)
    {
        applyOpen = false;

        await RunAsync("Applying...", async token =>
        {
            StudioScope? scope = State.ActiveScope;
            if (scope is null)
            {
                return;
            }

            applyResult = await SchemaData.ApplyAsync(scope, typed, token);

            if (applyResult.Succeeded)
            {
                await Toasts.Success(applyResult.Message);

                // The database has moved, so the two things on screen that described the old one are now
                // wrong. Re-checking is cheaper than leaving a stale "3 differences" badge up.
                check = await SchemaData.CheckAsync(scope, token);
                preview = await SchemaData.PreviewAsync(scope, token);
                acknowledged = false;
            }
            else
            {
                await Toasts.Error(applyResult.Message);
            }
        });
    }

    /// <summary>
    /// Runs one action with the progress line up and every failure on screen.
    /// </summary>
    /// <remarks>
    /// The capability and authorization refusals are caught by name, because their messages are the
    /// whole point: one names the option a host would set, the other deliberately says nothing about
    /// which store, database or tenant was refused.
    /// </remarks>
    private async Task RunAsync(string message, Func<CancellationToken, Task> action)
    {
        busy = true;
        progress = message;
        error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await action(lifetime.Token);
        }
        catch (OperationCanceledException)
        {
            // The circuit is going away; there is nobody to tell.
        }
        catch (StudioCapabilityDeniedException denied)
        {
            error = denied.Message;
        }
        catch (StudioNotAuthorizedException notAuthorized)
        {
            error = notAuthorized.Message;
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
            progress = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string Sanitize(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "database";
        }

        Span<char> buffer = stackalloc char[value.Length];
        for (int i = 0; i < value.Length; i++)
        {
            char c = value[i];
            buffer[i] = char.IsLetterOrDigit(c) || c is '-' or '_' ? c : '-';
        }

        return new string(buffer);
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
