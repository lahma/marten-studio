@using MartenStudio.Services.Database
@using MartenStudio.Services.Schema
@implements IDisposable
@inject ISchemaDataService SchemaData
@inject StudioState State

@*
    Every ordinary and partitioned table in the schemas this store owns, largest first, joined to what the
    statistics collector has recorded - and whose each one is, by the database browser's own rules
    (DatabaseObjectClassifier, AGENTS.md D27). A document table is linked to its collection and the event
    store's tables to Streams, which is the whole reason this screen beats \dt+; somebody else's table in
    the same schema - a Quartz.NET job store in the event schema, say - is "not Marten", with the browser's
    "recognised by name" hint, rather than the "event store" it used to be badged for living there.

    A partition is never a row: Marten names a tenant's partition after the tenant, so the list would be
    the tenant list. Its figures are added into its parent's, and how many partitions there are is shown
    only past the database browser's gate, because that number is the number of tenants - and so are the
    row figures of Marten's tenancy tables (mt_tenant_partitions, mt_tenant_databases), one row per tenant.
    The service decides both; this only draws them. A hidden document type's table is not here at all.

    A table with pgvector columns names each under its own name with its type and dimensions -
    "embedding vector(1536)" - from the catalog alone: the vector extension owns the type, and the dimensions are
    its type modifier, so no value is read to learn them.

    Two states are not errors and are drawn as such. A registered store that cannot be read withholds the
    tables it could own, with a notice naming it, rather than blanking the tab (SchemaClassification). And a
    read that gave up behind somebody's lock after three seconds says so, with a retry (SchemaTables.Busy).
*@

@if (!loading && tables.ClassificationNotice is { Length: > 0 } notice)
{
    <div class="ms-alert ms-alert-warning ms-schema-degraded" role="status">
        <div class="ms-alert-content">
            <p>@notice</p>
        </div>
    </div>
}

@if (loading)
{
    <LoadingSpinner />
}
else if (tables.Reason is { Length: > 0 } reason)
{
    <ErrorAlert Message="@reason" OnRetry="LoadAsync" RetryText="@(tables.Busy ? "Try again" : "Retry")" />
}
else if (tables.Tables.Count == 0)
{
    <div class="ms-empty">
        <p class="ms-empty-title">No tables</p>
        <p class="ms-empty-description">
            Nothing has been created yet in @(tables.Schemas.Count == 0 ? "this store's schemas" : string.Join(", ", tables.Schemas)).
            The Drift tab will show what Marten would create.
        </p>
    </div>
}
else
{
    <div class="ms-schema-summary">
        <span><strong>@tables.Tables.Count</strong> tables</span>
        <span><strong>@SchemaFormat.Bytes(TotalBytes)</strong> in this store's schemas</span>
        <span><strong>@SchemaFormat.Bytes(tables.DatabaseBytes)</strong> in the whole database</span>
        <span class="ms-mono">@string.Join(", ", tables.Schemas)</span>
    </div>

    <p class="ms-schema-note">
        Row counts are <code>pg_class.reltuples</code> estimates (D8) and the scan counters come from
        <code>pg_stat_user_tables</code>, which <code>pg_stat_reset()</code> and a crash both zero. Owners
        are the database browser's: a table this store does not declare is "not Marten", wherever it lives.
    </p>

    <p class="ms-schema-note ms-schema-health-note">
        <strong>Dead %</strong> is dead rows among live and dead, which only vacuum makes reusable;
        <strong>HOT %</strong> is the share of updates since the counters began that stayed on their page and
        touched no index. <strong>Storage parameters</strong> are the table's <code>reloptions</code>@StorageParameterNote
    </p>

    @if (HasPartitionedTable || HasWithheldFigures)
    {
        <p class="ms-schema-note ms-schema-partition-note">
            @if (HasPartitionedTable)
            {
                <text>
                    A partitioned table is one row. Its partitions are never listed - a per-tenant partition is
                    named after its tenant - and their sizes, row estimates and counters are added into it, the
                    sizes from the catalog's page counts, which <code>VACUUM</code> and <code>ANALYZE</code> refresh.
                </text>
            }
            @if (tables.PartitionCountsWithheld is { Length: > 0 } withheld)
            {
                @(" " + withheld)
            }
        </p>
    }

    <TableScroll Label="Schema tables table">
        <table class="ms-table">
            <thead>
                <tr>
                    <th>Table</th>
                    <th>Owner</th>
                    <th class="ms-num">Total</th>
                    <th class="ms-num">Heap</th>
                    <th class="ms-num">TOAST</th>
                    <th class="ms-num">Indexes</th>
                    <th class="ms-num">Rows</th>
                    <th class="ms-num">Live</th>
                    <th class="ms-num">Dead</th>
                    <th class="ms-num">Dead %</th>
                    <th class="ms-num">HOT %</th>
                    <th class="ms-num">Seq scans</th>
                    <th class="ms-num">Index scans</th>
                    <th>Last vacuum</th>
                    <th>Last autovacuum</th>
                    <th>Last analyze</th>
                    <th>Storage parameters</th>
                </tr>
            </thead>
            <tbody>
                @foreach (TableStats table in tables.Tables)
                {
                    <tr class="ms-table-row" @key="table.QualifiedName">
                        <td class="ms-table-cell ms-table-cell-mono">
                            <a class="ms-schema-object-link"
                               href="@ObjectLink(table.Schema, table.Table)"
                               title="Open @table.QualifiedName in the database browser">@table.QualifiedName</a>
                            @if (table.IsPartitioned)
                            {
                                <span class="ms-index-flag ms-schema-partitions"
                                      title="Its partitions' figures are added into this row; their names are never listed.">@PartitionLabel(table)</span>
                            }
                            @if (table.VectorColumns.Count > 0)
                            {
                                <span class="ms-schema-vectors">
                                    @foreach (TableVectorColumn column in table.VectorColumns)
                                    {
                                        <span class="ms-index-flag ms-index-flag-info ms-vector-badge" title="@column.Type.Description" @key="column.Name">@column.Text</span>
                                    }
                                </span>
                            }
                        </td>
                        <td class="ms-table-cell">
                            <span class="ms-schema-owner" data-owner="@table.Ownership.Owner">
                                @switch (table.Ownership.Owner)
                                {
                                    case DatabaseObjectOwner.MartenDocument when table.CollectionAlias is { Length: > 0 } alias:
                                        <a class="ms-collection-link"
                                           href="@CollectionLink(alias)"
                                           title="@DocumentTitle(table)">@alias</a>
                                        break;

                                    case DatabaseObjectOwner.MartenDocument:
                                        <span class="ms-index-flag ms-index-flag-info"
                                              title="A document collection another registered Marten store declares.">document collection</span>
                                        break;

                                    case DatabaseObjectOwner.MartenEventStore when table.OwnedByThisStore:
                                        <a class="ms-index-flag ms-index-flag-info"
                                           href="@StreamsLink"
                                           title="One of the event store's own tables. Its rows are read in Streams, the Feed and Projections.">event store</a>
                                        break;

                                    case DatabaseObjectOwner.MartenEventStore:
                                        <span class="ms-index-flag ms-index-flag-info"
                                              title="One of the event store's own tables, in another registered Marten store.">event store</span>
                                        break;

                                    case DatabaseObjectOwner.MartenProjectionOrExtended:
                                        <span class="ms-index-flag ms-index-flag-info"
                                              title="@ManagedTitle">Marten-managed</span>
                                        break;

                                    case DatabaseObjectOwner.MartenInfrastructure:
                                        <span class="ms-index-flag"
                                              title="@InfrastructureTitle">Marten infrastructure</span>
                                        break;

                                    default:
                                        <span class="ms-index-flag ms-schema-owner-other"
                                              title="This store's configuration does not declare it, and neither does any other registered Marten store.">not Marten</span>
                                        @if (table.Ownership.RecognisedAs is { Length: > 0 } hint)
                                        {
                                            <span class="ms-schema-hint"
                                                  title="A guess from the name, and nothing more: nothing about the table is read to make it.">@hint, recognised by name</span>
                                        }
                                        break;
                                }
                            </span>
                        </td>
                        <td class="ms-table-cell ms-num">@SchemaFormat.Bytes(table.TotalBytes)</td>
                        <td class="ms-table-cell ms-num">@SchemaFormat.Bytes(table.HeapBytes)</td>
                        <td class="ms-table-cell ms-num ms-schema-toast">@SchemaFormat.Bytes(table.ToastBytes)</td>
                        <td class="ms-table-cell ms-num">@SchemaFormat.Bytes(table.IndexBytes)</td>
                        @if (table.FiguresWithheld)
                        {
                            for (int withheldCell = 0; withheldCell < WithheldFigureColumns; withheldCell++)
                            {
                                <td class="ms-table-cell ms-num ms-schema-withheld" title="@WithheldFigureTitle">withheld</td>
                            }
                        }
                        else
                        {
                            <td class="ms-table-cell ms-num ms-schema-estimate">@SchemaFormat.Estimate(table.EstimatedRows)</td>
                            <td class="ms-table-cell ms-num">@SchemaFormat.Count(table.LiveRows)</td>
                            <td class="ms-table-cell ms-num">@SchemaFormat.Count(table.DeadRows)</td>
                            <td class="@DeadClass(table)">@Share(table.DeadShare)</td>
                            <td class="@HotClass(table)" title="@HotTitle(table)">@Share(table.HotShare)</td>
                            <td class="ms-table-cell ms-num">@SchemaFormat.Count(table.SequentialScans)</td>
                            <td class="ms-table-cell ms-num">@SchemaFormat.Count(table.IndexScans)</td>
                        }
                        <td class="ms-table-cell ms-table-cell-mono">@State.FormatInSelectedTimeZone(table.LastVacuum)</td>
                        <td class="ms-table-cell ms-table-cell-mono ms-schema-autovacuum">@State.FormatInSelectedTimeZone(table.LastAutovacuum)</td>
                        <td class="ms-table-cell ms-table-cell-mono">@State.FormatInSelectedTimeZone(table.LastAnalyze)</td>
                        <td class="ms-table-cell ms-schema-parameters">
                            @if (table.StorageParameters.Count == 0)
                            {
                                <span class="ms-schema-parameters-none">none</span>
                            }
                            @foreach (StorageParameterState parameter in table.StorageParameters)
                            {
                                <span class="@ParameterClass(parameter)" data-status="@parameter.Status" title="@ParameterTitle(parameter)" @key="parameter.Name">@ParameterText(parameter)</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </TableScroll>
}

@code {
    private const string ManagedTitle =
        "Marten migrates it on the application's behalf - a flat-table projection's table, an " +
        "EventProjection's table, or one of StoreOptions.Storage.ExtendedSchemaObjects - and its rows are the " +
        "application's own relational data.";

    private const string WithheldFigureTitle =
        "One of Marten's tenancy tables holds a row per tenant, so its row figures are the number of tenants - " +
        "shown only past the database browser's gate, like a partition count.";

    private const string InfrastructureTitle =
        "Marten's own bookkeeping (every mt_ table that is not a registered document or event table: " +
        "mt_hilo, the tenancy tables, a table no registered type declares any more).";

    /// <summary>The row figures a tenancy registry table withholds: rows, live, dead, dead %, HOT %, and both scan counters.</summary>
    private const int WithheldFigureColumns = 7;

    /// <summary>The dead share T07 speaks above, so the tab marks what the advisor would.</summary>
    private const double DeadShareWorth = MartenStudio.Services.Health.Checks.VacuumBehindCheck.MaxDeadShare;

    /// <summary>The HOT share T06 speaks below.</summary>
    private const double HotShareWorth = MartenStudio.Services.Health.Checks.HotUpdateCheck.MinHotShare;

    private readonly CancellationTokenSource lifetime = new();

    private SchemaTables tables = SchemaTables.Empty;
    private bool loading = true;

    /// <summary>
    /// The end of the note's sentence about storage parameters: compared with the declarations on a Marten that
    /// can declare them, shown as they are on one that cannot.
    /// </summary>
    /// <remarks>
    /// Decided by the host's Marten (the probe), not by the rows: a page of tables none of which is a document
    /// table of this store says nothing about whether the mappings could declare parameters.
    /// </remarks>
    private static string StorageParameterNote =>
        MartenStudio.Services.Configuration.RuntimeFeature.DeclaredStorageParameters.IsAvailable(
            MartenStudio.Services.Configuration.MartenRuntime.Current)
            ? ", each beside what a document mapping declares: a declared one the table differs from is drift, which the " +
              "next apply sets; one set outside Marten is left alone by Marten's delta - unless an apply rebuilds the table, " +
              "as a changed partition scheme does - because Marten manages only the storage parameters a mapping declares. " +
              "A partitioned table has none of its own: its partitions' are shown where they all agree."
            : ", as they are. A mapping can declare them (FillFactor, StorageParameter) from Marten 9.47, and this host runs " +
              MartenStudio.Services.Configuration.MartenRuntime.Current.Describe(MartenStudio.Services.Configuration.RuntimePackage.Marten) +
              ", so there is nothing to compare them with.";

    private static string Share(double? share) =>
        share is { } value
            ? (value * 100).ToString(value < 0.1 ? "0.0" : "0", System.Globalization.CultureInfo.InvariantCulture) + "%"
            : "n/a";

    /// <summary>The dead-share cell, marked past T07's share and its minimum of dead rows.</summary>
    private static string DeadClass(TableStats table) =>
        "ms-table-cell ms-num ms-schema-dead" +
        (table.DeadShare > DeadShareWorth && table.DeadRows >= MartenStudio.Services.Health.Checks.VacuumBehindCheck.MinDeadRows
            ? " ms-schema-share-high"
            : string.Empty);

    /// <summary>The HOT-share cell, marked below T06's share once the table has had T06's minimum of updates.</summary>
    private static string HotClass(TableStats table) =>
        "ms-table-cell ms-num ms-schema-hot" +
        (table.HotShare < HotShareWorth && table.Updates >= MartenStudio.Services.Health.Checks.HotUpdateCheck.MinUpdates
            ? " ms-schema-share-high"
            : string.Empty);

    private static string HotTitle(TableStats table) =>
        table.Updates is { } updates
            ? (table.HotUpdates ?? 0).ToString("N0", System.Globalization.CultureInfo.InvariantCulture) + " of " +
              updates.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) +
              " updates since the counters began were HOT updates. The Health page judges the rate over the last hour instead (T06)."
            : "No updates since the counters began.";

    private static string ParameterClass(StorageParameterState parameter) => parameter.Status switch
    {
        StorageParameterStatus.Drift => "ms-index-flag ms-index-flag-danger ms-schema-parameter ms-schema-parameter-drift",
        StorageParameterStatus.SetOutsideMarten => "ms-index-flag ms-index-flag-info ms-schema-parameter",
        StorageParameterStatus.PartitionsDiffer => "ms-index-flag ms-index-flag-warn ms-schema-parameter ms-schema-parameter-differ",
        _ => "ms-index-flag ms-schema-parameter",
    };

    private static string ParameterText(StorageParameterState parameter) => parameter.Status switch
    {
        StorageParameterStatus.Drift => parameter.Name + ": declared " + parameter.Declared + ", table " + (parameter.Actual ?? "unset"),
        StorageParameterStatus.PartitionsDiffer => parameter.Name + ": partitions differ",
        _ => parameter.Name + "=" + parameter.Actual,
    };

    private static string ParameterTitle(StorageParameterState parameter) => parameter.Status switch
    {
        StorageParameterStatus.Drift =>
            "The mapping declares " + parameter.Name + " = " + parameter.Declared + " and the table " +
            (parameter.Actual is null ? "does not have it" : "has " + parameter.Actual) +
            ": the next apply sets it. A layout parameter such as fillfactor affects only pages written after that.",
        StorageParameterStatus.SetOutsideMarten =>
            "Set on the table, and not declared by the configuration (or by a Marten that cannot declare it): Marten's delta " +
            "leaves it alone, unless an apply rebuilds the table - a changed partition scheme copies it out and back.",
        StorageParameterStatus.PartitionsDiffer =>
            "The table's partitions do not all have " + parameter.Name + " at one value" +
            (parameter.Declared is { } declared ? " (the mapping declares " + declared + ")" : string.Empty) +
            ". Postgres keeps no storage parameters on a partitioned table itself; the partitions are not named here, " +
            "because Marten names a tenant's partition after the tenant.",
        _ => "Declared by the mapping, and the table has it.",
    };

    /// <summary>
    /// Where a collection link points, scope query and all.
    /// </summary>
    /// <remarks>
    /// Supplied by the page rather than built here, because the studio's links go through
    /// <c>StudioLink.To</c> to honour a custom mount path, and the scope has to travel in the query
    /// string for the link to reopen the same thing (plan D9).
    /// </remarks>
    [Parameter]
    [EditorRequired]
    public Func<string, string> CollectionLink { get; set; } = static alias => alias;

    /// <summary>
    /// Where a table's name points: the database browser's object detail, scope query and all. Supplied by
    /// the page for the same reason as <see cref="CollectionLink" />.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public Func<string, string, string> ObjectLink { get; set; } = static (schema, name) => schema + "." + name;

    /// <summary>Where the event store's badge points: Streams, scope query and all.</summary>
    [Parameter]
    [EditorRequired]
    public string StreamsLink { get; set; } = string.Empty;

    private long TotalBytes
    {
        get
        {
            long total = 0;
            foreach (TableStats table in tables.Tables)
            {
                total += table.TotalBytes;
            }

            return total;
        }
    }

    private bool HasPartitionedTable
    {
        get
        {
            foreach (TableStats table in tables.Tables)
            {
                if (table.IsPartitioned)
                {
                    return true;
                }
            }

            return false;
        }
    }

    private bool HasWithheldFigures
    {
        get
        {
            foreach (TableStats table in tables.Tables)
            {
                if (table.FiguresWithheld)
                {
                    return true;
                }
            }

            return false;
        }
    }

    /// <summary>
    /// "N partitions" past the gate, and "partitioned" with no number before it - the service has already
    /// withheld the number, so there is nothing here to leak.
    /// </summary>
    private static string PartitionLabel(TableStats table) => table.PartitionCount switch
    {
        null => "partitioned",
        1 => "1 partition",
        int count => count.ToString(System.Globalization.CultureInfo.InvariantCulture) + " partitions",
    };

    private static string DocumentTitle(TableStats table) =>
        table.DocumentTypeName is { Length: > 0 } typeName
            ? "Document collection · " + typeName
            : "Document collection";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            StudioScope? scope = State.ActiveScope;
            tables = scope is null
                ? SchemaTables.Empty
                : await SchemaData.TablesAsync(scope, lifetime.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            tables = SchemaTables.Unavailable(exception.Message);
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
