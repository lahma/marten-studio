@using MartenStudio.Services.Live
@using PostgresStudio.Services.Live
@inject IJSRuntime JsRuntime

@*
    One configured value, the member it came from, and a copy button. The member name is the reason this
    screen exists: "Stream identity: Guid" is a fact, and "Stream identity: Guid, from
    StoreOptions.Events.StreamIdentity" is a fact somebody can act on without going to look for it.

    Three strings rather than the ConfigurationValue record: the Razor compiler emits a public component
    class and a public [Parameter] cannot have an internal type, and the data seam is internal by design
    (plan D12). Every component in this repository takes primitives for the same reason.
*@

<div class="ms-config-row">
    <span class="ms-config-name">@Name</span>
    <span class="ms-config-value">
        @Value
        <code class="ms-config-member">@Member</code>
        @if (Note is { Length: > 0 })
        {
            <span class="ms-config-note">
                @Note
                @if (NoteHref is { Length: > 0 })
                {
                    <a href="@NoteHref">How Marten uses this connection</a>
                }
            </span>
        }
    </span>
    <button type="button"
            class="ms-copy-inline"
            aria-label="@($"Copy the value of {Name}")"
            @onclick="CopyAsync">@label</button>
</div>

@code {
    private string label = "Copy";

    /// <summary>What the value is, in the studio's words.</summary>
    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>What it is set to.</summary>
    [Parameter]
    [EditorRequired]
    public string Value { get; set; } = string.Empty;

    /// <summary>The <c>StoreOptions</c> member it was read from.</summary>
    [Parameter]
    [EditorRequired]
    public string Member { get; set; } = string.Empty;

    /// <summary>
    /// A sentence about what the value means or which value wins, drawn under the member path (1.1-NP4-FIX); the member column
    /// holds the member path and nothing else.
    /// </summary>
    [Parameter]
    public string? Note { get; set; }

    /// <summary>Where the note's "How Marten uses this connection" link goes; no link when it is empty.</summary>
    [Parameter]
    public string? NoteHref { get; set; }

    protected override void OnParametersSet() => label = "Copy";

    private async Task CopyAsync()
    {
        try
        {
            bool copied = await JsRuntime.InvokeAsync<bool>("martenStudio.clipboard.copyText", new object?[] { Value });
            label = copied ? "Copied" : "Failed";
        }
        catch (Exception e) when (StudioLiveUpdates.IsInteropUnavailable(e))
        {
            label = "Failed";
        }
    }
}
