@page "/marten/projections"
@using System.Globalization
@using MartenStudio.Services
@using MartenStudio.Services.Health
@using MartenStudio.Services.Health.Checks
@using MartenStudio.Services.Live
@using MartenStudio.Services.Projections
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@implements IAsyncDisposable
@inject IProjectionDataService ProjectionData
@inject StudioState State
@inject StudioCapabilityGuard Capabilities
@inject StudioAuthorization Authorization
@inject StudioLiveUpdatesFactory LiveFactory
@inject ToastService Toasts
@inject IOptions<MartenStudioOptions> Options
@inject IHealthService Health
@inject IServiceProvider Services

<PageTitle>Projections</PageTitle>

<div class="ms-page ms-projections">
    <div class="ms-page-header">
        <h1 class="ms-page-title">Projections</h1>
        <div class="ms-projections-toolbar">
            @if (view is not null)
            {
                <span class="ms-badge ms-projections-freshness" title="@FreshnessTitle">@FreshnessLabel</span>
            }
            <button type="button" class="ms-button ms-projections-refresh" @onclick="RefreshAsync">Refresh</button>
        </div>
    </div>

    @if (loading && view is null)
    {
        <LoadingSpinner />
    }
    else if (loadError is { Length: > 0 } && view is null)
    {
        <ErrorAlert Message="@loadError" OnRetry="RefreshAsync" />
    }
    else if (view is null)
    {
        <div class="ms-empty">
            <p class="ms-empty-title">No Marten store to show</p>
            <p class="ms-empty-description">
                Nothing has been selected yet, or this application registered no Marten store you are
                authorized to see.
            </p>
        </div>
    }
    else
    {
        @if (loadError is { Length: > 0 })
        {
            @* The page keeps what it had and says the refresh failed: a database that comes back is one
               the next tick renders (plan section 4.8). *@
            <ErrorAlert Message="@($"The last refresh failed: {loadError}")" OnRetry="RefreshAsync" />
        }

        @* A database with no event tables is the reason for everything below it reading "never started",
           and it is not the same problem as a daemon nobody is hosting - so it is said first, and the
           daemon banner stands down. Marten creates those tables on the first append or daemon run; the
           studio never creates them from a page (hard rule 14). *@
        @if (!view.HasEventStore)
        {
            <div class="ms-empty">
                <p class="ms-empty-title">No event store in this database</p>
                <p class="ms-empty-description">
                    There is no <code>mt_events</code>, <code>mt_streams</code> or
                    <code>mt_event_progression</code> here. Marten creates them the first time this store
                    appends an event or runs its daemon; Marten Studio never creates them from a page.
                </p>
            </div>
        }
        else if (view.NoDaemonAnywhere && view.Daemon.IsExternallyManaged && !HasHealthBanner("D02"))
        {
            @* The same facts, about a store whose projections another system runs: worth saying, because
               there are events and nothing has advanced over them, and wrong to blame on a daemon this
               process was never meant to host. A store with no events yet raises neither banner
               (ProjectionsView.NoDaemonAnywhere): there has been nothing to advance over. *@
            <div class="ms-alert ms-alert-warning ms-no-daemon-banner" role="alert">
                <div class="ms-alert-content">
                    <p>
                        This store's asynchronous projections are run by an external system, and no shard has
                        ever advanced. If that system is running, it has not processed anything yet.
                    </p>
                </div>
            </div>
        }
        else if (view.NoDaemonAnywhere && !HasHealthBanner("D02"))
        {
            <div class="ms-alert ms-alert-warning ms-no-daemon-banner" role="alert">
                <div class="ms-alert-content">
                    <p>
                        This store has asynchronous projections, no daemon is hosted in this process, and no
                        shard has ever advanced. Nothing appears to be running these projections anywhere.
                    </p>
                    <p class="ms-muted">
                        If the daemon runs in another process, this is only a fact about <em>this</em> one -
                        the progress below comes from the database either way.
                    </p>
                </div>
            </div>
        }

        @* D01 and D02, from the health advisor's last regular sweep of this database - read from its cache on
           every poll, never by starting a sweep (pg_locks is read at the health cadence, by the Health page and
           the Overview). With no recent sweep there is nothing here, and nothing here claims the store is
           healthy either: absence is "not checked", not "fine". *@
        @foreach (HealthReportFinding finding in healthBanners)
        {
            bool critical = finding.Severity == HealthSeverity.Critical;

            <section class="@("ms-alert ms-health-banner ms-health-banner-" + finding.Code.ToLowerInvariant() + (critical ? " ms-alert-error" : " ms-alert-warning"))"
                     role="@(critical ? "alert" : "status")"
                     aria-label="@("Health finding " + finding.Code)"
                     @key="finding.MuteKey">
                <div class="ms-alert-content">
                    <p class="ms-health-banner-title">
                        <span class="@HealthBannerChip(finding)">@finding.Severity</span>
                        <code class="ms-health-banner-code">@finding.Code</code>
                        @finding.Finding.Title
                    </p>
                    <p class="ms-muted ms-health-banner-meta">
                        From the health advisor's check at @State.FormatInSelectedTimeZone(finding.Finding.MeasuredAt).
                        <a class="ms-health-banner-link" href="@HealthLinks.ToFinding(Options.Value, State.ActiveScope, finding)">Why, and what to change</a>
                    </p>

                    @if (string.Equals(finding.Code, "D01", StringComparison.Ordinal))
                    {
                        <div class="ms-health-banner-actions">
                            <button type="button"
                                    class="ms-button ms-btn-sm ms-high-water-explain"
                                    disabled="@explaining"
                                    title="Asks the database, once, which open transactions could be holding the mark: Marten's own gap-liveness questions, plus prepared transactions."
                                    @onclick="ExplainHighWaterAsync">
                                @(explaining ? "Asking..." : "Explain")
                            </button>
                        </div>

                        @if (explanation is { } explained)
                        {
                            <div class="ms-high-water-explanation" role="region" aria-label="What could be holding the high-water mark">
                                <p class="ms-high-water-explanation-summary">@explained.Summary</p>

                                @if (explained.Unavailable is null && explained.IsPinned)
                                {
                                    <dl class="ms-high-water-explanation-counts">
                                        <div><dt>Open since before the pin</dt><dd class="ms-mono">@explained.OpenTransactions</dd></div>
                                        <div><dt>Of them, mid-append on mt_events</dt><dd class="ms-mono">@explained.EventsWriteLockHolders</dd></div>
                                        <div><dt>Of them, writing</dt><dd class="ms-mono">@explained.Writers</dd></div>
                                        <div><dt>Ruled out, as Marten rules them out</dt><dd class="ms-mono">@explained.RuledOut</dd></div>
                                        <div><dt>Prepared before the pin</dt><dd class="ms-mono">@explained.PreparedBeforePin of @explained.PreparedTransactions</dd></div>
                                        <div><dt>Other roles' writers this role cannot date</dt><dd class="ms-mono">@explained.HiddenWriters</dd></div>
                                        @if (explained.OldestOpenTransaction is { } oldest)
                                        {
                                            <div><dt>Oldest open transaction</dt><dd class="ms-mono">@DaemonCheckConfiguration.Format(oldest)</dd></div>
                                        }
                                    </dl>

                                    @if (explained.DetailsShown && explained.Sessions.Count > 0)
                                    {
                                        <TableScroll Label="Sessions that could be holding the high-water mark">
                                            <table class="ms-table ms-high-water-sessions">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">pid</th>
                                                        <th scope="col">Role</th>
                                                        <th scope="col">Application</th>
                                                        <th scope="col">Client</th>
                                                        <th scope="col">Transaction began</th>
                                                        <th scope="col">State</th>
                                                        <th scope="col">Holding the mark?</th>
                                                        <th scope="col">Statement</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (HighWaterSuspect suspect in explained.Sessions)
                                                    {
                                                        <tr class="ms-table-row" @key="suspect.Pid">
                                                            <td class="ms-table-cell ms-table-cell-mono">@suspect.Pid</td>
                                                            <td class="ms-table-cell">@(suspect.User ?? "not visible")</td>
                                                            <td class="ms-table-cell">@suspect.Application</td>
                                                            <td class="ms-table-cell ms-table-cell-mono">@suspect.ClientAddress</td>
                                                            <td class="ms-table-cell ms-table-cell-mono">@(suspect.TransactionStart is { } began ? State.FormatInSelectedTimeZone(began) : string.Empty)</td>
                                                            <td class="ms-table-cell">@(suspect.State + (suspect.Wait is { } wait ? " (" + wait + ")" : string.Empty))</td>
                                                            <td class="ms-table-cell">@SuspectVerdict(suspect)</td>
                                                            <td class="ms-table-cell ms-table-cell-mono ms-high-water-statement" title="@suspect.Query">@suspect.Query</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </TableScroll>
                                    }

                                    @if (explained.DetailsShown && explained.Prepared.Count > 0)
                                    {
                                        <TableScroll Label="Prepared transactions in this database">
                                            <table class="ms-table ms-high-water-prepared">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">Transaction</th>
                                                        <th scope="col">Owner</th>
                                                        <th scope="col">Prepared</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (PreparedTransactionInfo prepared in explained.Prepared)
                                                    {
                                                        <tr class="ms-table-row" @key="prepared.Gid">
                                                            <td class="ms-table-cell ms-table-cell-mono">@prepared.Gid</td>
                                                            <td class="ms-table-cell">@prepared.Owner</td>
                                                            <td class="ms-table-cell ms-table-cell-mono">@State.FormatInSelectedTimeZone(prepared.Prepared)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </TableScroll>
                                    }

                                    @if (!explained.DetailsShown && explained.DetailsWithheldReason is { Length: > 0 } withheld)
                                    {
                                        <p class="ms-muted ms-high-water-withheld">@withheld</p>
                                    }

                                    <p class="ms-muted ms-high-water-remedy">
                                        End the transaction that holds it, or use <strong>Advance high water mark</strong> above:
                                        it moves the mark to the latest committed event, and anything that commits inside the
                                        gap afterwards is never projected.
                                    </p>
                                }

                                @foreach (HealthStatement statement in explained.Statements)
                                {
                                    <SqlDisclosure Sql="@statement.Sql" ParameterNames="statement.ParameterNames" />
                                }
                            </div>
                        }
                    }
                </div>
            </section>
        }

        <DaemonStatusCard IsHostedHere="view.Daemon.IsHostedHere"
                          IsExternallyManaged="view.Daemon.IsExternallyManaged"
                          IsRunning="view.Daemon.IsRunning"
                          Mode="@view.Daemon.Mode"
                          AgentCount="view.Daemon.Agents.Count"
                          HasAnyPaused="view.Daemon.HasAnyPaused"
                          HighWaterAge="@HighWaterAgeText"
                          HighWaterMark="view.HighWaterMark"
                          Explanation="@view.Daemon.Explanation"
                          IsPausedByStudio="view.Daemon.IsPausedByStudio"
                          PausedByUser="@view.Daemon.PausedByStudio?.User"
                          PausedAtText="@PausedAtText"
                          ControlExplanation="@DaemonControlMessages.PauseIsProcessWide">
            @if (!Capabilities.ReadOnly)
            {
                <div class="ms-daemon-actions ms-actions">
                    @* Hidden rather than disabled for an externally managed store: there is no option a
                       host could set to make them work here - they belong to the system that runs the
                       projections - and the card has already said so. The progression corrections stay:
                       they are writes against the progression table and need no daemon. *@
                    @if (!ExternallyManaged)
                    {
                        <button type="button"
                                class="ms-button ms-daemon-pause"
                                disabled="@(!ControlEnabled)"
                                title="@ControlTitle"
                                @onclick="() => AskAsync(PendingAction.PauseDaemon)">
                            Pause daemon
                        </button>
                        <button type="button"
                                class="ms-button ms-daemon-resume"
                                disabled="@(!ControlEnabled)"
                                title="@ControlTitle"
                                @onclick="() => AskAsync(PendingAction.ResumeDaemon)">
                            Resume daemon
                        </button>
                        <button type="button"
                                class="ms-button ms-daemon-restart-high-water"
                                disabled="@(!ControlEnabled)"
                                title="@ControlTitle"
                                @onclick="RestartHighWaterAsync">
                            Restart high water
                        </button>
                    }
                    <button type="button"
                            class="ms-button ms-daemon-advance-high-water"
                            disabled="@(!CorrectEnabled)"
                            title="@CorrectTitle"
                            @onclick="() => AskAsync(PendingAction.AdvanceHighWaterMark)">
                        Advance high water mark
                    </button>
                    <button type="button"
                            class="ms-button ms-daemon-correct-progression"
                            disabled="@(!CorrectEnabled)"
                            title="@CorrectTitle"
                            @onclick="() => AskAsync(PendingAction.CorrectProgression)">
                        Correct progression
                    </button>
                </div>

                @if (ControlEnabled && AgentControlRefusal is { Length: > 0 })
                {
                    @* Why the per-shard Start and Stop buttons below are disabled. On the page rather
                       than only in hover text, because it names the thing to do about it. *@
                    <p class="ms-muted ms-daemon-explanation ms-shard-control-hint">@AgentControlRefusal</p>
                }

                @if (agentRefusal is { Length: > 0 })
                {
                    @* A refusal that came back from the service after the button was clicked anyway. A
                       hint and not an error toast: nothing failed, and nothing was changed. *@
                    <p class="ms-muted ms-daemon-explanation ms-agent-refusal" role="status">@agentRefusal</p>
                }

                @if (!ExternallyManaged && !Capabilities.IsEnabled(StudioCapability.ControlDaemon))
                {
                    <CapabilityDisabled Capability="@nameof(StudioCapability.ControlDaemon)"
                                        Action="Pausing and resuming the projection daemon" />
                }

                @if (!Capabilities.IsEnabled(StudioCapability.CorrectProgression))
                {
                    <CapabilityDisabled Capability="@nameof(StudioCapability.CorrectProgression)"
                                        Action="Advancing the high water mark and correcting progression" />
                }

                @* One sentence per capability the policy refused this visitor, under the controls it
                   disabled. Each is its own line because a policy is free to allow a pause and refuse a
                   rebuild, and a reader has to be able to tell which button the sentence is about. *@
                <WriteRefusal Refused="@(!ExternallyManaged && RefusedByPolicy(StudioCapability.ControlDaemon))"
                              Capability="@nameof(StudioCapability.ControlDaemon)" />
                <WriteRefusal Refused="RefusedByPolicy(StudioCapability.CorrectProgression)"
                              Capability="@nameof(StudioCapability.CorrectProgression)" />
                <WriteRefusal Refused="@(!ExternallyManaged && RefusedByPolicy(StudioCapability.RebuildProjections))"
                              Capability="@nameof(StudioCapability.RebuildProjections)" />

                @if (!view.Daemon.IsHostedHere && !view.Daemon.IsExternallyManaged)
                {
                    <p class="ms-muted ms-daemon-unavailable">
                        Start, stop and rebuild are unavailable because no async daemon is hosted in this
                        process. Progress below is read from the database and is current either way.
                    </p>
                }
            }
        </DaemonStatusCard>

        @if (operations.Count > 0)
        {
            <section class="ms-operations" aria-label="Running operations">
                @foreach (StudioOperation operation in operations)
                {
                    <OperationStatus @key="operation.Id"
                                     Id="@operation.Id"
                                     Kind="@operation.Kind"
                                     Target="@operation.Target"
                                     State="@operation.State.ToString()"
                                     IsRunning="operation.IsRunning"
                                     Message="@operation.Message"
                                     ElapsedMilliseconds="operation.ElapsedMilliseconds"
                                     OnCancel="CancelCallback" />
                }
            </section>
        }

        @if (view.Projections.Count == 0)
        {
            <div class="ms-empty">
                <p class="ms-empty-title">No projections registered</p>
                <p class="ms-empty-description">
                    This store's <code>StoreOptions</code> registers no projection. Marten Studio shows what
                    the host configured - add one with <code>opts.Projections.Add(...)</code> or
                    <code>opts.Projections.Snapshot&lt;T&gt;(...)</code> and it appears here.
                </p>
            </div>
        }
        else
        {
            <TableScroll Label="Projections and shards table">
                <table class="ms-table ms-projections-table">
                    <thead>
                        <tr>
                            <th scope="col">Projection / shard</th>
                            <th scope="col">Type</th>
                            <th scope="col">Version</th>
                            <th scope="col">Shards</th>
                            <th scope="col">Progress</th>
                            <th scope="col">Lag</th>
                            <th scope="col">Status</th>
                            <th scope="col" title="When the shard last advanced, from its progression row's last_updated, in the database server's time">Last progress</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ProjectionInfo projection in OrderedProjections)
                        {
                            <ProjectionRow @key="projection.Name"
                                           Name="@projection.Name"
                                           Lifecycle="@projection.Lifecycle.ToString()"
                                           IsAsync="projection.IsAsync"
                                           SubscriptionType="@projection.SubscriptionType"
                                           Version="projection.Version"
                                           ImplementationType="@projection.ImplementationTypeName"
                                           ShardCount="projection.ShardNames.Count"
                                           IsRebuilding="IsRebuilding(projection.Name)"
                                           RebuildingBy="@RebuildingBy(projection.Name)">
                                <Actions>
                                    @if (!Capabilities.ReadOnly && !ExternallyManaged)
                                    {
                                        <button type="button"
                                                class="ms-button ms-button-danger ms-btn-sm ms-projection-rebuild"
                                                disabled="@(!RebuildEnabledFor(projection.Name))"
                                                title="@RebuildTitleFor(projection.Name)"
                                                @onclick="() => OpenRebuildAsync(projection.Name)">
                                            Rebuild
                                        </button>
                                    }
                                </Actions>
                            </ProjectionRow>

                            @foreach (ShardProgress shard in ShardsOf(projection))
                            {
                                <tr class="ms-table-row ms-shard-row ms-shard-row-@shard.Severity.ToString().ToLowerInvariant()"
                                    @key="shard.ShardName"
                                    data-shard="@shard.ShardName">
                                    <td class="ms-table-cell ms-table-cell-mono ms-shard-name">
                                        @shard.ShardName
                                        @if (shard.IsLive)
                                        {
                                            <span class="ms-badge ms-shard-live" title="Pushed by the in-process daemon's tracker">live</span>
                                        }
                                        @if (shard.TenantId is { Length: > 0 })
                                        {
                                            <span class="ms-badge ms-shard-tenant">@shard.TenantId</span>
                                        }
                                    </td>
                                    <td class="ms-table-cell" colspan="3">
                                        @if (!shard.HasProgressRow)
                                        {
                                            <span class="ms-muted">never started</span>
                                        }
                                    </td>
                                    <td class="ms-table-cell ms-shard-progress-cell">
                                        <ShardProgressBar ShardName="@shard.ShardName"
                                                          Sequence="shard.Sequence"
                                                          HighWater="shard.HighWater"
                                                          Severity="@shard.Severity.ToString().ToLowerInvariant()" />
                                    </td>
                                    <td class="ms-table-cell ms-table-cell-mono ms-shard-lag ms-lag-@shard.Severity.ToString().ToLowerInvariant()"
                                        title="@LagTitle(shard)">
                                        @shard.Lag.ToString("N0", CultureInfo.InvariantCulture)
                                        @if (TrendOf(shard) is { } trend && trend.Arrow.Length > 0)
                                        {
                                            <span class="@("ms-shard-trend ms-shard-trend-" + trend.Direction.ToString().ToLowerInvariant())"
                                                  title="@trend.Describe()"
                                                  aria-label="@trend.Describe()">@trend.Arrow</span>
                                            @if (trend is { Direction: LagDirection.Draining, CaughtUpIn: { } eta })
                                            {
                                                <span class="ms-shard-eta" title="@trend.Describe()">~@DaemonCheckConfiguration.Format(eta)</span>
                                            }
                                        }
                                    </td>
                                    <td class="ms-table-cell ms-shard-status">
                                        <StateIndicator State="@(shard.AgentStatus ?? "Unknown")" />
                                        @if (shard.PauseReason is { Length: > 0 })
                                        {
                                            <span class="ms-badge ms-chip-warning ms-shard-pause">@shard.PauseReason</span>
                                        }
                                        @if (shard.Failure is { Length: > 0 })
                                        {
                                            <span class="ms-text-danger ms-shard-failure" title="@shard.Failure">@shard.Failure</span>
                                        }
                                        @if (shard.SkippedCount is > 0)
                                        {
                                            <span class="ms-badge ms-shard-skipped" title="Skipped events become dead letters">
                                                @shard.SkippedCount skipped
                                            </span>
                                        }
                                    </td>
                                    <td class="ms-table-cell ms-table-cell-mono ms-shard-last-advanced"
                                        title="@LastProgressTitle(shard)">
                                        @LastProgressText(shard)
                                        @if (IsRebuilding(shard.ProjectionName))
                                        {
                                            <span class="ms-badge ms-shard-rebuilding" title="@RebuildingBy(shard.ProjectionName)">rebuilding</span>
                                        }
                                    </td>
                                    <td class="ms-table-cell ms-table-cell-actions">
                                        @if (!Capabilities.ReadOnly && !ExternallyManaged)
                                        {
                                            @* Disabled, never hidden, while the coordinator is running: the
                                               option has to stay discoverable, and the hover text - like the
                                               hint on the card - says exactly what would make it work. *@
                                            <button type="button"
                                                    class="ms-btn ms-btn-sm ms-shard-start"
                                                    disabled="@(!AgentControlEnabled || IsRebuilding(shard.ProjectionName))"
                                                    title="@StartTitle(shard)"
                                                    @onclick="() => StartAgentAsync(shard.ShardName)">
                                                Start
                                            </button>
                                            <button type="button"
                                                    class="ms-btn ms-btn-sm ms-shard-stop"
                                                    disabled="@(!AgentControlEnabled)"
                                                    title="@(AgentControlTitle is { Length: > 0 } refused ? refused : DrainSentence)"
                                                    @onclick="() => StopAgentAsync(shard.ShardName)">
                                                Stop
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </TableScroll>

            <p class="ms-muted ms-projections-footnote">
                Lag is the high water mark minus the shard's own sequence. Amber above
                @ProjectionLagThresholds.Amber.ToString("N0", CultureInfo.InvariantCulture) events, red above
                @ProjectionLagThresholds.Red.ToString("N0", CultureInfo.InvariantCulture) - unless the shard's
                progression row carries thresholds of its own, which Marten creates and does not write. The arrow and
                the time to catch up come from the health advisor's samples, taken while the Health page or the
                Overview is open; without them there is no arrow.
            </p>
        }

        @if (view.UnregisteredShards.Count > 0)
        {
            @* Progression rows nothing in this store's StoreOptions claims. Hiding them would hide the
               reason a table nobody writes to any more is still there, and the reason a shard name in
               the logs is in no table on this page. *@
            <section class="ms-unregistered-shards" aria-labelledby="ms-unregistered-shards-title">
                <h2 class="ms-section-title" id="ms-unregistered-shards-title">Unregistered shards</h2>
                <p class="ms-muted ms-unregistered-shards-note">
                    These shards have rows in <code>mt_event_progression</code> and no projection in this
                    store's <code>StoreOptions</code> claims them - a projection that was removed, renamed
                    or given a new version. Nothing advances them, and they cannot be started or rebuilt
                    from here.
                </p>

                <TableScroll Label="Unregistered shards table">
                    <table class="ms-table ms-unregistered-shards-table">
                        <thead>
                            <tr>
                                <th scope="col">Shard</th>
                                <th scope="col">Sequence</th>
                                <th scope="col">Lag</th>
                                <th scope="col">Last advanced</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ShardProgress shard in view.UnregisteredShards)
                            {
                                <tr class="ms-table-row ms-unregistered-shard-row"
                                    @key="shard.ShardName"
                                    data-unregistered-shard="@shard.ShardName">
                                    <td class="ms-table-cell ms-table-cell-mono">
                                        @shard.ShardName
                                        @if (shard.TenantId is { Length: > 0 })
                                        {
                                            <span class="ms-badge ms-shard-tenant">@shard.TenantId</span>
                                        }
                                    </td>
                                    <td class="ms-table-cell ms-table-cell-mono">
                                        @shard.Sequence.ToString("N0", CultureInfo.InvariantCulture)
                                    </td>
                                    <td class="ms-table-cell ms-table-cell-mono ms-lag-@shard.Severity.ToString().ToLowerInvariant()">
                                        @shard.Lag.ToString("N0", CultureInfo.InvariantCulture)
                                    </td>
                                    <td class="ms-table-cell ms-table-cell-mono">
                                        @(shard.LastAdvanced is { } advanced ? State.FormatInSelectedTimeZone(advanced) : "never")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </TableScroll>
            </section>
        }
    }

    <RebuildDialog IsOpen="rebuild is not null"
                   ProjectionName="@(rebuild?.ProjectionName ?? string.Empty)"
                   EventsToReplay="rebuild?.EventsToReplay ?? 0"
                   Shards="rebuild?.ShardNames ?? []"
                   Tables="rebuild?.TablesAffected ?? []"
                   Lifecycle="@(rebuild?.Lifecycle.ToString() ?? string.Empty)"
                   IsAsync="@(rebuild?.Lifecycle == JasperFx.Events.Projections.ProjectionLifecycle.Async)"
                   Tenant="@State.ActiveScope?.TenantId"
                   ShardTimeout="@(rebuild?.ShardTimeout ?? Options.Value.RebuildShardTimeout)"
                   Estimate="@RebuildEstimate"
                   DrainNote="@DrainSentence"
                   Warnings="rebuildWarnings"
                   OnConfirm="ConfirmRebuildAsync"
                   OnCancel="CancelRebuild" />

    <ConfirmDialog IsOpen="pending is not PendingAction.None"
                   Title="@PendingTitle"
                   Message="@PendingMessage"
                   OnConfirm="ConfirmPendingAsync"
                   OnCancel="CancelPending" />
</div>

@code {
    /// <summary>The actions that are confirmed but not typed out.</summary>
    private enum PendingAction
    {
        None,
        AdvanceHighWaterMark,
        CorrectProgression,
        CancelOperation,
        PauseDaemon,
        ResumeDaemon
    }

    private readonly CancellationTokenSource pageCancellation = new();

    /// <summary>
    /// This page's polling loop, built rather than injected.
    /// </summary>
    /// <remarks>
    /// <c>StudioLiveUpdates</c> is <c>IAsyncDisposable</c>, and a transient registration would leave the
    /// circuit's container holding one per page visit for the life of the circuit. The page owns it, and
    /// the page disposes it.
    /// </remarks>
    private StudioLiveUpdates? live;

    private ProjectionsView? view;
    private IReadOnlyList<StudioOperation> operations = [];
    private RebuildScope? rebuild;
    private PendingAction pending = PendingAction.None;
    private string? pendingOperationId;
    private IDisposable? liveLease;
    private bool loading = true;
    private bool started;
    private string? loadError;

    /// <summary>
    /// The reason a per-agent control did nothing, when one came back from the service.
    /// </summary>
    /// <remarks>
    /// Kept apart from <c>loadError</c> and from the toasts on purpose: a refusal is not a failure.
    /// Nothing was changed, nothing threw, and the visitor is being told what to do instead.
    /// </remarks>
    private string? agentRefusal;

    /// <summary>
    /// Whether <see cref="MartenStudioOptions.WriteAuthorizationPolicy" /> lets <em>this</em> visitor use
    /// each of the three mutating capabilities this page offers, in the scope on screen.
    /// </summary>
    /// <remarks>
    /// Three questions and not one: a policy is free to allow a pause and refuse a rebuild, and they are
    /// three capabilities. They default to <see langword="true" /> because the common case is a host that
    /// configured no write policy at all; fail-open is safe because this is not the enforcement - the
    /// service resolves the scope with the same capability and throws (AGENTS.md hard rule 5).
    /// </remarks>
    private bool mayControl = true;

    /// <inheritdoc cref="mayControl" />
    private bool mayRebuild = true;

    /// <inheritdoc cref="mayControl" />
    private bool mayCorrect = true;

    /// <summary>The health findings this screen draws as banners: D01 and D02, nothing else.</summary>
    private static readonly string[] BannerCodes = ["D01", "D02"];

    /// <summary>
    /// D01 and D02 as this visitor may see them, from the advisor's last regular sweep - read from its cache on every
    /// poll, never by asking for a sweep. Empty when no recent sweep exists, which is "not checked", never "healthy".
    /// </summary>
    private IReadOnlyList<HealthReportFinding> healthBanners = [];

    /// <summary>The health finding the rebuild dialog reads: D08, H6's - unknown to this build until H6 lands.</summary>
    private static readonly string[] RebuildCodes = ["D08"];

    /// <summary>D08's titles for the projection whose rebuild dialog is open; empty when there are none.</summary>
    private IReadOnlyList<string> rebuildWarnings = [];

    /// <summary>What the D01 Explain found, once asked; cleared when the scope changes.</summary>
    private HighWaterExplanation? explanation;

    /// <summary>Whether the Explain is being asked right now.</summary>
    private bool explaining;

    /// <summary>
    /// The advisor's samples as this visitor may read them, for the rebuild estimate - from the view, which reads them
    /// behind the database gate; empty without them.
    /// </summary>
    private HealthHistoryView history => view?.HealthHistory ?? HealthHistoryView.Empty;

    protected override async Task OnInitializedAsync()
    {
        State.ScopeChanged += OnScopeChangedAsync;

        live = LiveFactory.Create();
        live.Failed += OnRefreshFailedAsync;

        // Before the load, and for the same reason it is not part of it: a read that throws must not
        // leave the write controls showing the last visitor's answer.
        await UpdateWritePolicyAsync(pageCancellation.Token);
        await LoadAsync(pageCancellation.Token);
    }

    /// <summary>
    /// Asks the write policy about this visitor, once per load of the page and once per scope change.
    /// </summary>
    /// <remarks>
    /// Deliberately not part of <see cref="LoadAsync" />, which is also the polling tick: three policy
    /// evaluations per second per circuit would be a load nobody asked for, and the answer cannot change
    /// between ticks - it is about a principal and a scope, and the scope moving is its own event.
    /// Nothing is memoised across circuits either; a cache that outlived one would be how one person's
    /// answer gets shown to another.
    /// </remarks>
    private async Task UpdateWritePolicyAsync(CancellationToken cancellationToken)
    {
        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            return;
        }

        try
        {
            mayControl = await Authorization.IsAuthorizedAsync(scope, StudioCapability.ControlDaemon, cancellationToken);
            mayRebuild = await Authorization.IsAuthorizedAsync(scope, StudioCapability.RebuildProjections, cancellationToken);
            mayCorrect = await Authorization.IsAuthorizedAsync(scope, StudioCapability.CorrectProgression, cancellationToken);
        }
        catch (OperationCanceledException)
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || started)
        {
            return;
        }

        started = true;

        // The tracker lease and the polling loop are both started after the first render: neither needs
        // to exist for the page to draw, and neither may delay it.
        await SubscribeToLiveStateAsync();

        if (live is not null)
        {
            await live.StartAsync(Options.Value.RefreshInterval, TickAsync, pageCancellation.Token);
        }
    }

    /// <summary>
    /// One poll. The only place this page re-renders from, which is what throttles it: the interval is
    /// validated to be at least a second, so the tracker's sub-second pushes are folded into the next
    /// tick rather than each causing a render.
    /// </summary>
    private async Task TickAsync(CancellationToken cancellationToken)
    {
        await LoadAsync(cancellationToken);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync(CancellationToken cancellationToken)
    {
        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            view = null;
            loading = false;
            return;
        }

        try
        {
            view = await ProjectionData.GetProjectionsAsync(scope, cancellationToken);
            operations = await ProjectionData.RunningOperationsAsync(scope, cancellationToken);
            loadError = null;

            // Both read what the health advisor already has - its cache and its in-memory history - and neither asks
            // for a sweep: this is the 5 s poll, and pg_locks is read only at the health cadence (H2, criterion 5).
            await LoadHealthAsync(scope, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception exception)
        {
            // On the page, not only in the log: a failure the visitor cannot see is a page that silently
            // shows yesterday's numbers.
            loadError = exception.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        loading = view is null;
        await LoadAsync(pageCancellation.Token);
    }

    private async Task OnScopeChangedAsync()
    {
        // The refusal was about the daemon of the scope being left: a different store or database has a
        // different coordinator, a pause of its own or none, and carrying the sentence across would
        // explain the new scope with the old one's facts. The Explain was about that database's sessions.
        agentRefusal = null;
        explanation = null;

        ReleaseLease();
        await SubscribeToLiveStateAsync();

        // The policy is resource-based: it answers about a store, a database and a tenant, so a scope
        // change is exactly the event that can change its answer.
        await UpdateWritePolicyAsync(pageCancellation.Token);
        await LoadAsync(pageCancellation.Token);
        await InvokeAsync(StateHasChanged);
    }

    private Task OnRefreshFailedAsync(Exception exception)
    {
        loadError = exception.Message;
        return InvokeAsync(StateHasChanged);
    }

    private async Task SubscribeToLiveStateAsync()
    {
        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            return;
        }

        try
        {
            liveLease = await ProjectionData.SubscribeToLiveStateAsync(scope, pageCancellation.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            // Watching the tracker is an optimisation; the database rows are the page.
            loadError = exception.Message;
        }
    }

    private void ReleaseLease()
    {
        liveLease?.Dispose();
        liveLease = null;
    }

    // ------------------------------------------------------------------------------------------------
    // Gating. The service refuses regardless of what is rendered; this decides what is offered.
    // ------------------------------------------------------------------------------------------------

    private bool DaemonHostedHere => view?.Daemon.IsHostedHere == true;

    /// <summary>
    /// Whether an external system runs this store's async projections, so that the daemon controls are
    /// not offered here at all. The service refuses them regardless (AGENTS.md hard rule 5), from the
    /// same answer this reads: every control - pause and resume included - asks
    /// <c>DaemonAccessor.ForScopeAsync</c> and refuses on <c>ExternallyManaged</c>, whether that came
    /// from <c>AsyncMode</c> or from a coordinator whose lookup said <c>NotSupportedException</c>.
    /// </summary>
    private bool ExternallyManaged => view?.Daemon.IsExternallyManaged == true;

    private bool ControlEnabled =>
        Capabilities.IsEnabled(StudioCapability.ControlDaemon) && DaemonHostedHere && mayControl;

    private bool RebuildEnabled =>
        Capabilities.IsEnabled(StudioCapability.RebuildProjections) && DaemonHostedHere && mayRebuild;

    private bool CorrectEnabled =>
        Capabilities.IsEnabled(StudioCapability.CorrectProgression) && mayCorrect;

    /// <summary>
    /// Whether one agent may be started or stopped right now.
    /// </summary>
    /// <remarks>
    /// The capability, a daemon here, <em>and</em> the studio's own pause being in effect. With the
    /// coordinator running, its leadership loop restarts every agent missing from
    /// <c>CurrentAgents()</c> within <c>LeadershipPollingTime</c>, so the button would appear to work and
    /// then silently undo itself. The service refuses this independently (AGENTS.md hard rule 5); this is
    /// only what stops the button being offered.
    /// </remarks>
    private bool AgentControlEnabled => ControlEnabled && view?.Daemon.CanControlAgents == true;

    /// <summary>Why the per-agent controls are disabled, when the reason is the coordinator.</summary>
    private string? AgentControlRefusal => view?.Daemon.AgentControlRefusal;

    /// <summary>Whether a running operation may be asked to stop from here.</summary>
    private bool CancelEnabled =>
        !Capabilities.ReadOnly && Capabilities.IsEnabled(StudioCapability.RebuildProjections) && mayRebuild;

    /// <summary>
    /// The Cancel button on a running operation, or nothing.
    /// </summary>
    /// <remarks>
    /// An <c>EventCallback</c> without a delegate is how <c>OperationStatus</c> is told not to offer the
    /// button at all: a control that is rendered and then refused is worse than one that was never there,
    /// and the service refuses either way (AGENTS.md hard rule 5).
    /// </remarks>
    private EventCallback<string> CancelCallback =>
        CancelEnabled ? EventCallback.Factory.Create<string>(this, AskCancelAsync) : default;

    private string ControlTitle => Title(StudioCapability.ControlDaemon, needsDaemon: true);

    /// <summary>
    /// The hover text of a per-agent control: the capability, then the daemon, then the coordinator.
    /// </summary>
    private string AgentControlTitle
    {
        get
        {
            string common = Title(StudioCapability.ControlDaemon, needsDaemon: true);
            return common.Length > 0 ? common : AgentControlRefusal ?? string.Empty;
        }
    }

    private string CorrectTitle => Title(StudioCapability.CorrectProgression, needsDaemon: false);

    /// <summary>
    /// Whether this projection may be rebuilt right now.
    /// </summary>
    /// <remarks>
    /// One rebuild per projection at a time. The tracker is the singleton that actually enforces it - so
    /// a second circuit is refused even though it rendered its own button - and this is the half that
    /// stops the button being offered in the first place.
    /// </remarks>
    private bool RebuildEnabledFor(string projectionName) =>
        RebuildEnabled && !IsRebuilding(projectionName);

    private string RebuildTitleFor(string projectionName)
    {
        if (IsRebuilding(projectionName))
        {
            return $"A rebuild of {projectionName} is already running ({RebuildingBy(projectionName)}). Only one rebuild of a projection runs at a time.";
        }

        return Title(StudioCapability.RebuildProjections, needsDaemon: true);
    }

    /// <summary>
    /// Whether this projection is being rebuilt: by Marten Studio, anywhere in this process - or, where the daemon here
    /// can say so (JasperFx 2.86+), by anything. A daemon that says nothing proves nothing, so "no" is "not known to be".
    /// </summary>
    private bool IsRebuilding(string projectionName) =>
        IsRebuildingByStudio(projectionName) || view?.Daemon.IsRebuildingHere(projectionName) == true;

    private bool IsRebuildingByStudio(string projectionName) =>
        operations.Any(x => x.IsRunning
            && string.Equals(x.Kind, "Rebuild", StringComparison.Ordinal)
            && string.Equals(x.Target, projectionName, StringComparison.OrdinalIgnoreCase));

    /// <summary>Who is rebuilding it, for the row's badge and the buttons' hover text.</summary>
    private string? RebuildingBy(string projectionName) =>
        IsRebuildingByStudio(projectionName) ? "by Marten Studio"
        : view?.Daemon.IsRebuildingHere(projectionName) == true ? "on this daemon, by something other than Marten Studio"
        : null;

    /// <summary>The hover text of a shard's Start: the controls' own refusal first, then a rebuild of its projection.</summary>
    private string StartTitle(ShardProgress shard)
    {
        if (AgentControlTitle is { Length: > 0 } refused)
        {
            return refused;
        }

        if (IsRebuilding(shard.ProjectionName))
        {
            return $"{shard.ProjectionName} is being rebuilt {RebuildingBy(shard.ProjectionName)}. A continuous agent started now would run beside the replay; start it once the rebuild has finished.";
        }

        return DaemonLightUp.CanTellRebuilding ? string.Empty : StartBlindToRebuilds;
    }

    /// <summary>
    /// What Start says on a Marten whose daemon cannot tell anybody it is rebuilding (below 9.50, JasperFx 2.86): a
    /// rebuild started outside Marten Studio is invisible to the studio, nothing refuses the start, and the continuous
    /// agent it starts writes the shard's progression row beside the replay - measured: whichever inserts second fails on
    /// <c>pk_mt_event_progression</c> (23505), and the rebuild can be the one that fails.
    /// </summary>
    internal const string StartBlindToRebuilds =
        "On this Marten version the daemon cannot say whether this projection is being rebuilt by something other than "
        + "Marten Studio. Starting it during such a rebuild runs a second agent beside the replay, and the two can collide on "
        + "the shard's progression row - which can fail the rebuild. Make sure no rebuild is running first.";

    /// <summary>
    /// What stopping an agent does, at both ends of the supported Marten range: it gets <c>StopAndDrainTimeout</c> to
    /// finish what it is processing, and whatever is still running then is cancelled and processed again at the next
    /// start (from Marten 9.47 the page in flight is also rolled back). Said on Pause, Stop and Rebuild, because the
    /// screen must not promise a clean finish Marten does not make.
    /// </summary>
    private string DrainSentence
    {
        get
        {
            if (view?.Daemon is { IsDrainBounded: false })
            {
                return "Stopping waits for each agent to finish what it is processing, with no time limit: "
                    + "Projections.StopAndDrainTimeout is not positive, and JasperFx then applies no bound, so a page that never "
                    + "finishes holds the stop with it. Delivery is at-least-once, so a side effect outside Marten's session can "
                    + "happen twice.";
            }

            TimeSpan drain = view?.Daemon.StopAndDrainTimeout ?? TimeSpan.FromMilliseconds(DaemonDefaults.StopAndDrainMilliseconds);

            return "Stopping gives each agent up to " + DaemonCheckConfiguration.Format(drain)
                + " (Projections.StopAndDrainTimeout) to finish what it is processing; whatever is still running then is cancelled, "
                + "and its events are processed again when the shard next starts. Delivery is at-least-once, so a side effect "
                + "outside Marten's session can happen twice.";
        }
    }

    // ------------------------------------------------------------------------------------------------
    // The health advisor's half: banners, trends and the Explain. Read from what the advisor already has.
    // ------------------------------------------------------------------------------------------------

    /// <summary>The banners, from the advisor's cache - never a sweep. The trends come with the view.</summary>
    private async Task LoadHealthAsync(StudioScope scope, CancellationToken cancellationToken)
    {
        try
        {
            healthBanners = await Health.CachedFindingsAsync(scope, BannerCodes, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            // A banner is a decoration: one that could not be read is no banner, never a broken page.
            healthBanners = [];
        }
    }

    private bool HasHealthBanner(string code) =>
        healthBanners.Any(x => string.Equals(x.Code, code, StringComparison.Ordinal));

    private static string HealthBannerChip(HealthReportFinding finding) =>
        MartenStudio.Components.Pages.Health.HealthPresentation.ChipClass(finding.Severity);

    /// <summary>
    /// A shard's trend, as the service judged it - read behind the database gate, recent, and withheld where a pause, a
    /// rebuild or a stopped shard explains the lag (the arrow then is none, and the hover says why).
    /// </summary>
    private ShardTrend? TrendOf(ShardProgress shard) => view?.Trends.GetValueOrDefault(shard.ShardName);

    /// <summary>The lag cell's hover text: which thresholds colour it, and the trend.</summary>
    private string LagTitle(ShardProgress shard)
    {
        string thresholds = "Amber above " + shard.EffectiveWarningThreshold.ToString("N0", CultureInfo.InvariantCulture)
            + ", red above " + shard.EffectiveCriticalThreshold.ToString("N0", CultureInfo.InvariantCulture)
            + (shard.WarningThreshold is not null || shard.CriticalThreshold is not null
                ? " (this shard's own thresholds, from its progression row)."
                : " (the studio's defaults).");

        return TrendOf(shard) is { } trend ? thresholds + " " + char.ToUpperInvariant(trend.Describe()[0]) + trend.Describe()[1..] + "." : thresholds;
    }

    /// <summary>"12 s ago", from the row's last_updated in server time; the live tracker's time below it; or "never".</summary>
    private string LastProgressText(ShardProgress shard)
    {
        if (shard.SinceLastProgress is { } ago)
        {
            return ago < TimeSpan.FromSeconds(1) ? "just now" : DaemonCheckConfiguration.Format(ago) + " ago";
        }

        return shard.LastAdvanced is { } advanced ? State.FormatInSelectedTimeZone(advanced) : "never";
    }

    private string LastProgressTitle(ShardProgress shard) =>
        shard.LastProgress is { } at
            ? "Last progress written " + State.FormatInSelectedTimeZone(at) + " (mt_event_progression.last_updated, database server time)."
            : shard.LastAdvanced is { } advanced
                ? "Last advanced " + State.FormatInSelectedTimeZone(advanced) + ", as the in-process daemon's tracker reported it."
                : "This shard has no progress recorded.";

    /// <summary>The Explain's verdict on one session, in Marten's terms.</summary>
    private static string SuspectVerdict(HighWaterSuspect suspect) =>
        suspect.RuledOutBecause is { } ruledOut ? "no - " + ruledOut
        : suspect.HoldsEventsWriteLock ? "likely - it is mid-append on mt_events"
        : suspect.HasTransactionId ? "possibly - it has written in its transaction"
        : "possibly - its transaction was open before the mark was pinned";

    /// <summary>The rebuild dialog's duration estimate: events to replay over the throughput the advisor measured.</summary>
    private string? RebuildEstimate => rebuild is null
        ? null
        : ProjectionTrend.EstimateRebuild(rebuild.EventsToReplay, ProjectionTrend.Throughput(history, rebuild.ShardNames), history);

    /// <summary>
    /// What the advisor's last sweep says about rebuilding this projection: D08 ("being rebuilt somewhere, or a rebuild
    /// stopped half-way", H6) through the cache-only read - nothing, when no such finding exists or no sweep is cached.
    /// </summary>
    private async Task<IReadOnlyList<string>> RebuildWarningsAsync(StudioScope scope, string projectionName)
    {
        try
        {
            IReadOnlyList<HealthReportFinding> found = await Health.CachedFindingsAsync(scope, RebuildCodes, pageCancellation.Token);

            return
            [
                .. found
                    .Where(x => x.Finding.Subject is not { } subject
                        || string.Equals(subject, projectionName, StringComparison.OrdinalIgnoreCase)
                        || subject.StartsWith(projectionName + ":", StringComparison.OrdinalIgnoreCase))
                    .Select(static x => x.Finding.Title),
            ];
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            // A warning that could not be read is no warning: the dialog says what it always said.
            return [];
        }
    }

    /// <summary>D01's Explain: asks the database once, on this click, who could be holding the mark.</summary>
    private async Task ExplainHighWaterAsync()
    {
        StudioScope? scope = State.ActiveScope;
        if (scope is null || explaining)
        {
            return;
        }

        explaining = true;

        try
        {
            explanation = await ProjectionData.ExplainHighWaterAsync(scope, pageCancellation.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            await Toasts.Error("The Explain could not ask the database: " + exception.Message);
        }
        finally
        {
            explaining = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The hover text of one control: the capability, then the visitor, then the daemon.
    /// </summary>
    /// <remarks>
    /// In that order because that is the order the refusals bind in. A capability that is off makes the
    /// policy moot - the guard refuses before a scope is ever resolved - and names something a host can
    /// act on, so it is said first. The policy comes next, because a visitor it refuses does not need to
    /// be told where the daemon is: that is advice about a button they cannot press either way.
    /// </remarks>
    private string Title(StudioCapability capability, bool needsDaemon)
    {
        if (!Capabilities.IsEnabled(capability))
        {
            return $"Set {StudioCapabilityGuard.OptionName(capability)} to true to enable this.";
        }

        if (!MayUse(capability))
        {
            return WritePolicyRefusal.For(capability);
        }

        return needsDaemon && !DaemonHostedHere
            ? "No async daemon is hosted in this process, so there is nothing here to ask."
            : string.Empty;
    }

    /// <summary>Whether the write policy let this visitor have <paramref name="capability" />.</summary>
    private bool MayUse(StudioCapability capability) => capability switch
    {
        StudioCapability.ControlDaemon => mayControl,
        StudioCapability.RebuildProjections => mayRebuild,
        StudioCapability.CorrectProgression => mayCorrect,
        _ => true,
    };

    /// <summary>
    /// Whether the controls behind <paramref name="capability" /> are disabled by the write policy rather
    /// than by the capability being off - which is what decides whether the visitor is told about their
    /// account or about the host's configuration.
    /// </summary>
    private bool RefusedByPolicy(StudioCapability capability) =>
        Capabilities.IsEnabled(capability) && !MayUse(capability);

    // ------------------------------------------------------------------------------------------------
    // Actions
    // ------------------------------------------------------------------------------------------------

    private Task StartAgentAsync(string shardName) =>
        ControlAgentAsync(
            $"Started {shardName}",
            (scope, token) => ProjectionData.StartAgentAsync(scope, shardName, token));

    private Task StopAgentAsync(string shardName) =>
        ControlAgentAsync(
            $"Stopped {shardName}",
            (scope, token) => ProjectionData.StopAgentAsync(scope, shardName, token));

    /// <summary>
    /// One per-agent control, whose "no" is not an error.
    /// </summary>
    /// <remarks>
    /// <see cref="RunAsync" /> reports every non-success as a red toast, which is right for a throw and
    /// wrong for this: a refused agent control changed nothing, failed at nothing, and its answer is a
    /// sentence telling the visitor to pause the daemon first. It goes on the page as a hint.
    /// </remarks>
    private async Task ControlAgentAsync(
        string success,
        Func<StudioScope, CancellationToken, Task<DaemonControlResult>> action)
    {
        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            return;
        }

        try
        {
            DaemonControlResult result = await action(scope, pageCancellation.Token);

            if (result.Applied)
            {
                agentRefusal = null;
                await Toasts.Success(success);
            }
            else
            {
                agentRefusal = result.Reason;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            await Toasts.Error(exception.Message);
        }

        await LoadAsync(pageCancellation.Token);
        await InvokeAsync(StateHasChanged);
    }

    private Task RestartHighWaterAsync() =>
        RunAsync("Restarted the high water agent", (scope, token) => ProjectionData.RestartHighWaterAgentAsync(scope, token));

    private async Task OpenRebuildAsync(string projectionName)
    {
        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            return;
        }

        try
        {
            RebuildScope described = await ProjectionData.DescribeRebuildAsync(scope, projectionName, pageCancellation.Token);
            rebuildWarnings = await RebuildWarningsAsync(scope, described.ProjectionName);
            rebuild = described;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            await Toasts.Error(exception.Message);
        }
    }

    private void CancelRebuild() => rebuild = null;

    private async Task ConfirmRebuildAsync()
    {
        RebuildScope? scope = rebuild;
        if (scope is null)
        {
            return;
        }

        rebuild = null;

        StudioScope? studioScope = State.ActiveScope;
        if (studioScope is null)
        {
            return;
        }

        try
        {
            OperationStart start = await ProjectionData.RebuildAsync(studioScope, scope.ProjectionName, pageCancellation.Token);

            if (start.Refusal is { } refusal)
            {
                // "Already rebuilding" is a state, not a failure: nothing was started, and nothing went wrong.
                await Toasts.Info(refusal);
            }
            else if (start.Started)
            {
                await Toasts.Success($"Rebuild of {scope.ProjectionName} started");
                await Toasts.Info($"Rebuild {start.Id} runs in the background; it will finish even if you leave this page.");
            }
            else
            {
                await Toasts.Info(
                    $"{scope.ProjectionName} is already being rebuilt, as operation {start.Id}. Nothing was started.");
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            await Toasts.Error(exception.Message);
        }

        await LoadAsync(pageCancellation.Token);
        await InvokeAsync(StateHasChanged);
    }

    private Task AskAsync(PendingAction action)
    {
        pending = action;
        pendingOperationId = null;
        return Task.CompletedTask;
    }

    /// <summary>Asks before cancelling: a half-replayed projection is worse than a slow one.</summary>
    private Task AskCancelAsync(string operationId)
    {
        pending = PendingAction.CancelOperation;
        pendingOperationId = operationId;
        return Task.CompletedTask;
    }

    private void CancelPending()
    {
        pending = PendingAction.None;
        pendingOperationId = null;
    }

    private async Task ConfirmPendingAsync()
    {
        PendingAction action = pending;
        string? operationId = pendingOperationId;

        pending = PendingAction.None;
        pendingOperationId = null;

        switch (action)
        {
            case PendingAction.AdvanceHighWaterMark:
                await RunAsync(
                    "High water mark advanced to the latest event",
                    (scope, token) => ProjectionData.AdvanceHighWaterMarkAsync(scope, token));
                break;

            case PendingAction.CorrectProgression:
                await RunAsync(
                    "Progression corrected",
                    (scope, token) => ProjectionData.CorrectProgressionAsync(scope, token));
                break;

            case PendingAction.CancelOperation when operationId is { Length: > 0 }:
                await RunAsync(
                    $"Asked operation {operationId} to stop",
                    (scope, token) => ProjectionData.CancelOperationAsync(scope, operationId, token));
                break;

            case PendingAction.PauseDaemon:
                await RunAsync(
                    "The projection daemon is paused",
                    (scope, token) => ProjectionData.PauseDaemonAsync(scope, token));
                break;

            case PendingAction.ResumeDaemon:
                agentRefusal = null;
                await RunAsync(
                    "The projection daemon is resuming",
                    (scope, token) => ProjectionData.ResumeDaemonAsync(scope, token));
                break;

            default:
                break;
        }
    }

    private string PendingTitle => pending switch
    {
        PendingAction.AdvanceHighWaterMark => "Advance the high water mark?",
        PendingAction.CorrectProgression => "Correct the progression?",
        PendingAction.CancelOperation => "Stop this operation?",
        PendingAction.PauseDaemon => "Pause the projection daemon?",
        PendingAction.ResumeDaemon => "Resume the projection daemon?",
        _ => string.Empty
    };

    /// <summary>
    /// The databases a pause or resume reaches, named in the dialog.
    /// </summary>
    /// <remarks>
    /// The coordinator is per store, not per database: it stops its leadership runner and then every
    /// daemon it has resolved. So the dialog names every database of this store rather than the one the
    /// scope selector is on, because that is the set the operation is actually about.
    /// </remarks>
    private string AffectedDatabases
    {
        get
        {
            IReadOnlyList<string> databases = view?.Daemon.Databases ?? [];

            return databases.Count > 0
                ? string.Join(", ", databases)
                : (State.ActiveScope?.DatabaseId ?? "this store's database");
        }
    }

    /// <summary>
    /// What the confirm dialog of a progression correction adds about where it lands, or nothing.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Marten 9.31 has no per-database form of either correction: asked without a tenant, it runs
    /// against every database of the store (the service's <c>AdvancedAsync</c> says where that was
    /// read), so on a store with more than one database the dialog says so - the same way the pause
    /// dialog says a pause reaches every database - and names the ones this visitor can see. The
    /// service refuses the correction unless the visitor may change every one of them; this sentence is
    /// what makes that refusal unsurprising.
    /// </para>
    /// <para>
    /// The names come from the scope selector's own listing, which is already filtered through the store
    /// policy, so the dialog never names a database the visitor may not address - nor says how many
    /// others there are.
    /// </para>
    /// <para>
    /// <b>With a tenant selected it is still not that tenant's correction.</b> Marten finds the tenant's
    /// database and then runs the same untenanted correction over it: the high-water mark it advances and
    /// the progression rows it rewrites are the database's, and every tenant stored there is read against
    /// them. The dialog says so, because "that tenant's database only" read as "that tenant only", and the
    /// service refuses it unless the visitor may change the database as a whole - or the database holds
    /// no one else (<c>DatabaseReachAuthorization.RequireWholeDatabaseAsync</c>).
    /// </para>
    /// </remarks>
    private string CorrectionReach
    {
        get
        {
            if (State.ActiveScope?.TenantId is { Length: > 0 } tenantId)
            {
                return $" With tenant {tenantId} selected, Marten does this in that tenant's database, and it is "
                    + "not limited to that tenant: the high water mark and the progression rows belong to the "
                    + "database, so every tenant stored in it is affected. It is refused unless you may change "
                    + "that database as a whole, or it holds this tenant and no other.";
            }

            bool several = State.Cardinality is JasperFx.Descriptors.DatabaseCardinality.StaticMultiple
                or JasperFx.Descriptors.DatabaseCardinality.DynamicMultiple;

            if (!several)
            {
                return string.Empty;
            }

            string names = State.AvailableDatabases.Count > 0
                ? ": " + string.Join(", ", State.AvailableDatabases.Select(static x => x.Identity))
                : string.Empty;

            return " With no tenant selected, Marten does this in every database of this store, not only the "
                + $"one selected{names}. It is refused unless you may change every one of them.";
        }
    }

    private string PendingMessage => pending switch
    {
        PendingAction.PauseDaemon =>
            DaemonControlMessages.PauseIsProcessWide
            + $" That is every database this store has here: {AffectedDatabases}. Nothing projects "
            + "asynchronously while it is paused - inline projections are unaffected - and it stays "
            + "paused after you close this page, until somebody resumes it. "
            + DrainSentence,
        PendingAction.ResumeDaemon =>
            "This restarts the projection coordinator, which brings the agents of every database this "
            + $"store has here back up: {AffectedDatabases}. Any agent you started or stopped by hand "
            + "while it was paused goes back to whatever the coordinator decides.",
        PendingAction.AdvanceHighWaterMark =>
            "This moves the high water mark to the latest event sequence. Every async projection then treats "
            + "the events it has not processed as already gone: they will never be projected. This exists for "
            + "retrofitting projections onto a very large event store, and it is not reversible."
            + CorrectionReach,
        PendingAction.CorrectProgression =>
            "This pulls the high water mark and every shard's progression back to the highest real event "
            + "sequence. It only does anything if progression somehow ran ahead of the events themselves."
            + CorrectionReach,
        PendingAction.CancelOperation =>
            "Cancelling a replay leaves the projection partial: its tables were emptied before the replay "
            + "started, so what is in them is whatever had been rewritten when it stopped. Nothing will "
            + "finish it - the projection stays half built until it is rebuilt again.",
        _ => string.Empty
    };

    /// <summary>
    /// Runs one action: report it, refresh, and put any refusal on the screen rather than in the log.
    /// </summary>
    private async Task RunAsync(string success, Func<StudioScope, CancellationToken, Task> action)
    {
        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            return;
        }

        try
        {
            await action(scope, pageCancellation.Token);
            await Toasts.Success(success);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            await Toasts.Error(exception.Message);
        }

        await LoadAsync(pageCancellation.Token);
        await InvokeAsync(StateHasChanged);
    }

    // ------------------------------------------------------------------------------------------------
    // Shaping
    // ------------------------------------------------------------------------------------------------

    /// <summary>
    /// Projections worst first, by the lag of their worst shard, then by name. A projection with nothing
    /// to do sorts under one that is behind, which is the order an operations screen is read in.
    /// </summary>
    private IEnumerable<ProjectionInfo> OrderedProjections
    {
        get
        {
            if (view is null)
            {
                return [];
            }

            return view.Projections
                .OrderByDescending(WorstLagOf)
                .ThenBy(static x => x.Name, StringComparer.OrdinalIgnoreCase);
        }
    }

    private long WorstLagOf(ProjectionInfo projection)
    {
        long worst = 0;
        foreach (ShardProgress shard in ShardsOf(projection))
        {
            worst = Math.Max(worst, shard.Lag);
        }

        return worst;
    }

    /// <summary>
    /// The progress rows belonging to one projection, worst first.
    /// </summary>
    /// <remarks>
    /// Only the rows a registered shard name claims. A progression row whose shard this projection no
    /// longer runs - a version bump that changed the shard keys, say - belongs under "Unregistered
    /// shards", not under a projection that would never advance it.
    /// </remarks>
    private IEnumerable<ShardProgress> ShardsOf(ProjectionInfo projection)
    {
        if (view is null)
        {
            return [];
        }

        return view.Progress.Where(x => x.IsRegistered
            && string.Equals(x.ProjectionName, projection.Name, StringComparison.OrdinalIgnoreCase));
    }

    private string FreshnessLabel => view?.Daemon.IsHostedHere == true ? "live + polling" : "polling";

    private string FreshnessTitle => view is null
        ? string.Empty
        : $"Read {State.FormatInSelectedTimeZone(view.ReadAt)}; refreshed every {Options.Value.RefreshInterval.TotalSeconds:0.#} s and paused while this tab is hidden.";

    /// <summary>When the studio paused this store's coordinator, in the visitor's selected time zone.</summary>
    private string PausedAtText => view?.Daemon.PausedByStudio is { } pause
        ? State.FormatInSelectedTimeZone(pause.PausedAt)
        : string.Empty;

    private string HighWaterAgeText
    {
        get
        {
            if (view?.Daemon.HighWaterAge(DateTimeOffset.UtcNow) is not { } age)
            {
                return string.Empty;
            }

            return age < TimeSpan.FromMinutes(1)
                ? string.Create(CultureInfo.InvariantCulture, $"{age.TotalSeconds:0} s ago")
                : string.Create(CultureInfo.InvariantCulture, $"{age.TotalMinutes:0} min ago");
        }
    }

    public async ValueTask DisposeAsync()
    {
        State.ScopeChanged -= OnScopeChangedAsync;

        if (live is not null)
        {
            live.Failed -= OnRefreshFailedAsync;
            await live.DisposeAsync();
            live = null;
        }

        ReleaseLease();

        await pageCancellation.CancelAsync();
        pageCancellation.Dispose();
    }
}
