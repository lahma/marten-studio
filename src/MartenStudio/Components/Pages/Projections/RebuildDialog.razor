@* The rebuild confirm: what it will do, and the projection's name typed out before it will do it.

   A rebuild deletes the projection's documents and replays every event into them. There is no undo and
   there is no progress bar that can bring the old rows back, so this is the "type the name" severity of
   confirmation rather than the "are you sure" one. It states the scope first - tables, shards, and how
   many events would be replayed - because a person cannot consent to something the dialog did not
   say. *@

@if (IsOpen)
{
    <div class="ms-confirm-overlay ms-rebuild-overlay">
        <div class="ms-confirm-dialog ms-rebuild-dialog" role="dialog" aria-modal="true" aria-labelledby="ms-rebuild-title">
            <h3 id="ms-rebuild-title">Rebuild projection @ProjectionName</h3>

            <p class="ms-rebuild-summary">
                This deletes what <span class="ms-mono">@ProjectionName</span> has written and replays
                <strong>@EventsToReplay.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</strong>
                events into it from the beginning. It cannot be undone.
            </p>

            <div class="ms-kv ms-rebuild-scope">
                <div class="ms-kv-row">
                    <span class="ms-kv-key">Lifecycle</span>
                    <span class="ms-kv-value">@Lifecycle</span>
                </div>
                <div class="ms-kv-row">
                    <span class="ms-kv-key">Shards restarted</span>
                    <span class="ms-kv-value ms-mono">@(Shards.Count == 0 ? "none" : string.Join(", ", Shards))</span>
                </div>
                <div class="ms-kv-row">
                    <span class="ms-kv-key">Tables rewritten</span>
                    <span class="ms-kv-value ms-mono">@(Tables.Count == 0 ? "could not be determined" : string.Join(", ", Tables))</span>
                </div>
                <div class="ms-kv-row">
                    <span class="ms-kv-key">Events to replay</span>
                    <span class="ms-kv-value ms-mono">@EventsToReplay.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
                </div>
            </div>

            @if (!IsAsync)
            {
                <p class="ms-alert ms-alert-warning ms-rebuild-inline-warning" role="note">
                    This projection is <strong>@Lifecycle</strong>, not async. The daemon can still rebuild it,
                    but nothing will keep it up to date afterwards except the next write.
                </p>
            }

            <label class="ms-form-label" for="ms-rebuild-confirm">
                Type <span class="ms-mono">@ProjectionName</span> to confirm
            </label>
            <input id="ms-rebuild-confirm"
                   class="ms-input ms-input-mono ms-rebuild-input"
                   type="text"
                   autocomplete="off"
                   spellcheck="false"
                   value="@typed"
                   @oninput="OnTypedAsync" />

            <div class="ms-confirm-actions">
                <button type="button"
                        class="ms-button ms-button-danger ms-rebuild-confirm"
                        disabled="@(!IsConfirmed)"
                        @onclick="ConfirmAsync">
                    Rebuild @ProjectionName
                </button>
                <button type="button" class="ms-button ms-rebuild-cancel" @onclick="CancelAsync">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private string typed = string.Empty;
    private string? openedFor;

    /// <summary>Whether the dialog is showing.</summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>The projection that would be rebuilt, and the word that has to be typed.</summary>
    [Parameter]
    public string ProjectionName { get; set; } = string.Empty;

    /// <summary>How many events a rebuild would replay: the store's high-water mark.</summary>
    [Parameter]
    public long EventsToReplay { get; set; }

    /// <summary>The shards that would restart.</summary>
    [Parameter]
    public IReadOnlyList<string> Shards { get; set; } = [];

    /// <summary>The tables Marten would rewrite.</summary>
    [Parameter]
    public IReadOnlyList<string> Tables { get; set; } = [];

    /// <summary>The projection's lifecycle, spelled out.</summary>
    [Parameter]
    public string Lifecycle { get; set; } = string.Empty;

    /// <summary>Whether the daemon is what runs this projection.</summary>
    [Parameter]
    public bool IsAsync { get; set; }

    /// <summary>Raised when the name has been typed and the button pressed.</summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>Raised on Cancel.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>Whether what was typed matches the projection's name, exactly.</summary>
    private bool IsConfirmed => string.Equals(typed.Trim(), ProjectionName, StringComparison.Ordinal);

    /// <summary>
    /// Clears the box whenever the dialog opens on a different projection, so a name typed for one
    /// rebuild can never confirm another.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            openedFor = null;
            typed = string.Empty;
            return;
        }

        if (!string.Equals(openedFor, ProjectionName, StringComparison.Ordinal))
        {
            openedFor = ProjectionName;
            typed = string.Empty;
        }
    }

    private void OnTypedAsync(ChangeEventArgs args) => typed = args.Value?.ToString() ?? string.Empty;

    private async Task ConfirmAsync()
    {
        if (!IsConfirmed)
        {
            return;
        }

        await OnConfirm.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        typed = string.Empty;
        await OnCancel.InvokeAsync();
    }
}
