@* The rebuild confirm: what it will do, and the projection's name typed out before it will do it.

   A rebuild deletes the projection's documents and replays every event into them. There is no undo and
   there is no progress bar that can bring the old rows back, so this is the "type the name" severity of
   confirmation rather than the "are you sure" one. It states the scope first - tables, shards, how many
   events would be replayed and how long each shard is given - because a person cannot consent to
   something the dialog did not say.

   The typed confirmation is the shared ConfirmDialog's, not a second implementation of it: this
   component decides what has to be typed and what is shown above the box, and nothing else. *@

<ConfirmDialog IsOpen="IsOpen"
               Title="@($"Rebuild projection {ProjectionName}")"
               Message="@Summary"
               ConfirmationPhrase="@ProjectionName"
               ConfirmText="@($"Rebuild {ProjectionName}")"
               OnConfirm="OnConfirm"
               OnCancel="OnCancel">
    <div class="ms-kv ms-rebuild-scope">
        <div class="ms-kv-row">
            <span class="ms-kv-key">Lifecycle</span>
            <span class="ms-kv-value">@Lifecycle</span>
        </div>
        <div class="ms-kv-row">
            <span class="ms-kv-key">Shards restarted</span>
            <span class="ms-kv-value ms-mono">@(Shards.Count == 0 ? "none" : string.Join(", ", Shards))</span>
        </div>
        <div class="ms-kv-row">
            <span class="ms-kv-key">Tables rewritten</span>
            <span class="ms-kv-value ms-mono">@(Tables.Count == 0 ? "could not be determined" : string.Join(", ", Tables))</span>
        </div>
        <div class="ms-kv-row">
            <span class="ms-kv-key">Events to replay</span>
            <span class="ms-kv-value ms-mono">@EventsToReplay.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
        </div>
        <div class="ms-kv-row ms-rebuild-timeout">
            <span class="ms-kv-key">Time allowed per shard</span>
            <span class="ms-kv-value ms-mono">@TimeoutText</span>
        </div>
    </div>

    <p class="ms-muted ms-rebuild-timeout-note">
        The tables are emptied first and then replayed, so a shard that has not finished within
        @TimeoutText stops with them still empty. Raise
        <code>MartenStudioOptions.RebuildShardTimeout</code> if this store needs longer.
    </p>

    @if (!IsAsync)
    {
        <p class="ms-alert ms-alert-warning ms-rebuild-inline-warning" role="note">
            This projection is <strong>@Lifecycle</strong>, not async. The daemon can still rebuild it,
            but nothing will keep it up to date afterwards except the next write.
        </p>
    }
</ConfirmDialog>

@code {
    /// <summary>Whether the dialog is showing.</summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>The projection that would be rebuilt, and the word that has to be typed.</summary>
    [Parameter]
    public string ProjectionName { get; set; } = string.Empty;

    /// <summary>How many events a rebuild would replay: the store's high-water mark.</summary>
    [Parameter]
    public long EventsToReplay { get; set; }

    /// <summary>The shards that would restart.</summary>
    [Parameter]
    public IReadOnlyList<string> Shards { get; set; } = [];

    /// <summary>The tables Marten would rewrite.</summary>
    [Parameter]
    public IReadOnlyList<string> Tables { get; set; } = [];

    /// <summary>The projection's lifecycle, spelled out.</summary>
    [Parameter]
    public string Lifecycle { get; set; } = string.Empty;

    /// <summary>Whether the daemon is what runs this projection.</summary>
    [Parameter]
    public bool IsAsync { get; set; }

    /// <summary>
    /// How long each shard is given to replay - <c>MartenStudioOptions.RebuildShardTimeout</c>.
    /// </summary>
    /// <remarks>
    /// Shown because it is not a retry budget: Marten tears the projection's tables down before the
    /// timeout starts applying to the replay.
    /// </remarks>
    [Parameter]
    public TimeSpan ShardTimeout { get; set; } = TimeSpan.FromHours(1);

    /// <summary>Raised when the name has been typed and the button pressed.</summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>Raised on Cancel.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string Summary =>
        $"This deletes what {ProjectionName} has written and replays "
        + EventsToReplay.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
        + " events into it from the beginning. It cannot be undone.";

    /// <summary>The timeout in the largest unit that says it without a decimal point.</summary>
    private string TimeoutText
    {
        get
        {
            System.Globalization.CultureInfo culture = System.Globalization.CultureInfo.InvariantCulture;

            if (ShardTimeout.TotalHours >= 1)
            {
                return string.Create(culture, $"{ShardTimeout.TotalHours:0.##} h");
            }

            return ShardTimeout.TotalMinutes >= 1
                ? string.Create(culture, $"{ShardTimeout.TotalMinutes:0.##} min")
                : string.Create(culture, $"{ShardTimeout.TotalSeconds:0.##} s");
        }
    }
}
