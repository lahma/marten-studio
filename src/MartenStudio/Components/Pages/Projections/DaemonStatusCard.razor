@* The daemon card: whether the async daemon is running here, and in plain words when it is not.

   "Not hosted in this process" is a value, not a failure (AGENTS.md hard rule 11): an application whose
   daemon runs elsewhere is a supported deployment, and the page still renders every progress row out of
   the database. Only the buttons go away. *@

<section class="ms-daemon-card ms-daemon-@StateClass" aria-label="Async daemon">
    <header class="ms-daemon-card-header">
        <span class="ms-state-indicator">
            <span class="ms-state-dot ms-state-@StateClass" aria-hidden="true"></span>
            <span class="ms-state-label ms-daemon-headline">@Headline</span>
        </span>
        <span class="ms-badge ms-daemon-mode" title="MartenStudioOptions cannot change this: it is the host's AddAsyncDaemon setting">
            Mode: @Mode
        </span>
    </header>

    <div class="ms-kv ms-daemon-facts">
        <div class="ms-kv-row">
            <span class="ms-kv-key">Hosting</span>
            <span class="ms-kv-value">@(IsHostedHere ? "This process" : "Not this process")</span>
        </div>
        @if (IsHostedHere)
        {
            <div class="ms-kv-row">
                <span class="ms-kv-key">Agents</span>
                <span class="ms-kv-value ms-mono">@AgentCount</span>
            </div>
            <div class="ms-kv-row">
                <span class="ms-kv-key">Paused shards</span>
                <span class="ms-kv-value">@(HasAnyPaused ? "yes" : "none")</span>
            </div>
            <div class="ms-kv-row">
                <span class="ms-kv-key">High water polled</span>
                <span class="ms-kv-value">@(string.IsNullOrWhiteSpace(HighWaterAge) ? "unknown" : HighWaterAge)</span>
            </div>
        }
        <div class="ms-kv-row">
            <span class="ms-kv-key">High water mark</span>
            <span class="ms-kv-value ms-mono">@HighWaterMark.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
        </div>
    </div>

    @if (IsPausedByStudio)
    {
        @* The coordinator has no public paused flag, so this line is the studio reporting what the
           studio did - never an inference from "no agents have been running for a while". *@
        <p class="ms-daemon-explanation ms-daemon-paused-by">
            <strong>Paused by Marten Studio</strong>
            <span class="ms-muted">(@PausedByUser, @PausedAtText)</span>
        </p>

        @if (PauseNoLongerInEffect)
        {
            @* The record and the daemon disagree, and the daemon is the one that is true now: something
               outside this studio resumed the coordinator, so its leadership loop is back and the
               per-agent controls are gone with it. *@
            <p class="ms-daemon-explanation ms-daemon-pause-lifted" role="status">
                <strong>but this daemon reports that it is running.</strong>
                <span class="ms-muted">
                    Something outside Marten Studio resumed it. Pause it again before starting or
                    stopping one agent.
                </span>
            </p>
        }
        else
        {
            <p class="ms-muted ms-daemon-explanation ms-daemon-pause-effect">@ControlExplanation</p>
        }
    }

    @if (!IsHostedHere)
    {
        <p class="ms-muted ms-daemon-explanation">@Explanation</p>
    }

    @if (ChildContent is not null)
    {
        <div class="ms-daemon-card-content">@ChildContent</div>
    }
</section>

@code {
    /// <summary>Whether a coordinator answered for this database in this process.</summary>
    [Parameter]
    public bool IsHostedHere { get; set; }

    /// <summary>Whether that daemon says it is running.</summary>
    [Parameter]
    public bool IsRunning { get; set; }

    /// <summary>The configured daemon mode - Disabled, Solo or HotCold.</summary>
    [Parameter]
    public string Mode { get; set; } = "Unknown";

    /// <summary>How many agents the daemon currently has.</summary>
    [Parameter]
    public int AgentCount { get; set; }

    /// <summary>Whether any shard is paused.</summary>
    [Parameter]
    public bool HasAnyPaused { get; set; }

    /// <summary>How long ago the high-water agent polled, already formatted.</summary>
    [Parameter]
    public string? HighWaterAge { get; set; }

    /// <summary>The store's highest event sequence.</summary>
    [Parameter]
    public long HighWaterMark { get; set; }

    /// <summary>Plain words about the state, shown when the daemon is not hosted here.</summary>
    [Parameter]
    public string Explanation { get; set; } = string.Empty;

    /// <summary>
    /// Whether Marten Studio itself paused this store's projection coordinator.
    /// </summary>
    /// <remarks>
    /// Only ever what this process recorded doing. There is no public "is paused" on
    /// <c>IProjectionCoordinator</c>, so a daemon paused by something else - or by a studio in another
    /// process - draws as "hosted, stopped" and says nothing it cannot know.
    /// </remarks>
    [Parameter]
    public bool IsPausedByStudio { get; set; }

    /// <summary>Who paused it, as the audit entry names them.</summary>
    [Parameter]
    public string? PausedByUser { get; set; }

    /// <summary>When they paused it, already formatted in the visitor's selected time zone.</summary>
    [Parameter]
    public string? PausedAtText { get; set; }

    /// <summary>One sentence on what pausing actually reaches, shown while it is paused.</summary>
    [Parameter]
    public string ControlExplanation { get; set; } = string.Empty;

    /// <summary>The controls the page puts inside the card, so the card owns no gating of its own.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether the studio's recorded pause and the daemon's own answer disagree.
    /// </summary>
    /// <remarks>
    /// <c>JasperFxAsyncDaemon.IsRunning</c> is its high-water agent's, and the coordinator's
    /// <c>PauseAsync()</c> stops that agent - so a pause that still holds reports
    /// <see cref="IsRunning" /> <see langword="false" />. Both true at once means somebody resumed the
    /// coordinator outside this studio, and the card must say that rather than keep claiming a pause
    /// which no longer stops anything.
    /// </remarks>
    private bool PauseNoLongerInEffect => IsHostedHere && IsPausedByStudio && IsRunning;

    private string Headline => (IsHostedHere, IsPausedByStudio, IsRunning, HasAnyPaused) switch
    {
        (false, _, _, _) => "Not hosted in this process",
        (true, true, true, _) => "Hosted and running - the studio's pause is no longer in effect",
        (true, true, false, _) => "Hosted, paused by Marten Studio",
        (true, false, false, _) => "Hosted, stopped",
        (true, false, true, true) => "Hosted, running, paused shards",
        _ => "Hosted and running"
    };

    private string StateClass => (IsHostedHere, IsPausedByStudio, IsRunning, HasAnyPaused) switch
    {
        (false, _, _, _) => "info",
        (true, true, _, _) => "paused",
        (true, false, false, _) => "error",
        (true, false, true, true) => "paused",
        _ => "success"
    };
}
