@using MartenStudio.Services.Live
@inject IJSRuntime JsRuntime

@*
    The three copy actions of the document detail header, in one menu.

    They were three loose buttons in a header of nine, two of which - Copy JSON and Download - were also
    repeated verbatim in the JSON viewer's own toolbar sixty pixels below. Nine equal-weight buttons say
    nothing about which of them a person wants, and on a phone they wrapped into three rows before the
    document itself had started. Folding the three copies into one menu leaves the header with six
    controls and one obvious primary pair.

    The mechanism is the platform's own popover, the same one JsonCopyMenu and CapabilityBanner use: no
    positioning library and no third-party menu component (AGENTS.md hard rule 3), and light dismiss and
    Escape for free.

    role="menu" is a promise about the keyboard rather than a label. A menu is one tab stop, and inside it
    the arrow keys, Home and End move a roving tabindex between the items - the pattern is lifted from
    JsonCopyMenu rather than re-invented, down to the shared focus helper it calls. Keeping the role and
    leaving three tab stops behind would tell a screen-reader user this is a menu and then behave like a
    row of buttons.
*@

<span class="ms-doc-copy-menu">
    <button type="button"
            class="ms-btn ms-btn-sm ms-doc-copy-menu-button"
            popovertarget="@ElementId"
            aria-controls="@ElementId"
            aria-haspopup="menu"
            aria-expanded="@(open ? "true" : "false")"
            title="Copy this document, its id, or a C# record for it">
        <span>Copy</span>
        @Chevron
    </button>

    @* `ontoggle` is what keeps aria-expanded honest: Escape and a click anywhere else close this
       popover without the circuit hearing anything. The event fires once per transition and the
       transitions strictly alternate, so flipping the flag is exact. *@
    <div id="@ElementId"
         popover="auto"
         class="ms-doc-copy-popover"
         role="menu"
         aria-label="@($"Copy from {Label}")"
         @ontoggle="OnToggledAsync"
         @onkeydown="OnKeyDownAsync">
        @for (var i = 0; i < items.Count; i++)
        {
            var index = i;
            MenuItem item = items[index];

            <button type="button"
                    id="@ItemId(index)"
                    class="ms-menu-item"
                    role="menuitem"
                    tabindex="@(index == activeIndex ? 0 : -1)"
                    popovertarget="@ElementId"
                    popovertargetaction="hide"
                    @key="index"
                    @onclick="() => CopyAsync(index)">
                <span class="ms-menu-item-label">@item.Label</span>
                <span class="ms-menu-item-detail">@item.Detail</span>
            </button>
        }
    </div>
</span>

@code {
    private static readonly MarkupString Chevron = new(
        """<svg class="ms-btn-glyph" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4,7 9,12 14,7" /></svg>""");

    private IReadOnlyList<MenuItem> items = [];
    private int activeIndex;
    private bool open;

    /// <summary>
    /// The DOM id the button's <c>popovertarget</c> points at. A parameter so a second menu on one page
    /// would not collide with this one, though today there is exactly one.
    /// </summary>
    [Parameter]
    public string ElementId { get; set; } = "ms-doc-copy-menu";

    /// <summary>What the menu is about, for its accessible name: the document's id.</summary>
    [Parameter]
    public string Label { get; set; } = "this document";

    /// <summary>The document id, shown beside "Copy id" so the item says what it will put on the clipboard.</summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    /// <summary>Copies the document exactly as it is stored.</summary>
    [Parameter]
    public EventCallback OnCopyJson { get; set; }

    /// <summary>Copies the id.</summary>
    [Parameter]
    public EventCallback OnCopyId { get; set; }

    /// <summary>Copies a C# record that would deserialize this document.</summary>
    [Parameter]
    public EventCallback OnCopyRecord { get; set; }

    protected override void OnParametersSet() =>
        items =
        [
            new MenuItem("Copy JSON", "the document exactly as it is stored", OnCopyJson),
            new MenuItem("Copy id", Id, OnCopyId),
            new MenuItem("Copy as C# record", "a record that would deserialize this document", OnCopyRecord),
        ];

    private string ItemId(int index) =>
        ElementId + "-item-" + index.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private Task CopyAsync(int index) =>
        index >= 0 && index < items.Count ? items[index].Invoke.InvokeAsync() : Task.CompletedTask;

    /// <summary>
    /// Moves focus into the menu when the browser opens it. A <c>popover="auto"</c> opened through
    /// <c>popovertarget</c> does not focus anything on its own, so without this the roving tabindex has
    /// nothing to rove and the arrow keys below would never be reached.
    /// </summary>
    private async Task OnToggledAsync()
    {
        open = !open;

        if (!open)
        {
            return;
        }

        activeIndex = 0;
        await FocusItemAsync(0);
    }

    /// <summary>
    /// The menu keyboard pattern: one tab stop, arrows and Home/End inside it. Tab is left alone, because
    /// leaving is what Tab is for; Escape is left alone too, because the popover's own light dismiss
    /// already closes on it.
    /// </summary>
    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (items.Count == 0 || args.CtrlKey || args.AltKey || args.MetaKey)
        {
            return;
        }

        var next = args.Key switch
        {
            "ArrowDown" => (activeIndex + 1) % items.Count,
            "ArrowUp" => (activeIndex - 1 + items.Count) % items.Count,
            "Home" => 0,
            "End" => items.Count - 1,
            _ => -1,
        };

        if (next < 0)
        {
            return;
        }

        activeIndex = next;
        await FocusItemAsync(next);
    }

    private async Task FocusItemAsync(int index)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("martenStudio.json.focusElement", ItemId(index));
        }
        catch (Exception e) when (StudioLiveUpdates.IsInteropUnavailable(e))
        {
            // Prerender, or a circuit that closed while the menu was open. Focus is a courtesy; the
            // items are still reachable with the mouse and with Tab.
        }
    }

    /// <summary>One offer in the menu: what it says, what it says about itself, and what it does.</summary>
    private readonly record struct MenuItem(string Label, string Detail, EventCallback Invoke);
}
