@*
    The three copy actions of the document detail header, in one menu.

    They were three loose buttons in a header of nine, two of which - Copy JSON and Download - were also
    repeated verbatim in the JSON viewer's own toolbar sixty pixels below. Nine equal-weight buttons say
    nothing about which of them a person wants, and on a phone they wrapped into three rows before the
    document itself had started. Folding the three copies into one menu leaves the header with six
    controls and one obvious primary pair.

    The menu itself - the native popover, role="menu", the roving tabindex and the shared focus helper - is
    MenuButton now, which the database browser's object header uses as well. What is left here is what is
    this menu's own: its three offers, and the ms-doc-copy-* classes its anchor and placement rules in the
    stylesheet are written against.
*@

<MenuButton ElementId="@ElementId"
            WrapperClass="ms-doc-copy-menu"
            ButtonClass="ms-btn ms-btn-sm ms-doc-copy-menu-button"
            PopoverClass="ms-doc-copy-popover"
            Text="Copy"
            Title="Copy this document, its id, or a C# record for it"
            Label="@($"Copy from {Label}")"
            Items="items" />

@code {
    private IReadOnlyList<(string Label, string? Detail, Func<Task> OnSelect)> items = [];

    /// <summary>
    /// The DOM id the button's <c>popovertarget</c> points at. A parameter so a second menu on one page
    /// would not collide with this one, though today there is exactly one.
    /// </summary>
    [Parameter]
    public string ElementId { get; set; } = "ms-doc-copy-menu";

    /// <summary>What the menu is about, for its accessible name: the document's id.</summary>
    [Parameter]
    public string Label { get; set; } = "this document";

    /// <summary>The document id, shown beside "Copy id" so the item says what it will put on the clipboard.</summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    /// <summary>Copies the document exactly as it is stored.</summary>
    [Parameter]
    public EventCallback OnCopyJson { get; set; }

    /// <summary>Copies the id.</summary>
    [Parameter]
    public EventCallback OnCopyId { get; set; }

    /// <summary>Copies a C# record that would deserialize this document.</summary>
    [Parameter]
    public EventCallback OnCopyRecord { get; set; }

    protected override void OnParametersSet() =>
        items =
        [
            ("Copy JSON", "the document exactly as it is stored", () => OnCopyJson.InvokeAsync()),
            ("Copy id", Id, () => OnCopyId.InvokeAsync()),
            ("Copy as C# record", "a record that would deserialize this document", () => OnCopyRecord.InvokeAsync()),
        ];
}
