@using MartenStudio.Services
@inject StudioCapabilityGuard Capabilities

@*
    The three controls that change a document: Edit, Delete and Undelete.

    The gating rule is the plan's, and it has three levels rather than two on purpose (D4). Under
    `ReadOnly` nothing is rendered at all - a studio a host mounted read-only should not read like a
    product with the buttons greyed out, because there is nothing the person looking at it can do about
    it. With `ReadOnly` off and one capability off, the control *is* rendered, disabled, naming the exact
    option a host would set: that is the case where somebody can act on it. And for a collection the
    studio only discovered - a table no mapping claims - nothing is rendered either, because there is no
    CLR type to write it as and no amount of configuration changes that.

    There is a fourth level, and it is per person rather than per process: a capability is a property of
    the application, while `MartenStudioOptions.WriteAuthorizationPolicy` is asked about the visitor. A
    studio with EditDocuments on, mounted for a team where only two people may write, showed everybody a
    live Edit button and told the other forty only after they had pressed it. So the page evaluates the
    write policy for this scope and hands the answer down as `MayEdit` / `MayDelete`, and a refusal
    renders the control disabled - disabled rather than hidden, because "this studio can edit documents
    and your account may not" is a different fact from "this studio cannot edit documents", and somebody
    who cannot see the first one goes and asks the wrong question.

    None of this is the enforcement. `IDocumentWriteService` refuses on its own, in the service layer,
    for every one of these reasons and several this component cannot see (AGENTS.md hard rule 5). What is
    here is the part a person reads.
*@

@if (!Capabilities.ReadOnly && Writable)
{
    <div class="ms-doc-write-actions">
        @if (!Editing)
        {
            <button type="button"
                    class="ms-btn ms-btn-sm ms-doc-edit-btn"
                    disabled="@(!EditAllowed)"
                    title="@EditTitle"
                    @onclick="OnEdit">Edit</button>
        }

        @if (IsDeleted && SoftDeleteType)
        {
            <button type="button"
                    class="ms-btn ms-btn-sm ms-doc-undelete-btn"
                    disabled="@(!DeleteAllowed || Busy)"
                    title="@DeleteTitle"
                    @onclick="OnUndelete">Undelete</button>
        }
        else if (!IsDeleted)
        {
            <button type="button"
                    class="ms-btn ms-btn-sm ms-btn-danger ms-doc-delete-btn"
                    disabled="@(!DeleteAllowed || Busy)"
                    title="@DeleteTitle"
                    @onclick="OnDelete">@(SoftDeleteType ? "Soft-delete" : "Delete")</button>
        }

        @* Said out loud as well as in the buttons' titles: a tooltip does not exist on a touch screen,
           and this is the one refusal a person cannot work out from the screen on their own. *@
        @if (PolicyRefusal is { Length: > 0 } refusal)
        {
            <span class="ms-write-refusal" role="note">@refusal</span>
        }
    </div>
}

@code {
    /// <summary>
    /// Whether this collection can be written at all: a registered mapping, and not one of Marten's own
    /// bookkeeping types. A discovered table has no CLR type to deserialize into and dead letters answer
    /// to <c>ManageDeadLetters</c> on a screen of their own, so neither gets these buttons.
    /// </summary>
    [Parameter]
    public bool Writable { get; set; }

    /// <summary>Whether the collection's delete style is soft, which is what makes undelete possible.</summary>
    [Parameter]
    public bool SoftDeleteType { get; set; }

    /// <summary>Whether this row is soft-deleted right now.</summary>
    [Parameter]
    public bool IsDeleted { get; set; }

    /// <summary>Whether the editor is already open, in which case Edit is not offered again.</summary>
    [Parameter]
    public bool Editing { get; set; }

    /// <summary>Whether a write is in flight.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// Why editing is impossible for this particular document even though the capability is on - a type
    /// the round trip could not construct, most often. Non-null disables Edit and becomes its title.
    /// </summary>
    [Parameter]
    public string? EditRefusal { get; set; }

    /// <summary>
    /// Whether <see cref="MartenStudioOptions.WriteAuthorizationPolicy" /> lets <em>this</em> visitor edit
    /// documents in the scope on screen.
    /// </summary>
    /// <remarks>
    /// Evaluated once per load by the page, which holds the scope, and handed down: a component that
    /// asked for itself would put an <c>await</c> in a render path and would ask again for every
    /// document. The default is <see langword="true" /> because the overwhelmingly common case is a host
    /// that configured no write policy at all, and a studio that greyed out Edit for everyone because a
    /// caller forgot a parameter would be worse than useless. Fail-open is safe precisely because this is
    /// not the enforcement - <c>IDocumentWriteService</c> asks the same policy again and throws
    /// (AGENTS.md hard rule 5).
    /// </remarks>
    [Parameter]
    public bool MayEdit { get; set; } = true;

    /// <summary>
    /// The same question for deleting and undeleting. Separate from <see cref="MayEdit" /> because they
    /// are two capabilities and a policy is free to allow one and refuse the other.
    /// </summary>
    [Parameter]
    public bool MayDelete { get; set; } = true;

    /// <summary>Opens the editor.</summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>Opens the delete confirmation.</summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>Brings a soft-deleted document back.</summary>
    [Parameter]
    public EventCallback OnUndelete { get; set; }

    /// <summary>What a visitor the write policy refuses is told, per capability.</summary>
    internal const string EditRefusedByPolicy = "Your account may not edit documents here.";

    /// <summary>The same, for delete and undelete.</summary>
    internal const string DeleteRefusedByPolicy = "Your account may not delete documents here.";

    private bool EditCapability => Capabilities.IsEnabled(StudioCapability.EditDocuments);

    private bool DeleteCapability => Capabilities.IsEnabled(StudioCapability.DeleteDocuments);

    private bool DeleteAllowed => DeleteCapability && MayDelete;

    private bool EditAllowed => EditCapability && MayEdit && EditRefusal is null && !Busy;

    /// <summary>
    /// The capability's name first, the visitor's refusal second: a capability that is off makes the
    /// policy moot, because the guard refuses before the scope is ever resolved.
    /// </summary>
    private string EditTitle => !EditCapability
        ? Requires(StudioCapability.EditDocuments)
        : !MayEdit
            ? EditRefusedByPolicy
            : EditRefusal ?? "Edit this document's JSON";

    private string DeleteTitle => !DeleteCapability
        ? Requires(StudioCapability.DeleteDocuments)
        : !MayDelete
            ? DeleteRefusedByPolicy
            : IsDeleted
                ? "Clear the deleted flag on this row"
                : SoftDeleteType
                    ? "Mark this document deleted; it can be undeleted"
                    : "Remove this row from the table";

    /// <summary>
    /// The one sentence under the buttons, when the policy - and not a capability - is what refused.
    /// Nothing is said where a capability is already off: that case names the option out loud in the
    /// button's own title and is about the application rather than about the person.
    /// </summary>
    private string? PolicyRefusal
    {
        get
        {
            bool editRefused = EditCapability && !MayEdit && !Editing;
            bool deleteRefused = DeleteCapability && !MayDelete;

            return (editRefused, deleteRefused) switch
            {
                (true, true) => "Your account may not edit or delete documents here.",
                (true, false) => EditRefusedByPolicy,
                (false, true) => DeleteRefusedByPolicy,
                _ => null
            };
        }
    }

    private static string Requires(StudioCapability capability) =>
        "Requires " + StudioCapabilityGuard.OptionName(capability);
}
