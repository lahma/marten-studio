@page "/marten/relationships"
@using Microsoft.Extensions.Options
@using MartenStudio.Components.Pages.Documents
@using MartenStudio.Services.Documents
@using MartenStudio.Services.Relationships
@using GraphModel = MartenStudio.Services.Relationships.RelationshipGraph
@implements IDisposable
@inject IRelationshipDataService RelationshipData
@inject StudioState State
@inject IOptions<MartenStudioOptions> Options
@inject NavigationManager Navigation

@*
    The Relationships screen: one node per document type, one per table beside them the visitor may see,
    one arrow per foreign key.

    One read per navigation and no polling (D10 lists the pages that poll; this is not one of them). A
    store's foreign keys change when somebody deploys a migration, not second by second, so a refresh
    button is the honest affordance and a timer would be one more query per circuit per interval for a
    picture that is the same every time.

    Tables arrive only when some table takes part in a key. Until then there is no view switch, no schema
    chip and no cap: the screen is exactly the document-type diagram it always was. Once there are, the
    view (?view=documents|tables|both) and the schema chip (?schema=) live in the URL, so a pasted link
    reopens the same picture (D9) - and every view is a pure function of one read, so switching costs
    nothing and the picture and the table can never disagree.
*@

<PageTitle>Relationships</PageTitle>

<div class="ms-page ms-rel-page">
    <div class="ms-page-header">
        <h1 class="ms-page-title">Relationships</h1>
    </div>

    @if (graph.Tables.Count > 0)
    {
        <p class="ms-schema-note">
            Every foreign key between this store's document types, as <code>StoreOptions</code> declares them
            and as Postgres actually has them, and between them and the other tables of this database that you
            may see. Counts are <code>pg_class</code> estimates; nothing on this screen writes anything.
        </p>
    }
    else
    {
        <p class="ms-schema-note">
            Every foreign key between this store's document types, as <code>StoreOptions</code> declares them
            and as Postgres actually has them. Counts are <code>pg_class</code> estimates; nothing on this
            screen writes anything.
        </p>
    }

    @if (Drawing && graph.HasTableEdges)
    {
        <div class="ms-graph-toolbar">
            <div class="ms-segmented ms-graph-views" role="group" aria-label="Which relationships to draw">
                @ViewButton(RelationshipViewMode.Documents, "Documents", projection.DocumentEdges)
                @ViewButton(RelationshipViewMode.Tables, "Tables", projection.TableEdges)
                @ViewButton(RelationshipViewMode.Both, "Both", projection.AllEdges)
            </div>

            @if (view != RelationshipViewMode.Documents && projection.Schemas.Count > 0)
            {
                <div class="ms-graph-schemas" role="group" aria-label="Schemas">
                    <button type="button"
                            class="ms-graph-schema-chip"
                            aria-pressed="@(schema is null ? "true" : "false")"
                            @onclick="() => SelectSchema(null)">All schemas</button>
                    @foreach (RelationshipSchemaChip chip in projection.Schemas)
                    {
                        <button type="button"
                                class="ms-graph-schema-chip"
                                style="--ms-collection-hue: @chip.Hue"
                                aria-pressed="@(string.Equals(schema, chip.Schema, StringComparison.Ordinal) ? "true" : "false")"
                                title="@($"{chip.Tables} tables of {chip.Schema} take part in a foreign key")"
                                @key="chip.Schema"
                                @onclick="() => SelectSchema(chip.Schema)">
                            <span class="ms-graph-schema-chip-dot" aria-hidden="true"></span>
                            @chip.Schema
                            <span class="ms-graph-view-count">@chip.Tables</span>
                        </button>
                    }
                </div>
            }
        </div>
    }

    @* The legend and the refresh sit on the diagram's own top edge, next to what they describe. The bar is
       drawn in every state and at the same place in the render tree, so Refresh is one element before,
       during and after a read rather than a button torn down and drawn again somewhere else. *@
    <div class="ms-graph-bar">
        @if (Drawing)
        {
            <RelationshipLegend Styles="@styles" />
        }
        <div class="ms-graph-actions">
            @if (!loading && graph.ReadAt != DateTimeOffset.MinValue)
            {
                <span class="ms-graph-readat">Read @State.FormatInSelectedTimeZone(graph.ReadAt)</span>
            }
            <button type="button" class="ms-button" @onclick="LoadAsync" disabled="@loading">Refresh</button>
        </div>
    </div>

    @if (loading)
    {
        <LoadingSpinner />
    }
    else if (graph.Error is { Length: > 0 } error)
    {
        <ErrorAlert Message="@error" OnRetry="LoadAsync" />
    }
    else if (State.ActiveScope is null)
    {
        <div class="ms-empty">
            <p class="ms-empty-title">No Marten store to show</p>
            <p class="ms-empty-description">
                This application registered no Marten store that you are authorized to see.
            </p>
        </div>
    }
    else if (graph.IsEmpty)
    {
        @if (graph.Tables.Count > 0)
        {
            <div class="ms-empty">
                <p class="ms-empty-title">No foreign keys connect the document types and tables you can see</p>
                <p class="ms-empty-description">
                    A table's keys are its own: <code>REFERENCES</code> in its DDL, which this screen draws as soon
                    as Postgres has one. Between document types, Marten declares one with
                    <code>opts.Schema.For&lt;Order&gt;().ForeignKey&lt;Customer&gt;(x =&gt; x.CustomerId)</code>,
                    and into a table with <code>ForeignKey(x =&gt; x.CustomerId, "schema", "table", "column")</code>.
                </p>
            </div>
        }
        else
        {
            <div class="ms-empty">
                <p class="ms-empty-title">No foreign keys are declared between the document types of this store</p>
                <p class="ms-empty-description">
                    Marten declares one with
                    <code>opts.Schema.For&lt;Order&gt;().ForeignKey&lt;Customer&gt;(x =&gt; x.CustomerId)</code>,
                    which duplicates the member into its own column and puts a real constraint on it.
                </p>
            </div>
        }

        @Notes()
    }
    else
    {
        @if (projection.OverCap)
        {
            <div class="ms-graph-toomany" role="status">
                <p class="ms-graph-toomany-title">@projection.DrawnNodes objects are too many to draw — pick a schema or a view.</p>
                <p class="ms-graph-toomany-description">
                    Every foreign key of this view is still in the table below.
                </p>
            </div>
        }
        else
        {
            <RelationshipGraph Model="@projection.Drawn" HrefFor="@CollectionHref" TableHrefFor="@TableHref" />
        }

        @* What has no key at all, as chips right under the picture: drawn, a dozen unconnected boxes filled
           the diagram's first column. Only where tables take part in keys, and never in the Documents view,
           which draws every document type as the screen always has. *@
        @if (view != RelationshipViewMode.Documents && graph.HasTableEdges && projection.IsolatedDocuments.Count + projection.Isolated.Count > 0)
        {
            <div class="ms-graph-isolated">
                <h2 class="ms-section-title">No foreign keys</h2>
                <ul class="ms-graph-isolated-list" aria-label="Document types and tables with no foreign key">
                    @foreach (RelationshipNode document in projection.IsolatedDocuments)
                    {
                        <li @key="@("d:" + document.Alias)">
                            <a class="ms-graph-row-link" href="@CollectionHref(document.Alias)" title="@($"{document.Alias} - {document.DisplayName}: no foreign key from or to it")">
                                <CollectionChip Alias="@document.Alias" Hue="@document.Hue" Small="true" />
                            </a>
                        </li>
                    }
                    @foreach (RelationshipTableNode table in projection.Isolated.Take(IsolatedLimit))
                    {
                        <li @key="@("t:" + table.Key)">
                            <a class="ms-graph-row-link" href="@TableHref(table.Schema, table.Name)">
                                <TableChip Schema="@table.Schema" Name="@table.Name" Hue="@table.Hue" Small="true" />
                            </a>
                        </li>
                    }
                </ul>
                @if (projection.Isolated.Count > IsolatedLimit)
                {
                    <p class="ms-schema-note">And @(projection.Isolated.Count - IsolatedLimit) more tables - pick a schema to see them.</p>
                }
            </div>
        }

        <div class="ms-graph-table-panel">
            <h2 class="ms-section-title">Relationships</h2>
            @if (projection.Drawn.Edges.Count == 0)
            {
                <p class="ms-schema-note">No foreign key is drawn in this view.</p>
            }
            <RelationshipTable Model="@projection.Drawn" HrefFor="@CollectionHref" TableHrefFor="@TableHref" />
        </div>

        @Notes()

        @if (graph.Unmatched.Count > 0)
        {
            <div class="ms-graph-unmatched">
                <h2 class="ms-section-title">Not on the diagram</h2>
                <p class="ms-schema-note">
                    These foreign keys have an end that is not a document type of this store, so there is
                    nothing to draw them between.
                </p>
                <TableScroll Label="Foreign keys not on the diagram table">
                    <table class="ms-table">
                        <thead>
                            <tr>
                                <th scope="col">Constraint</th>
                                <th scope="col">From</th>
                                <th scope="col">Columns</th>
                                <th scope="col">Points at</th>
                                <th scope="col">Why</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < graph.Unmatched.Count; i++)
                            {
                                UnmatchedForeignKey key = graph.Unmatched[i];

                                <tr class="ms-table-row" @key="i">
                                    <td class="ms-table-cell ms-table-cell-mono">@key.Name</td>
                                    <td class="ms-table-cell ms-table-cell-mono">@key.From</td>
                                    <td class="ms-table-cell ms-table-cell-mono">@key.Columns</td>
                                    <td class="ms-table-cell ms-table-cell-mono">@key.To</td>
                                    <td class="ms-table-cell">@key.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </TableScroll>
            </div>
        }
    }
</div>

@code {
    /// <summary>How many isolated tables are listed before "and N more".</summary>
    private const int IsolatedLimit = 200;

    private readonly CancellationTokenSource lifetime = new();

    private GraphModel graph = GraphModel.None;
    private RelationshipProjection projection = RelationshipViews.Project(GraphModel.None, RelationshipViewMode.Both, null);
    private IReadOnlyList<string> styles = [];
    private bool loading = true;

    private RelationshipViewMode view = RelationshipViewMode.Both;
    private string? schema;
    private string? seenView;
    private string? seenSchema;
    private bool seenParameters;

    /// <summary>The view, as the URL carries it: <c>documents</c>, <c>tables</c> or <c>both</c> (the default).</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewToken { get; set; }

    /// <summary>The schema chip, as the URL carries it.</summary>
    [SupplyParameterFromQuery(Name = "schema")]
    public string? SchemaToken { get; set; }

    /// <summary>Whether the picture and its table are on screen - the branch the view switch and the legend belong to.</summary>
    private bool Drawing =>
        !loading && graph.Error is not { Length: > 0 } && State.ActiveScope is not null && !graph.IsEmpty;

    protected override async Task OnInitializedAsync()
    {
        State.ScopeChanged += OnScopeChangedAsync;

        // Idempotent, and normally already done by StudioLayout. Called here so the page also works when
        // it is the only thing rendered, which is what a component test does.
        await State.EnsureInitializedAsync();
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        // The URL is the authority whenever it changes - a pasted link, the back button - and only then:
        // a click sets the state first and the navigation it makes then agrees with it.
        if (!seenParameters || !string.Equals(ViewToken, seenView, StringComparison.Ordinal))
        {
            view = RelationshipViews.Parse(ViewToken);
            seenView = ViewToken;
        }

        if (!seenParameters || !string.Equals(SchemaToken, seenSchema, StringComparison.Ordinal))
        {
            schema = string.IsNullOrWhiteSpace(SchemaToken) ? null : SchemaToken;
            seenSchema = SchemaToken;
        }

        seenParameters = true;
        Recompute();
    }

    private async Task LoadAsync()
    {
        loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            StudioScope? scope = State.ActiveScope;

            graph = scope is null
                ? GraphModel.None
                : await RelationshipData.GetGraphAsync(scope, lifetime.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            // The service answers with a value rather than throwing, so reaching here means something
            // outside it did - the scope refusing to resolve, most likely. On the page either way: a
            // failure the visitor cannot see is a page that silently shows nothing.
            graph = GraphModel.Failed(exception.Message, DateTimeOffset.UtcNow);
        }
        finally
        {
            Recompute();
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Recompute()
    {
        projection = RelationshipViews.Project(graph, view, schema);
        styles = RelationshipViews.Styles(projection.Drawn.Edges);
    }

    private void SelectView(RelationshipViewMode mode)
    {
        view = mode;
        Recompute();
        Navigation.NavigateTo(MartenStudio.Services.Database.DatabaseLinks.ToRelationships(Options.Value, State.ActiveScope, view, schema));
    }

    private void SelectSchema(string? chip)
    {
        schema = chip;
        Recompute();
        Navigation.NavigateTo(MartenStudio.Services.Database.DatabaseLinks.ToRelationships(Options.Value, State.ActiveScope, view, schema));
    }

    private RenderFragment ViewButton(RelationshipViewMode mode, string label, int count) => __builder =>
    {
        bool on = view == mode;

        <button type="button"
                class="ms-segmented-option @(on ? "ms-segmented-option-on" : null)"
                aria-pressed="@(on ? "true" : "false")"
                title="@($"{count} foreign keys")"
                @onclick="() => SelectView(mode)">
            @label <span class="ms-graph-view-count">@count</span>
        </button>
    };

    /// <summary>What the picture leaves out, said once below it: withheld keys, a gate that failed, a cap.</summary>
    private RenderFragment Notes() => __builder =>
    {
        if (graph.Withheld.Count > 0)
        {
            <p class="ms-graph-withheld" role="note">
                @(graph.Withheld.Count == 1
                    ? "1 foreign key connects what is shown here to a schema this studio does not show you."
                    : $"{graph.Withheld.Count} foreign keys connect what is shown here to schemas this studio does not show you.")
            </p>
        }

        if (graph.TablesUnavailable is { Length: > 0 } unavailable)
        {
            <p class="ms-graph-withheld" role="note">Only document types are drawn: @unavailable</p>
        }

        if (graph.Truncated)
        {
            <p class="ms-graph-withheld" role="note">
                The database holds more tables or keys than the studio reads at once, so this picture is partial.
                Narrow MartenStudioOptions.BrowsableSchemas to see all of one part of it.
            </p>
        }
    };

    /// <summary>
    /// The link to a collection's list, scope and all. Built through <c>DocumentLinks</c> rather than by
    /// hand: the scope travels in the query string (D9), and a diagram whose nodes dropped it would send
    /// every click to the default store.
    /// </summary>
    private string CollectionHref(string alias) =>
        DocumentLinks.ToCollection(Options.Value, State.ActiveScope, alias);

    /// <summary>The link to a table's object detail, scope and all.</summary>
    private string TableHref(string tableSchema, string name) =>
        MartenStudio.Services.Database.DatabaseLinks.ToObject(Options.Value, State.ActiveScope, tableSchema, name);

    private async Task OnScopeChangedAsync() => await LoadAsync();

    public void Dispose()
    {
        State.ScopeChanged -= OnScopeChangedAsync;
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
