@using MartenStudio.Components.Pages.Documents
@using MartenStudio.Services.Relationships
@using GraphModel = MartenStudio.Services.Relationships.RelationshipGraph

@*
    The foreign-key diagram: a relationship graph handed to the neutral GraphDiagram.

    Everything about what the picture *means* is decided here and in RelationshipDiagram - a document type
    is a rounded box linking to its collection, a table is a square box linking to its object detail and
    coloured by its schema, a key on a document table keeps the declared/physical drift styles and a key on
    somebody else's table is solid, or dashed when Postgres has not validated it. Everything about how it is
    *drawn* is GraphDiagram's, which is why a store with no tables draws exactly the picture it always did:
    the same classes, the same geometry, the same tooltips.
*@

<GraphDiagram Model="@diagram" />

@code {
    /// <summary>
    /// The graph, as a <c>RelationshipGraph</c> - already cut down to what is drawn. Typed
    /// <see cref="object" /> for the reason <see cref="DocumentComponentModel" /> records.
    /// </summary>
    [Parameter]
    public object? Model { get; set; }

    /// <summary>Builds the link to a collection's documents list.</summary>
    [Parameter]
    public Func<string, string> HrefFor { get; set; } = static _ => "#";

    /// <summary>Builds the link to a table's object detail, from its schema and name.</summary>
    [Parameter]
    public Func<string, string, string> TableHrefFor { get; set; } = static (_, _) => "#";

    /// <summary>The node the picture is about - a document alias or a table's key - drawn emphasised.</summary>
    [Parameter]
    public string? Centre { get; set; }

    private GraphDiagramModel diagram = GraphDiagramModel.Empty;

    protected override void OnParametersSet()
    {
        GraphModel graph = DocumentComponentModel.Read(Model, GraphModel.None);

        diagram = RelationshipDiagram.From(graph, HrefFor, TableHrefFor, Centre);
    }
}
