@page "/marten/events/dead-letters"
@using System.Globalization
@using Microsoft.Extensions.Options
@using MartenStudio.Components.Json
@using MartenStudio.Services
@using MartenStudio.Services.Events
@using MartenStudio.Services.Projections
@implements IAsyncDisposable
@inject IEventDataService Events
@inject IProjectionDataService ProjectionData
@inject StudioState State
@inject StudioCapabilityGuard Capabilities
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject IOptions<MartenStudioOptions> Options

<PageTitle>Dead letters</PageTitle>

<div class="ms-page">
    <div class="ms-page-header">
        <h1 class="ms-page-title">Dead letters</h1>
    </div>

    <p class="ms-muted">
        An event the async daemon could not apply, recorded by Marten as a
        <code>DeadLetterEvent</code> document in the event store's own schema. The projection is still
        stopped or still skipping: discarding the record forgets the failure, it does not fix it.
    </p>

    <div class="ms-event-filters">
        <div class="ms-event-filter">
            <label class="ms-event-filter-label" for="ms-dl-projection">Projection</label>
            <input id="ms-dl-projection"
                   type="text"
                   class="ms-input"
                   placeholder="any projection"
                   value="@Projection"
                   @onchange="OnProjectionChangedAsync" />
        </div>

        <div class="ms-event-filter">
            <label class="ms-event-filter-label" for="ms-dl-shard">Shard</label>
            <input id="ms-dl-shard"
                   type="text"
                   class="ms-input"
                   placeholder="any shard"
                   value="@Shard"
                   @onchange="OnShardChangedAsync" />
        </div>

        <div class="ms-event-filter">
            <label class="ms-event-filter-label" for="ms-dl-exception">Exception type contains</label>
            <input id="ms-dl-exception"
                   type="text"
                   class="ms-input"
                   placeholder="any exception"
                   value="@Exception"
                   @onchange="OnExceptionChangedAsync" />
        </div>
    </div>

    @if (!Capabilities.IsEnabled(StudioCapability.ManageDeadLetters))
    {
        <CapabilityDisabled Capability="@nameof(StudioCapability.ManageDeadLetters)" Action="Managing dead letters" />
    }

    @if (loading)
    {
        <LoadingSpinner />
    }
    else if (page?.Error is { } error)
    {
        <ErrorAlert Message="@error.Display" OnRetry="@(error.CanRetry ? EventCallback.Factory.Create(this, ReloadAsync) : default)" />
    }
    else if (shape is { Available: true, EventTablesExist: false })
    {
        <div class="ms-empty">
            <p class="ms-empty-title">This store has no event storage yet</p>
            <p class="ms-empty-description">
                Nothing has appended an event, so no projection has run and nothing can have failed on one.
            </p>
        </div>
    }
    else if (page is null || page.Rows.Count == 0)
    {
        <div class="ms-empty">
            <p class="ms-empty-title">No dead letters</p>
            <p class="ms-empty-description">
                @(HasFilters
                    ? "No dead letter matches these filters."
                    : "No projection in this database has failed on an event.")
            </p>
        </div>
    }
    else
    {
        <table class="ms-table">
            <thead>
                <tr>
                    <th>Projection</th>
                    <th>Shard</th>
                    <th>Event</th>
                    <th>Exception</th>
                    <th>When</th>
                    <th>Tenant</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (DeadLetterRow row in page.Rows)
                {
                    <tr class="ms-table-row" @key="row.Id">
                        <td class="ms-table-cell ms-table-cell-mono">@row.ProjectionName</td>
                        <td class="ms-table-cell ms-table-cell-mono">@row.ShardName</td>
                        <td class="ms-table-cell ms-table-cell-mono">#@row.EventSequence.ToString(CultureInfo.InvariantCulture)</td>
                        <td class="ms-table-cell ms-truncate" title="@row.ExceptionMessage">@row.ExceptionType</td>
                        <td class="ms-table-cell"><TimeAgo Timestamp="row.Timestamp" /></td>
                        <td class="ms-table-cell ms-table-cell-mono">@row.TenantId</td>
                        <td class="ms-table-cell ms-table-cell-actions">
                            <button type="button" class="ms-button ms-btn-sm" @onclick="() => ToggleAsync(row.Id, row.EventSequence)">
                                @(expanded == row.Id ? "Hide" : "Details")
                            </button>
                        </td>
                    </tr>

                    @if (expanded == row.Id)
                    {
                        <tr class="ms-table-row ms-dead-letter-detail" @key="@(row.Id.ToString() + "-detail")">
                            <td class="ms-table-cell" colspan="@DetailColumnSpan">
                                <div class="ms-dead-letter-panel">
                                    <pre class="ms-dead-letter-exception">@row.ExceptionType: @row.ExceptionMessage</pre>

                                    <div>
                                        <h3 class="ms-section-title">The event that failed</h3>
                                        @if (loadingEvent)
                                        {
                                            <LoadingSpinner />
                                        }
                                        else if (offending is null)
                                        {
                                            <p class="ms-muted">
                                                Event #@row.EventSequence.ToString(CultureInfo.InvariantCulture) is no
                                                longer in <code>mt_events</code>, or this tenant cannot see it.
                                            </p>
                                        }
                                        else
                                        {
                                            <EventCard Sequence="offending.Sequence"
                                                       Version="offending.Version"
                                                       EventType="@offending.EventType"
                                                       DotNetType="@offending.DotNetType"
                                                       Timestamp="offending.Timestamp"
                                                       StreamId="@offending.StreamId"
                                                       StreamHref="@StreamHref(offending.StreamId)"
                                                       ShowStream="true"
                                                       IsArchived="offending.IsArchived"
                                                       IsSkipped="offending.IsSkipped"
                                                       HasBinary="offending.HasBinary"
                                                       BinaryLength="offending.BinaryLength"
                                                       Json="@offending.Json"
                                                       Metadata="offending.Metadata" />
                                        }
                                    </div>

                                    <div class="ms-dead-letter-actions">
                                        @if (!Capabilities.IsEnabled(StudioCapability.ManageDeadLetters))
                                        {
                                            <span class="ms-muted">
                                                Discard and Skip need
                                                <code>MartenStudioOptions.Capabilities.ManageDeadLetters</code>.
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="ms-button ms-button-danger"
                                                    disabled="@working"
                                                    @onclick="() => OpenDiscardAsync(row.Id)">
                                                Discard
                                            </button>

                                            <button type="button"
                                                    class="ms-button"
                                                    disabled="@(working || !SupportsSkipping)"
                                                    title="@SkipTitle"
                                                    @onclick="() => OpenSkipAsync(row.EventSequence)">
                                                Skip event
                                            </button>
                                        }

                                        @* The third action the design names, and the only one that needs
                                           a running daemon. It is offered when there is one to ask and
                                           says why when there is not - "the daemon runs somewhere else"
                                           is a supported deployment, not a fault (hard rule 11). *@
                                        @if (Capabilities.IsEnabled(StudioCapability.ManageDeadLetters))
                                        {
                                            <button type="button"
                                                    class="ms-button @(CanRewind(row.ProjectionName) ? string.Empty : "ms-btn-disabled")"
                                                    disabled="@(working || !CanRewind(row.ProjectionName))"
                                                    title="@RewindTitle(row.ProjectionName)"
                                                    @onclick="() => OpenRewindAsync(row)">
                                                Rewind subscription to this event
                                            </button>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(actionError))
                                    {
                                        <ErrorAlert Message="@actionError" />
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <nav class="ms-pagination">
            @if (OffsetValue > 0)
            {
                <a class="ms-button" href="@PageHref(Math.Max(0, OffsetValue - PageSize))">Previous</a>
            }
            else
            {
                <span class="ms-button ms-btn-disabled" aria-disabled="true">Previous</span>
            }
            <span class="ms-pagination-info">from @((OffsetValue + 1).ToString(CultureInfo.InvariantCulture))</span>
            @if (page.HasMore)
            {
                <a class="ms-button" href="@PageHref(OffsetValue + PageSize)">Next</a>
            }
        </nav>
    }
</div>

<ConfirmDialog IsOpen="@(dialog is not DialogKind.None)"
               Title="@DialogTitle"
               Message="@DialogMessage"
               ConfirmationPhrase="@DialogConfirmationPhrase"
               ConfirmText="@DialogConfirmText"
               OnConfirm="ConfirmAsync"
               OnCancel="CancelDialog">
    @if (dialog == DialogKind.Rewind)
    {
        <div class="ms-rewind-scope">
            @if (rewindScopeError is { Length: > 0 } scopeError)
            {
                <p class="ms-alert ms-alert-warning" role="alert">
                    Marten Studio could not describe what this rewind would touch: @scopeError. The rewind
                    itself is still available, and the service refuses it if the daemon is not here.
                </p>
            }

            <div class="ms-kv">
                <div class="ms-kv-row">
                    <span class="ms-kv-key">Re-applied</span>
                    <span class="ms-kv-value">
                        @RewindEventCountText
                    </span>
                </div>
                <div class="ms-kv-row">
                    <span class="ms-kv-key">Progression set to</span>
                    <span class="ms-kv-value ms-mono">
                        @(RewindFloorText)
                    </span>
                </div>
                <div class="ms-kv-row">
                    <span class="ms-kv-key">Shards restarted</span>
                    <span class="ms-kv-value ms-mono">
                        @(rewindScope is { ShardNames.Count: > 0 }
                            ? string.Join(", ", rewindScope.ShardNames)
                            : "unknown")
                    </span>
                </div>
                <div class="ms-kv-row">
                    <span class="ms-kv-key">Tables written</span>
                    <span class="ms-kv-value ms-mono">
                        @(rewindScope is { TablesAffected.Count: > 0 }
                            ? string.Join(", ", rewindScope.TablesAffected)
                            : "none this projection declares")
                    </span>
                </div>
            </div>

            <p class="ms-muted">
                Marten deletes this projection's dead letters at or above that sequence as part of the
                rewind, so the record you are looking at goes away whether or not the replay succeeds. The
                rows are rewritten in place rather than dropped: this is a rewind, not a rebuild.
            </p>

            @if (State.ActiveScope?.TenantId is { Length: > 0 } tenant)
            {
                <p class="ms-alert ms-alert-warning" role="alert">
                    Projection progression is recorded per shard and not per tenant, so this rewind
                    re-applies every tenant's events after that sequence - not only
                    <code>@tenant</code>'s.
                </p>
            }
        </div>
    }
</ConfirmDialog>

@code {
    private const int PageSize = 50;

    /// <summary>Which confirmation is open.</summary>
    private enum DialogKind
    {
        None,
        Discard,
        Skip,
        Rewind
    }

    private readonly CancellationTokenSource pageCancellation = new();

    private DeadLetterPage? page;
    private EventStoreShape? shape;
    private ProjectionsView? projections;
    private EventRow? offending;
    private Guid? expanded;
    private Guid pendingDiscard;
    private long pendingSkip;
    private DeadLetterRow? pendingRewind;
    private RebuildScope? rewindScope;
    private string? rewindScopeError;
    private DialogKind dialog = DialogKind.None;
    private bool loading = true;
    private bool loadingEvent;
    private bool working;
    private string? actionError;
    private string? signature;

    /// <summary>Only this projection's dead letters.</summary>
    [SupplyParameterFromQuery(Name = "projection")]
    public string? Projection { get; set; }

    /// <summary>Only this shard's.</summary>
    [SupplyParameterFromQuery(Name = "shard")]
    public string? Shard { get; set; }

    /// <summary>Only those whose exception type contains this.</summary>
    [SupplyParameterFromQuery(Name = "exception")]
    public string? Exception { get; set; }

    /// <summary>How many to skip.</summary>
    [SupplyParameterFromQuery(Name = "offset")]
    public int? Offset { get; set; }

    /// <summary>The store this link is about.</summary>
    [SupplyParameterFromQuery(Name = EventLinks.StoreKey)]
    public string? Store { get; set; }

    /// <summary>The database this link is about.</summary>
    [SupplyParameterFromQuery(Name = EventLinks.DatabaseKey)]
    public string? Database { get; set; }

    /// <summary>The tenant this link is about.</summary>
    [SupplyParameterFromQuery(Name = EventLinks.TenantKey)]
    public string? Tenant { get; set; }

    private int OffsetValue => Math.Max(0, Offset ?? 0);

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(Projection)
        || !string.IsNullOrWhiteSpace(Shard)
        || !string.IsNullOrWhiteSpace(Exception);

    private int DetailColumnSpan => 7;

    private bool SupportsSkipping => shape?.HasIsSkipped == true;

    private string SkipTitle => SupportsSkipping
        ? "Marks the event skipped so the daemon steps over it"
        : "This store has no mt_events.is_skipped column: the host did not enable event skipping";

    /// <summary>
    /// Whether the daemon this process hosts could be asked to rewind <paramref name="projectionName" />.
    /// </summary>
    /// <remarks>
    /// Three things have to be true, and the service checks the first one again regardless of what was
    /// rendered (hard rule 5): a daemon is hosted here, this store still registers a projection by that
    /// name, and that projection is async. A dead letter can outlive the projection that wrote it - the
    /// record is a document and the registration is code - and rewinding a projection this store no
    /// longer has would be asking the daemon for a shard it cannot build.
    /// </remarks>
    private bool CanRewind(string projectionName) =>
        projections is { Daemon.IsHostedHere: true }
        && FindProjection(projectionName) is { IsAsync: true };

    private ProjectionInfo? FindProjection(string projectionName) =>
        projections?.Projections.FirstOrDefault(
            x => string.Equals(x.Name, projectionName, StringComparison.OrdinalIgnoreCase));

    private string RewindTitle(string projectionName)
    {
        if (projections is null)
        {
            return "Marten Studio has not read the projections for this database yet";
        }

        if (!projections.Daemon.IsHostedHere)
        {
            return projections.Daemon.Explanation;
        }

        ProjectionInfo? projection = FindProjection(projectionName);

        if (projection is null)
        {
            return $"This store no longer registers a projection called '{projectionName}', so there is no "
                + "shard for the daemon to restart. The record is still here because a dead letter is a "
                + "document and outlives the code that wrote it.";
        }

        return projection.IsAsync
            ? "Rewinds the subscription so the daemon re-applies this event and everything after it"
            : $"'{projectionName}' runs {projection.Lifecycle}, not Async, so the daemon does not run it and "
                + "there is no progression to rewind.";
    }

    /// <summary>The floor the rewind would write: one below the dead letter's own sequence.</summary>
    private long RewindFloor => pendingRewind is { } row
        ? Math.Max(0, row.EventSequence - 1)
        : 0;

    private string RewindFloorText => pendingRewind is null
        ? "unknown"
        : RewindFloor == 0
            ? "no progression row, so the projection replays from its first event"
            : "#" + RewindFloor.ToString("N0", CultureInfo.InvariantCulture);

    /// <summary>
    /// How many events the replay covers, from the dead letter's own sequence to the high-water mark.
    /// </summary>
    private string RewindEventCountText
    {
        get
        {
            if (pendingRewind is not { } row)
            {
                return "unknown";
            }

            string from = "#" + row.EventSequence.ToString("N0", CultureInfo.InvariantCulture);

            if (rewindScope is not { } scope || scope.EventsToReplay < row.EventSequence)
            {
                return $"every event from {from} onwards";
            }

            long count = scope.EventsToReplay - row.EventSequence + 1;

            return $"{count.ToString("N0", CultureInfo.InvariantCulture)} events, {from} to the high-water "
                + $"mark #{scope.EventsToReplay.ToString("N0", CultureInfo.InvariantCulture)}";
        }
    }

    private string DialogTitle => dialog switch
    {
        DialogKind.Discard => "Discard this dead letter?",
        DialogKind.Skip => "Mark this event as skipped?",
        DialogKind.Rewind => "Rewind this subscription?",
        _ => "Confirm",
    };

    private string DialogMessage => dialog switch
    {
        DialogKind.Discard =>
            "The record of the failure is deleted. The projection is not restarted and the event is not " +
            "reapplied - if the shard is still failing on it, a new dead letter will appear.",
        DialogKind.Skip =>
            $"Event #{pendingSkip.ToString(CultureInfo.InvariantCulture)} is marked skipped, so the daemon " +
            "steps over it on the next attempt. The event stays in the store, and every projection that " +
            "reads it from now on will not see it.",
        DialogKind.Rewind =>
            $"The daemon stops '{pendingRewind?.ProjectionName}', moves its progression back and starts it "
            + "again from there, so the event it failed on is re-applied along with everything after it. "
            + "If the projection still throws, the same failure comes back as a new dead letter.",
        _ => string.Empty,
    };

    /// <summary>
    /// The projection's own name, typed out, before a rewind runs.
    /// </summary>
    /// <remarks>
    /// Only this action asks for it. Discarding a record and skipping one event each undo cheaply;
    /// rewinding replays every event after a point through a projection, which on a production store is
    /// minutes of work and a table being rewritten - and the row it is started from is one of forty in a
    /// list that look alike.
    /// </remarks>
    private string? DialogConfirmationPhrase =>
        dialog == DialogKind.Rewind ? pendingRewind?.ProjectionName : null;

    private string DialogConfirmText => dialog switch
    {
        DialogKind.Skip => "Skip event",
        DialogKind.Rewind => "Rewind subscription",
        _ => "Discard",
    };

    protected override async Task OnInitializedAsync()
    {
        State.ScopeChanged += OnScopeChangedAsync;
        await ApplyScopeFromQueryAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        string current = Signature();
        if (string.Equals(current, signature, StringComparison.Ordinal))
        {
            return;
        }

        signature = current;
        await LoadAsync();
    }

    private async Task ApplyScopeFromQueryAsync()
    {
        if (string.IsNullOrWhiteSpace(Store) && string.IsNullOrWhiteSpace(Database) && string.IsNullOrWhiteSpace(Tenant))
        {
            return;
        }

        StudioScope? active = State.ActiveScope;
        if (active is not null
            && string.Equals(active.StoreKey, Store ?? active.StoreKey, StringComparison.OrdinalIgnoreCase)
            && string.Equals(active.DatabaseId, Database ?? active.DatabaseId, StringComparison.OrdinalIgnoreCase)
            && string.Equals(active.TenantId ?? string.Empty, Tenant ?? active.TenantId ?? string.Empty, StringComparison.Ordinal))
        {
            return;
        }

        await State.SetScopeAsync(Store, Database, Tenant, pageCancellation.Token);
    }

    private async Task OnScopeChangedAsync()
    {
        signature = Signature();
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task ReloadAsync()
    {
        signature = Signature();
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            loading = false;
            return;
        }

        loading = true;
        expanded = null;
        offending = null;
        StateHasChanged();

        try
        {
            CancellationToken token = pageCancellation.Token;

            shape = await Events.DescribeAsync(scope, token);

            // Hard rule 14 gates all three reads below, and the shape is what answers it: one
            // information_schema question, through the studio's own cached column catalog, with no Marten
            // call in it.
            //
            // The list is a Marten session query over DeadLetterEvent, and every Marten query opens with
            // EnsureStorageExistsAsync for the document type - which on a database that has never run the
            // daemon creates mt_doc_deadletterevent and Marten's whole helper-function set under the
            // database's own AutoCreate. Proven live by NavIndicatorNoDdlLiveTests: a studio that wrote
            // twenty functions and a table because somebody opened a tab.
            //
            // Nothing is lost by not asking. A dead letter is recorded by the async daemon while it
            // applies an event, so a database with no event tables has never had one - the list would
            // have been empty, at the cost of a migration.
            if (shape.EventTablesExist)
            {
                page = await Events.ListDeadLettersAsync(scope, new DeadLetterQuery
                {
                    ProjectionName = Projection,
                    ShardName = Shard,
                    ExceptionType = Exception,
                    Offset = OffsetValue,
                    PageSize = PageSize,
                }, token);
            }
            else
            {
                page = DeadLetterPage.Empty;
            }

            projections = await ReadProjectionsAsync(scope, shape, token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            page = DeadLetterPage.Failed(new EventDataError(exception.Message, null, true));
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleAsync(Guid id, long sequence)
    {
        actionError = null;

        if (expanded == id)
        {
            expanded = null;
            offending = null;
            return;
        }

        expanded = id;
        offending = null;

        StudioScope? scope = State.ActiveScope;
        if (scope is null)
        {
            return;
        }

        loadingEvent = true;

        try
        {
            offending = await Events.GetEventBySequenceAsync(scope, sequence, pageCancellation.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            actionError = exception.Message;
        }
        finally
        {
            loadingEvent = false;
        }
    }

    private Task OpenDiscardAsync(Guid id)
    {
        actionError = null;
        pendingDiscard = id;
        dialog = DialogKind.Discard;
        return Task.CompletedTask;
    }

    private Task OpenSkipAsync(long sequence)
    {
        actionError = null;
        pendingSkip = sequence;
        dialog = DialogKind.Skip;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Opens the rewind confirmation, having first asked the projections service what it would touch.
    /// </summary>
    /// <remarks>
    /// The facts come from <c>DescribeRebuildAsync</c>, which is where the studio already works out a
    /// projection's shards, its tables and the high-water mark a replay runs to - the same numbers the
    /// rebuild dialog shows, for an operation that costs the same kind of work. A projection it cannot
    /// describe still opens the dialog, saying so: the service is what refuses the rewind, not this.
    /// <c>DescribeRebuildAsync</c> reads the high-water mark, which is a Marten call that would apply the
    /// event store's migration (hard rule 14), so it is asked only where there is an event store. Belt and
    /// braces rather than the gate that matters: a database with no event tables renders the "no event
    /// storage yet" empty state and therefore no rows, so no handler exists for a circuit to be driven to
    /// invoke. It is one line and it is the same condition, and a row rendered in that state by some later
    /// change would otherwise arrive with a migration behind its button.
    /// </remarks>
    private async Task OpenRewindAsync(DeadLetterRow row)
    {
        actionError = null;
        rewindScope = null;
        rewindScopeError = null;
        pendingRewind = row;
        dialog = DialogKind.Rewind;

        StudioScope? scope = State.ActiveScope;
        if (scope is null || shape?.EventTablesExist != true)
        {
            return;
        }

        try
        {
            rewindScope = await ProjectionData.DescribeRebuildAsync(scope, row.ProjectionName, pageCancellation.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            rewindScopeError = exception.Message;
        }
    }

    /// <summary>
    /// The daemon card and the registered projections, read as a value.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A failure here takes the rewind button away and nothing else: this page is about dead letters, and
    /// a projections service that cannot answer must not be able to blank the list (plan section 4.8).
    /// </para>
    /// <para>
    /// <b>Not asked at all when this database has no event tables</b> (hard rule 14).
    /// <c>GetProjectionsAsync</c> reads the progression rows and the high-water mark, and both of those
    /// Marten calls open with <c>EnsureStorageExistsAsync(typeof(IEvent))</c> - they apply the event
    /// store's migration under the database's own <c>AutoCreate</c> before they read anything. The shape
    /// is already in hand from <c>DescribeAsync</c>, which answers from <c>information_schema</c>, and a
    /// database with no event store has no dead letters to rewind either, so there is nothing the read
    /// could have told this page that is worth creating an event store for.
    /// </para>
    /// </remarks>
    private async Task<ProjectionsView?> ReadProjectionsAsync(
        StudioScope scope,
        EventStoreShape shape,
        CancellationToken token)
    {
        if (!shape.EventTablesExist)
        {
            return null;
        }

        try
        {
            return await ProjectionData.GetProjectionsAsync(scope, token);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private void CancelDialog()
    {
        dialog = DialogKind.None;
        pendingRewind = null;
        rewindScope = null;
        rewindScopeError = null;
    }

    private async Task ConfirmAsync()
    {
        DialogKind kind = dialog;
        dialog = DialogKind.None;

        StudioScope? scope = State.ActiveScope;
        if (scope is null || kind == DialogKind.None)
        {
            return;
        }

        working = true;
        actionError = null;

        try
        {
            if (kind == DialogKind.Discard)
            {
                await Events.DiscardDeadLetterAsync(scope, pendingDiscard, pageCancellation.Token);
                await Toasts.Success("The dead letter is discarded.");
            }
            else if (kind == DialogKind.Skip)
            {
                await Events.SkipEventAsync(scope, pendingSkip, pageCancellation.Token);
                await Toasts.Success(
                    $"Event #{pendingSkip.ToString(CultureInfo.InvariantCulture)} is marked as skipped.");
            }
            else if (pendingRewind is { } rewind)
            {
                await Events.RewindSubscriptionAsync(
                    scope, rewind.ProjectionName, rewind.EventSequence, pageCancellation.Token);

                await Toasts.Success(
                    $"'{rewind.ProjectionName}' is rewound to #"
                    + RewindFloor.ToString(CultureInfo.InvariantCulture)
                    + $", so event #{rewind.EventSequence.ToString(CultureInfo.InvariantCulture)} is re-applied.");
            }

            pendingRewind = null;
            rewindScope = null;
            rewindScopeError = null;

            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            actionError = exception.Message;
            await Toasts.Error(exception.Message);
        }
        finally
        {
            working = false;
        }
    }

    private Task OnProjectionChangedAsync(ChangeEventArgs args)
    {
        Projection = args.Value?.ToString();
        return NavigateAsync();
    }

    private Task OnShardChangedAsync(ChangeEventArgs args)
    {
        Shard = args.Value?.ToString();
        return NavigateAsync();
    }

    private Task OnExceptionChangedAsync(ChangeEventArgs args)
    {
        Exception = args.Value?.ToString();
        return NavigateAsync();
    }

    private Task NavigateAsync()
    {
        Navigation.NavigateTo(PageHref(0));
        return Task.CompletedTask;
    }

    private string PageHref(int offset) =>
        EventLinks.To(
            Options.Value,
            EventLinks.DeadLettersRoute,
            State.ActiveScope,
            [
                new("projection", Projection),
                new("shard", Shard),
                new("exception", Exception),
                new("offset", offset > 0 ? offset.ToString(CultureInfo.InvariantCulture) : null),
            ]);

    private string StreamHref(string streamId) =>
        EventLinks.ToStream(Options.Value, State.ActiveScope, streamId);

    private string Signature() =>
        string.Join(
            '',
            State.ActiveScope?.StoreKey,
            State.ActiveScope?.DatabaseId,
            State.ActiveScope?.TenantId,
            Projection,
            Shard,
            Exception,
            OffsetValue.ToString(CultureInfo.InvariantCulture));

    public async ValueTask DisposeAsync()
    {
        State.ScopeChanged -= OnScopeChangedAsync;

        await pageCancellation.CancelAsync();
        pageCancellation.Dispose();

        GC.SuppressFinalize(this);
    }
}
