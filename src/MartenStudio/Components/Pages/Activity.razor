@page "/marten/activity"
@using MartenStudio.Services
@implements IDisposable
@inject StudioActionLog ActionLog
@inject StudioState State
@inject StudioAuthorization Authorization

<PageTitle>Activity</PageTitle>

<div class="ms-page">
    <div class="ms-page-header">
        <h1 class="ms-page-title">Activity</h1>
        <SearchFilter Placeholder="Filter by action, outcome or user" OnFilterChanged="OnFilterChangedAsync" />
    </div>

    <p class="ms-muted">
        The most recent @StudioActionLogService.MaxEntries actions taken through Marten Studio in this
        process, newest first. The ring is in memory and goes away with the process - the durable record
        is in this application's own log, under event ids 9200-9211.
    </p>

    @if (visible.Count == 0)
    {
        <div class="ms-empty">
            <p class="ms-empty-title">Nothing to show</p>
            <p class="ms-empty-description">
                @(string.IsNullOrWhiteSpace(filter)
                    ? "No one has changed anything through Marten Studio since this process started."
                    : "No recorded action matches that filter.")
            </p>
        </div>
    }
    else
    {
        <TableScroll Label="Activity table">
            <table class="ms-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>User</th>
                        @* Store, database and tenant were three columns, and on a single-store host they
                           carry the same three values on every row - 300px of the width of this table to
                           say "default" a hundred times. One Scope cell says it in a third of the space
                           and still says all of it. *@
                        <th>Scope</th>
                        <th>Action</th>
                        <th>Target</th>
                        <th>Outcome</th>
                        <th>Capability</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (StudioActionLogEntry entry in visible)
                    {
                        @* Keyed by the ring's own sequence number, not by the entry: the record has value
                           equality, and two identical actions a second apart would collide on one key and
                           make the diff reuse the wrong row. *@
                        <tr class="ms-table-row" @key="entry.Sequence">
                            <td class="ms-table-cell ms-table-cell-mono ms-activity-when">@State.FormatInSelectedTimeZone(entry.Timestamp)</td>
                            <td class="ms-table-cell">@entry.User</td>
                            <td class="ms-table-cell ms-table-cell-mono ms-activity-scope" title="@ScopeTitle(entry)">
                                @* The separators are text and not `aria-hidden` decoration: hiding them
                                   would leave a screen reader reading the three values run together as
                                   one word, and a dot between them is how the cell reads out loud too. *@
                                @entry.StoreKey<span class="ms-activity-scope-separator"> · </span>@entry.DatabaseId<span class="ms-activity-scope-separator"> · </span>@(entry.TenantId ?? "all")
                            </td>
                            <td class="ms-table-cell">@entry.Action</td>
                            <td class="ms-table-cell ms-table-cell-mono ms-activity-target">@entry.Target</td>
                            <td class="ms-table-cell">
                                <span class="ms-state-indicator">
                                    <span class="ms-state-dot @(entry.Succeeded ? "ms-state-success" : "ms-state-error")" aria-hidden="true"></span>
                                    <span class="ms-state-label">@Outcome(entry)</span>
                                </span>
                            </td>
                            <td class="ms-table-cell">@(entry.Capability ?? "-")</td>
                            <td class="ms-table-cell ms-activity-message">@entry.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </TableScroll>
    }
</div>

@code {
    private string filter = string.Empty;
    private List<StudioActionLogEntry> visible = [];

    /// <summary>Failures are recorded too, which is the point - so the outcome is a column, not a filter.</summary>
    private static string Outcome(StudioActionLogEntry entry) => entry.Succeeded ? "succeeded" : "failed";

    /// <summary>
    /// The three values behind the Scope cell, spelled out, for its <c>title</c>.
    /// </summary>
    /// <remarks>
    /// The cell reads <c>default · localhost.marten · all</c>, which is short enough for the column and
    /// ambiguous on its own about which dot-separated part is which. The title says.
    /// </remarks>
    private static string ScopeTitle(StudioActionLogEntry entry) =>
        "Store " + entry.StoreKey + ", database " + entry.DatabaseId + ", tenant " + (entry.TenantId ?? "all");

    protected override async Task OnInitializedAsync()
    {
        State.ScopeChanged += OnScopeChanged;
        await ReloadAsync();
    }

    /// <summary>
    /// Reads the ring, drops every entry the visitor may not see, then applies the text filter.
    /// </summary>
    /// <remarks>
    /// The ring is process-wide and every circuit writes into it, so it is the one place in the studio
    /// where one visitor's actions can be read by another. The per-store policy decides, entry by entry,
    /// against the store, database and tenant the action was aimed at - the same question
    /// <see cref="StudioScopeResolver" /> asks before any of those actions could have run. Entries whose
    /// scope was never settled carry a placeholder store key, which no policy recognises, so they are
    /// filtered out too; that is the safe direction.
    /// </remarks>
    private async Task ReloadAsync()
    {
        IReadOnlyList<StudioActionLogEntry> entries = ActionLog.GetLatest();

        List<StudioActionLogEntry> allowed = await Authorization.FilterAsync(
            entries,
            static entry => new StudioScope(entry.StoreKey, entry.DatabaseId, entry.TenantId));

        if (string.IsNullOrWhiteSpace(filter))
        {
            visible = allowed;
            return;
        }

        string needle = filter.Trim();
        List<StudioActionLogEntry> matches = [];
        foreach (StudioActionLogEntry entry in allowed)
        {
            if (entry.Action.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || entry.User.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || Outcome(entry).Contains(needle, StringComparison.OrdinalIgnoreCase))
            {
                matches.Add(entry);
            }
        }

        visible = matches;
    }

    private async Task OnScopeChanged()
    {
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFilterChangedAsync(string value)
    {
        filter = value;
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.ScopeChanged -= OnScopeChanged;
    }
}
