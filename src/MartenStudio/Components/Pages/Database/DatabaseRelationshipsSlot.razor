@using Microsoft.Extensions.Options
@using MartenStudio.Services.Database
@inject IOptions<MartenStudioOptions> Options
@inject StudioState State

@*
    The Relationships tab's slot: the relation's foreign keys, both ways, as text. The neighbourhood
    diagram replaces this file; until then the same facts are here in the form that works at every width
    and in a screen reader, which is the form the diagram's own table will keep.

    The contract is the parameters, and nothing else:

      Schema  - the relation's schema, as the catalog spells it
      Name    - the relation's name, likewise
      Detail  - the DatabaseObjectDetail the page already read (ForeignKeysOut, ForeignKeysIn), typed object
                for the reason DocumentComponentModel gives

    A far end this visitor may not see is said to be out of view and is never named.
*@

<div class="ms-db-relationships" data-schema="@Schema" data-name="@Name">
    @if (DetailModel is { } detail)
    {
        <section class="ms-db-relationships-group">
            <h2 class="ms-db-section-title">Points at</h2>
            @if (detail.ForeignKeysOut.Count == 0)
            {
                <p class="ms-muted">No foreign keys: it points at nothing.</p>
            }
            else
            {
                <ul class="ms-db-fk-list">
                    @foreach (DatabaseForeignKeyInfo key in detail.ForeignKeysOut)
                    {
                        <li @key="key.Name">
                            <span class="ms-db-fk-columns">(@string.Join(", ", key.Columns))</span>
                            <span class="ms-db-fk-arrow" aria-hidden="true">→</span>
                            <span class="ms-sr-only">references</span>
                            @if (key is { LinkedVisible: true, LinkedSchema: { } schema, LinkedTable: { } table })
                            {
                                <a class="ms-db-name" href="@DatabaseLinks.ToObject(Options.Value, State.ActiveScope, schema, table, DatabaseObjectTab.Relationships)">@DatabaseLinks.QualifiedName(schema, table)</a>
                                <span class="ms-db-fk-columns">(@string.Join(", ", key.LinkedColumns))</span>
                            }
                            else
                            {
                                <span class="ms-db-none">a table you cannot see</span>
                            }
                            <span class="ms-db-fk-meta">@Actions(key)</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="ms-db-relationships-group">
            <h2 class="ms-db-section-title">Pointed at by</h2>
            @if (detail.ForeignKeysIn.Count == 0)
            {
                <p class="ms-muted">Nothing you can see points at it.</p>
            }
            else
            {
                <ul class="ms-db-fk-list">
                    @foreach (DatabaseForeignKeyInfo key in detail.ForeignKeysIn)
                    {
                        <li @key="key.Schema + '\u001f' + key.Table + '\u001f' + key.Name">
                            <a class="ms-db-name" href="@DatabaseLinks.ToObject(Options.Value, State.ActiveScope, key.Schema, key.Table, DatabaseObjectTab.Relationships)">@DatabaseLinks.QualifiedName(key.Schema, key.Table)</a>
                            <span class="ms-db-fk-columns">(@string.Join(", ", key.Columns))</span>
                            <span class="ms-db-fk-arrow" aria-hidden="true">→</span>
                            <span class="ms-sr-only">references</span>
                            <span class="ms-db-fk-columns">(@string.Join(", ", key.LinkedColumns))</span>
                            <span class="ms-db-fk-meta">@Actions(key)</span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>

@code {
    /// <summary>The relation's schema.</summary>
    [Parameter]
    public string Schema { get; set; } = string.Empty;

    /// <summary>The relation's name.</summary>
    [Parameter]
    public string Name { get; set; } = string.Empty;

    /// <summary>The relation's <c>DatabaseObjectDetail</c>. Typed <see cref="object" /> - see <c>DocumentComponentModel</c>.</summary>
    [Parameter]
    public object? Detail { get; set; }

    private DatabaseObjectDetail? DetailModel => Detail as DatabaseObjectDetail;

    /// <summary>What happens to the pointing row when the row it points at goes or changes, and whether the key is checked.</summary>
    internal static string Actions(DatabaseForeignKeyInfo key) =>
        "on delete " + key.OnDelete + " · on update " + key.OnUpdate + (key.Validated ? string.Empty : " · NOT VALID");
}
