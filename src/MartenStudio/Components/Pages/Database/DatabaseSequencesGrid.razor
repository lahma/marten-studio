@using Microsoft.Extensions.Options
@using MartenStudio.Services.Database
@inject StudioState State
@inject IOptions<MartenStudioOptions> Options
@inject IDatabaseObjectService Data

@*
    Sequences. The owning column is a link to its table, because "which serial is this" is the question a
    sequence list is opened to answer. The last value is read only when asked, one sequence at a time:
    reading it takes a brief lock on the sequence, and a list must lock nothing it lists. It is offered only
    where the reading role may read it and the gate lets this visitor read the object's data; otherwise the
    cell says which of the two it was.

    Marten's per-tenant event sequences roll up into one row: their names are the tenant list, which no
    grid here ever prints.
*@

<TableScroll Label="@Label">
    <table class="ms-table ms-db-table ms-db-sequences">
        <thead>
            <tr>
                @Header("name", "Name")
                <th scope="col">Owned by</th>
                <th scope="col" class="ms-db-col-number">Last value</th>
                <th scope="col" class="ms-db-col-number">Increment</th>
                <th scope="col">Range</th>
                <th scope="col">Cycles</th>
                <th scope="col">Type</th>
                @Header("owner", "Owner")
            </tr>
        </thead>
        <tbody>
            @if (Sequences.Count == 0)
            {
                <tr>
                    <td class="ms-table-empty" colspan="8">@EmptyText</td>
                </tr>
            }

            @foreach (DatabaseSequenceSummary sequence in Sorted())
            {
                <tr class="@(sequence.Ownership.IsMarten ? "ms-db-row-marten" : null)" @key="sequence.Schema + '\u001f' + sequence.Name">
                    <td class="ms-db-cell-name">
                        <span class="ms-db-name ms-db-name-cut" title="@DatabaseLinks.QualifiedName(sequence.Schema, sequence.Name)"><span class="ms-db-schema-prefix">@(ShowSchema ? sequence.Schema + "." : null)</span>@sequence.Name</span>
                        @if (sequence.RolledUp is { } rolled && rolled > 0)
                        {
                            <span class="ms-db-badge"
                                  title="@($"{DatabasePresentation.Number(rolled)} per-tenant sequences are rolled into this row. Their names are never listed: they would name every tenant.")">
                                +@rolled per tenant
                            </span>
                        }
                    </td>
                    <td class="ms-db-cell-name">
                        @if (sequence is { OwnerSchema: { } ownerSchema, OwnerTable: { } ownerTable, OwnerColumn: { } ownerColumn })
                        {
                            <a class="ms-db-name"
                               href="@DatabaseLinks.ToObject(Options.Value, State.ActiveScope, ownerSchema, ownerTable, DatabaseObjectTab.Columns)"
                               title="The column this sequence belongs to: dropping the column drops the sequence">@(DatabaseLinks.QualifiedName(ownerSchema, ownerTable)).@ownerColumn</a>
                        }
                        else if (sequence.OwnedOutsideView)
                        {
                            <span class="ms-db-none" title="It belongs to a column of a table this studio does not show you">a table you cannot see</span>
                        }
                        else
                        {
                            <span class="ms-db-none" title="No column owns it">—</span>
                        }
                    </td>
                    <td class="ms-db-cell-number">
                        @if (!sequence.CanReadValue)
                        {
                            <span class="ms-db-none" title="@WithheldTitle(sequence)">@(MayReadData(sequence) ? "no privilege" : "withheld")</span>
                        }
                        else if (values.TryGetValue(KeyOf(sequence), out DatabaseSequenceValue? read))
                        {
                            @if (!read.Found)
                            {
                                <span class="ms-db-none" title="@read.Reason">unavailable</span>
                            }
                            else if (read.LastValue is { } last)
                            {
                                @DatabasePresentation.Number(last)
                            }
                            else
                            {
                                <span class="ms-db-none" title="nextval has never been called on it">never used</span>
                            }
                        }
                        else
                        {
                            <button type="button"
                                    class="ms-btn ms-btn-sm ms-db-read-value"
                                    title="Reading a sequence's value takes a brief lock on it, so it is read only when asked"
                                    aria-label="@($"Read the last value of {sequence.Name}")"
                                    @onclick="() => ReadValueAsync(sequence)">
                                read
                            </button>
                        }
                    </td>
                    <td class="ms-db-cell-number">@DatabasePresentation.Number(sequence.Increment)</td>
                    <td class="ms-db-cell-range" title="@(DatabasePresentation.Number(sequence.Minimum) + " to " + DatabasePresentation.Number(sequence.Maximum) + ", starting at " + DatabasePresentation.Number(sequence.Start))">@Bound(sequence.Minimum, sequence.DataType) … @Bound(sequence.Maximum, sequence.DataType)</td>
                    <td>@(sequence.Cycles ? "yes" : "no")</td>
                    <td class="ms-db-cell-type">@sequence.DataType</td>
                    <td class="ms-db-cell-owner"><DatabaseOwnerBadge Model="sequence.Ownership" /></td>
                </tr>
            }
        </tbody>
    </table>
</TableScroll>

@code {
    private readonly Dictionary<string, DatabaseSequenceValue> values = new(StringComparer.Ordinal);
    private object? shownModel;
    private string? shownScope;
    private int generation;
    private string sortKey = "default";
    private bool descending;

    /// <summary>The list, as a <c>DatabaseObjectList</c>. Typed <see cref="object" /> - see <c>DocumentComponentModel</c>.</summary>
    [Parameter]
    public object? Model { get; set; }

    /// <summary>Whether to put the schema in front of each name - when the list spans schemas.</summary>
    [Parameter]
    public bool ShowSchema { get; set; }

    /// <summary>The scroll region's accessible name.</summary>
    [Parameter]
    public string Label { get; set; } = "Sequences";

    /// <summary>What an empty list says.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "Nothing here.";

    private DatabaseObjectList? List => Model as DatabaseObjectList;

    private List<DatabaseSequenceSummary> Sequences => [.. (List?.Items ?? []).OfType<DatabaseSequenceSummary>()];

    /// <summary>
    /// Whether the gate lets this visitor read the object's data, so that a withheld value was the reading
    /// role's privilege rather than the gate. Marten's own in the store's schemas always, as on the Schema
    /// screen; anything else needs the gate open and the schema browsable.
    /// </summary>
    private bool MayReadData(DatabaseSequenceSummary sequence)
    {
        DatabaseAccessState? access = List?.Access;
        if (access is null)
        {
            return false;
        }

        return (sequence.Ownership.IsMarten && access.StoreSchemas.Contains(sequence.Schema))
            || (access.IsOpen && access.BrowsableSchemas.Contains(sequence.Schema));
    }

    /// <summary>
    /// Forgets every value read when the list or the scope changes under the grid.
    /// </summary>
    /// <remarks>
    /// A value is keyed by schema and name, which say nothing about the database it was read in: after a
    /// switch of database - one per tenant, say - a value read in the old one would otherwise sit against
    /// the same-named sequence of the new one as if it were its own. A read still in flight when this happens
    /// belongs to the old list too, and is dropped when it lands (<c>generation</c>).
    /// </remarks>
    protected override void OnParametersSet()
    {
        StudioScope? scope = State.ActiveScope;
        string scopeKey = string.Join('\u001f', scope?.StoreKey, scope?.DatabaseId, scope?.TenantId);

        if (!ReferenceEquals(shownModel, Model) || !string.Equals(shownScope, scopeKey, StringComparison.Ordinal))
        {
            shownModel = Model;
            shownScope = scopeKey;
            values.Clear();
            generation++;
        }
    }

    private static string KeyOf(DatabaseSequenceSummary sequence) => sequence.Schema + '\u001f' + sequence.Name;

    private async Task ReadValueAsync(DatabaseSequenceSummary sequence)
    {
        string key = KeyOf(sequence);
        int asked = generation;
        DatabaseSequenceValue value;

        try
        {
            if (State.ActiveScope is not { } scope)
            {
                return;
            }

            value = await Data.GetSequenceValueAsync(scope, sequence.Schema, sequence.Name);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            value = DatabaseSequenceValue.Unavailable(sequence.Ref, DatabaseRefusal.Unavailable, exception.Message);
        }

        // Asked about a list that has since been replaced: the answer is about another database's sequence.
        if (asked == generation)
        {
            values[key] = value;
        }
    }

    private string WithheldTitle(DatabaseSequenceSummary sequence) =>
        MayReadData(sequence)
            ? "The reading role has neither SELECT nor USAGE on this sequence, so its value cannot be read."
            : List?.Access.Denial ?? "Its value is data, and the gate does not let this visitor read data in this schema.";

    /// <summary>A bound, with the type's own limits spelled as such rather than as nineteen digits.</summary>
    private static string Bound(long value, string dataType) => (value, dataType) switch
    {
        (long.MaxValue, _) or (int.MaxValue, "integer") or (short.MaxValue, "smallint") => "max",
        (long.MinValue, _) or (int.MinValue, "integer") or (short.MinValue, "smallint") => "min",
        _ => DatabasePresentation.Number(value),
    };

    private IEnumerable<DatabaseSequenceSummary> Sorted()
    {
        List<DatabaseSequenceSummary> sequences = Sequences;

        IEnumerable<DatabaseSequenceSummary> ordered = sortKey switch
        {
            "name" => sequences.OrderBy(static x => x.Name, StringComparer.OrdinalIgnoreCase).ThenBy(static x => x.Schema, StringComparer.Ordinal),
            "owner" => sequences.OrderBy(static x => x.Ownership.IsMarten)
                .ThenBy(static x => DatabasePresentation.OwnerLabel(x.Ownership), StringComparer.OrdinalIgnoreCase)
                .ThenBy(static x => x.Name, StringComparer.Ordinal),
            _ => DatabasePresentation.DefaultOrder(sequences),
        };

        return descending ? ordered.Reverse() : ordered;
    }

    private Task SortAsync(string key)
    {
        descending = string.Equals(sortKey, key, StringComparison.Ordinal) && !descending;
        sortKey = key;
        return Task.CompletedTask;
    }

    private RenderFragment Header(string key, string label) =>
        @<th scope="col" aria-sort="@DatabasePresentation.AriaSort(sortKey == key, descending)">
            <button type="button"
                    class="ms-doc-sort @(sortKey == key ? "ms-doc-sort-on" : null)"
                    title="@($"Sort by {label.ToLowerInvariant()}")"
                    @onclick="() => SortAsync(key)">
                @label
                @if (sortKey == key)
                {
                    <span class="ms-doc-sort-arrow" aria-hidden="true">@(descending ? "▼" : "▲")</span>
                }
            </button>
        </th>;
}
