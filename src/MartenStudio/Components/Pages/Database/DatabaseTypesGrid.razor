@using MartenStudio.Services.Database

@*
    Enums, domains, ranges and composite types, described in place: an enum's labels are the whole of it,
    so they are drawn as chips in their declared order rather than hidden behind a disclosure. "Used by"
    counts the columns declared with the type directly, which is the number that says whether dropping or
    changing it is somebody else's problem.
*@

<TableScroll Label="@Label">
    <table class="ms-table ms-db-table ms-db-types">
        <thead>
            <tr>
                @Header("name", "Name")
                <th scope="col">Kind</th>
                <th scope="col">Definition</th>
                <th scope="col" class="ms-db-col-number">Used by</th>
                @Header("owner", "Owner")
            </tr>
        </thead>
        <tbody>
            @if (Types.Count == 0)
            {
                <tr>
                    <td class="ms-table-empty" colspan="5">@EmptyText</td>
                </tr>
            }

            @foreach (DatabaseTypeSummary type in Sorted())
            {
                <tr class="@(type.Ownership.IsMarten ? "ms-db-row-marten" : null)" @key="type.Schema + '\u001f' + type.Name">
                    <td class="ms-db-cell-name">
                        <span class="ms-db-name" title="@(type.Comment ?? DatabaseLinks.QualifiedName(type.Schema, type.Name))"><span class="ms-db-schema-prefix">@(ShowSchema ? type.Schema + "." : null)</span>@type.Name</span>
                    </td>
                    <td><span class="ms-db-badge">@DatabasePresentation.KindLabel(type.Kind)</span></td>
                    <td class="ms-db-cell-definition"><DatabaseTypeDescription Model="type" /></td>
                    <td class="ms-db-cell-number">@(type.UsedByColumns == 1 ? "1 column" : DatabasePresentation.Number(type.UsedByColumns) + " columns")</td>
                    <td class="ms-db-cell-owner"><DatabaseOwnerBadge Model="type.Ownership" /></td>
                </tr>
            }
        </tbody>
    </table>
</TableScroll>

@code {
    private string sortKey = "default";
    private bool descending;

    /// <summary>The list, as a <c>DatabaseObjectList</c>. Typed <see cref="object" /> - see <c>DocumentComponentModel</c>.</summary>
    [Parameter]
    public object? Model { get; set; }

    /// <summary>Whether to put the schema in front of each name - when the list spans schemas.</summary>
    [Parameter]
    public bool ShowSchema { get; set; }

    /// <summary>The scroll region's accessible name.</summary>
    [Parameter]
    public string Label { get; set; } = "Types";

    /// <summary>What an empty list says.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "Nothing here.";

    private List<DatabaseTypeSummary> Types => [.. ((Model as DatabaseObjectList)?.Items ?? []).OfType<DatabaseTypeSummary>()];

    private IEnumerable<DatabaseTypeSummary> Sorted()
    {
        List<DatabaseTypeSummary> types = Types;

        IEnumerable<DatabaseTypeSummary> ordered = sortKey switch
        {
            "name" => types.OrderBy(static x => x.Name, StringComparer.OrdinalIgnoreCase).ThenBy(static x => x.Schema, StringComparer.Ordinal),
            "owner" => types.OrderBy(static x => x.Ownership.IsMarten)
                .ThenBy(static x => DatabasePresentation.OwnerLabel(x.Ownership), StringComparer.OrdinalIgnoreCase)
                .ThenBy(static x => x.Name, StringComparer.Ordinal),
            _ => DatabasePresentation.DefaultOrder(types),
        };

        return descending ? ordered.Reverse() : ordered;
    }

    private Task SortAsync(string key)
    {
        descending = string.Equals(sortKey, key, StringComparison.Ordinal) && !descending;
        sortKey = key;
        return Task.CompletedTask;
    }

    private RenderFragment Header(string key, string label) =>
        @<th scope="col" aria-sort="@DatabasePresentation.AriaSort(sortKey == key, descending)">
            <button type="button"
                    class="ms-doc-sort @(sortKey == key ? "ms-doc-sort-on" : null)"
                    title="@($"Sort by {label.ToLowerInvariant()}")"
                    @onclick="() => SortAsync(key)">
                @label
                @if (sortKey == key)
                {
                    <span class="ms-doc-sort-arrow" aria-hidden="true">@(descending ? "▼" : "▲")</span>
                }
            </button>
        </th>;
}
