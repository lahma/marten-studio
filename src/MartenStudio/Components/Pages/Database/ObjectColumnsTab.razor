@using Microsoft.Extensions.Options
@using MartenStudio.Services.Database
@inject IOptions<MartenStudioOptions> Options
@inject StudioState State

@*
    A relation's columns, in attnum order. The key column is marked where the key is, and a column that is
    part of a foreign key links to the table it points at - so the Columns tab answers "what is this column
    and where does it go" without a trip to Keys.
*@

@if (DetailModel is { } detail)
{
    <TableScroll Label="@($"Columns of {detail.Relation?.Name}")">
        <table class="ms-table ms-db-table ms-db-columns">
            <thead>
                <tr>
                    <th scope="col" class="ms-db-col-number">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Null</th>
                    <th scope="col">Default</th>
                    <th scope="col">Key</th>
                    <th scope="col">Comment</th>
                </tr>
            </thead>
            <tbody>
                @if (detail.Columns.Count == 0)
                {
                    <tr>
                        <td class="ms-table-empty" colspan="7">It has no columns.</td>
                    </tr>
                }

                @foreach (DatabaseColumnInfo column in detail.Columns)
                {
                    <tr @key="column.Position">
                        <td class="ms-db-cell-number">@column.Position</td>
                        <td class="ms-db-cell-name">
                            <span class="ms-db-name">@column.Name</span>
                            @switch (column.Identity)
                            {
                                case DatabaseIdentityKind.Always:
                                    <span class="ms-db-badge" title="GENERATED ALWAYS AS IDENTITY: Postgres assigns it and refuses an explicit value">identity</span>
                                    break;
                                case DatabaseIdentityKind.ByDefault:
                                    <span class="ms-db-badge" title="GENERATED BY DEFAULT AS IDENTITY: Postgres assigns it unless a value is given">identity</span>
                                    break;
                            }
                            @if (column.Generated)
                            {
                                <span class="ms-db-badge" title="A stored generated column: computed from the others, never written">generated</span>
                            }
                        </td>
                        <td class="ms-db-cell-type">@column.Type</td>
                        <td class="ms-db-cell-null">
                            @if (column.Nullable)
                            {
                                <span class="ms-db-none">null</span>
                            }
                            else
                            {
                                <span>NOT NULL</span>
                            }
                        </td>
                        <td class="ms-db-cell-default">
                            @if (column.Default is { Length: > 0 } value)
                            {
                                <code class="ms-db-code" title="@value">@value</code>
                            }
                        </td>
                        <td class="ms-db-cell-key">
                            @if (detail.RowKey is { } key && key.Columns.Contains(column.Name))
                            {
                                <span class="ms-db-badge ms-db-badge-key"
                                      title="@(key.Source == DatabaseRowKeySource.PrimaryKey ? "Part of the primary key" : "Part of the row key: the unique index " + key.IndexName)">
                                    @(key.Source == DatabaseRowKeySource.PrimaryKey ? "PK" : "unique")
                                </span>
                            }
                            @foreach (DatabaseForeignKeyInfo foreignKey in detail.ForeignKeysOut.Where(x => x.Columns.Contains(column.Name)))
                            {
                                @if (foreignKey is { LinkedVisible: true, LinkedSchema: { } schema, LinkedTable: { } table })
                                {
                                    <a class="ms-db-fk-link"
                                       href="@DatabaseLinks.ToObject(Options.Value, State.ActiveScope, schema, table)"
                                       title="@($"Foreign key {foreignKey.Name}: references {DatabaseLinks.QualifiedName(schema, table)} ({string.Join(", ", foreignKey.LinkedColumns)})")">→ @table</a>
                                }
                                else
                                {
                                    <span class="ms-db-none" title="@($"Foreign key {foreignKey.Name}, into a table this studio does not show you")">→ not visible</span>
                                }
                            }
                        </td>
                        <td class="ms-db-cell-comment">
                            @if (column.Comment is { Length: > 0 } comment)
                            {
                                <span class="ms-db-comment" title="@comment">@comment</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </TableScroll>
}

@code {
    /// <summary>The relation's <c>DatabaseObjectDetail</c>. Typed <see cref="object" /> - see <c>DocumentComponentModel</c>.</summary>
    [Parameter]
    public object? Detail { get; set; }

    private DatabaseObjectDetail? DetailModel => Detail as DatabaseObjectDetail;
}
