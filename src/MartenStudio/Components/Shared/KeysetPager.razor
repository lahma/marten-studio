@*
    Paging, both ways.

    Keyset is the default because it is the only one that stays correct: `offset 10000` makes Postgres read
    and throw away ten thousand rows, and a row written between two page views silently shifts everything
    after it. The cursor is (sort value, id) with the id as a mandatory tiebreaker, so a page boundary in
    the middle of a millisecond does not drop rows.

    Offset paging is still offered, because numbered pages are what people reach for and "page 7" is a
    thing they can say to each other. It is capped, and the cap says so out loud rather than silently
    returning nothing.

    Shared since the database browser's row grid pages the same way: the documents list keeps every default
    below, and the row grid names itself "Row pages" and leaves out the jump box - a row is opened by its
    key, which is a link in the grid, not an id typed into a field.
*@

<div class="ms-pager" role="navigation" aria-label="@AriaLabel">
    @if (OffsetPaging)
    {
        <button type="button" class="ms-btn ms-btn-sm" disabled="@(Busy || Page <= 1)" @onclick="() => GoToPageAsync(1)">First</button>
        <button type="button" class="ms-btn ms-btn-sm" disabled="@(Busy || Page <= 1)" @onclick="() => GoToPageAsync(Page - 1)">Prev</button>
        <span class="ms-pager-position">Page @Page</span>
        <button type="button" class="ms-btn ms-btn-sm" disabled="@(Busy || !HasMore || AtOffsetCap)" @onclick="() => GoToPageAsync(Page + 1)">Next</button>

        @if (AtOffsetCap)
        {
            <span class="ms-pager-note" role="status">
                Offset paging stops at @MaxOffset rows: past that Postgres is reading and discarding rows to
                find the page. Switch to keyset paging to keep going.
            </span>
        }
    }
    else
    {
        <button type="button" class="ms-btn ms-btn-sm" disabled="@(Busy || !HasPrevious)" @onclick="FirstAsync">First</button>
        <button type="button" class="ms-btn ms-btn-sm" disabled="@(Busy || !HasPrevious)" @onclick="PreviousAsync">Prev</button>
        <span class="ms-pager-position">@PositionText</span>
        <button type="button" class="ms-btn ms-btn-sm" disabled="@(Busy || !HasMore)" @onclick="NextAsync">Next</button>
    }

    @if (ShowJump)
    {
        <form class="ms-pager-jump" @onsubmit="JumpAsync" @onsubmit:preventDefault="true">
            <label class="ms-sr-only" for="ms-pager-jump-input">@JumpLabel</label>
            <input id="ms-pager-jump-input"
                   class="ms-input ms-input-mono ms-pager-jump-input"
                   type="text"
                   placeholder="@JumpLabel"
                   @bind="jump"
                   @bind:event="onchange" />
            @* The button is not disabled on `jump.Length`: with `onchange` the field only reaches the server on
               blur, so a disabled-until-typed button would still be disabled when it was pressed. An empty jump
               is refused in the handler instead, where the check can be right. *@
            <button type="submit" class="ms-btn ms-btn-sm">Go</button>
        </form>
    }
</div>

@code {
    private string jump = string.Empty;

    /// <summary>The navigation landmark's accessible name.</summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Document pages";

    /// <summary>The jump box's label and placeholder.</summary>
    [Parameter]
    public string JumpLabel { get; set; } = "Jump to id";

    /// <summary>Whether to draw the jump box at all.</summary>
    [Parameter]
    public bool ShowJump { get; set; } = true;

    /// <summary>Whether a page is being read, which holds every button until it has been.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Whether the page is in offset mode.</summary>
    [Parameter]
    public bool OffsetPaging { get; set; }

    /// <summary>The one-based page number, in offset mode.</summary>
    [Parameter]
    public int Page { get; set; } = 1;

    /// <summary>Rows per page.</summary>
    [Parameter]
    public int PageSize { get; set; }

    /// <summary>The offset the builder refuses to go past.</summary>
    [Parameter]
    public int MaxOffset { get; set; }

    /// <summary>Whether another page exists.</summary>
    [Parameter]
    public bool HasMore { get; set; }

    /// <summary>Whether this is not the first page.</summary>
    [Parameter]
    public bool HasPrevious { get; set; }

    /// <summary>How many rows are on this page, for the position text.</summary>
    [Parameter]
    public int RowCount { get; set; }

    /// <summary>Goes to the first page.</summary>
    [Parameter]
    public EventCallback OnFirst { get; set; }

    /// <summary>Goes back one page.</summary>
    [Parameter]
    public EventCallback OnPrevious { get; set; }

    /// <summary>Goes forward one page.</summary>
    [Parameter]
    public EventCallback OnNext { get; set; }

    /// <summary>Goes to a numbered page, in offset mode.</summary>
    [Parameter]
    public EventCallback<int> OnPage { get; set; }

    /// <summary>Opens a document by id, whatever page it is on.</summary>
    [Parameter]
    public EventCallback<string> OnJumpToId { get; set; }

    private bool AtOffsetCap => Page * Math.Max(PageSize, 1) >= MaxOffset;

    private string PositionText => RowCount == 0 ? "no rows" : $"{RowCount} rows";

    private async Task FirstAsync() => await OnFirst.InvokeAsync();

    private async Task PreviousAsync() => await OnPrevious.InvokeAsync();

    private async Task NextAsync() => await OnNext.InvokeAsync();

    private async Task GoToPageAsync(int page) => await OnPage.InvokeAsync(Math.Max(1, page));

    private async Task JumpAsync()
    {
        if (jump.Length == 0)
        {
            return;
        }

        await OnJumpToId.InvokeAsync(jump.Trim());
    }
}
