<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <IsPackable>false</IsPackable>
    <!-- The repository uses central package management, but the build project pins Fallout's
         own versions here (NU1008 otherwise) and stays out of the artifacts layout. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UseArtifactsOutput>false</UseArtifactsOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.5.0" />
    <PackageReference Include="Fallout.Components" Version="10.5.0" />
  </ItemGroup>

</Project>
