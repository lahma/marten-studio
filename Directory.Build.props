<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CS1591 (missing XML doc comment) is deliberately NOT silenced here: MartenStudio is a documented
         public library, so a missing doc comment must fail the build in src/. .editorconfig turns it off
         again for build/, tests/, samples/ and *.razor, where it is noise. GenerateDocumentationFile is
         also what lets IDE0005 (unnecessary usings) run under EnforceCodeStyleInBuild. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Only the RCL opts back in. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Reproducibility and source indexing. SourceLink ships in the SDK on .NET 8+, so there is
       deliberately no SourceLink PackageReference here. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- CHANGELOG.md is the version authority: the Fallout build parses its top section and
       overrides VersionPrefix on the command line. The value below is only the local fallback - what a plain `dotnet run`
       builds with, and so the tag its health docs links point at - and VersionFallbackTests holds it to CHANGELOG.md's top
       version. -->
  <PropertyGroup>
    <VersionPrefix>2.0.0</VersionPrefix>
  </PropertyGroup>

  <!-- K8: the Kafka module ships as a preview beside the family release. The three Kafka projects (DataStudio.Kafka.Core, DataStudio.Kafka, DataStudio.Kafka.Wolverine) pack
       at `<version>-<label>`, the version being CHANGELOG.md's (above); no other project reads the label. To graduate KStudio, empty it:
       they then pack at the family version and stamp no label. The rest of graduation is words (the READMEs' "preview" and the
       prerelease flag of the install lines) and, a release later, the three projects' empty PackageValidationBaselineVersion element
       (build-and-release.md, "KStudio's preview label"). -->
  <PropertyGroup>
    <KafkaPrereleaseLabel>preview.1</KafkaPrereleaseLabel>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Marko Lahma</Authors>
    <Company>Marko Lahma</Company>
    <!-- One product (2.0): every project, shipped or not, is Data Studio; the modules are Marten, Postgres and Kafka. -->
    <Product>Data Studio</Product>
    <Copyright>Copyright (c) 2026 Marko Lahma</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lahma/marten-studio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lahma/marten-studio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- 1.0: the icon is the studio's favicon at 128 px (icon.png at the repository root, packed by each shipped project), and the
         release notes are the CHANGELOG, the version authority (D15). -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>What changed in each release: https://github.com/lahma/marten-studio/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- Package validation compares each shipped package with a release on nuget.org (EnablePackageValidation is on in each shipped project)
         once there is one. For 2.0 there is none: the seven ids (DataStudio, DataStudio.Postgres, DataStudio.Postgres.Diagnostics, DataStudio.Marten,
         DataStudio.Kafka, DataStudio.Kafka.Core, DataStudio.Kafka.Wolverine) are new, no release of them exists to be compared with, and restore refuses
         a baseline it cannot find (NU1101), so the element is empty. One release later, in that release's own pull request, set it to 2.0.0 (the Kafka
         three, which carry a preview label, to the version they shipped at, in their own projects: each has its own empty element until then). -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
