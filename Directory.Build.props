<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CS1591 (missing XML doc comment) is deliberately NOT silenced here: MartenStudio is a documented
         public library, so a missing doc comment must fail the build in src/. .editorconfig turns it off
         again for build/, tests/, samples/ and *.razor, where it is noise. GenerateDocumentationFile is
         also what lets IDE0005 (unnecessary usings) run under EnforceCodeStyleInBuild. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Only the RCL opts back in. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Reproducibility and source indexing. SourceLink ships in the SDK on .NET 8+, so there is
       deliberately no SourceLink PackageReference here. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- CHANGELOG.md is the version authority: the Fallout build parses its top section and
       overrides VersionPrefix on the command line. The value below is only the local fallback - what a plain `dotnet run`
       builds with, and so the tag its health docs links point at - and VersionFallbackTests holds it to CHANGELOG.md's top
       version. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Marko Lahma</Authors>
    <Company>Marko Lahma</Company>
    <!-- Each shipped project names its own Product (1.0): a Postgres Studio user should not read "Marten Studio". -->
    <Product>Marten Studio</Product>
    <Copyright>Copyright (c) 2026 Marko Lahma</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lahma/marten-studio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lahma/marten-studio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- 1.0: the icon is the studio's favicon at 128 px (icon.png at the repository root, packed by each shipped project), and the
         release notes are the CHANGELOG, the version authority (D15). -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>What changed in each release: https://github.com/lahma/marten-studio/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- 1.0: package validation compares each shipped package with the last release on nuget.org (EnablePackageValidation is
         on in each shipped project). Move it to the version just released, in the release's own pull request
         (build-and-release.md, Release engineering). -->
    <PackageValidationBaselineVersion>0.11.0</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
