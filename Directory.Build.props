<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CS1591 (missing XML doc comment) is deliberately NOT silenced here: MartenStudio is a documented
         public library, so a missing doc comment must fail the build in src/. .editorconfig turns it off
         again for build/, tests/, samples/ and *.razor, where it is noise. GenerateDocumentationFile is
         also what lets IDE0005 (unnecessary usings) run under EnforceCodeStyleInBuild. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Only the RCL opts back in. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Reproducibility and source indexing. SourceLink ships in the SDK on .NET 8+, so there is
       deliberately no SourceLink PackageReference here. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- CHANGELOG.md is the version authority: the Fallout build parses its top section and
       overrides VersionPrefix on the command line. The value below is only the local fallback. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Marko Lahma</Authors>
    <Company>Marko Lahma</Company>
    <Product>Marten Studio</Product>
    <Copyright>Copyright (c) 2026 Marko Lahma</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lahma/marten-studio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lahma/marten-studio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
