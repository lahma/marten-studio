<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Postgres Studio diagnostics worker: a generic host with no ASP.NET Core and no studio UI, which registers its own
    NpgsqlDataSource, adds PostgresStudio.Diagnostics and logs a plain-text summary of every database's findings once a
    day. It references src/PostgresStudio.Diagnostics ALONE - not PostgresStudio, not MartenStudio - and that is the
    point: PostgresStudioFenceTests holds the engine assembly free of ASP.NET Core, and this project is what shows a
    worker host can build and run on it. samples/PostgresStudio.SampleData is referenced only for the throwaway
    database's demo data; it references no studio either (D17). With no ConnectionStrings:Postgres it starts a
    throwaway Postgres (D18).

    Microsoft.NET.Sdk with OutputType Exe and Microsoft.Extensions.Hosting: a generic host and nothing else.

    It sets PostgresStudioPinsNpgsql, as every PostgresStudio-only project does, so it restores the Npgsql the packages are
    pinned to and joins the latest-Npgsql pass over postgres-studio.slnf (AGENTS.md D30); and
    PostgresStudioDiagnosticsPinsExtensions, so the conditional Microsoft.Extensions.* rows of Directory.Packages.props -
    Microsoft.Extensions.Hosting among them - apply here as they do to the engine. Nothing here may reach Marten:
    PostgresStudioSolutionFilterTests holds the filter closed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>postgres-studio-worker</UserSecretsId>
    <PostgresStudioPinsNpgsql>true</PostgresStudioPinsNpgsql>
    <PostgresStudioDiagnosticsPinsExtensions>true</PostgresStudioDiagnosticsPinsExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PostgresStudio.Diagnostics/PostgresStudio.Diagnostics.csproj" />
    <ProjectReference Include="../PostgresStudio.SampleData/PostgresStudio.SampleData.csproj" />
  </ItemGroup>

</Project>
