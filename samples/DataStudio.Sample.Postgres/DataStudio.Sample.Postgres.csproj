<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Postgres sample: a web host with no Marten, shaped like issue #8's host B - an admin database (the
    application's unkeyed NpgsqlDataSource) and one database per tenant, listed by the host itself through an
    IPostgresDatabaseSource. With no ConnectionStrings:Postgres it starts a throwaway Postgres (D18).

    Deliberately NO `RequiresAspNetWebAssets`, for the reason samples/DataStudio.Sample.Marten gives: the studio's own
    reference to Microsoft.AspNetCore.App.Internal.Assets brings blazor.web.js here, which is the shape a real host
    has.

    It sets DataStudioPostgresPinsNpgsql, as every Postgres-only project does, so it restores the Npgsql the
    The Postgres module package is pinned to and joins the latest-Npgsql pass over data-studio-postgres.slnf (AGENTS.md D30).
    Nothing here may reach Marten: PostgresSolutionFilterTests holds the filter closed.
  -->
  <PropertyGroup>
    <UserSecretsId>postgres-studio-sample</UserSecretsId>
    <DataStudioPostgresPinsNpgsql>true</DataStudioPostgresPinsNpgsql>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <!-- The throwaway-Postgres switch and the sign-in form are internal to the demo; PS-5's suite tests them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DataStudio.Postgres.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DataStudio.Postgres/DataStudio.Postgres.csproj" />
    <ProjectReference Include="../DataStudio.Sample.Postgres.Data/DataStudio.Sample.Postgres.Data.csproj" />
  </ItemGroup>

</Project>
