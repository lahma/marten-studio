<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The demo domain, its StoreOptions configuration and its seeder — shared by the sample host and by
    the integration tests, which is the whole reason it is a project of its own. It deliberately does
    NOT reference MartenStudio: the studio must work against a store it knows nothing about, and a
    reference here would let that invariant rot unnoticed.
  -->
  <ItemGroup>
    <PackageReference Include="Marten" />
  </ItemGroup>

  <!--
    The relational demo schemas (Quartz.NET's job store and a hand-made "legacy" schema) that
    RelationalDemoSchema applies. Embedded under a fixed logical name, so the resource name does not
    depend on how the SDK derives one from a folder path.
  -->
  <ItemGroup>
    <None Remove="Relational/*.sql" />
    <EmbeddedResource Include="Relational/*.sql" LogicalName="MartenStudio.SampleDomain.Relational.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
