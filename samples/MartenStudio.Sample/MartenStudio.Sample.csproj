<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>marten-studio-sample</UserSecretsId>

    <!--
      Not required any more, and kept on purpose. As of .NET 10 `_framework/blazor.web.js` is no longer
      embedded in the ASP.NET Core assemblies: it is a static web asset out of a pack the SDK resolves
      only for a project that says it needs one, and a host whose only Blazor components come from a
      referenced RCL says nothing. The package now ships its own copy for exactly that host, but the
      copy is only a fallback - the studio's script endpoint prefers whatever the host serves, because
      the host's copy is the one that matches the host's runtime. This is the sample showing the shape a
      real host should use, and it pairs with `app.MapStaticAssets()` in Program.cs.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <!-- The sign-in form and the throwaway-Postgres switch are tested; both are internal to the demo. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MartenStudio.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MartenStudio/MartenStudio.csproj" />
    <ProjectReference Include="../MartenStudio.SampleDomain/MartenStudio.SampleDomain.csproj" />
  </ItemGroup>

</Project>
