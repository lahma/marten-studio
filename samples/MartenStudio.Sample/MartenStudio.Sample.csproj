<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>marten-studio-sample</UserSecretsId>

    <!--
      Deliberately NO `RequiresAspNetWebAssets` here. As of .NET 10 `_framework/blazor.web.js` is no
      longer embedded in the ASP.NET Core assemblies: it is a static web asset out of a pack the SDK
      resolves only for a project that says it needs one, and a host whose only Blazor components come
      from a referenced RCL says nothing - which is exactly this host. The studio's own
      `PackageReference` to Microsoft.AspNetCore.App.Internal.Assets is what brings the script here,
      transitively, and it pairs with `app.MapStaticAssets()` in Program.cs. This sample is therefore the
      shape a real host has, and the fact that `/marten` is interactive without the property is the
      thing worth demonstrating. (Setting it here would also be NU1009 under central package management:
      the SDK's implicit reference and our PackageVersion row cannot both exist.)
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <!-- The sign-in form and the throwaway-Postgres switch are tested; both are internal to the demo. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MartenStudio.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MartenStudio/MartenStudio.csproj" />
    <ProjectReference Include="../MartenStudio.SampleDomain/MartenStudio.SampleDomain.csproj" />
  </ItemGroup>

</Project>
